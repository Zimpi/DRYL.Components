@namespace DRYL.Components
@implements IDisposable

@*  ─────────────────────────────────────────────────────────
    DrylStat — KPI / metric card.

    A glass surface showing a label, a big value, an optional delta
    chip and an optional sparkline. AI-aware: a model-generated value
    can reveal with the shared Generated wash.

    Usage:
      <DrylStat Label="Active users" Value="12,480"
                Delta="+12.4%" Direction="DeltaDirection.Up" Icon="User">
          <Sparkline>
              <DrylSparkline Data="@_series" Kind="SparklineKind.Area" />
          </Sparkline>
      </DrylStat>
    ───────────────────────────────────────────────────────── *@

<div class="@RootCssClass" @attributes="AdditionalAttributes">
    <DrylAuraElements Aura="_aura" GenTick="_genTick" />

    <div class="stat-head">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="stat-icon"><DrylIcon Name="@Icon" Size="14" /></span>
        }
        <span class="stat-label">@Label</span>
    </div>

    <div class="stat-value-row">
        <span class="stat-value">@Value</span>
        @if (!string.IsNullOrEmpty(Delta) && Direction != DeltaDirection.None)
        {
            <span class="@DeltaCssClass">
                @if (Direction == DeltaDirection.Up)
                {
                    <DrylIcon Name="ArrowUp" Size="12" />
                }
                else if (Direction == DeltaDirection.Down)
                {
                    <DrylIcon Name="ArrowDown" Size="12" />
                }
                @Delta
            </span>
        }
    </div>

    @if (Sparkline is not null)
    {
        <div class="stat-spark">
            @Sparkline
        </div>
    }
</div>

@code {
    /// <summary>Label / caption for the metric.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The headline value (pre-formatted).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Optional leading icon name.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Delta text, e.g. "+12.4%".</summary>
    [Parameter] public string? Delta { get; set; }

    /// <summary>Trend direction — drives delta colour and arrow.</summary>
    [Parameter] public DeltaDirection Direction { get; set; } = DeltaDirection.None;

    /// <summary>Optional sparkline slot, typically a <see cref="DrylSparkline"/>.</summary>
    [Parameter] public RenderFragment? Sparkline { get; set; }

    /// <summary>AI ambient state — controls the gradient border, glow, and reveal animation.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>AI aura variant. Leave <c>null</c> to inherit a surrounding <c>DrylAiScope</c> (ultimately <see cref="AiAura.Comet"/>).</summary>
    [Parameter] public AiAura? Aura { get; set; }

    /// <summary>Surrounding AI scope (supplied by <c>DrylAiScope</c>); used to resolve the aura variant.</summary>
    [CascadingParameter] private AiScope? Scope { get; set; }

    private AiAura EffectiveAura => AiScope.ResolveAura(Aura, Scope);

    /// <summary>Pass-through HTML attributes on the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Extra CSS class(es) merged onto the stat card's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly AuraLifecycle _aura = new();

    protected override void OnParametersSet()
    {
        if (Ai == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = Ai;
        _aura.Sync(Ai, () => InvokeAsync(StateHasChanged));
    }

    public void Dispose() => _aura.Dispose();

    private string RootCssClass
    {
        get
        {
            var parts = new List<string> { "glass-card", "p-default", "stat" };
            AiAuraCss.Append(parts, _aura, EffectiveAura);
            if (!string.IsNullOrWhiteSpace(Class)) parts.Add(Class!);
            return string.Join(' ', parts);
        }
    }

    private string DeltaCssClass =>
        "stat-delta " + Direction switch
        {
            DeltaDirection.Up => "stat-delta--up",
            DeltaDirection.Down => "stat-delta--down",
            _ => "stat-delta--neutral"
        };
}
