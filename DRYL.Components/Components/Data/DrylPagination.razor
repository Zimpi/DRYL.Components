@namespace DRYL.Components

@*  ─────────────────────────────────────────────────────────
    DrylPagination — page-size selector + page navigation.

    Usage (standalone):
      <DrylPagination CurrentPage="@page"
                      PageSize="@size"
                      TotalCount="@total"
                      OnPageChanged="@(p => page = p)"
                      OnPageSizeChanged="@(s => size = s)" />

    Pages are zero-indexed on the wire (CurrentPage = 0 is page 1). The
    component handles the conversion to 1-based labels in the UI.
    ───────────────────────────────────────────────────────── *@

<div class="tbl-pagination" @attributes="AdditionalAttributes">

    @if (TotalCount > 0)
    {
        var from = (CurrentPage * PageSize) + 1;
        var to = Math.Min((CurrentPage + 1) * PageSize, TotalCount);
        <div class="tbl-pagination-info">
            Showing @from–@to of @TotalCount
        </div>
    }
    else
    {
        <div class="tbl-pagination-info">No items</div>
    }

    @if (ShowPageSize)
    {
        <div class="tbl-pagination-size">
            <label for="@_sizeId">Rows</label>
            <select id="@_sizeId" class="select"
                    value="@PageSize"
                    @onchange="OnSizeChange"
                    aria-label="Rows per page">
                @foreach (var opt in PageSizeOptions)
                {
                    <option value="@opt" selected="@(opt == PageSize)">@opt</option>
                }
            </select>
        </div>
    }

    <div class="tbl-pagination-pages" role="navigation" aria-label="Pagination">
        <DrylButton Variant="DrylButton.ButtonVariant.Ghost"
                    Size="DrylButton.ButtonSize.Small"
                    LeadingIcon="ChevronsLeft"
                    AriaLabel="First page"
                    Disabled="@(CurrentPage == 0)"
                    OnClick="@(() => Go(0))"
 />

        <DrylButton Variant="DrylButton.ButtonVariant.Ghost"
                    Size="DrylButton.ButtonSize.Small"
                    LeadingIcon="ChevronLeft"
                    AriaLabel="Previous page"
                    Disabled="@(CurrentPage == 0)"
                    OnClick="@(() => Go(CurrentPage - 1))"
 />

        @foreach (var p in BuildPageList())
        {
            if (p is null)
            {
                <span class="tbl-pagination-gap" aria-hidden="true">…</span>
            }
            else
            {
                var pageZeroIdx = p.Value;
                var isCurrent = pageZeroIdx == CurrentPage;
                <DrylButton Variant="@(isCurrent ? DrylButton.ButtonVariant.Secondary : DrylButton.ButtonVariant.Ghost)"
                            Size="DrylButton.ButtonSize.Small"
                            OnClick="@(() => Go(pageZeroIdx))"
                            AriaLabel="@($"Page {pageZeroIdx + 1}")">
                    @(pageZeroIdx + 1)
                </DrylButton>
            }
        }

        <DrylButton Variant="DrylButton.ButtonVariant.Ghost"
                    Size="DrylButton.ButtonSize.Small"
                    LeadingIcon="ChevronRight"
                    AriaLabel="Next page"
                    Disabled="@(CurrentPage >= TotalPages - 1)"
                    OnClick="@(() => Go(CurrentPage + 1))" />

        <DrylButton Variant="DrylButton.ButtonVariant.Ghost"
                    Size="DrylButton.ButtonSize.Small"
                    LeadingIcon="ChevronsRight"
                    AriaLabel="Last page"
                    Disabled="@(CurrentPage >= TotalPages - 1)"
                    OnClick="@(() => Go(TotalPages - 1))"
 />
    </div>

</div>

@code {
    /// <summary>Zero-indexed current page.</summary>
    [Parameter] public int CurrentPage { get; set; }

    /// <summary>Number of items per page.</summary>
    [Parameter] public int PageSize { get; set; } = 20;

    /// <summary>Total number of items across all pages.</summary>
    [Parameter] public int TotalCount { get; set; }

    /// <summary>Available page-size choices in the selector. Default: <c>[10, 20, 50, 100]</c>.</summary>
    [Parameter] public IReadOnlyList<int> PageSizeOptions { get; set; } = [10, 20, 50, 100];

    /// <summary>Hides the page-size selector when false. Default true.</summary>
    [Parameter] public bool ShowPageSize { get; set; } = true;

    /// <summary>Raised with the new zero-indexed page when the user clicks a page button.</summary>
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    /// <summary>Raised with the new page size when the user picks a size in the selector.</summary>
    [Parameter] public EventCallback<int> OnPageSizeChanged { get; set; }

    /// <summary>Pass-through HTML attributes applied to the outermost element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _sizeId = $"dryl-pgsize-{Guid.NewGuid():N}";

    private int TotalPages => PageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)TotalCount / PageSize));

    private Task Go(int page)
    {
        var clamped = Math.Max(0, Math.Min(page, TotalPages - 1));
        return clamped == CurrentPage ? Task.CompletedTask : OnPageChanged.InvokeAsync(clamped);
    }

    private Task OnSizeChange(ChangeEventArgs e)
    {
        if (e.Value is null) return Task.CompletedTask;
        if (!int.TryParse(e.Value.ToString(), out var newSize) || newSize <= 0) return Task.CompletedTask;
        return OnPageSizeChanged.InvokeAsync(newSize);
    }

    // Returns the visible page list — int values are zero-indexed page numbers,
    // null entries denote ellipsis gaps. For ≤7 pages, lists everything.
    // Otherwise: 1 … (current±1) … last, with edges handled at start/end.
    private IEnumerable<int?> BuildPageList()
    {
        var total = TotalPages;
        if (total <= 7)
        {
            for (var i = 0; i < total; i++) yield return i;
            yield break;
        }

        var current = CurrentPage;
        var nearStart = current <= 3;
        var nearEnd = current >= total - 4;

        yield return 0;

        if (nearStart)
        {
            for (var i = 1; i <= 4; i++) yield return i;
            yield return null;
        }
        else if (nearEnd)
        {
            yield return null;
            for (var i = total - 5; i < total - 1; i++) yield return i;
        }
        else
        {
            yield return null;
            yield return current - 1;
            yield return current;
            yield return current + 1;
            yield return null;
        }

        yield return total - 1;
    }
}
