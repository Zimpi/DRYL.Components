@namespace DRYL.Components

@*  ─────────────────────────────────────────────────────────
    DrylBadge — small status pill.

    Usage:
      <DrylBadge Kind="BadgeKind.Success" Dot>Healthy</DrylBadge>
      <DrylBadge Kind="BadgeKind.Accent">v0.2.0</DrylBadge>
      <DrylBadge>Neutral</DrylBadge>

    Use <c>Dot</c> for live/status indicators. The dot glows in the
    badge's foreground color.
    ───────────────────────────────────────────────────────── *@

<span class="@CssClass" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <DrylIcon Name="@Icon" Size="11" />
    }
    @ChildContent
</span>

@code {
    /// <summary>Color treatment of the badge.</summary>
    [Parameter] public BadgeKind Kind { get; set; } = BadgeKind.Neutral;

    /// <summary>If true, prefixes the label with a glowing dot.</summary>
    [Parameter] public bool Dot { get; set; }

    /// <summary>Optional icon name shown before the label.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Badge content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Pass-through HTML attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass
    {
        get
        {
            var kind = Kind switch
            {
                BadgeKind.Accent  => "badge-accent",
                BadgeKind.Success => "badge-success",
                BadgeKind.Warning => "badge-warning",
                BadgeKind.Danger  => "badge-danger",
                _ => string.Empty
            };
            var dot = Dot ? "badge-dot" : string.Empty;
            return string.Join(' ', new[] { "badge", kind, dot }
                                 .Where(s => !string.IsNullOrWhiteSpace(s)));
        }
    }

    public enum BadgeKind { Neutral, Accent, Success, Warning, Danger }
}
