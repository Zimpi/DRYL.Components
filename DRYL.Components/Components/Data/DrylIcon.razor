@namespace DRYL.Components

@*  ─────────────────────────────────────────────────────────
    DrylIcon — line icon set, currentColor stroked.

    Usage:
      <DrylIcon Name="Download" />
      <DrylIcon Name="Settings" Size="20" AriaLabel="Settings" />

    Pass <c>AriaLabel</c> when the icon stands alone semantically.
    Without it, the icon is marked aria-hidden (decorative).
    See <c>DrylIcon.Icons.Keys</c> for the full list of names.

    Icon paths are sourced from Lucide (https://lucide.dev), ISC-licensed.
    See THIRD_PARTY_NOTICES.md at the repository root for the full license.
    The DRYL-side name (left column) is the public identifier; the comment
    after each entry shows the upstream Lucide icon name.
    ───────────────────────────────────────────────────────── *@

<svg viewBox="0 0 24 24"
     width="@Size"
     height="@Size"
     fill="none"
     stroke="currentColor"
     stroke-width="@StrokeWidth"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="@Class"
     role="@(string.IsNullOrEmpty(AriaLabel) ? null : "img")"
     aria-label="@AriaLabel"
     aria-hidden="@(string.IsNullOrEmpty(AriaLabel) ? "true" : null)"
     @attributes="AdditionalAttributes">
    @((MarkupString)Inner)
</svg>

@code {
    /// <summary>Icon name. See <see cref="Icons"/> for the available set.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Width and height in pixels. Default 16.</summary>
    [Parameter] public int Size { get; set; } = 16;

    /// <summary>SVG stroke-width. Default "2" (Lucide's native weight).</summary>
    [Parameter] public string StrokeWidth { get; set; } = "2";

    /// <summary>Extra CSS class(es) applied to the &lt;svg&gt; root.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Accessible label. Leave null for a decorative icon (aria-hidden).</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Pass-through HTML attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string Inner => Icons.TryGetValue(Name, out var v) ? v : string.Empty;

