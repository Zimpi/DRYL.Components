    }

    // ───── Selection helpers ─────

    private async Task ClearSelection()
    {
        if (_selected.Count == 0) return;
        _selected.Clear();
        await SelectedItemsChanged.InvokeAsync(new HashSet<TItem>());
    }

    // ───── Pipeline ─────

    private async Task RebuildViewAsync()
    {
        if (DataProvider is not null)
        {
            await LoadFromProviderAsync();
            return;
        }

        var items = Items ?? [];
        var filtered = items.Where(MatchesSearch).Where(MatchesFilters);
        var sorted = ApplySort(filtered, _columns, _sort);
        var materialized = sorted as IList<TItem> ?? sorted.ToList();
        _filteredCount = materialized.Count;

        if (_pageSize > 0 && !Virtualize)
        {
            var maxPage = Math.Max(0, (int)Math.Ceiling((double)_filteredCount / _pageSize) - 1);
            if (_page > maxPage) _page = maxPage;
            _view = materialized.Skip(_page * _pageSize).Take(_pageSize).ToList();
        }
        else
        {
            _view = materialized is List<TItem> lst ? lst : materialized.ToList();
        }
    }

    private async Task LoadFromProviderAsync()
    {
        if (DataProvider is null) return;

        _dataProviderCts?.Cancel();
        _dataProviderCts = new CancellationTokenSource();
        var token = _dataProviderCts.Token;

        _serverLoading = true;
        StateHasChanged();

        try
        {
            var skip = _pageSize > 0 && !Virtualize ? _page * _pageSize : 0;
            var take = _pageSize > 0 && !Virtualize ? _pageSize : int.MaxValue;
            var request = new DataRequest(
                Skip: skip,
                Take: take,
                SearchText: _appliedSearch,
                Sort: _sort.ToArray(),
                Filters: _filters.Values.ToArray());

            var result = await DataProvider(request, token);
            if (token.IsCancellationRequested) return;

            _view = result.Items.ToList();
            _filteredCount = result.TotalCount;
        }
        catch (OperationCanceledException) { /* superseded */ }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _serverLoading = false;
                StateHasChanged();
            }
        }
    }

    // ───── Rendering helpers ─────

    private string HeaderCssClass(DrylColumn<TItem> col)
    {
        var classes = new List<string>();
        if (col.Sortable) classes.Add("tbl-th-sort");
        if (col.Filterable) classes.Add("tbl-th-filterable");
        if (col.Align != ColumnAlign.Start) classes.Add($"tbl-align-{col.Align.ToString().ToLowerInvariant()}");
        return string.Join(' ', classes);
    }

    private string? HeaderStyle(DrylColumn<TItem> col)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(col.Width)) parts.Add($"width: {col.Width}");
        return parts.Count == 0 ? null : string.Join("; ", parts);
    }

    private string CellCssClass(DrylColumn<TItem> col)
    {
        var classes = new List<string>();
        if (col.Primary) classes.Add("tbl-td-primary");
        if (col.Align != ColumnAlign.Start) classes.Add($"tbl-align-{col.Align.ToString().ToLowerInvariant()}");
        return string.Join(' ', classes);
    }

    private string? CellStyle(DrylColumn<TItem> col) =>
        col.Align != ColumnAlign.Start ? $"text-align: {col.TextAlign}" : null;

    private bool ShowAiEnter(TItem item) =>
        (Ai == AiState.Streaming || Ai == AiState.Generated) && !_seenItems.Contains(item);

    private string RowCssClass(TItem item, int rowIndex)
    {
        var classes = new List<string>();
        if (_selected.Contains(item)) classes.Add("tbl-row--selected");
        if (ShowAiEnter(item)) classes.Add("tbl-row--ai-enter");
        if (ReorderColumnVisible && rowIndex >= 0)
        {
            if (_dragIndex == rowIndex) classes.Add("tbl-row--dragging");
            else if (_dragOverIndex == rowIndex) classes.Add("tbl-row--drop-target");
        }
        return classes.Count == 0 ? string.Empty : string.Join(' ', classes);
    }

    private async Task ToggleRow(TItem item)
    {
        if (!_selected.Remove(item))
            _selected.Add(item);
        await SelectedItemsChanged.InvokeAsync(new HashSet<TItem>(_selected));
    }

    private async Task ToggleAll(ChangeEventArgs e)
    {
        if (e.Value is true)
            foreach (var item in _view) _selected.Add(item);
        else
            foreach (var item in _view) _selected.Remove(item);

        await SelectedItemsChanged.InvokeAsync(new HashSet<TItem>(_selected));
    }

    private Task HandleRowClick(TItem item) =>
        OnRowClick.InvokeAsync(item);

    // ───── Row reorder ─────

    private string GripAriaLabel(int index)
    {
        var position = index + 1;
        return _view.Count > 0
            ? $"Reorder row {position} of {_view.Count}. Press Alt plus Arrow Up or Arrow Down to move."
            : "Reorder row.";
    }

    private void OnDragStart(int index)
    {
        if (!CanReorderNow) return;
        _dragIndex = index;
        _dragOverIndex = index;
    }

    private void OnDragEnter(int index)
    {
        if (_dragIndex is null || !CanReorderNow) return;
        _dragOverIndex = index;
    }

    private async Task OnDrop(int index)
    {
        if (_dragIndex is int from)
            await MoveRow(from, index);
        _dragIndex = null;
        _dragOverIndex = null;
    }

    private void OnDragEnd()
    {
        _dragIndex = null;
        _dragOverIndex = null;
    }

    private async Task OnGripKeyDown(KeyboardEventArgs e, int index)
    {
        if (!CanReorderNow || !e.AltKey) return;
        var target = e.Key switch
        {
            "ArrowUp" => index - 1,
            "ArrowDown" => index + 1,
            _ => index
        };
        if (target == index || target < 0 || target >= _view.Count) return;
        await MoveRow(index, target);
        _pendingFocusGrip = target;
    }

    // Optimistically reorders the displayed view so the move is reflected immediately, then
    // raises OnRowReordered so the consumer can apply the same move to its backing collection.
    private async Task MoveRow(int from, int to)
    {
        if (!CanReorderNow) return;
        if (from < 0 || from >= _view.Count) return;
        to = Math.Clamp(to, 0, _view.Count - 1);
        if (from == to) return;

        var item = _view[from];
        _view.RemoveAt(from);
        _view.Insert(to, item);
        await OnRowReordered.InvokeAsync(new RowReorderEventArgs(from, to));
    }

    // ───── State persistence ─────

    private void MarkPersistDirty()
    {
        if (!string.IsNullOrEmpty(PersistStateKey)) _persistDirty = true;
    }

    private sealed record PersistedFilter(string Key, int Op, string? Text, List<string>? In);

    private sealed record PersistedState(
        List<SortDescriptor> Sort,
        List<PersistedFilter> Filters,
        int Page,
        int PageSize,
        List<string> Hidden);

    private async Task RestoreStateAsync(string key)
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("dryl.storage.get", key);
            _stateRestored = true;
            if (string.IsNullOrEmpty(json)) return;

            var state = System.Text.Json.JsonSerializer.Deserialize<PersistedState>(json);
            if (state is null) return;

            _sort.Clear();
            foreach (var s in state.Sort) _sort.Add(s);

            _filters.Clear();
            foreach (var f in state.Filters)
            {
                var op = (FilterOperator)f.Op;
                if (op == FilterOperator.Contains && f.Text is not null)
                    _filters[f.Key] = new FilterDescriptor(f.Key, op, f.Text);
                else if (op == FilterOperator.In && f.In is { Count: > 0 })
                    _filters[f.Key] = new FilterDescriptor(f.Key, op,
                        new HashSet<object?>(f.In.Cast<object?>()));
            }

            _page = state.Page;
            if (state.PageSize > 0) { _pageSize = state.PageSize; _lastSeenPageSize = state.PageSize; }

            _hiddenColumns.Clear();
            foreach (var k in state.Hidden) _hiddenColumns.Add(k);

            await RebuildViewAsync();
            StateHasChanged();
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or System.Text.Json.JsonException)
        {
            // Restore is best-effort — fall back to defaults.
            _stateRestored = true;
        }
    }

    private async Task PersistStateAsync(string key)
    {
        var filters = _filters.Values.Select(d =>
        {
            string? text = null;
            List<string>? inList = null;
            if (d.Operator == FilterOperator.Contains)
                text = d.Value as string;
            else if (d.Operator == FilterOperator.In && d.Value is HashSet<object?> set)
                inList = set.Select(v => v?.ToString() ?? string.Empty).ToList();
            return new PersistedFilter(d.ColumnKey, (int)d.Operator, text, inList);
        }).ToList();

        var state = new PersistedState(
            Sort: _sort.ToList(),
            Filters: filters,
            Page: _page,
            PageSize: _pageSize,
            Hidden: _hiddenColumns.ToList());

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(state);
            await JS.InvokeVoidAsync("dryl.storage.set", key, json);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // Persistence is best-effort.
        }
    }

    // ───── CSV export ─────

    private const string Utf8Bom = "﻿";

    private async Task ExportCsvAsync()
    {
        var columns = VisibleColumns.ToList();
        var rows = await BuildExportRowsAsync(CancellationToken.None);
        var csv = BuildCsv(columns, rows);
        // Prepend a UTF-8 BOM so Excel opens the file with the correct encoding.
        await JS.InvokeVoidAsync("dryl.download.csv", ExportFileName, Utf8Bom + csv);
    }

    // The rows to export: search + filters + sort applied, across ALL pages.
    // In client mode this is computed in-memory. In server (DataProvider) mode we
    // issue a dedicated request with the current search/sort/filters but Skip=0 /
    // Take=int.MaxValue so the export covers the full filtered set, not just the
    // page currently in view. Backends that cannot serve an unbounded Take should
    // cap it on their side.
    private async Task<List<TItem>> BuildExportRowsAsync(CancellationToken ct)
    {
        if (DataProvider is not null)
        {
            var request = new DataRequest(
                Skip: 0,
                Take: int.MaxValue,
                SearchText: _appliedSearch,
                Sort: _sort.ToArray(),
                Filters: _filters.Values.ToArray());

            var result = await DataProvider(request, ct);
            return result.Items.ToList();
        }

        var items = Items ?? [];
        var filtered = items.Where(MatchesSearch).Where(MatchesFilters);
        var sorted = ApplySort(filtered, _columns, _sort);
        return sorted.ToList();
    }

    private string BuildCsv(List<DrylColumn<TItem>> columns, List<TItem> rows)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(',', columns.Select(c => CsvField(c.DisplayTitle))));
        foreach (var item in rows)
            sb.AppendLine(string.Join(',', columns.Select(c => CsvField(FormatExportValue(c.GetValue(item))))));
        return sb.ToString();
    }

    // Numbers and dates are formatted with InvariantCulture so the CSV is stable
    // regardless of the server's locale (e.g. German "0,5" → "0.5").
    private static string FormatExportValue(object? value) => value switch
    {
        null => string.Empty,
        System.IFormattable f => f.ToString(null, System.Globalization.CultureInfo.InvariantCulture),
        _ => value.ToString() ?? string.Empty
    };

    // RFC 4180: quote a field containing a comma, quote or line break; escape inner quotes.
    private static string CsvField(string value)
    {
        if (value.IndexOfAny([',', '"', '\n', '\r']) >= 0)
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        return value;
    }

    public async ValueTask DisposeAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _dataProviderCts?.Cancel();
        _dataProviderCts?.Dispose();
        await ValueTask.CompletedTask;
    }
}
