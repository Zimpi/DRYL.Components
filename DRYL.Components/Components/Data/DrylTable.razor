@namespace DRYL.Components
@typeparam TItem
@inject IJSRuntime JS
@implements IAsyncDisposable

@*  ─────────────────────────────────────────────────────────
    DrylTable<TItem> — glass data table with declarative columns,
    global search, click-to-sort, per-column filters, pagination,
    grouping, row-expansion, bulk-actions, virtualization,
    column-visibility menu, state persistence, optional KPI summary
    bar and optional server-side DataProvider.

    Usage (minimal):
      <DrylTable TItem="ServiceRow" Items="@services" AriaLabel="Services">
          <Columns>
              <DrylColumn TItem="ServiceRow" Field="@(s => s.Name)" Title="Service" Sortable Searchable Primary />
              <DrylColumn TItem="ServiceRow" Field="@(s => s.Status)" Title="Status" Filterable />
          </Columns>
      </DrylTable>

    Usage (enterprise):
      <DrylTable TItem="ServiceRow"
                 Items="@services"
                 Searchable ShowToolbar
                 PageSize="20"
                 GroupBy="@(s => s.Environment)"
                 PersistStateKey="services-table"
                 StickyHeader>
          <Columns> ... </Columns>
          <DetailTemplate Context="s"> ... </DetailTemplate>
          <RowActions    Context="s"> ... </RowActions>
          <BulkActions   Context="selected"> ... </BulkActions>
      </DrylTable>
    ───────────────────────────────────────────────────────── *@

<CascadingValue Value="this" IsFixed="true">
    @Columns
</CascadingValue>

<div class="@WrapperClass" @ref="_rootEl" @attributes="AdditionalAttributes">

    @if (Ai != AiState.None && Bordered)
    {
        <div class="ai-aura-ring"></div>
        <div class="ai-aura-glow"></div>
        @if (Ai == AiState.Generated)
        {
            <div class="ai-aura-wash" @key="_genTick"></div>
        }
    }

    @if (BulkActions is not null && _selected.Count > 0)
    {
        <div class="tbl-bulk-bar" role="region" aria-label="Bulk actions">
            <div class="tbl-bulk-bar-info">
                <span class="tbl-bulk-bar-count">@_selected.Count</span>
                <span class="tbl-bulk-bar-label">selected</span>
            </div>
            <div class="tbl-bulk-bar-actions">
                @BulkActions(_selected)
            </div>
            <button type="button"
                    class="tbl-bulk-bar-close"
                    @onclick="ClearSelection"
                    aria-label="Clear selection">
                <DrylIcon Name="X" Size="14" />
            </button>
        </div>
    }

    @if (SummaryContent is not null)
    {
        <div class="tbl-summary">
            @SummaryContent
        </div>
    }

    @if (ShowToolbar)
    {
        <div class="tbl-toolbar">
            @if (Searchable)
            {
                <div class="tbl-search">
                    <DrylIcon Name="Search" Size="14" Class="input-icon input-icon-leading" />
                    <input class="input has-leading-icon"
                           type="search"
                           value="@_searchInput"
                           @oninput="OnSearchInput"
                           placeholder="@SearchPlaceholder"
                           aria-label="@SearchPlaceholder" />
                </div>
            }
            @if (_filters.Count > 0)
            {
                <div class="tbl-filter-chips" role="list" aria-label="Active filters">
                    @foreach (var (key, descriptor) in _filters)
                    {
                        var col = _columns.FirstOrDefault(c => c.Key == key);
                        if (col is null) continue;
                        <span class="tbl-filter-chip" role="listitem">
                            <span class="tbl-filter-chip-label">@col.DisplayTitle:</span>
                            <span class="tbl-filter-chip-value">@FormatFilterValue(descriptor)</span>
                            <button type="button"
                                    class="tbl-filter-chip-close"
                                    @onclick="@(() => ClearFilter(key))"
                                    aria-label="@($"Remove filter on {col.DisplayTitle}")">
                                <DrylIcon Name="X" Size="11" />
                            </button>
                        </span>
                    }
                </div>
            }
            @if (ToolbarContent is not null)
            {
                <div class="tbl-toolbar-extra">@ToolbarContent</div>
            }
            @if (ShowExport)
            {
                <div class="tbl-toolbar-action @(ToolbarContent is null ? "tbl-toolbar-action--auto" : null)">
                    <DrylButton Variant="DrylButton.ButtonVariant.Ghost"
                                Size="DrylButton.ButtonSize.Small"
                                LeadingIcon="Download"
                                OnClick="ExportCsvAsync">
                        Export
                    </DrylButton>
                </div>
            }
            @if (AllowColumnVisibility)
            {
                <div class="tbl-col-menu-wrap @(ToolbarContent is null && !ShowExport ? "tbl-col-menu-wrap--auto" : null)">
                    <button type="button"
                            class="tbl-col-menu-trigger @(_colMenuOpen ? "is-active" : null)"
                            @onclick="ToggleColMenu"
                            aria-label="Columns"
                            aria-expanded="@(_colMenuOpen ? "true" : "false")">
                        <DrylIcon Name="Settings" Size="13" />
                    </button>
                    @if (_colMenuOpen)
                    {
                        <div class="tbl-col-menu" @onkeydown="OnColMenuKeyDown" tabindex="-1">
                            <div class="tbl-col-menu-header">
                                <span class="tbl-col-menu-title">Columns</span>
                                <button type="button" class="tbl-col-menu-close"
                                        @onclick="CloseColMenu" aria-label="Close">
                                    <DrylIcon Name="X" Size="12" />
                                </button>
                            </div>
                            <div class="tbl-col-menu-body">
                                @foreach (var col in _columns)
                                {
                                    var c = col;
                                    var isHidden = _hiddenColumns.Contains(c.Key);
                                    <label class="tbl-col-menu-option">
                                        <input type="checkbox" class="checkbox"
                                               checked="@(!isHidden)"
                                               @onchange="@((ChangeEventArgs e) => ToggleColumnVisible(c, e.Value is true))" />
                                        <span>@c.DisplayTitle</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="@WrapClass" style="@WrapStyle">
        <table class="tbl" aria-label="@AriaLabel" role="grid">
            <thead>
                <tr>
                    @if (ReorderColumnVisible)
                    {
                        <th class="tbl-col-grip" scope="col" aria-label="Reorder"></th>
                    }
                    @if (Selectable)
                    {
                        <th class="tbl-col-check" scope="col">
                            <input type="checkbox"
                                   class="checkbox"
                                   checked="@AllSelected"
                                   @onchange="ToggleAll"
                                   aria-label="Select all rows" />
                        </th>
                    }
                    @if (DetailTemplate is not null)
                    {
                        <th class="tbl-col-expand" scope="col" aria-label="Expand"></th>
                    }
                    @foreach (var col in VisibleColumns)
                    {
                        <th class="@HeaderCssClass(col)"
                            scope="col"
                            style="@HeaderStyle(col)"
                            aria-sort="@HeaderAriaSort(col)">
                            <div class="tbl-th-inner">
                                <span class="tbl-th-clickable"
                                      tabindex="@(col.Sortable ? 0 : (int?)null)"
                                      @onclick="@((MouseEventArgs e) => OnHeaderClick(col, e))"
                                      @onkeydown="@((KeyboardEventArgs e) => OnHeaderKeyDown(col, e))">
                                    <span class="tbl-th-label">
                                        @if (col.HeaderTemplate is not null)
                                        {
                                            @col.HeaderTemplate
                                        }
                                        else
                                        {
                                            @col.DisplayTitle
                                        }
                                    </span>
                                    @if (col.Sortable)
                                    {
                                        var dir = SortDirectionFor(col);
                                        <span class="tbl-th-sort-icon @(dir.HasValue ? "is-active" : null)">
                                            @if (dir == SortDirection.Descending)
                                            {
                                                <DrylIcon Name="ArrowDown" Size="12" />
                                            }
                                            else
                                            {
                                                <DrylIcon Name="ArrowUp" Size="12" />
                                            }
                                        </span>
                                    }
                                </span>

                                @if (col.Filterable)
                                {
                                    var hasFilter = _filters.ContainsKey(col.Key);
                                    <button type="button"
                                            class="tbl-filter-trigger @(hasFilter ? "is-active" : null)"
                                            @onclick="@(() => ToggleFilter(col))"
                                            @onclick:stopPropagation
                                            aria-label="@($"Filter {col.DisplayTitle}")"
                                            aria-expanded="@(_openFilterColumn == col.Key ? "true" : "false")">
                                        <DrylIcon Name="Filter" Size="11" />
                                    </button>
                                }

                                @if (col.Filterable && _openFilterColumn == col.Key)
                                {
                                    var openCol = col;
                                    var currentText = _filters.TryGetValue(openCol.Key, out var f1)
                                        ? f1.Value as string ?? "" : "";
                                    var currentSet = _filters.TryGetValue(openCol.Key, out var f2) && f2.Value is HashSet<object?> s
                                        ? s : new HashSet<object?>();
                                    <div class="tbl-filter-popover"
                                         @onkeydown="OnPopoverKeyDown"
                                         tabindex="-1">
                                        <div class="tbl-filter-popover-header">
                                            <span class="tbl-filter-popover-title">Filter @openCol.DisplayTitle</span>
                                            <button type="button" class="tbl-filter-popover-close"
                                                    @onclick="CloseFilter" aria-label="Close filter">
                                                <DrylIcon Name="X" Size="12" />
                                            </button>
                                        </div>
                                        <div class="tbl-filter-popover-body">
                                            @if (openCol.ResolvedFilterType == ColumnFilterType.Select)
                                            {
                                                var values = GetDistinctValues(openCol).ToList();
                                                if (values.Count == 0)
                                                {
                                                    <span class="tbl-filter-empty">No values</span>
                                                }
                                                @foreach (var value in values)
                                                {
                                                    var v = value;
                                                    var isChecked = SetContainsValue(currentSet, v);
                                                    <label class="tbl-filter-option">
                                                        <input type="checkbox" class="checkbox"
                                                               checked="@isChecked"
                                                               @onchange="@((ChangeEventArgs e) => ToggleSelectFilterValue(openCol, v, e.Value is true))" />
                                                        <span>@(v?.ToString() ?? "(empty)")</span>
                                                    </label>
                                                }
                                            }
                                            else
                                            {
                                                <input class="input"
                                                       type="text"
                                                       value="@currentText"
                                                       placeholder="Contains…"
                                                       @oninput="@((ChangeEventArgs e) => SetTextFilter(openCol, e.Value?.ToString()))" />
                                            }
                                        </div>
                                        <div class="tbl-filter-popover-footer">
                                            <DrylButton Variant="DrylButton.ButtonVariant.Ghost"
                                                        Size="DrylButton.ButtonSize.Small"
                                                        OnClick="@(() => ClearFilter(openCol.Key))">
                                                Clear
                                            </DrylButton>
                                            <DrylButton Variant="DrylButton.ButtonVariant.Secondary"
                                                        Size="DrylButton.ButtonSize.Small"
                                                        OnClick="CloseFilter">
                                                Done
                                            </DrylButton>
                                        </div>
                                    </div>
                                }
                            </div>
                        </th>
                    }
                    @if (RowActions is not null)
                    {
                        <th class="tbl-col-actions" scope="col" aria-label="Actions"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Loading || _serverLoading)
                {
                    <tr class="tbl-loading-row">
                        <td colspan="99" aria-label="Loading">
                            <div style="display:flex; align-items:center; justify-content:center; padding: var(--sp-7) 0;">
                                <span class="spinner" role="status" aria-label="Loading data…"></span>
                            </div>
                        </td>
                    </tr>
                }
                else if (_view.Count == 0)
                {
                    <tr class="tbl-empty-row">
                        <td colspan="99">
                            @if (EmptyContent is not null)
                            {
                                @EmptyContent
                            }
                            else
                            {
                                <span>No data</span>
                            }
                        </td>
                    </tr>
                }
                else if (Virtualize)
                {
                    <Virtualize TItem="TItem" Items="@_view" ItemSize="@VirtualizeItemSize" Context="item">
                        @RowFragment(item)
                    </Virtualize>
                }
                else if (UseGrouping)
                {
                    @foreach (var group in _view.GroupBy(GroupBy!))
                    {
                        var groupKey = group.Key;
                        var groupId = GroupId(groupKey);
                        var collapsed = _collapsedGroups.Contains(groupId);
                        <tr class="tbl-group-header" @key="@($"g:{groupId}")">
                            <td colspan="99">
                                <button type="button"
                                        class="tbl-group-toggle"
                                        @onclick="@(() => ToggleGroup(groupId))"
                                        aria-expanded="@(collapsed ? "false" : "true")">
                                    <span class="tbl-group-chevron @(collapsed ? "is-collapsed" : null)">
                                        <DrylIcon Name="ChevronDown" Size="12" />
                                    </span>
                                    <span class="tbl-group-label">@(groupKey?.ToString() ?? "(none)")</span>
                                    <span class="tbl-group-count">@group.Count()</span>
                                </button>
                            </td>
                        </tr>
                        if (!collapsed)
                        {
                            @foreach (var item in group)
                            {
                                @RowFragment(item)
                            }
                        }
                    }
                }
                else
                {
                    @foreach (var item in _view)
                    {
                        @RowFragment(item)
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_pageSize > 0 && !Virtualize)
    {
        <div class="tbl-footer">
            <DrylPagination CurrentPage="@_page"
                            PageSize="@_pageSize"
                            TotalCount="@_filteredCount"
                            PageSizeOptions="@PageSizeOptions"
                            OnPageChanged="OnPageChangedInternal"
                            OnPageSizeChanged="OnPageSizeChangedInternal" />
        </div>
    }

</div>

@* Templated row fragment — emits the data <tr> and the optional detail <tr>.
   <text> is a Razor pass-through tag that lets a single template return multiple
   top-level elements without wrapping them in an extra container. *@
@code {
    private RenderFragment<TItem> RowFragment => item =>
    @<text>
        @{ var rowIndex = ReorderColumnVisible ? _view.IndexOf(item) : -1; }
        <tr class="@RowCssClass(item, rowIndex)"
            @onclick="() => HandleRowClick(item)"
            @key="item"
            @ondragenter="() => OnDragEnter(rowIndex)"
            @ondragover:preventDefault="ReorderColumnVisible"
            @ondrop="() => OnDrop(rowIndex)"
            aria-selected="@(Selectable ? _selected.Contains(item).ToString().ToLower() : null)">

            @if (ReorderColumnVisible)
            {
                var canDrag = CanReorderNow;
                <td class="tbl-col-grip" @onclick:stopPropagation>
                    <button type="button"
                            class="tbl-grip"
                            data-grip-index="@rowIndex"
                            draggable="@(canDrag ? "true" : "false")"
                            disabled="@(!canDrag)"
                            @ondragstart="() => OnDragStart(rowIndex)"
                            @ondragend="OnDragEnd"
                            @onkeydown="@((KeyboardEventArgs e) => OnGripKeyDown(e, rowIndex))"
                            aria-label="@GripAriaLabel(rowIndex)"
                            title="@(canDrag ? "Drag, or press Alt+Arrow Up/Down to reorder" : "Clear sorting to reorder rows")">
                        <DrylIcon Name="GripVertical" Size="14" />
                    </button>
                </td>
            }

            @if (Selectable)
            {
                <td class="tbl-col-check" @onclick:stopPropagation>
                    <input type="checkbox"
                           class="checkbox"
                           checked="@_selected.Contains(item)"
                           @onchange="() => ToggleRow(item)"
                           aria-label="Select row" />
                </td>
            }

            @if (DetailTemplate is not null)
            {
                var expanded = _expandedRows.Contains(item);
                <td class="tbl-col-expand" @onclick:stopPropagation>
                    <button type="button"
                            class="tbl-expand-btn @(expanded ? "is-expanded" : null)"
                            @onclick="() => ToggleExpanded(item)"
                            aria-label="@(expanded ? "Collapse row" : "Expand row")"
                            aria-expanded="@(expanded ? "true" : "false")">
                        <DrylIcon Name="ChevronRight" Size="12" />
                    </button>
                </td>
            }

            @foreach (var col in VisibleColumns)
            {
                <td class="@CellCssClass(col)" style="@CellStyle(col)">
                    @if (col.CellTemplate is not null)
                    {
                        @col.CellTemplate(item)
                    }
                    else
                    {
                        @col.GetValue(item)
                    }
                </td>
            }

            @if (RowActions is not null)
            {
                <td class="tbl-col-actions" @onclick:stopPropagation>
                    <div class="tbl-row-actions">
                        @RowActions(item)
                    </div>
                </td>
            }
        </tr>

        @if (DetailTemplate is not null && _expandedRows.Contains(item))
        {
            <tr class="tbl-row-detail" @key="@($"d:{item!.GetHashCode()}")">
                <td colspan="99">
                    <div class="tbl-row-detail-inner">
                        @DetailTemplate(item)
                    </div>
                </td>
            </tr>
        }
    </text>;
}

@code {
    /// <summary>The data items to display when no <see cref="DataProvider"/> is set.</summary>
    [Parameter] public IEnumerable<TItem> Items { get; set; } = [];

    /// <summary>
    /// Server-side loader. When set, <see cref="Items"/> is ignored and the table calls this
    /// callback whenever search/sort/filter/page state changes. The provider receives a
    /// <see cref="DataRequest"/> snapshot and returns the matching page plus the total count.
    /// </summary>
    [Parameter]
    public Func<DataRequest, CancellationToken, ValueTask<DataResult<TItem>>>? DataProvider { get; set; }

    /// <summary>Declarative column definitions. Place <see cref="DrylColumn{TItem}"/> components inside.</summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>Optional KPI summary tiles rendered above the toolbar.</summary>
    [Parameter] public RenderFragment? SummaryContent { get; set; }

    /// <summary>Optional extra content rendered in the toolbar (right-aligned area).</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>Rendered when the current view is empty. Defaults to "No data".</summary>
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    /// <summary>
    /// Renders an expandable detail panel for each row. When set, a leading expand-chevron
    /// column is added; clicking the chevron toggles the panel below the row.
    /// </summary>
    [Parameter] public RenderFragment<TItem>? DetailTemplate { get; set; }

    /// <summary>
    /// Trailing per-row action slot. When set, an actions column is appended to the right.
    /// Clicks inside the actions cell don't propagate to the row's click handler.
    /// </summary>
    [Parameter] public RenderFragment<TItem>? RowActions { get; set; }

    /// <summary>
    /// Floating bulk-action bar shown above the toolbar when the current selection is non-empty.
    /// The context exposes the live selection as a read-only set.
    /// </summary>
    [Parameter] public RenderFragment<IReadOnlySet<TItem>>? BulkActions { get; set; }

    /// <summary>Shows the toolbar above the table. Required when <see cref="Searchable"/> or extra toolbar content is used.</summary>
    [Parameter] public bool ShowToolbar { get; set; }

    /// <summary>Enables the global search input in the toolbar. Searches across all columns with <c>Searchable=true</c>.</summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>Placeholder for the search input. Default: "Search…".</summary>
    [Parameter] public string SearchPlaceholder { get; set; } = "Search…";

    /// <summary>Debounce in milliseconds for the search input. Default 200.</summary>
    [Parameter] public int SearchDebounceMs { get; set; } = 200;

    /// <summary>
    /// Optional override for the search predicate. Receives the row item and the current search text and
    /// returns true to keep the row. When null, the default predicate matches when any
    /// column with <see cref="DrylColumn{TItem}.Searchable"/> contains the search text (case-insensitive).
    /// </summary>
    [Parameter] public Func<TItem, string, bool>? SearchPredicate { get; set; }

    /// <summary>
    /// Items per page. Set to 0 (default) to disable pagination. Two-way bindable —
    /// the table calls back on this when the user picks a new size in the footer.
    /// </summary>
    [Parameter] public int PageSize { get; set; }

    /// <summary>Raised when the user picks a new page size in the pagination footer.</summary>
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    /// <summary>Page-size options shown in the pagination footer. Default: <c>[10, 20, 50, 100]</c>.</summary>
    [Parameter] public IReadOnlyList<int> PageSizeOptions { get; set; } = [10, 20, 50, 100];

    /// <summary>Raised when the user navigates to a different page (zero-indexed).</summary>
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    /// <summary>
    /// Optional row grouping. When set, rows are grouped by the returned key (per page slice
    /// in client mode). Mutually exclusive with <see cref="Virtualize"/> — when both are set,
    /// Virtualize wins and a console warning is emitted.
    /// </summary>
    [Parameter] public Func<TItem, object?>? GroupBy { get; set; }

    /// <summary>
    /// Renders the visible portion of the rows via <c>Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize</c>.
    /// Requires a fixed <see cref="Height"/> (or an outer scroll container) so the body can scroll.
    /// Suppresses the pagination footer when active. Ignores grouping.
    /// </summary>
    [Parameter] public bool Virtualize { get; set; }

    /// <summary>Estimated row height in pixels for <see cref="Virtualize"/>. Default 44.</summary>
    [Parameter] public float VirtualizeItemSize { get; set; } = 44f;

    /// <summary>
    /// Maximum height (any CSS length) for the scroll body. When set, the table body becomes
    /// vertically scrollable and the header sticks to the top of the scroll area.
    /// Required for <see cref="Virtualize"/> to function.
    /// </summary>
    [Parameter] public string? Height { get; set; }

    /// <summary>If true (default), the header sticks to the top while the body scrolls.</summary>
    [Parameter] public bool StickyHeader { get; set; } = true;

    /// <summary>
    /// Shows the column-visibility menu in the toolbar (Settings icon → checkbox list).
    /// Requires <see cref="ShowToolbar"/>.
    /// </summary>
    [Parameter] public bool AllowColumnVisibility { get; set; }

    /// <summary>
    /// Shows a CSV export button in the toolbar. Requires <see cref="ShowToolbar"/>.
    /// The export honours the active search, filters and sort, includes only the
    /// currently visible columns, and covers the full filtered result set across
    /// all pages — not just the current page. In server mode (<see cref="DataProvider"/>)
    /// this issues a dedicated request with the current search/sort/filters but
    /// <c>Skip=0</c> / <c>Take=int.MaxValue</c>; backends that cannot serve an
    /// unbounded page should cap the take on their side.
    /// </summary>
    [Parameter] public bool ShowExport { get; set; }

    /// <summary>File name used for the CSV export download. Default: <c>"export.csv"</c>.</summary>
    [Parameter] public string ExportFileName { get; set; } = "export.csv";

    /// <summary>
    /// Persists sort, filters, page, page-size and column-visibility state under this key
    /// in <c>localStorage</c>. State is restored on first render.
    /// </summary>
    [Parameter] public string? PersistStateKey { get; set; }

    /// <summary>If true, a checkbox column is prepended and row selection is enabled.</summary>
    [Parameter] public bool Selectable { get; set; }

    /// <summary>Two-way bindable set of currently selected items.</summary>
    [Parameter] public IReadOnlySet<TItem>? SelectedItems { get; set; }

    /// <summary>Raised when the selection changes.</summary>
    [Parameter] public EventCallback<IReadOnlySet<TItem>> SelectedItemsChanged { get; set; }

    /// <summary>Raised when a data row is clicked.</summary>
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }

    /// <summary>
    /// Enables manual row reordering via a leading grip-handle column. Users drag the handle
    /// to move a row, or focus it and press <c>Alt</c>+<c>Arrow Up</c>/<c>Arrow Down</c> for a
    /// keyboard-accessible move. Reordering requires a plain client-side list — it is ignored
    /// (with a console warning) when <see cref="Virtualize"/>, <see cref="GroupBy"/> or
    /// <see cref="DataProvider"/> is set, and the handle is temporarily disabled while a sort
    /// is active (clear the sort to reorder again). Pair with <see cref="OnRowReordered"/> to
    /// persist the new order in your backing collection.
    /// </summary>
    [Parameter] public bool Reorderable { get; set; }

    /// <summary>
    /// Raised after the user moves a row via <see cref="Reorderable"/>. The table updates its own
    /// displayed order immediately; handle this callback to apply the same move to your backing
    /// collection. See <see cref="RowReorderEventArgs"/> for the index semantics.
    /// </summary>
    [Parameter] public EventCallback<RowReorderEventArgs> OnRowReordered { get; set; }

    /// <summary>If true, renders a loading spinner in place of rows.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>
    /// If true (default), wraps the table in a glass card surface.
    /// Set to false when the table is already inside a <see cref="DrylCard"/>.
    /// </summary>
    [Parameter] public bool Bordered { get; set; } = true;

    /// <summary>Accessible label for the <c>&lt;table&gt;</c> element.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// AI ambient state for the table. <see cref="AiState.Streaming"/> and
    /// <see cref="AiState.Generated"/> additionally make newly-inserted rows
    /// fade in with an accent flash so users can see what the model just added.
    /// </summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>Pass-through HTML attributes applied to the outermost element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly List<DrylColumn<TItem>> _columns = [];
    private readonly HashSet<TItem> _selected = [];
    private readonly HashSet<TItem> _seenItems = [];
    private readonly List<SortDescriptor> _sort = [];
    private readonly Dictionary<string, FilterDescriptor> _filters = new();
    private readonly HashSet<string> _hiddenColumns = new(StringComparer.Ordinal);
    private readonly HashSet<string> _collapsedGroups = new(StringComparer.Ordinal);
    private readonly HashSet<TItem> _expandedRows = [];
    private List<TItem> _view = [];
    private AiState _prevAi = AiState.None;
    private int _genTick;

    private string? _searchInput;
    private string? _appliedSearch;
    private CancellationTokenSource? _searchDebounceCts;
    private CancellationTokenSource? _dataProviderCts;
    private bool _serverLoading;
    private int _filteredCount;
    private int _page;
    private int _pageSize;
    private int _lastSeenPageSize;
    private IEnumerable<TItem>? _lastItemsRef;
    private bool _columnsDirty;
    private string? _openFilterColumn;
    private bool _colMenuOpen;
    private bool _virtualizeWarned;
    private bool _reorderWarned;
    private bool _stateRestored;
    private bool _persistDirty;
    private int? _dragIndex;
    private int? _dragOverIndex;
    private int? _pendingFocusGrip;
    private ElementReference _rootEl;

    private bool AllSelected =>
        _view.Count > 0 && _view.All(i => _selected.Contains(i));

    private IEnumerable<DrylColumn<TItem>> VisibleColumns =>
        _columns.Where(c => !_hiddenColumns.Contains(c.Key));

    private bool UseGrouping => GroupBy is not null;

    // Reorder is only meaningful on a plain client-side list: virtualization, grouping and
    // server-side data all break the 1:1 mapping between a displayed row and a stable position.
    private bool ReorderColumnVisible =>
        Reorderable && !Virtualize && GroupBy is null && DataProvider is null;

    // The handle is live only when no sort is applied — reordering a sorted view is meaningless,
    // so the grip is shown but disabled until the user clears the sort.
    private bool CanReorderNow => ReorderColumnVisible && _sort.Count == 0;

    private string WrapperClass
    {
        get
        {
            var classes = new List<string> { "tbl-root" };
            if (Bordered) { classes.Add("glass-card"); classes.Add("p-0"); }
            if (Ai != AiState.None && Bordered) classes.Add("ai-aura");
            if (!StickyHeader) classes.Add("tbl-no-sticky");
            switch (Ai)
            {
                case AiState.Thinking:  if (Bordered) classes.Add("ai-thinking");  break;
                case AiState.Streaming: if (Bordered) classes.Add("ai-streaming"); break;
                case AiState.Generated: if (Bordered) classes.Add("ai-generated"); break;
            }
            return string.Join(' ', classes);
        }
    }

    private string WrapClass =>
        Height is not null || Virtualize ? "tbl-wrap tbl-wrap--scroll" : "tbl-wrap";

    private string? WrapStyle =>
        string.IsNullOrEmpty(Height) ? null : $"max-height: {Height}";

    internal void AddColumn(DrylColumn<TItem> column)
    {
        if (_columns.Contains(column)) return;
        _columns.Add(column);
        if (column.Hidden) _hiddenColumns.Add(column.Key);
        _columnsDirty = true;
        // No StateHasChanged here — the column's own first render already queued one;
        // OnAfterRenderAsync will pick up _columnsDirty and rebuild + re-render once.
    }

    internal void RemoveColumn(DrylColumn<TItem> column)
    {
        if (_columns.Remove(column))
        {
            _sort.RemoveAll(s => s.ColumnKey == column.Key);
            _filters.Remove(column.Key);
            _hiddenColumns.Remove(column.Key);
            _columnsDirty = true;
            InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Ai == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = Ai;

        if (SelectedItems is not null)
        {
            _selected.Clear();
            foreach (var item in SelectedItems) _selected.Add(item);
        }

        if (PageSize != _lastSeenPageSize)
        {
            _lastSeenPageSize = PageSize;
            _pageSize = PageSize;
        }

        if (Virtualize && GroupBy is not null && !_virtualizeWarned)
        {
            _virtualizeWarned = true;
            Console.WriteLine(
                "DrylTable: Virtualize and GroupBy are mutually exclusive — grouping is ignored when Virtualize is enabled.");
        }

        if (Reorderable && (Virtualize || GroupBy is not null || DataProvider is not null) && !_reorderWarned)
        {
            _reorderWarned = true;
            Console.WriteLine(
                "DrylTable: Reorderable is ignored when Virtualize, GroupBy or DataProvider is set — row reordering requires a plain client-side list.");
        }

        var itemsChanged = !ReferenceEquals(_lastItemsRef, Items);
        _lastItemsRef = Items;

        if (itemsChanged || _columnsDirty)
        {
            _columnsDirty = false;
            await RebuildViewAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(PersistStateKey))
        {
            await RestoreStateAsync(PersistStateKey);
        }

        if (_columnsDirty)
        {
            _columnsDirty = false;
            await RebuildViewAsync();
            StateHasChanged();
        }

        if (_persistDirty && !string.IsNullOrEmpty(PersistStateKey) && _stateRestored)
        {
            _persistDirty = false;
            await PersistStateAsync(PersistStateKey);
        }

        if (_pendingFocusGrip is int gripIndex)
        {
            _pendingFocusGrip = null;
            try { await JS.InvokeVoidAsync("dryl.table.focusGrip", _rootEl, gripIndex); }
            catch (Microsoft.JSInterop.JSException) { /* element gone — best effort */ }
        }

        _seenItems.Clear();
        foreach (var item in _view) _seenItems.Add(item);
    }

    // ───── Search ─────

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchInput = e.Value?.ToString();
        _searchDebounceCts?.Cancel();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try { await Task.Delay(SearchDebounceMs, token); }
        catch (TaskCanceledException) { return; }

        _appliedSearch = string.IsNullOrWhiteSpace(_searchInput) ? null : _searchInput;
        _page = 0;
        await RebuildViewAsync();
        StateHasChanged();
    }

    private bool MatchesSearch(TItem item)
    {
        if (string.IsNullOrEmpty(_appliedSearch)) return true;
        if (SearchPredicate is not null) return SearchPredicate(item, _appliedSearch);

        foreach (var col in _columns)
        {
            if (!col.Searchable || col.FieldGetter is null) continue;
            var value = col.FieldGetter(item)?.ToString();
            if (value is not null && value.Contains(_appliedSearch, StringComparison.OrdinalIgnoreCase))
                return true;
        }
        return false;
    }

    // ───── Filters ─────

    private async Task ToggleFilter(DrylColumn<TItem> column)
    {
        _openFilterColumn = _openFilterColumn == column.Key ? null : column.Key;
        await Task.CompletedTask;
    }

    private void CloseFilter() => _openFilterColumn = null;

    private async Task ClearFilter(string columnKey)
    {
        if (_filters.Remove(columnKey))
        {
            _page = 0;
            MarkPersistDirty();
            await RebuildViewAsync();
        }
    }

    private async Task SetTextFilter(DrylColumn<TItem> column, string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            _filters.Remove(column.Key);
        else
            _filters[column.Key] = new FilterDescriptor(column.Key, FilterOperator.Contains, text);
        _page = 0;
        MarkPersistDirty();
        await RebuildViewAsync();
    }

    private async Task ToggleSelectFilterValue(DrylColumn<TItem> column, object? value, bool include)
    {
        HashSet<object?> set;
        if (_filters.TryGetValue(column.Key, out var existing) && existing.Value is HashSet<object?> existingSet)
        {
            set = existingSet;
        }
        else
        {
            set = new HashSet<object?>();
        }

        if (include)
        {
            // Avoid duplicate string/object entries from restored state.
            if (!SetContainsValue(set, value)) set.Add(value);
        }
        else
        {
            if (!set.Remove(value))
            {
                var s = value?.ToString();
                var match = set.FirstOrDefault(v => string.Equals(v?.ToString(), s, StringComparison.Ordinal));
                if (match is not null) set.Remove(match);
            }
        }

        if (set.Count == 0)
            _filters.Remove(column.Key);
        else
            _filters[column.Key] = new FilterDescriptor(column.Key, FilterOperator.In, set);

        _page = 0;
        MarkPersistDirty();
        await RebuildViewAsync();
    }

    private static bool SetContainsValue(HashSet<object?> set, object? value)
    {
        if (set.Contains(value)) return true;
        var s = value?.ToString();
        return set.Any(v => string.Equals(v?.ToString(), s, StringComparison.Ordinal));
    }

    private bool MatchesFilters(TItem item)
    {
        foreach (var (key, descriptor) in _filters)
        {
            var column = _columns.FirstOrDefault(c => c.Key == key);
            if (column?.FieldGetter is null) continue;
            var value = column.FieldGetter(item);

            switch (descriptor.Operator)
            {
                case FilterOperator.Contains:
                    if (descriptor.Value is not string needle) break;
                    var hay = value?.ToString() ?? string.Empty;
                    if (!hay.Contains(needle, StringComparison.OrdinalIgnoreCase)) return false;
                    break;
                case FilterOperator.In:
                    if (descriptor.Value is not HashSet<object?> set) break;
                    if (!SetContainsValue(set, value)) return false;
                    break;
            }
        }
        return true;
    }

    private string FormatFilterValue(FilterDescriptor descriptor) => descriptor.Operator switch
    {
        FilterOperator.Contains => $"\"{descriptor.Value}\"",
        FilterOperator.In when descriptor.Value is HashSet<object?> set =>
            set.Count <= 2
                ? string.Join(", ", set.Select(v => v?.ToString() ?? "(empty)"))
                : $"{set.Count} selected",
        _ => descriptor.Value?.ToString() ?? string.Empty
    };

    private IEnumerable<object?> GetDistinctValues(DrylColumn<TItem> column)
    {
        if (column.FilterValues is not null)
            return column.FilterValues(Items ?? []);
        if (column.FieldGetter is null) return [];
        return (Items ?? [])
            .Select(column.FieldGetter)
            .Distinct()
            .OrderBy(v => v?.ToString(), StringComparer.OrdinalIgnoreCase);
    }

    private void OnPopoverKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseFilter();
    }

    // ───── Sort ─────

    private SortDirection? SortDirectionFor(DrylColumn<TItem> column)
    {
        foreach (var s in _sort)
            if (s.ColumnKey == column.Key) return s.Direction;
        return null;
    }

    private async Task OnHeaderClick(DrylColumn<TItem> column, MouseEventArgs e)
    {
        if (!column.Sortable) return;
        ToggleSort(column, e.ShiftKey);
        MarkPersistDirty();
        await RebuildViewAsync();
    }

    private async Task OnHeaderKeyDown(DrylColumn<TItem> column, KeyboardEventArgs e)
    {
        if (!column.Sortable) return;
        if (e.Key is not ("Enter" or " ")) return;
        ToggleSort(column, e.ShiftKey);
        MarkPersistDirty();
        await RebuildViewAsync();
    }

    private void ToggleSort(DrylColumn<TItem> column, bool multi)
    {
        var existingIndex = _sort.FindIndex(s => s.ColumnKey == column.Key);
        var current = existingIndex >= 0 ? _sort[existingIndex].Direction : (SortDirection?)null;

        // Cycle: none → asc → desc → none
        SortDirection? next = current switch
        {
            null => SortDirection.Ascending,
            SortDirection.Ascending => SortDirection.Descending,
            _ => null
        };

        if (!multi) _sort.Clear();
        else if (existingIndex >= 0) _sort.RemoveAt(existingIndex);

        if (next is not null)
            _sort.Add(new SortDescriptor(column.Key, next.Value));
    }

    private string? HeaderAriaSort(DrylColumn<TItem> column)
    {
        if (!column.Sortable) return null;
        return SortDirectionFor(column) switch
        {
            SortDirection.Ascending => "ascending",
            SortDirection.Descending => "descending",
            _ => "none"
        };
    }

    private static IEnumerable<TItem> ApplySort(IEnumerable<TItem> source, List<DrylColumn<TItem>> columns, List<SortDescriptor> sort)
    {
        if (sort.Count == 0) return source;

        IOrderedEnumerable<TItem>? ordered = null;
        foreach (var s in sort)
        {
            var col = columns.FirstOrDefault(c => c.Key == s.ColumnKey);
            if (col?.FieldGetter is null) continue;
            var getter = col.FieldGetter;

            ordered = ordered is null
                ? (s.Direction == SortDirection.Ascending
                    ? source.OrderBy(getter, NullSafeComparer.Instance)
                    : source.OrderByDescending(getter, NullSafeComparer.Instance))
                : (s.Direction == SortDirection.Ascending
                    ? ordered.ThenBy(getter, NullSafeComparer.Instance)
                    : ordered.ThenByDescending(getter, NullSafeComparer.Instance));
        }

        return (IEnumerable<TItem>?)ordered ?? source;
    }

    private sealed class NullSafeComparer : IComparer<object?>
    {
        public static readonly NullSafeComparer Instance = new();
        public int Compare(object? x, object? y)
        {
            if (x is null && y is null) return 0;
            if (x is null) return -1;
            if (y is null) return 1;
            if (x is IComparable cx && x.GetType() == y.GetType()) return cx.CompareTo(y);
            return string.CompareOrdinal(x.ToString(), y.ToString());
        }
    }

    // ───── Pagination ─────

    private async Task OnPageChangedInternal(int page)
    {
        _page = page;
        MarkPersistDirty();
        await OnPageChanged.InvokeAsync(page);
        await RebuildViewAsync();
    }

    private async Task OnPageSizeChangedInternal(int size)
    {
        _pageSize = size;
        _lastSeenPageSize = size;
        _page = 0;
        MarkPersistDirty();
        await PageSizeChanged.InvokeAsync(size);
        await RebuildViewAsync();
    }

    // ───── Grouping ─────

    private static string GroupId(object? key) => key?.ToString() ?? "__null__";

    private void ToggleGroup(string id)
    {
        if (!_collapsedGroups.Remove(id)) _collapsedGroups.Add(id);
    }

    // ───── Row expansion ─────

    private void ToggleExpanded(TItem item)
    {
        if (!_expandedRows.Remove(item)) _expandedRows.Add(item);
    }

    // ───── Column visibility ─────

    private void ToggleColMenu() => _colMenuOpen = !_colMenuOpen;
    private void CloseColMenu() => _colMenuOpen = false;

    private void OnColMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseColMenu();
    }

    private async Task ToggleColumnVisible(DrylColumn<TItem> column, bool visible)
    {
        if (visible) _hiddenColumns.Remove(column.Key);
        else _hiddenColumns.Add(column.Key);
        MarkPersistDirty();
