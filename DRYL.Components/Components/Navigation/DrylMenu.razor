@namespace DRYL.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

@*  ─────────────────────────────────────────────────────────
    DrylMenu — dropdown action menu anchored to a trigger.

    Usage:
      <DrylMenu>
        <Trigger>
          <DrylButton TrailingIcon="chevron-down">Actions</DrylButton>
        </Trigger>
        <Items>
          <DrylMenuItem Icon="edit" OnClick="Edit">Edit</DrylMenuItem>
          <DrylMenuItem Separator />
          <DrylMenuItem Icon="trash" Variant="DrylMenuItem.MenuItemVariant.Danger" OnClick="Delete">
            Delete
          </DrylMenuItem>
        </Items>
      </DrylMenu>
    ───────────────────────────────────────────────────────── *@

<div class="@AnchorClass" @ref="_anchor" @attributes="AdditionalAttributes">
    <div @onclick="Toggle" class="menu-trigger">
        @Trigger
    </div>

    @if (_isOpen)
    {
        <CascadingValue Value="this" IsFixed="true">
            <div class="@PanelClass"
                 role="menu"
                 aria-label="@Label"
                 @onkeydown="HandleKeyDown"
                 tabindex="-1"
                 @ref="_panel">
                @Items
            </div>
        </CascadingValue>
    }
</div>

@code {
    /// <summary>Content that opens the menu — typically a DrylButton.</summary>
    [Parameter] public RenderFragment? Trigger { get; set; }

    /// <summary>Menu body — place DrylMenuItem components here.</summary>
    [Parameter] public RenderFragment? Items { get; set; }

    /// <summary>Accessible label for the menu panel (aria-label).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Where the panel opens relative to the trigger.</summary>
    [Parameter] public MenuPlacement Placement { get; set; } = MenuPlacement.BottomStart;

    /// <summary>If true, the anchor div stretches to full width of its container.</summary>
    [Parameter] public bool Block { get; set; }

    /// <summary>Pass-through HTML attributes on the outer anchor element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool _isOpen;
    private bool _shouldFocusPanel;
    private bool _jsReady;
    private ElementReference _anchor;
    private ElementReference _panel;
    private DotNetObjectReference<DrylMenu>? _dotnetRef;

    private string AnchorClass => Block ? "menu-anchor menu-anchor--block" : "menu-anchor";

    private string PanelClass => Placement switch
    {
        MenuPlacement.BottomEnd => "menu-panel menu-panel--end",
        MenuPlacement.TopStart  => "menu-panel menu-panel--top",
        MenuPlacement.TopEnd    => "menu-panel menu-panel--top menu-panel--end",
        _                       => "menu-panel"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsReady = true;
            _dotnetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("dryl.menu.attach", _anchor, _dotnetRef);
        }

        if (_shouldFocusPanel)
        {
            _shouldFocusPanel = false;
            await JS.InvokeVoidAsync("dryl.menu.focusPanel", _panel);
        }
    }

    private void Toggle()
    {
        _isOpen = !_isOpen;
        if (_isOpen) _shouldFocusPanel = true;
    }

    /// <summary>Closes the menu and returns focus to the trigger.</summary>
    [JSInvokable]
    public void Close()
    {
        _isOpen = false;
        StateHasChanged();
    }

    internal void CloseFromItem()
    {
        _isOpen = false;
        StateHasChanged();
        if (_jsReady)
            _ = JS.InvokeVoidAsync("dryl.menu.focusTrigger", _anchor).AsTask();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                _isOpen = false;
                await JS.InvokeVoidAsync("dryl.menu.focusTrigger", _anchor);
                break;
            case "ArrowDown":
                await JS.InvokeVoidAsync("dryl.menu.navigate", _panel, "down");
                break;
            case "ArrowUp":
                await JS.InvokeVoidAsync("dryl.menu.navigate", _panel, "up");
                break;
            case "Home":
                await JS.InvokeVoidAsync("dryl.menu.navigate", _panel, "first");
                break;
            case "End":
                await JS.InvokeVoidAsync("dryl.menu.navigate", _panel, "last");
                break;
            case "Tab":
                _isOpen = false;
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsReady)
            await JS.InvokeVoidAsync("dryl.menu.detach", _anchor);
        _dotnetRef?.Dispose();
    }

    /// <summary>Controls where the menu panel opens relative to its trigger.</summary>
    public enum MenuPlacement
    {
        /// <summary>Below the trigger, left-aligned.</summary>
        BottomStart,
        /// <summary>Below the trigger, right-aligned.</summary>
        BottomEnd,
        /// <summary>Above the trigger, left-aligned.</summary>
        TopStart,
        /// <summary>Above the trigger, right-aligned.</summary>
        TopEnd
    }
}
