@namespace DRYL.Components
@implements IDisposable

@*  ─────────────────────────────────────────────────────────
    DrylBreadcrumbs — hierarchical navigation trail.

    Child DrylBreadcrumbItem elements register themselves via the
    cascading parent reference. The last crumb is rendered as the
    current page (aria-current="page", not a link). When MaxItems is
    set and exceeded, the middle crumbs collapse into an ellipsis.

      <DrylBreadcrumbs MaxItems="4">
          <DrylBreadcrumbItem Href="/" Icon="Home">Home</DrylBreadcrumbItem>
          <DrylBreadcrumbItem Href="/projects">Projects</DrylBreadcrumbItem>
          <DrylBreadcrumbItem>Apollo</DrylBreadcrumbItem>
      </DrylBreadcrumbs>
    ───────────────────────────────────────────────────────── *@

<nav class="breadcrumbs-nav" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
    <ol class="breadcrumbs">
        @{
            var tokens = BuildDisplayTokens();
        }
        @for (var i = 0; i < tokens.Count; i++)
        {
            var token = tokens[i];
            if (i > 0)
            {
                <li class="breadcrumb-sep" aria-hidden="true">
                    @if (Separator is not null)
                    {
                        @Separator
                    }
                    else
                    {
                        <DrylIcon Name="ChevronRight" Size="14" />
                    }
                </li>
            }

            @if (token is null)
            {
                <li class="breadcrumb-item breadcrumb-ellipsis" aria-hidden="true">
                    <DrylIcon Name="MoreHorizontal" Size="16" />
                </li>
            }
            else
            {
                var isCurrent = token == _items[^1];
                <li class="breadcrumb-item" @key="token">
                    @if (isCurrent || string.IsNullOrEmpty(token.ItemHref))
                    {
                        <span class="breadcrumb-current" aria-current="@(isCurrent ? "page" : null)">
                            @if (!string.IsNullOrEmpty(token.ItemIcon))
                            {
                                <DrylIcon Name="@token.ItemIcon" Size="14" />
                            }
                            @token.Content
                        </span>
                    }
                    else
                    {
                        <a class="breadcrumb-link" href="@token.ItemHref">
                            @if (!string.IsNullOrEmpty(token.ItemIcon))
                            {
                                <DrylIcon Name="@token.ItemIcon" Size="14" />
                            }
                            @token.Content
                        </a>
                    }
                </li>
            }
        }
    </ol>

    @* Items render no DOM — this slot exists so they register. *@
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</nav>

@code {
    /// <summary>Accessible label for the navigation landmark.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Breadcrumb";

    /// <summary>Custom separator rendered between crumbs. Defaults to a chevron.</summary>
    [Parameter] public RenderFragment? Separator { get; set; }

    /// <summary>Maximum crumbs to show before collapsing the middle into an ellipsis. Null = show all.</summary>
    [Parameter] public int? MaxItems { get; set; }

    /// <summary>The crumbs.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Pass-through HTML attributes on the nav element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly List<DrylBreadcrumbItem> _items = new();

    internal void Register(DrylBreadcrumbItem item)
    {
        if (_items.Contains(item)) return;
        _items.Add(item);
        StateHasChanged();
    }

    internal void Unregister(DrylBreadcrumbItem item)
    {
        if (_items.Remove(item)) StateHasChanged();
    }

    internal void NotifyChanged() => StateHasChanged();

    // Returns the display sequence: items in order, with a single null marking
    // the collapsed ellipsis when MaxItems is exceeded.
    private List<DrylBreadcrumbItem?> BuildDisplayTokens()
    {
        var all = _items.Cast<DrylBreadcrumbItem?>().ToList();
        if (MaxItems is not { } max || max < 2 || _items.Count <= max)
            return all;

        // Keep the first crumb, an ellipsis, then the trailing (max - 1) crumbs.
        var tail = max - 1;
        var result = new List<DrylBreadcrumbItem?> { _items[0], null };
        result.AddRange(_items.Skip(_items.Count - tail));
        return result;
    }

    public void Dispose() => _items.Clear();
}
