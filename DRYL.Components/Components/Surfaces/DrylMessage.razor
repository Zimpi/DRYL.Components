@namespace DRYL.Components
@inherits DrylAiAware

@*  ─────────────────────────────────────────────────────────
    DrylMessage — a single chat bubble inside a DrylChat.

    User messages align right with an accent-tinted bubble; Assistant
    messages align left on a glass bubble and host the AI aura when
    streaming; System messages render as a centered muted line.

    Usage:
      <DrylMessage Role="MessageRole.User" Author="You">Hello!</DrylMessage>

      <DrylMessage Role="MessageRole.Assistant" Author="DRYL AI"
                   AvatarIcon="Sparkle" Ai="AiState.Streaming">
          Here is your summary…
      </DrylMessage>

      <DrylMessage Role="MessageRole.Assistant" Typing="true" AvatarIcon="Sparkle" />
    ───────────────────────────────────────────────────────── *@

@if (Role == MessageRole.System)
{
    <div class="chat-msg chat-msg--system @Class" @attributes="AdditionalAttributes">
        <span class="chat-system-line">@ChildContent</span>
    </div>
}
else
{
    <div class="@RootCssClass" @attributes="AdditionalAttributes">
        @if (ShowAvatar)
        {
            <div class="chat-msg-avatar">
                @if (Avatar is not null)
                {
                    @Avatar
                }
                else
                {
                    <DrylAvatar Name="@Author" Src="@AvatarSrc" Icon="@DefaultIcon" Size="AvatarSize.Medium" />
                }
            </div>
        }

        <div class="chat-msg-body">
            @if (!string.IsNullOrEmpty(Author) || !string.IsNullOrEmpty(Timestamp))
            {
                <div class="chat-msg-meta">
                    @if (!string.IsNullOrEmpty(Author))
                    {
                        <span class="chat-msg-author">@Author</span>
                    }
                    @if (!string.IsNullOrEmpty(Timestamp))
                    {
                        <span class="chat-msg-time">@Timestamp</span>
                    }
                </div>
            }

            <div class="@BubbleCssClass">
                @if (EffectiveAi != AiState.None)
                {
                    <div class="ai-aura-ring"></div>
                    <div class="ai-aura-glow"></div>
                    @if (EffectiveAi == AiState.Generated)
                    {
                        <div class="ai-aura-wash" @key="_genTick"></div>
                    }
                }

                @if (Typing)
                {
                    <span class="chat-typing" aria-label="Assistant is typing">
                        <span></span><span></span><span></span>
                    </span>
                }
                else if (Markdown && Text is not null)
                {
                    @* The bubble itself already hosts the ai-aura ring/glow above — passing
                       EffectiveAi into DrylMarkdown too would wrap the text a second time in
                       its own glass surface + ring, reading as a nested duplicate box. *@
                    <DrylMarkdown Content="@Text" />
                }
                else if (Text is not null)
                {
                    @if (_streamTokens.Count > 0)
                    {
                        @* Plain-text streaming: each freshly arrived word mounts as its own
                           keyed-by-position .stream-token span and blur-materializes in;
                           .stream-text::after draws the glowing caret at the tip. Whitespace
                           lives inside the token text, so no markup whitespace between spans. *@
                        <span class="stream-text">@foreach (var t in _streamTokens){<span class="stream-token" style="--stream-i:@t.Stagger">@t.Text</span>}</span>
                    }
                    else
                    {
                        @Text
                    }
                }
                else
                {
                    @ChildContent
                }
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Author role — drives alignment and styling.</summary>
    [Parameter] public MessageRole Role { get; set; } = MessageRole.Assistant;

    /// <summary>Display name shown above the bubble and used to derive the avatar initials.</summary>
    [Parameter] public string? Author { get; set; }

    /// <summary>Optional pre-formatted timestamp shown next to the author.</summary>
    [Parameter] public string? Timestamp { get; set; }

    /// <summary>When true, shows an avatar beside the bubble. Default true.</summary>
    [Parameter] public bool ShowAvatar { get; set; } = true;

    /// <summary>Custom avatar content — overrides the default DrylAvatar.</summary>
    [Parameter] public RenderFragment? Avatar { get; set; }

    /// <summary>Image URL for the default avatar.</summary>
    [Parameter] public string? AvatarSrc { get; set; }

    /// <summary>Icon name for the default avatar (falls back per role when omitted).</summary>
    [Parameter] public string? AvatarIcon { get; set; }

    /// <summary>When true, shows animated typing dots instead of the content.</summary>
    [Parameter] public bool Typing { get; set; }

    /// <summary>
    /// Optional text content. When set it takes precedence over <see cref="ChildContent"/>.
    /// Combine with <see cref="Markdown"/> to render it as formatted Markdown — ideal for
    /// streaming LLM output. Leave null to use <see cref="ChildContent"/> as before.
    /// </summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>
    /// When true and <see cref="Text"/> is set, the text is rendered through
    /// <c>DrylMarkdown</c> (CommonMark + GFM, code blocks, raw HTML disabled).
    /// Default <c>false</c> so existing usages are unchanged.
    /// </summary>
    [Parameter] public bool Markdown { get; set; }

    /// <summary>Bubble content. Used when <see cref="Text"/> is null.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // AI ambient state (the Ai parameter, typically on Assistant bubbles) is inherited from
    // DrylAiAware and resolves against a surrounding DrylAiScope.

    /// <summary>Pass-through HTML attributes on the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Extra CSS class(es) merged onto the message row's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    private AiState _prevAi = AiState.None;
    private int _genTick;

    private readonly List<(string Text, int Stagger)> _streamTokens = new();
    private string _streamSeen = "";

    protected override void OnParametersSet()
    {
        if (EffectiveAi == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = EffectiveAi;
        TrackPlainStream();
    }

    // Plain-text streaming reveal (server-side, no JS): accumulate the delta of
    // each Text update as word tokens so only the freshly arrived words mount as
    // new .stream-token spans. Blazor's index-based diff keeps the already-shown
    // spans untouched (append-only), so they never re-animate — only new words
    // blur-materialize in. Markdown bubbles can't tokenize this way (words live
    // inside Markdig markup); they use the CSS newest-block sheen instead.
    private void TrackPlainStream()
    {
        if (EffectiveAi != AiState.Streaming || Markdown || Typing || Text is null)
        {
            _streamTokens.Clear();
            _streamSeen = "";
            return;
        }

        if (!Text.StartsWith(_streamSeen, StringComparison.Ordinal))
        {
            _streamTokens.Clear();      // stream restarted — re-materialize from scratch
            _streamSeen = "";
        }

        if (Text.Length > _streamSeen.Length)
        {
            var stagger = 0;
            foreach (var token in SplitTokens(Text.AsMemory(_streamSeen.Length)))
                _streamTokens.Add((token, Math.Min(stagger++, 10)));
            _streamSeen = Text;
        }
    }

    // "word + trailing whitespace" chunks; a leading whitespace run is its own
    // token. Whitespace stays inside the span so adjacent spans never need
    // markup whitespace between them (which Blazor's diff may drop).
    private static IEnumerable<string> SplitTokens(ReadOnlyMemory<char> text)
    {
        var s = text;
        while (!s.IsEmpty)
        {
            var span = s.Span;
            var i = 0;
            while (i < span.Length && !char.IsWhiteSpace(span[i])) i++;
            while (i < span.Length && char.IsWhiteSpace(span[i])) i++;
            yield return s[..i].ToString();
            s = s[i..];
        }
    }

    private string? DefaultIcon =>
        !string.IsNullOrEmpty(AvatarIcon) ? AvatarIcon
        : Role == MessageRole.Assistant ? "Sparkle"
        : null;

    private string RootCssClass =>
        string.Join(' ', new[]
        {
            Role == MessageRole.User ? "chat-msg chat-msg--user" : "chat-msg chat-msg--assistant",
            Class
        }.Where(s => !string.IsNullOrWhiteSpace(s)));

    private string BubbleCssClass
    {
        get
        {
            var parts = new List<string> { "chat-bubble" };
            parts.Add(Role == MessageRole.User ? "chat-bubble--user" : "chat-bubble--assistant");
            if (EffectiveAi != AiState.None)
            {
                parts.Add("ai-aura");
                switch (EffectiveAi)
                {
                    case AiState.Thinking:  parts.Add("ai-thinking");  break;
                    case AiState.Streaming: parts.Add("ai-streaming"); break;
                    case AiState.Generated: parts.Add("ai-generated"); break;
                }
            }
            return string.Join(' ', parts);
        }
    }
}
