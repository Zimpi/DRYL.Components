@namespace DRYL.Components
@inject IJSRuntime JS
@implements IAsyncDisposable

@*  ─────────────────────────────────────────────────────────
    DrylDepthGlass — a glass surface that warps in 3D toward the
    pointer (experimental).

    The pointer drives a perspective tilt of the whole pane, while the
    content and the gloss parallax in separate layers so the surface
    reads like a sheet of glass floating above the page. A travelling
    specular highlight tracks the cursor and the card lifts on hover.

    Pure CSS transforms, so it is reliable across browsers and
    composited. Stilled under prefers-reduced-motion (rule 2.12).

    The same effect is available on DrylCard via its Depth parameter.

    Usage:
      <DrylDepthGlass Intensity="DepthGlassIntensity.Strong">
          <h3>Depth glass</h3>
          <p>Hover me — the surface tilts and the content floats.</p>
      </DrylDepthGlass>
    ───────────────────────────────────────────────────────── *@

<div class="@RootCss" @ref="_el" @attributes="AdditionalAttributes">
    <div class="dg-sheen"></div>
    <div class="dg-specular"></div>
    <div class="dg-content">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>The surface content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>How strong the tilt and parallax are.</summary>
    [Parameter] public DepthGlassIntensity Intensity { get; set; } = DepthGlassIntensity.Medium;

    /// <summary>If true (default), the surface warps toward the pointer and the highlight follows it.</summary>
    [Parameter] public bool Interactive { get; set; } = true;

    /// <summary>Extra CSS class(es) merged onto the surface.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through HTML attributes on the surface element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _el;
    private bool _attached;

    private string RootCss
    {
        get
        {
            var parts = new List<string>
            {
                "dg-surface",
                "dg-warp",
                Intensity switch
                {
                    DepthGlassIntensity.Subtle => "dg--subtle",
                    DepthGlassIntensity.Strong => "dg--strong",
                    _ => "dg--medium"
                }
            };
            if (!Interactive) parts.Add("dg--static");
            if (!string.IsNullOrWhiteSpace(Class)) parts.Add(Class!);
            return string.Join(' ', parts);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Interactive) return;
        try
        {
            await JS.InvokeVoidAsync("dryl.depthglass.track", _el);
            _attached = true;
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_attached)
        {
            try { await JS.InvokeVoidAsync("dryl.depthglass.untrack", _el); }
            catch (JSDisconnectedException) { /* circuit gone */ }
            catch (InvalidOperationException) { /* prerender — no JS */ }
        }
    }
}
