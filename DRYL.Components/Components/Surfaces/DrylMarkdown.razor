@namespace DRYL.Components
@inherits DrylAiAware
@implements IDisposable
@using Markdig
@using Markdig.Syntax
@using System.Text

@*  ─────────────────────────────────────────────────────────
    DrylMarkdown — renders Markdown (CommonMark + GFM) into DRYL's
    glass aesthetic. The natural sink for LLM output: bind it to a
    streaming completion and it re-renders as tokens arrive.

    Fenced code blocks are delegated to DrylCodeBlock (language label
    + copy button). All other Markdown is rendered to HTML by Markdig
    with raw HTML disabled, so model-authored "<script>…" is escaped
    rather than executed.

    Usage:
      <DrylMarkdown Content="@_answer" Ai="@_state" />
    ───────────────────────────────────────────────────────── *@

<div class="@RootCssClass" @attributes="AdditionalAttributes">
    @if (_aura.Present)
    {
        <div class="ai-aura-ring"></div>
        <div class="ai-aura-glow"></div>
        @if (_aura.RenderState == AiState.Generated && !_aura.Exiting)
        {
            <div class="ai-aura-wash" @key="_genTick"></div>
        }
    }

    <div class="md-content">
        @foreach (var seg in _segments)
        {
            if (seg.IsCode)
            {
                <DrylCodeBlock Code="@seg.Text" Language="@seg.Language" />
            }
            else
            {
                @((MarkupString)seg.Text)
            }
        }
    </div>
</div>

@code {
    /// <summary>The Markdown source to render.</summary>
    [Parameter] public string? Content { get; set; }

    // AI ambient state (Ai) and aura variant (Aura) are inherited from DrylAiAware; both
    // resolve against a surrounding DrylAiScope via EffectiveAi / EffectiveAura.

    /// <summary>Pass-through HTML attributes on the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Extra CSS class(es) merged onto the markdown root's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    // Raw HTML is disabled so untrusted (model-authored) Markdown cannot inject
    // active markup; advanced extensions add GFM tables, autolinks, etc.
    private static readonly MarkdownPipeline _pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private readonly List<Segment> _segments = new();
    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly DRYL.Components.Ai.AuraLifecycle _aura = new();

    private readonly record struct Segment(bool IsCode, string Text, string? Language);

    protected override void OnParametersSet()
    {
        if (EffectiveAi == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = EffectiveAi;
        // Keep the aura mounted (and fading) for one beat after leaving AI mode so it
        // dissolves rather than snapping away when a completion settles back to None.
        _aura.Sync(EffectiveAi, () => InvokeAsync(StateHasChanged));
        BuildSegments();
    }

    public void Dispose() => _aura.Dispose();

    private void BuildSegments()
    {
        _segments.Clear();
        if (string.IsNullOrEmpty(Content)) return;

        // Streaming re-parses the accumulated text on every chunk, and a chunk
        // boundary can split a UTF-16 surrogate pair (e.g. mid-emoji), leaving a
        // lone surrogate at the tail. Markdig's AutoIdentifier (from advanced
        // extensions) urilizes heading text through ICU normalization, which
        // throws ArgumentException("invalid Unicode code points") on an unpaired
        // surrogate. Drop unpaired surrogates so the partial parse stays valid;
        // the next chunk delivers the pair and the character renders normally.
        var document = Markdown.Parse(StripLoneSurrogates(Content!), _pipeline);

        var sb = new StringBuilder();
        using var writer = new StringWriter(sb);
        var renderer = new Markdig.Renderers.HtmlRenderer(writer);
        _pipeline.Setup(renderer);

        void FlushHtml()
        {
            if (sb.Length == 0) return;
            _segments.Add(new Segment(false, sb.ToString(), null));
            sb.Clear();
        }

        foreach (var block in document)
        {
            if (block is CodeBlock codeBlock)
            {
                FlushHtml();
                var language = (codeBlock as FencedCodeBlock)?.Info;
                _segments.Add(new Segment(true, codeBlock.Lines.ToString(), language));
            }
            else
            {
                renderer.Render(block);
                writer.Flush();
            }
        }

        FlushHtml();
    }

    // Returns the string with any unpaired UTF-16 surrogate removed (a valid
    // high+low pair is kept intact). Allocation-free when the input is already
    // well-formed, which is the overwhelmingly common case.
    private static string StripLoneSurrogates(string s)
    {
        var hasSurrogate = false;
        for (var i = 0; i < s.Length; i++)
        {
            if (char.IsSurrogate(s[i])) { hasSurrogate = true; break; }
        }
        if (!hasSurrogate) return s;

        var sb = new StringBuilder(s.Length);
        for (var i = 0; i < s.Length; i++)
        {
            var c = s[i];
            if (char.IsHighSurrogate(c))
            {
                if (i + 1 < s.Length && char.IsLowSurrogate(s[i + 1]))
                {
                    sb.Append(c);
                    sb.Append(s[++i]);
                }
                // else: unpaired high surrogate — drop it
            }
            else if (char.IsLowSurrogate(c))
            {
                // unpaired low surrogate — drop it
            }
            else
            {
                sb.Append(c);
            }
        }
        return sb.ToString();
    }

    private string RootCssClass
    {
        get
        {
            var parts = new List<string> { "md" };
            if (_aura.Present)
            {
                parts.Add("ai-aura");
                if (EffectiveAura == AiAura.Aurora) parts.Add("ai-aura--aurora");
                if (_aura.Exiting) parts.Add("ai-aura--out");
                switch (_aura.RenderState)
                {
                    case AiState.Thinking:  parts.Add("ai-thinking");  break;
                    case AiState.Streaming: parts.Add("ai-streaming"); break;
                    case AiState.Generated: parts.Add("ai-generated"); break;
                }
            }
            if (!string.IsNullOrWhiteSpace(Class)) parts.Add(Class!);
            return string.Join(' ', parts);
        }
    }
}
