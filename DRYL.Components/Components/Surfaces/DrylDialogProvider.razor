@namespace DRYL.Components
@using DRYL.Components.Dialogs
@using Microsoft.AspNetCore.Components.Rendering
@inject IDrylDialogService DialogService
@inject IJSRuntime JS
@implements IAsyncDisposable

@*  ─────────────────────────────────────────────────────────
    DrylDialogProvider — host for service-driven dialogs.

    Place once in your root layout (e.g. MainLayout.razor):
        <DrylDialogProvider />

    It subscribes to IDrylDialogService, renders the active
    dialog inside a glass backdrop, cascades IDrylDialogInstance
    to the rendered component, and installs the JS-side scroll
    lock + focus trap + ESC handler.
    ───────────────────────────────────────────────────────── *@

@foreach (var entry in _entries)
{
    <div class="@(entry.IsExiting ? "dialog-backdrop is-exiting" : "dialog-backdrop")"
         @ref="entry.BackdropRef"
         tabindex="-1"
         @onclick="@(() => OnBackdropClick(entry))">
        <CascadingValue Value="@((IDrylDialogInstance)entry.Reference)" IsFixed="false">
            <div class="dialog-shell" @onclick:stopPropagation="true">
                <DynamicComponent Type="@entry.Reference.DialogType"
                                  Parameters="@entry.Reference.Parameters" />
            </div>
        </CascadingValue>
    </div>
}

@code {
    private sealed class Entry
    {
        public DrylDialogReference Reference { get; init; } = default!;
        public ElementReference BackdropRef;
        public DotNetObjectReference<DialogCallbacks>? DotNetRef;
        public bool Attached;

        // Exit animation lifecycle: the entry stays mounted with .is-exiting
        // until dialogOut's animationend, then it is removed.
        public bool IsExiting;
        public bool ExitAttached;
        public DotNetObjectReference<ExitCallback>? ExitRef;
    }

    private readonly List<Entry> _entries = new();

    protected override void OnInitialized()
    {
        DialogService.OnDialogInstanceAdded   += OnAdded;
        DialogService.OnDialogCloseRequested  += OnClosed;
        DialogService.OnDialogInstanceUpdated += OnUpdated;
    }

    private void OnAdded(IDrylDialogReference reference)
    {
        if (reference is DrylDialogReference impl)
        {
            _entries.Add(new Entry { Reference = impl });
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnClosed(IDrylDialogReference reference)
    {
        var entry = _entries.FirstOrDefault(e => e.Reference.Id == reference.Id);
        if (entry is null || entry.IsExiting) return;
        // Begin the exit animation; the entry is removed once it finishes
        // (FinalizeExit, driven by dryl.motion.onExit on the backdrop).
        entry.IsExiting = true;
        InvokeAsync(StateHasChanged);
    }

    private void FinalizeExit(Entry entry)
    {
        InvokeAsync(async () =>
        {
            await DetachInterop(entry);
            entry.ExitRef?.Dispose();
            entry.ExitRef = null;
            _entries.Remove(entry);
            StateHasChanged();
        });
    }

    private void OnUpdated(IDrylDialogReference reference)
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (var entry in _entries.Where(e => !e.Attached && !e.IsExiting).ToList())
        {
            entry.DotNetRef = DotNetObjectReference.Create(new DialogCallbacks(entry.Reference));
            var opts = new
            {
                closeOnEscape = entry.Reference.Options.CloseOnEscape,
                trapFocus = true
            };
            try
            {
                await JS.InvokeVoidAsync("dryl.modal.attach",
                    entry.BackdropRef, entry.DotNetRef, opts);
                entry.Attached = true;
            }
            catch (JSDisconnectedException) { /* circuit gone */ }
        }

        // Wire the exit animationend (dialogOut bubbles from .dialog up to the
        // backdrop) so the entry is removed only after the animation plays.
        foreach (var entry in _entries.Where(e => e.IsExiting && !e.ExitAttached).ToList())
        {
            entry.ExitAttached = true;
            entry.ExitRef = DotNetObjectReference.Create(new ExitCallback(this, entry));
            try
            {
                await JS.InvokeVoidAsync("dryl.motion.onExit",
                    entry.BackdropRef, entry.ExitRef, new { name = "dialogOut", self = false });
            }
            catch (JSDisconnectedException) { /* circuit gone */ }
        }
    }

    private void OnBackdropClick(Entry entry)
    {
        if (entry.Reference.Options.CloseOnBackdropClick)
        {
            entry.Reference.Cancel();
        }
    }

    private async Task DetachInterop(Entry entry)
    {
        if (!entry.Attached) return;
        try
        {
            await JS.InvokeVoidAsync("dryl.modal.detach", entry.BackdropRef);
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
        entry.DotNetRef?.Dispose();
        entry.DotNetRef = null;
        entry.Attached = false;
    }

    public async ValueTask DisposeAsync()
    {
        DialogService.OnDialogInstanceAdded   -= OnAdded;
        DialogService.OnDialogCloseRequested  -= OnClosed;
        DialogService.OnDialogInstanceUpdated -= OnUpdated;

        foreach (var entry in _entries.ToList())
        {
            await DetachInterop(entry);
            entry.ExitRef?.Dispose();
            entry.ExitRef = null;
        }
        _entries.Clear();
    }

    /// <summary>
    /// Tiny bridge object exposed to JS so the modal interop can invoke ESC
    /// back into a specific dialog without holding onto the provider itself.
    /// </summary>
    internal sealed class DialogCallbacks
    {
        private readonly DrylDialogReference _reference;
        public DialogCallbacks(DrylDialogReference reference) => _reference = reference;

        [JSInvokable]
        public void OnEscape() => _reference.Cancel();
    }

    /// <summary>
    /// Bridge invoked by dryl.motion.onExit when a dialog's exit animation ends,
    /// so the provider can drop the (now invisible) entry from the render tree.
    /// </summary>
    private sealed class ExitCallback
    {
        private readonly DrylDialogProvider _provider;
        private readonly Entry _entry;
        public ExitCallback(DrylDialogProvider provider, Entry entry)
        {
            _provider = provider;
            _entry = entry;
        }

        [JSInvokable]
        public void OnExitFinished() => _provider.FinalizeExit(_entry);
    }
}
