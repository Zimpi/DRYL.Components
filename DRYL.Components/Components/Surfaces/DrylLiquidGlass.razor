@namespace DRYL.Components
@inject IJSRuntime JS
@implements IAsyncDisposable

@*  ─────────────────────────────────────────────────────────
    DrylLiquidGlass — a glass surface that warps in 3D toward the
    pointer (experimental).

    The pointer drives a perspective tilt of the whole pane, while the
    content and the gloss parallax in separate layers so the surface
    reads like a sheet of glass floating above the page — a
    visionOS / Apple-style depth warp. A travelling specular highlight
    tracks the cursor and the card lifts on hover.

    Pure CSS transforms (no SVG backdrop filters), so it is reliable
    across browsers and composited. Stilled under
    prefers-reduced-motion (rule 2.12).

    Usage:
      <DrylLiquidGlass Intensity="LiquidGlassIntensity.Strong">
          <h3>Liquid glass</h3>
          <p>Hover me — the surface tilts and the content floats.</p>
      </DrylLiquidGlass>
    ───────────────────────────────────────────────────────── *@

<div class="@RootCss" @ref="_el" @attributes="AdditionalAttributes">
    <div class="lg-sheen"></div>
    <div class="lg-specular"></div>
    <div class="lg-content">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>The surface content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>How strong the tilt, parallax and frost are.</summary>
    [Parameter] public LiquidGlassIntensity Intensity { get; set; } = LiquidGlassIntensity.Medium;

    /// <summary>If true (default), the surface warps toward the pointer and the highlight follows it.</summary>
    [Parameter] public bool Interactive { get; set; } = true;

    /// <summary>Extra CSS class(es) merged onto the surface.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through HTML attributes on the surface element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _el;
    private bool _attached;

    private string RootCss
    {
        get
        {
            var parts = new List<string>
            {
                "lg",
                Intensity switch
                {
                    LiquidGlassIntensity.Subtle => "lg--subtle",
                    LiquidGlassIntensity.Strong => "lg--strong",
                    _ => "lg--medium"
                }
            };
            if (!Interactive) parts.Add("lg--static");
            if (!string.IsNullOrWhiteSpace(Class)) parts.Add(Class!);
            return string.Join(' ', parts);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Interactive) return;
        try
        {
            await JS.InvokeVoidAsync("dryl.liquidglass.track", _el);
            _attached = true;
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_attached)
        {
            try { await JS.InvokeVoidAsync("dryl.liquidglass.untrack", _el); }
            catch (JSDisconnectedException) { /* circuit gone */ }
            catch (InvalidOperationException) { /* prerender — no JS */ }
        }
    }
}
