@namespace DRYL.Components
@inject IJSRuntime JS
@implements IAsyncDisposable

@*  ─────────────────────────────────────────────────────────
    DrylLiquidGlass — an Apple-style "liquid glass" surface
    (experimental).

    Unlike a plain frosted card, this one actually REFRACTS the
    backdrop: a backdrop-filter feeds the background through an SVG
    feDisplacementMap whose map is neutral (0.5) in the centre and
    ramps toward the edges, so the content behind bends most at the
    rim — like looking through thick rounded glass. The pointer adds a
    3D tilt and a travelling specular highlight.

    It is a progressive enhancement: backdrop url() filters are a
    Chromium strength, so elsewhere it degrades to a plain frosted
    glass surface. Fully stilled under prefers-reduced-motion (rule 2.12).

    Usage:
      <DrylLiquidGlass Intensity="LiquidGlassIntensity.Strong">
          <h3>Liquid glass</h3>
          <p>Hover me — the background refracts through the surface.</p>
      </DrylLiquidGlass>
    ───────────────────────────────────────────────────────── *@

<div class="@RootCss" @ref="_el" @attributes="AdditionalAttributes">

    @* Per-instance refraction filter — a unique id so multiple surfaces never
       collide. feTurbulence at a low frequency makes large, smooth warps (a
       "thick glass" wobble rather than fine water noise); feDisplacementMap
       then bends the backdrop by that map. feTurbulence is used over feImage
       because procedural maps are reliably honoured inside backdrop-filter. *@
    <svg class="lg-defs" aria-hidden="true" focusable="false">
        <filter id="@_filterId" x="-20%" y="-20%" width="140%" height="140%"
                color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="@BaseFrequency"
                          numOctaves="2" seed="11" result="noise" />
            <feGaussianBlur in="noise" stdDeviation="2" result="smooth" />
            <feDisplacementMap in="SourceGraphic" in2="smooth"
                               scale="@DisplacementScale"
                               xChannelSelector="R" yChannelSelector="G" />
        </filter>
    </svg>

    <div class="lg-refract" style="@RefractStyle"></div>
    <div class="lg-sheen"></div>
    <div class="lg-specular"></div>

    <div class="lg-content">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>The surface content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>How strongly the backdrop is refracted and frosted.</summary>
    [Parameter] public LiquidGlassIntensity Intensity { get; set; } = LiquidGlassIntensity.Medium;

    /// <summary>If true (default), the surface tilts and the highlight follows the pointer.</summary>
    [Parameter] public bool Interactive { get; set; } = true;

    /// <summary>Extra CSS class(es) merged onto the surface.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through HTML attributes on the surface element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _filterId = $"lg-{Guid.NewGuid():N}";
    private ElementReference _el;
    private bool _attached;

    // Edge-bending strength (px). Higher = more pronounced lens at the rim.
    private int DisplacementScale => Intensity switch
    {
        LiquidGlassIntensity.Subtle => 40,
        LiquidGlassIntensity.Strong => 140,
        _ => 80
    };

    private double Frost => Intensity switch
    {
        LiquidGlassIntensity.Subtle => 1,
        LiquidGlassIntensity.Strong => 4,
        _ => 2
    };

    // Refract layer: lens the backdrop through the displacement filter. If the
    // browser lacks url() backdrop filters the whole declaration is dropped and
    // the .lg-refract CSS fallback (a plain frost) applies instead.
    private string RefractStyle
    {
        get
        {
            var f = FormattableString.Invariant(
                $"url(#{_filterId}) blur({Frost}px) saturate(1.5)");
            return $"backdrop-filter: {f}; -webkit-backdrop-filter: {f};";
        }
    }

    // Lower frequency → larger, smoother warps (thick glass) rather than fine
    // water ripples. Invariant so the German locale doesn't emit "0,008".
    private string BaseFrequency => Intensity switch
    {
        LiquidGlassIntensity.Subtle => "0.006",
        LiquidGlassIntensity.Strong => "0.013",
        _ => "0.009"
    };

    private string RootCss
    {
        get
        {
            var parts = new List<string>
            {
                "lg",
                Intensity switch
                {
                    LiquidGlassIntensity.Subtle => "lg--subtle",
                    LiquidGlassIntensity.Strong => "lg--strong",
                    _ => "lg--medium"
                }
            };
            if (!string.IsNullOrWhiteSpace(Class)) parts.Add(Class!);
            return string.Join(' ', parts);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Interactive) return;
        try
        {
            await JS.InvokeVoidAsync("dryl.liquidglass.track", _el);
            _attached = true;
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_attached)
        {
            try { await JS.InvokeVoidAsync("dryl.liquidglass.untrack", _el); }
            catch (JSDisconnectedException) { /* circuit gone */ }
            catch (InvalidOperationException) { /* prerender — no JS */ }
        }
    }
}
