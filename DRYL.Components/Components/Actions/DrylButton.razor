@namespace DRYL.Components
@inherits DrylAiAware
@implements IDisposable

@*  ─────────────────────────────────────────────────────────
    DrylButton — primary action component.

    Usage:
      <DrylButton Variant="ButtonVariant.Primary"
                  Loading="@isSaving"
                  OnClick="HandleSave">
        Save changes
      </DrylButton>

      <DrylButton Variant="ButtonVariant.Secondary"
                  LeadingIcon="Download">
        Export
      </DrylButton>

      <DrylButton Variant="ButtonVariant.Ghost"
                  Size="ButtonSize.Small"
                  AriaLabel="Settings"
                  LeadingIcon="Settings" />
    ───────────────────────────────────────────────────────── *@

<button class="@CssClass"
        type="@(IsSubmit ? "submit" : "button")"
        disabled="@(Disabled || Loading)"
        aria-label="@AriaLabel"
        aria-pressed="@AriaPressed"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">

    <DrylAuraElements Aura="_aura" GenTick="_genTick" />

    @if (Loading)
    {
        <span class="spinner" aria-hidden="true"></span>
    }
    else if (!string.IsNullOrEmpty(LeadingIcon))
    {
        <DrylIcon Name="@LeadingIcon" Size="14" Class="btn-ico-lead" />
    }

    @ChildContent

    @if (!string.IsNullOrEmpty(TrailingIcon) && !Loading)
    {
        <DrylIcon Name="@TrailingIcon" Size="14" Class="btn-ico-trail" />
    }
</button>

@code {
    /// <summary>Visual style of the button.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    /// <summary>Size of the button.</summary>
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;

    /// <summary>If true, button shows a spinner and is non-clickable.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>If true, button is greyed out and non-clickable.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>If true, button submits the enclosing form.</summary>
    [Parameter] public bool IsSubmit { get; set; }

    /// <summary>Icon name shown before the label.</summary>
    [Parameter] public string? LeadingIcon { get; set; }

    /// <summary>Icon name shown after the label.</summary>
    [Parameter] public string? TrailingIcon { get; set; }

    /// <summary>Accessible label — required for icon-only buttons.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Toggle state for a toggle button (mute, bold, filter on/off, …). When set,
    /// emits <c>aria-pressed</c> and highlights the button while pressed. Leave
    /// <c>null</c> (default) for a regular, non-toggle button.
    /// </summary>
    [Parameter] public bool? Pressed { get; set; }

    /// <summary>Click event handler.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Button label content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // AI ambient state (the Ai parameter) is inherited from DrylAiAware; it engages the
    // shared aura vocabulary (rotating comet ring, breathing glow, one-shot Generated
    // wash) and resolves against a surrounding DrylAiScope.

    /// <summary>
    /// Extra CSS class(es) merged onto the button's own classes. Because Blazor
    /// matches attribute names case-insensitively, a consumer-supplied
    /// <c>class="..."</c> also binds here and is merged in — it does not clobber
    /// the component's identity classes (which a bare <c>@attributes</c> splat would).
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through HTML attributes (e.g. data-*).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly DRYL.Components.Ai.AuraLifecycle _aura = new();

    protected override void OnParametersSet()
    {
        // Re-key the one-shot Generated wash each time the consumer re-enters Generated.
        if (EffectiveAi == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = EffectiveAi;

        // Keep the aura mounted (and fading) for one beat after leaving AI mode so it
        // dissolves rather than snapping away.
        _aura.Sync(EffectiveAi, () => InvokeAsync(StateHasChanged));
    }

    private string CssClass
    {
        get
        {
            var variant = Variant switch
            {
                ButtonVariant.Primary   => "btn-primary",
                ButtonVariant.Secondary => "btn-secondary",
                ButtonVariant.Ghost     => "btn-ghost",
                ButtonVariant.Danger    => "btn-danger",
                _ => "btn-primary"
            };
            var size = Size switch
            {
                ButtonSize.Small => "btn-sm",
                ButtonSize.Large => "btn-lg",
                _ => string.Empty
            };
            var iconOnly = ChildContent is null ? "btn-icon" : string.Empty;
            var pressed = Pressed == true ? "btn--active" : string.Empty;

            var classes = new List<string> { "btn", variant, size, iconOnly, pressed };
            DRYL.Components.Ai.AiAuraCss.Append(classes, _aura, EffectiveAura);
            if (!string.IsNullOrWhiteSpace(Class)) classes.Add(Class!);
            return string.Join(' ', classes.Where(s => !string.IsNullOrWhiteSpace(s)));
        }
    }

    /// <summary>aria-pressed value: "true"/"false" for toggle buttons, null otherwise (attribute omitted).</summary>
    private string? AriaPressed => Pressed is null ? null : (Pressed.Value ? "true" : "false");

    private Task HandleClick(MouseEventArgs e) =>
        Disabled || Loading ? Task.CompletedTask : OnClick.InvokeAsync(e);

    public void Dispose() => _aura.Dispose();

    public enum ButtonVariant { Primary, Secondary, Ghost, Danger }
    public enum ButtonSize    { Small, Medium, Large }
}
