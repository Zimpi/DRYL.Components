@namespace DRYL.Components
@implements IDisposable

@*  ─────────────────────────────────────────────────────────
    DrylLayout — root container for the standard app chrome.

    Wraps DrylAppBar, DrylDrawer, and DrylMainContent in a CSS
    grid (.app-shell). Provides a DrylLayoutContext so the app
    bar can render a hamburger that toggles the drawer, and so a
    Collapsible/Pinnable drawer reflows the body when it collapses.

    Usage:
      <DrylLayout SidebarWidth="280px">
          <DrylAppBar ShowSidebarToggle>...</DrylAppBar>
          <DrylDrawer Mode="SidebarMode.Collapsible" @bind-Collapsed="collapsed">...</DrylDrawer>
          <DrylMainContent>@Body</DrylMainContent>
      </DrylLayout>
    ───────────────────────────────────────────────────────── *@

<CascadingValue Value="_ctx" IsFixed="true">
    <div class="app-shell@(_ctx.SidebarCollapsed ? " is-sidebar-collapsed" : null) @Class"
         style="@StyleVars"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly DrylLayoutContext _ctx = new();

    /// <summary>Layout children (DrylAppBar, DrylDrawer, DrylMainContent).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Expanded sidebar column width as a CSS length (e.g. <c>"280px"</c>). Overrides the
    /// <c>--sidebar-w</c> token for this layout. Default keeps the token value (260px).
    /// </summary>
    [Parameter] public string? SidebarWidth { get; set; }

    /// <summary>
    /// Collapsed sidebar column width as a CSS length (e.g. <c>"56px"</c>). Overrides the
    /// <c>--sidebar-collapsed-w</c> token for this layout.
    /// </summary>
    [Parameter] public string? SidebarCollapsedWidth { get; set; }

    /// <summary>Extra CSS class(es) applied to the .app-shell root.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through HTML attributes on the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? StyleVars
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrEmpty(SidebarWidth)) parts.Add($"--sidebar-w:{SidebarWidth}");
            if (!string.IsNullOrEmpty(SidebarCollapsedWidth)) parts.Add($"--sidebar-collapsed-w:{SidebarCollapsedWidth}");
            return parts.Count == 0 ? null : string.Join(';', parts);
        }
    }

    protected override void OnInitialized() => _ctx.StateChanged += OnContextChanged;

    private void OnContextChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => _ctx.StateChanged -= OnContextChanged;
}
