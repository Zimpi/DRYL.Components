@namespace DRYL.Components
@implements IDisposable
@inject NavigationManager Nav

@*  ─────────────────────────────────────────────────────────
    DrylDrawer — sidebar inside a DrylLayout.

    Responsive: on desktop (>= 1024px) the drawer is always
    visible as a grid column. On mobile it becomes a fixed
    overlay controlled by <c>Open</c>; a backdrop closes it.

    Usage:
      <DrylDrawer @bind-Open="open">
          <DrylNavGroup Title="Library">
              <DrylNavLink Href="" Icon="Home" Match="NavLinkMatch.All">Overview</DrylNavLink>
              <DrylNavLink Href="buttons" Icon="Bolt">Buttons</DrylNavLink>
          </DrylNavGroup>
      </DrylDrawer>
    ───────────────────────────────────────────────────────── *@

<div class="sidebar-backdrop @(Open ? "is-open" : null)" @onclick="CloseAsync"></div>

<aside class="sidebar @(Open ? "is-open" : null) @Class" @attributes="AdditionalAttributes">
    @ChildContent
</aside>

@code {
    /// <summary>Cascaded from <see cref="DrylLayout"/>. Null if the drawer is used outside a layout.</summary>
    [CascadingParameter] public DrylLayoutContext? Context { get; set; }

    /// <summary>
    /// Open state. Only affects the mobile overlay — on desktop the drawer is always laid out
    /// in the grid regardless of this value. Default <c>false</c> so mobile starts closed.
    /// </summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Two-way binding callback for <see cref="Open"/>.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Drawer body (brand, nav groups, footer links, etc.).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra CSS class(es) applied to the .sidebar root.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through HTML attributes on the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private DrylLayoutContext? _registered;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_registered, Context))
        {
            _registered?.UnregisterDrawer(this);
            _registered = Context;
            _registered?.RegisterDrawer(this);
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (Open) _ = SetOpenAsync(false);
    }

    internal Task ToggleAsync() => SetOpenAsync(!Open);

    internal async Task SetOpenAsync(bool value)
    {
        if (Open == value) return;
        Open = value;
        if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(value);
        _registered?.NotifyStateChanged();
        StateHasChanged();
    }

    private Task CloseAsync() => SetOpenAsync(false);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _registered?.UnregisterDrawer(this);
    }
}
