@namespace DRYL.Components
@typeparam TValue
@inherits InputBase<TValue>
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

@*  ─────────────────────────────────────────────────────────
    DrylInputNumber<TValue> — numeric input bound to EditForm.

    Supported value types: int, long, float, double, decimal,
    and their nullable counterparts.

    Usage:
      <DrylInputNumber @bind-Value="model.Price"
                       Label="Price"
                       Min="0m"
                       Max="9999m"
                       Step="0.01m"
                       LeadingIcon="DollarSign" />

    Optional ± stepper buttons are shown when ShowStepper="true".
    ───────────────────────────────────────────────────────── *@

<div class="field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="field-label" for="@_id">@Label</label>
    }

    <div class="@WrapperCssClass">
        @if (Ai != AiState.None)
        {
            <div class="ai-aura-ring"></div>
            <div class="ai-aura-glow"></div>
            @if (Ai == AiState.Generated)
            {
                <div class="ai-aura-wash" @key="_genTick"></div>
            }
        }

        @if (!string.IsNullOrEmpty(LeadingIcon))
        {
            <DrylIcon Name="@LeadingIcon" Size="16" Class="input-icon input-icon-leading" />
        }

        <input id="@_id"
               class="@InputCssClass"
               type="number"
               inputmode="decimal"
               value="@CurrentValueAsString"
               min="@FormatConstraint(Min)"
               max="@FormatConstraint(Max)"
               step="@FormatConstraint(Step)"
               @oninput="HandleInput"
               placeholder="@Placeholder"
               disabled="@Disabled"
               aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)"
               aria-invalid="@(HasValidationError ? "true" : null)"
               aria-describedby="@(ShowHelper ? _helperId : null)"
               @attributes="AdditionalAttributes" />

        @if (ShowStepper)
        {
            <div class="num-stepper">
                <button type="button" class="num-step-btn" tabindex="-1"
                        aria-label="Increase" disabled="@Disabled"
                        @onclick="StepUp">
                    <DrylIcon Name="ChevronUp" Size="12" />
                </button>
                <button type="button" class="num-step-btn" tabindex="-1"
                        aria-label="Decrease" disabled="@Disabled"
                        @onclick="StepDown">
                    <DrylIcon Name="ChevronDown" Size="12" />
                </button>
            </div>
        }
    </div>

    @if (HasValidationError)
    {
        <div class="input-helper input-helper-error" id="@_helperId">
            @string.Join(" ", EditContext!.GetValidationMessages(FieldIdentifier))
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="input-helper" id="@_helperId">@HelperText</div>
    }
</div>

@code {
    /// <summary>Optional label shown above the input.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder text shown when the input is empty.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Helper text shown below the input. Replaced by validation errors when present.</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>Optional icon name rendered inside the input on the left.</summary>
    [Parameter] public string? LeadingIcon { get; set; }

    /// <summary>Minimum allowed value (maps to the HTML <c>min</c> attribute).</summary>
    [Parameter] public TValue? Min { get; set; }

    /// <summary>Maximum allowed value (maps to the HTML <c>max</c> attribute).</summary>
    [Parameter] public TValue? Max { get; set; }

    /// <summary>Step size for the stepper buttons and the HTML <c>step</c> attribute.</summary>
    [Parameter] public TValue? Step { get; set; }

    /// <summary>Visual state override. An active validation error overrides this.</summary>
    [Parameter] public InputState State { get; set; } = InputState.Default;

    /// <summary>If true, ± buttons are shown to increment / decrement the value by <c>Step</c>.</summary>
    [Parameter] public bool ShowStepper { get; set; }

    /// <summary>If true, the input is greyed out and non-editable.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible label — required if <c>Label</c> is not set.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>AI ambient state — controls the gradient border, glow, and reveal animation.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    private readonly string _id       = $"dryl-num-{Guid.NewGuid():N}";
    private readonly string _helperId = $"dryl-help-{Guid.NewGuid():N}";
    private AiState _prevAi = AiState.None;
    private int _genTick;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        if (ValueExpression is null)
            ValueExpression = () => Value;
        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Ai == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = Ai;
    }

    private void HandleInput(ChangeEventArgs e) =>
        CurrentValueAsString = e.Value?.ToString();

    private void StepUp()
    {
        var step = GetStepDouble();
        if (TryGetDouble(CurrentValue, out var v))
            CurrentValueAsString = FormattableString.Invariant($"{v + step}");
    }

    private void StepDown()
    {
        var step = GetStepDouble();
        if (TryGetDouble(CurrentValue, out var v))
            CurrentValueAsString = FormattableString.Invariant($"{v - step}");
    }

    private double GetStepDouble()
    {
        if (Step is null) return 1;
        return TryGetDouble(Step, out var s) ? s : 1;
    }

    private static bool TryGetDouble(TValue? value, out double result)
    {
        result = 0;
        if (value is null) return false;
        try { result = Convert.ToDouble(value, CultureInfo.InvariantCulture); return true; }
        catch { return false; }
    }

    private static string? FormatConstraint(TValue? value)
    {
        if (value is null) return null;
        return value switch
        {
            double d  => FormattableString.Invariant($"{d}"),
            float f   => FormattableString.Invariant($"{f}"),
            decimal m => FormattableString.Invariant($"{m}"),
            _         => value.ToString()
        };
    }

    private bool HasValidationError =>
        EditContext is not null && EditContext.GetValidationMessages(FieldIdentifier).Any();

    private bool ShowHelper => HasValidationError || !string.IsNullOrEmpty(HelperText);

    private string WrapperCssClass
    {
        get
        {
            var classes = new List<string> { "input-wrapper" };
            if (ShowStepper) classes.Add("has-stepper");
            if (Ai != AiState.None) classes.Add("ai-aura");
            switch (Ai)
            {
                case AiState.Thinking:  classes.Add("ai-thinking");  break;
                case AiState.Streaming: classes.Add("ai-streaming"); break;
                case AiState.Generated: classes.Add("ai-generated"); break;
            }
            return string.Join(' ', classes);
        }
    }

    private string InputCssClass
    {
        get
        {
            var classes = "input";
            if (!string.IsNullOrEmpty(LeadingIcon)) classes += " has-leading-icon";

            if (HasValidationError || State == InputState.Error)   classes += " input-error";
            else if (State == InputState.Success)                  classes += " input-success";

            return classes;
        }
    }

    protected override string? FormatValueAsString(TValue? value) =>
        value switch
        {
            null    => null,
            double d  => FormattableString.Invariant($"{d}"),
            float f   => FormattableString.Invariant($"{f}"),
            decimal m => FormattableString.Invariant($"{m}"),
            _         => value.ToString()
        };

    protected override bool TryParseValueFromString(
        string? value,
        out TValue result,
        out string validationErrorMessage)
    {
        if (BindConverter.TryConvertTo<TValue>(value, CultureInfo.InvariantCulture, out result!))
        {
            validationErrorMessage = string.Empty;
            return true;
        }
        result = default!;
        validationErrorMessage = $"The field must be a valid number.";
        return false;
    }
}
