@namespace DRYL.Components
@inherits InputBase<string>
@inject IJSRuntime JS
@implements IAsyncDisposable

@*  ─────────────────────────────────────────────────────────
    DrylSelect — single-select dropdown bound to EditForm.

    Built on the shared DrylPopover primitive (anchor, positioning and
    click-outside dismissal); DrylSelect keeps the combobox role,
    option list and keyboard navigation.

    Usage:
      <DrylSelect @bind-Value="model.Environment" Label="Environment"
                  Items="@_envItems" />

      @code {
          private static readonly SelectItem[] _envItems =
          [
              new("Production",  "Production"),
              new("Staging",     "Staging"),
              new("Development", "Development"),
          ];
      }

    Keyboard: ArrowDown/Up navigate options, Enter/Space opens,
    Enter selects highlighted, Escape closes.
    ───────────────────────────────────────────────────────── *@

<div class="field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="field-label" for="@_id">@Label</label>
    }

    <DrylPopover @ref="_popover"
                 @bind-Open="_isOpen"
                 Block="true"
                 MatchTriggerWidth="true"
                 TriggerTogglesOpen="false"
                 Surface="false"
                 CloseOnEscape="false">
        <TriggerContent>
            <div class="@WrapperCssClass">
                @if (Ai != AiState.None)
                {
                    <div class="ai-aura-ring"></div>
                    <div class="ai-aura-glow"></div>
                    @if (Ai == AiState.Generated)
                    {
                        <div class="ai-aura-wash" @key="_genTick"></div>
                    }
                }

                @* Trigger — styled div so keyboard events don't double-fire via button activation *@
                <div id="@_id"
                     @ref="_trigger"
                     class="@TriggerCssClass"
                     tabindex="@(Disabled ? -1 : 0)"
                     role="combobox"
                     aria-haspopup="listbox"
                     aria-expanded="@(_isOpen ? "true" : "false")"
                     aria-controls="@_listboxId"
                     aria-activedescendant="@ActiveDescendant"
                     aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)"
                     aria-invalid="@(HasValidationError ? "true" : null)"
                     aria-describedby="@(ShowHelper ? _helperId : null)"
                     @onclick="Toggle"
                     @onkeydown="HandleKeyDown"
                     @attributes="AdditionalAttributes">
                    <span class="@(HasSelection ? null : "select-placeholder")">@DisplayLabel</span>
                </div>
            </div>
        </TriggerContent>
        <PanelContent>
            <div id="@_listboxId"
                 role="listbox"
                 class="select-panel"
                 aria-label="@(string.IsNullOrEmpty(Label) ? "Options" : $"{Label} options")">

                @if (_items.Count == 0)
                {
                    <div class="select-empty">No options</div>
                }
                else
                {
                    for (int i = 0; i < _items.Count; i++)
                    {
                        var item  = _items[i];
                        var idx   = i;
                        var isHl  = idx == _highlightedIndex;
                        var isSel = item.Value == CurrentValueAsString;

                        <div id="@($"sopt-{_id}-{idx}")"
                             role="option"
                             class="@OptionCss(isHl, isSel)"
                             aria-selected="@(isSel ? "true" : "false")"
                             @onclick="() => SelectItem(item)"
                             @onmouseenter="() => _highlightedIndex = idx"
                             @onmousedown:preventDefault
                             @key="idx">
                            @item.Label
                        </div>
                    }
                }
            </div>
        </PanelContent>
    </DrylPopover>

    @if (HasValidationError)
    {
        <div class="input-helper input-helper-error" id="@_helperId">
            @string.Join(" ", EditContext!.GetValidationMessages(FieldIdentifier))
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="input-helper" id="@_helperId">@HelperText</div>
    }
</div>

@code {
    /// <summary>Optional label shown above the select.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder text shown when no item is selected.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Helper text shown below the select. Replaced by validation errors when present.</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>Visual state override. An active validation error overrides this.</summary>
    [Parameter] public InputState State { get; set; } = InputState.Default;

    /// <summary>If true, the select is greyed out and non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible label — required if <c>Label</c> is not set.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>AI ambient state — controls the gradient border, glow, and reveal animation.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>The selectable options.</summary>
    [Parameter] public IEnumerable<SelectItem>? Items { get; set; }

    private readonly string _id        = $"dryl-sel-{Guid.NewGuid():N}";
    private readonly string _listboxId = $"dryl-sel-lb-{Guid.NewGuid():N}";
    private readonly string _helperId  = $"dryl-help-{Guid.NewGuid():N}";

    private List<SelectItem> _items = [];
    private bool _isOpen;
    private int _highlightedIndex = -1;

    private DrylPopover? _popover;
    private ElementReference _trigger;
    private bool _attached;
    private AiState _prevAi = AiState.None;
    private int _genTick;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        if (ValueExpression is null)
            ValueExpression = () => Value;
        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Ai == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = Ai;
        _items = Items?.ToList() ?? [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _attached) return;
        // Suppress the browser's default page-scroll for the navigation keys so
        // HandleKeyDown can move the option highlight. Tab/Enter/Escape stay live.
        try
        {
            await JS.InvokeVoidAsync("dryl.keynav.attach", _trigger);
            _attached = true;
        }
        catch (JSDisconnectedException) { /* circuit closing during prerender — ignore */ }
    }

    private void Toggle()
    {
        if (Disabled) return;
        _isOpen = !_isOpen;
        if (_isOpen)
            _highlightedIndex = _items.FindIndex(i => i.Value == CurrentValueAsString);
    }

    private void SelectItem(SelectItem item)
    {
        CurrentValueAsString = item.Value;
        _isOpen = false;
        _highlightedIndex = -1;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var count = _items.Count;

        switch (e.Key)
        {
            case "ArrowDown":
                if (!_isOpen)
                {
                    _isOpen = true;
                    _highlightedIndex = _items.FindIndex(i => i.Value == CurrentValueAsString);
                    if (_highlightedIndex < 0) _highlightedIndex = 0;
                    break;
                }
                _highlightedIndex = Math.Min(_highlightedIndex + 1, count - 1);
                await ScrollHighlightedIntoView();
                break;

            case "ArrowUp":
                if (!_isOpen)
                {
                    // ARIA combobox: ArrowUp on a closed select opens it and
                    // highlights the selected option (or the last one if none).
                    _isOpen = true;
                    _highlightedIndex = _items.FindIndex(i => i.Value == CurrentValueAsString);
                    if (_highlightedIndex < 0) _highlightedIndex = count - 1;
                    break;
                }
                if (_highlightedIndex > 0)
                {
                    _highlightedIndex--;
                    await ScrollHighlightedIntoView();
                }
                break;

            case "Enter":
            case " ":
                if (_isOpen && _highlightedIndex >= 0 && _highlightedIndex < count)
                    SelectItem(_items[_highlightedIndex]);
                else if (!_isOpen)
                {
                    _isOpen = true;
                    _highlightedIndex = _items.FindIndex(i => i.Value == CurrentValueAsString);
                    if (_highlightedIndex < 0) _highlightedIndex = 0;
                }
                break;

            case "Escape":
                _isOpen = false;
                break;

            case "Tab":
                if (_isOpen && _highlightedIndex >= 0 && _highlightedIndex < count)
                    SelectItem(_items[_highlightedIndex]);
                _isOpen = false;
                break;
        }
    }

    private async Task ScrollHighlightedIntoView()
    {
        if (_popover is not null)
            await JS.InvokeVoidAsync("dryl.autocomplete.scrollOptionIntoView", _popover.PanelElement, _highlightedIndex);
    }

    private bool HasSelection => !string.IsNullOrEmpty(CurrentValueAsString);

    private string DisplayLabel =>
        _items.FirstOrDefault(i => i.Value == CurrentValueAsString)?.Label
        ?? Placeholder
        ?? string.Empty;

    private string? ActiveDescendant =>
        _highlightedIndex >= 0 ? $"sopt-{_id}-{_highlightedIndex}" : null;

    // ── CSS helpers ────────────────────────────────────────

    private string WrapperCssClass
    {
        get
        {
            var classes = new List<string> { "input-wrapper" };
            if (Ai != AiState.None) classes.Add("ai-aura");
            switch (Ai)
            {
                case AiState.Thinking:  classes.Add("ai-thinking");  break;
                case AiState.Streaming: classes.Add("ai-streaming"); break;
                case AiState.Generated: classes.Add("ai-generated"); break;
            }
            return string.Join(' ', classes);
        }
    }

    private string TriggerCssClass
    {
        get
        {
            var c = "select";
            if (_isOpen)                                             c += " select--open";
            if (Disabled)                                            c += " select--disabled";
            if (HasValidationError || State == InputState.Error)     c += " input-error";
            else if (State == InputState.Success)                    c += " input-success";
            return c;
        }
    }

    private static string OptionCss(bool isHighlighted, bool isSelected)
    {
        var c = "select-option";
        if (isHighlighted) c += " is-highlighted";
        if (isSelected)    c += " is-selected";
        return c;
    }

    private bool HasValidationError =>
        EditContext is not null && EditContext.GetValidationMessages(FieldIdentifier).Any();

    private bool ShowHelper => HasValidationError || !string.IsNullOrEmpty(HelperText);

    protected override bool TryParseValueFromString(
        string? value,
        out string result,
        out string validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = string.Empty;
        return true;
    }

    public async ValueTask DisposeAsync()
    {
        if (!_attached) return;
        try { await JS.InvokeVoidAsync("dryl.keynav.detach", _trigger); }
        catch (JSDisconnectedException) { /* circuit already gone — ignore */ }
        catch (JSException) { /* element/listener already gone — ignore */ }
    }
}
