@namespace DRYL.Components
@inherits InputBase<double>
@implements IDisposable
@using System.Globalization

@*  ─────────────────────────────────────────────────────────
    DrylSlider — range slider bound to EditForm.

    Usage:
      <EditForm Model="@model">
          <DrylSlider @bind-Value="model.Volume"
                      Label="Volume"
                      Min="0" Max="100" Step="1"
                      ShowValue="true" />
      </EditForm>

    The accent gradient fill tracks the thumb position via a CSS
    custom property --pct set inline — no extra JS required.
    ───────────────────────────────────────────────────────── *@

<div class="field">
    @if (!string.IsNullOrEmpty(Label) || ShowValue)
    {
        <div class="slider-header">
            @if (!string.IsNullOrEmpty(Label))
            {
                <label class="field-label" style="margin-bottom: 0;" for="@_id">@Label</label>
            }
            @if (ShowValue)
            {
                <span class="slider-value">@FormattableString.Invariant($"{CurrentValue:G}")</span>
            }
        </div>
    }

    <div class="@WrapperCssClass">
        <DrylAuraElements Aura="_aura" GenTick="_genTick" />

        <input id="@_id"
               class="@SliderCssClass"
               type="range"
               min="@Min.ToString(CultureInfo.InvariantCulture)"
               max="@Max.ToString(CultureInfo.InvariantCulture)"
               step="@Step.ToString(CultureInfo.InvariantCulture)"
               value="@CurrentValueAsString"
               style="--pct: @_pct"
               disabled="@Disabled"
               aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)"
               aria-valuemin="@Min.ToString(CultureInfo.InvariantCulture)"
               aria-valuemax="@Max.ToString(CultureInfo.InvariantCulture)"
               aria-valuenow="@CurrentValue.ToString(CultureInfo.InvariantCulture)"
               aria-describedby="@(ShowHelper ? _helperId : null)"
               @oninput="HandleInput"
               @attributes="AdditionalAttributes" />
    </div>

    @if (HasValidationError)
    {
        <div class="input-helper input-helper-error" id="@_helperId">
            @string.Join(" ", EditContext!.GetValidationMessages(FieldIdentifier))
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="input-helper" id="@_helperId">@HelperText</div>
    }
</div>

@code {
    /// <summary>Optional label shown above the slider.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Helper text shown below the slider. Replaced by validation errors when present.</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>Minimum value.</summary>
    [Parameter] public double Min { get; set; } = 0;

    /// <summary>Maximum value.</summary>
    [Parameter] public double Max { get; set; } = 100;

    /// <summary>Step size between values.</summary>
    [Parameter] public double Step { get; set; } = 1;

    /// <summary>If true, the current numeric value is shown at the trailing edge of the label row.</summary>
    [Parameter] public bool ShowValue { get; set; } = true;

    /// <summary>If true, the slider is greyed out and non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible label — required if <c>Label</c> is not set.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>AI ambient state — controls the gradient border, glow, and reveal animation.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>AI aura variant. Leave <c>null</c> to inherit a surrounding <c>DrylAiScope</c> (ultimately <see cref="AiAura.Comet"/>).</summary>
    [Parameter] public AiAura? Aura { get; set; }

    /// <summary>Surrounding AI scope (supplied by <c>DrylAiScope</c>); used to resolve the aura variant.</summary>
    [CascadingParameter] private AiScope? Scope { get; set; }

    private AiAura EffectiveAura => AiScope.ResolveAura(Aura, Scope);

    private readonly string _id       = $"dryl-slider-{Guid.NewGuid():N}";
    private readonly string _helperId = $"dryl-help-{Guid.NewGuid():N}";
    private AiState _prevAi = AiState.None;
    private int _genTick;
    private string _pct = "0%";
    private readonly AuraLifecycle _aura = new();

    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        if (ValueExpression is null)
            ValueExpression = () => Value;
        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Ai == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = Ai;
        _aura.Sync(Ai, () => InvokeAsync(StateHasChanged));
        UpdatePct(CurrentValue);
    }

    public void Dispose() => _aura.Dispose();

    private void HandleInput(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
        UpdatePct(CurrentValue);
    }

    private void UpdatePct(double value)
    {
        var range = Max - Min;
        var pct = range > 0 ? Math.Clamp((value - Min) / range * 100, 0, 100) : 0;
        _pct = FormattableString.Invariant($"{pct:F2}%");
    }

    private bool HasValidationError =>
        EditContext is not null && EditContext.GetValidationMessages(FieldIdentifier).Any();

    private bool ShowHelper => HasValidationError || !string.IsNullOrEmpty(HelperText);

    private string WrapperCssClass
    {
        get
        {
            var classes = new List<string> { "slider-wrap" };
            AiAuraCss.Append(classes, _aura, EffectiveAura);
            return string.Join(' ', classes);
        }
    }

    private string SliderCssClass =>
        HasValidationError ? "dryl-slider input-error" : "dryl-slider";

    protected override string? FormatValueAsString(double value) =>
        value.ToString(CultureInfo.InvariantCulture);

    protected override bool TryParseValueFromString(
        string? value,
        out double result,
        out string validationErrorMessage)
    {
        if (double.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out result))
        {
            validationErrorMessage = string.Empty;
            return true;
        }
        validationErrorMessage = "The field must be a valid number.";
        return false;
    }
}
