@namespace DRYL.Components.Canvas
@using System.Text
@using System.Text.Json
@implements IDisposable

@*  ─────────────────────────────────────────────────────────
    CanvasNodeView — the recursive renderer for one canvas node.

    Every node maps to a curated DRYL component (see CanvasCatalog).
    Each node is wrapped in a DrylPresence keyed by its stable id so
    it glides in on mount and plays its exit animation on removal;
    the `data-cid` attribute is the FLIP move anchor for the JS layer.

    Nodes that don't yet validate while the run is streaming render a skeleton
    placeholder with a "waiting for {type}…" caption; once the run has settled
    (Generated / None) an invalid node is finished-broken and shows a compact
    .canvas-invalid placeholder carrying the catalog's corrective message.

    The shared pieces (form state, pulse tracker, data binder, intent callback)
    arrive as one CanvasContext cascade from DrylCanvas and flow down to child
    views automatically.
    ───────────────────────────────────────────────────────── *@

<DrylPresence @key="Node.Id"
              Visible="@(!Node.Removing)"
              Appear
              Transition="PresenceTransition.SlideUp"
              Speed="PresenceSpeed.Slow"
              OnExited="PurgeSelf">
    <div class="canvas-node" data-cid="@Node.Id">
        @if (_pulseKey > 0)
        {
            @*  Change-pulse: a setProps has no motion of its own, so the node flashes an
                accent ring once. Re-keying (not a timer) restarts the animation — a new key
                makes Blazor replace the element, and a freshly mounted element runs its
                CSS animation from frame one. Nothing to dispose, nothing to leak. *@
            <span class="canvas-pulse" @key="_pulseKey" aria-hidden="true"></span>
        }
        @{
            EnsureMemo();
            var error = _memoError;
            var binding = _bindingState;
        }
        @if (binding is { HasValue: false, Error: { } bindError })
        {
            @*  A bound node that never got a good value. Compact and local: one broken
                widget must never blow up the dashboard around it. *@
            <span class="canvas-data-error">
                <DrylIcon Name="Alert" Size="14" />
                @bindError
            </span>
        }
        else if (binding is { HasValue: false })
        {
            @*  First load — a skeleton in the rough shape of the node type, exactly like the
                streaming case. A *refresh* deliberately never gets here: the node keeps its
                identity and its value, and the change-pulse carries the movement instead (A8). *@
            <DrylSkeleton Variant="SkeletonFor(Node.Type)" Lines="3" Ai="AiState.Streaming" />
        }
        else if (error is not null)
        {
            @if (Ctx.State is AiState.Streaming or AiState.Thinking)
            {
                <DrylSkeleton Variant="DrylSkeleton.SkeletonVariant.Card" Ai="AiState.Streaming" />
                <span class="canvas-waiting">@($"waiting for {Node.Type}…")</span>
            }
            else
            {
                @* Settled and still invalid — finished-broken, not loading. *@
                <span class="canvas-invalid">@error</span>
            }
        }
        else
        {
            switch (Node.Type)
            {
                case "stack":
                {
                    var p = Props<StackNodeProps>();
                    <DrylStack Gap="MapGap(p?.Gap)">
                        @RenderChildren
                    </DrylStack>
                    break;
                }

                case "grid":
                {
                    var p = Props<GridNodeProps>();
                    <DrylGrid Columns="p!.Columns">
                        @RenderChildren
                    </DrylGrid>
                    break;
                }

                case "card":
                {
                    var p = Props<CardNodeProps>();
                    <DrylCard>
                        @if (!string.IsNullOrWhiteSpace(p?.Title))
                        {
                            <div class="canvas-card-title">@p!.Title</div>
                        }
                        @RenderChildren
                    </DrylCard>
                    break;
                }

                case "tabs":
                {
                    var p = Props<TabsNodeProps>();
                    var labels = p!.Labels!;
                    var children = Node.Children!;
                    <DrylTabs>
                        @for (var i = 0; i < labels.Count; i++)
                        {
                            var idx = i;                 // capture per-iteration for the fragment
                            var child = children[idx];
                            <DrylTab Label="@labels[idx]">
                                <CanvasNodeView @key="child.Id" Node="child" />
                            </DrylTab>
                        }
                    </DrylTabs>
                    break;
                }

                case "accordion":
                {
                    var p = Props<AccordionNodeProps>();
                    var labels = p!.Labels!;
                    var children = Node.Children!;
                    @for (var i = 0; i < labels.Count; i++)
                    {
                        var idx = i;                 // capture per-iteration for the fragment
                        var child = children[idx];
                        <DrylExpansion Title="@labels[idx]"
                                       Open="@_openSections.Contains(idx)"
                                       OpenChanged="@(v => ToggleSection(idx, v))">
                            <CanvasNodeView @key="child.Id" Node="child" />
                        </DrylExpansion>
                    }
                    break;
                }

                case "form":
                {
                    var p = Props<FormNodeProps>();
                    var actionState = Ctx.Actions?.StateOf(Node.Id);
                    <div class="canvas-form">
                        <CascadingValue Value="_formScope" IsFixed="true">
                            @RenderChildren
                        </CascadingValue>
                        <div class="canvas-form-submit">
                            <DrylButton Variant="DrylButton.ButtonVariant.Primary"
                                        Loading="@(actionState?.Busy == true)"
                                        OnClick="@(_ => SubmitFormAsync(p!))">
                                @p!.SubmitLabel
                            </DrylButton>
                        </div>
                        <DrylPresence Visible="@(actionState?.Error is not null)"
                                      Transition="PresenceTransition.SlideUp" Speed="PresenceSpeed.Fast">
                            <span class="canvas-action-error">
                                <DrylIcon Name="Alert" Size="14" />
                                @actionState?.Error
                            </span>
                        </DrylPresence>
                    </div>
                    break;
                }

                case "divider":
                    <DrylDivider />
                    break;

                case "markdown":
                {
                    var p = Props<MarkdownNodeProps>();
                    <DrylMarkdown Content="@p!.Content" />
                    break;
                }

                case "stat":
                {
                    var p = Props<CanvasStatProps>();
                    @* Every number in an artifact is AI-authored and changes by setProps,
                       so the count-up tween is the rule here, not the exception. *@
                    <DrylStat Label="@p!.Label" Value="@p.Value" Delta="@p.Delta"
                              Direction="@p.ParsedDirection" CountUp Ai="AiState.Generated" />
                    break;
                }

                case "badge":
                {
                    var p = Props<BadgeNodeProps>();
                    <DrylBadge Kind="MapBadge(p!.Kind)">@p.Text</DrylBadge>
                    break;
                }

                case "progress":
                {
                    var p = Props<ProgressNodeProps>();
                    var hasLabel = !string.IsNullOrWhiteSpace(p!.Label);
                    <DrylProgress Value="p.Value" Max="100" ShowLabel="hasLabel" LabelText="@p.Label" />
                    break;
                }

                case "table":
                {
                    var p = Props<TableNodeProps>();
                    <DrylMarkdown Content="@BuildTable(p!)" />
                    break;
                }

                case "dataGrid":
                {
                    var p = Props<DataGridNodeProps>();
                    var rows = GridRows(p!);
                    var sortable = p!.Sortable ?? true;
                    var searchable = p.Searchable == true;
                    var filterable = p.Filterable == true;
                    var pageSize = p.PageSize ?? 10;
                    // Paging only when it has something to page — a footer under three rows is noise.
                    var effectivePageSize = pageSize > 0 && rows.Count > pageSize ? pageSize : 0;
                    <DrylTable TItem="CanvasGridRow" Items="@rows"
                               ShowToolbar="@searchable" Searchable="@searchable"
                               PageSize="@effectivePageSize"
                               AriaLabel="Data grid"
                               RowIdSelector="@(r => r.Index)">
                        <Columns>
                            @for (var i = 0; i < p.Columns!.Count; i++)
                            {
                                var idx = i;             // capture per-iteration for the expression
                                <DrylColumn TItem="CanvasGridRow"
                                            ColumnKey="@($"c{idx}")" Title="@p.Columns[idx]"
                                            Field="@(r => r.Cell(idx))"
                                            Sortable="@sortable" Searchable="@searchable"
                                            Filterable="@filterable"
                                            FilterType="@(filterable ? ColumnFilterType.Select : ColumnFilterType.Auto)" />
                            }
                        </Columns>
                    </DrylTable>
                    break;
                }

                case "timeline":
                {
                    var p = Props<CanvasTimelineProps>();
                    <DrylTimeline>
                        @foreach (var e in p!.Events!)
                        {
                            @if (string.IsNullOrWhiteSpace(e.Text))
                            {
                                <DrylTimelineItem Title="@e.Title" Timestamp="@e.Timestamp" Variant="@e.ParsedVariant" />
                            }
                            else
                            {
                                <DrylTimelineItem Title="@e.Title" Timestamp="@e.Timestamp" Variant="@e.ParsedVariant">
                                    @e.Text
                                </DrylTimelineItem>
                            }
                        }
                    </DrylTimeline>
                    break;
                }

                case "lineChart":
                {
                    var p = Props<CanvasChartProps>();
                    @if (!string.IsNullOrWhiteSpace(p!.Title))
                    {
                        <div class="canvas-chart-title">@p.Title</div>
                    }
                    <DrylLineChart Labels="@p!.Labels" Series="@ToSeries(p)" ValueFormat="@p.ValueFormat"
                                   Smooth ShowMarkers Ai="AiState.Generated" />
                    break;
                }

                case "areaChart":
                {
                    var p = Props<CanvasChartProps>();
                    @if (!string.IsNullOrWhiteSpace(p!.Title))
                    {
                        <div class="canvas-chart-title">@p.Title</div>
                    }
                    <DrylAreaChart Labels="@p!.Labels" Series="@ToSeries(p)" ValueFormat="@p.ValueFormat"
                                   Smooth Ai="AiState.Generated" />
                    break;
                }

                case "barChart":
                {
                    var p = Props<CanvasChartProps>();
                    @if (!string.IsNullOrWhiteSpace(p!.Title))
                    {
                        <div class="canvas-chart-title">@p.Title</div>
                    }
                    <DrylBarChart Labels="@p!.Labels" Series="@ToSeries(p)" ValueFormat="@p.ValueFormat"
                                  Stacked="@p.Stacked" Ai="AiState.Generated" />
                    break;
                }

                case "donutChart":
                {
                    var p = Props<CanvasDonutProps>();
                    @if (!string.IsNullOrWhiteSpace(p!.Title))
                    {
                        <div class="canvas-chart-title">@p.Title</div>
                    }
                    <DrylDonutChart Segments="@ToSegments(p!)" ValueFormat="@p!.ValueFormat" Ai="AiState.Generated" />
                    break;
                }

                case "kpi":
                {
                    var p = Props<CanvasKpiProps>();
                    <div class="canvas-kpi">
                        @foreach (var item in p!.Items!)
                        {
                            <DrylStat Label="@item.Label" Value="@item.Value" Delta="@item.Delta"
                                      Direction="@item.ParsedDirection" CountUp Ai="AiState.Generated" />
                        }
                    </div>
                    break;
                }

                case "list":
                {
                    var p = Props<CanvasListProps>();
                    <DrylList>
                        @foreach (var item in p!.Items!)
                        {
                            <DrylListItem Icon="@item.Icon">
                                @item.Title
                                @if (!string.IsNullOrWhiteSpace(item.Text))
                                {
                                    <span class="canvas-list-text">@item.Text</span>
                                }
                            </DrylListItem>
                        }
                    </DrylList>
                    break;
                }

                case "keyValue":
                {
                    var p = Props<CanvasKeyValueProps>();
                    <DrylDescriptionList Columns="@(p!.Columns ?? 1)">
                        @foreach (var pair in p.Pairs!)
                        {
                            <DrylDescriptionItem Term="@pair.Key">@pair.Value</DrylDescriptionItem>
                        }
                    </DrylDescriptionList>
                    break;
                }

                case "image":
                {
                    var p = Props<ImageNodeProps>();
                    <DrylImage Src="@(p!.Src!)" Alt="@(p.Alt!)" Fit="MapImageFit(p.Fit)"
                               Ratio="MapImageRatio(p.Ratio)" Rounded="DrylImage.ImageRounded.Md" />
                    @if (!string.IsNullOrWhiteSpace(p.Caption))
                    {
                        <div class="canvas-image-caption">@p.Caption</div>
                    }
                    break;
                }

                case "code":
                {
                    var p = Props<CodeNodeProps>();
                    <DrylCodeBlock Code="@(p!.Code!)" Language="@p.Language"
                                   ShowLineNumbers="@(p.LineNumbers == true)" />
                    break;
                }

                case "emptyState":
                {
                    var p = Props<EmptyStateNodeProps>();
                    <DrylEmptyState Icon="@p!.Icon" Title="@p.Title" Description="@p.Description" />
                    break;
                }

                case "inputText":
                {
                    var p = Props<InputTextNodeProps>();
                    var name = p!.Name!;
                    <DrylInputText Label="@p.Label" Placeholder="@p.Placeholder"
                                   Value="@(Ctx.Form.Get<string>(name))"
                                   ValueChanged="@(v => { Ctx.Form.Set(name, v); FormScope?.Clear(name); })" />
                    @RequiredHint(name)
                    break;
                }

                case "select":
                {
                    var p = Props<SelectNodeProps>();
                    var name = p!.Name!;
                    <DrylSelect Label="@p.Label" Items="@ToItems(p.Options!)"
                                Value="@(Ctx.Form.Get<string>(name))"
                                ValueChanged="@(v => { Ctx.Form.Set(name, v); FormScope?.Clear(name); })"
                                Ai="AiState.None" />
                    @RequiredHint(name)
                    break;
                }

                case "slider":
                {
                    var p = Props<SliderNodeProps>();
                    var name = p!.Name!;
                    <DrylSlider Label="@p.Label" Min="p.Min" Max="p.Max" Step="@(p.Step ?? 1)"
                                Value="@(Ctx.Form.Get<double>(name))"
                                ValueChanged="@(v => { Ctx.Form.Set(name, v); FormScope?.Clear(name); })" />
                    @RequiredHint(name)
                    break;
                }

                case "toggle":
                {
                    var p = Props<ToggleNodeProps>();
                    var name = p!.Name!;
                    <DrylToggle Label="@p.Label"
                                Value="@(Ctx.Form.Get<bool>(name))"
                                ValueChanged="@(v => { Ctx.Form.Set(name, v); FormScope?.Clear(name); })" />
                    @RequiredHint(name)
                    break;
                }

                case "button":
                {
                    var p = Props<ButtonNodeProps>();
                    var actionState = Ctx.Actions?.StateOf(Node.Id);
                    <DrylButton Variant="MapButtonVariant(p!.Kind)"
                                Loading="@(actionState?.Busy == true)"
                                OnClick="@(_ => TriggerAsync(p))">
                        @p.Label
                    </DrylButton>
                    @*  A command that failed. It stays until the next attempt — a failure asks the
                        user to react, so it must not expire the way a toast would. *@
                    <DrylPresence Visible="@(actionState?.Error is not null)"
                                  Transition="PresenceTransition.SlideUp" Speed="PresenceSpeed.Fast">
                        <span class="canvas-action-error">
                            <DrylIcon Name="Alert" Size="14" />
                            @actionState?.Error
                        </span>
                    </DrylPresence>
                    break;
                }
            }
        }

        @if (_truncated)
        {
            <span class="canvas-data-truncated">Showing the first @CanvasDataMapper.MaxTableRows rows.</span>
        }
        @if (binding is { HasValue: true, Error: { } staleError })
        {
            @*  The source failed but a good value is still on screen. "Briefly disturbed" is
                not "broken", so the value stays and this is all the user sees. *@
            <DrylTooltip Text="@staleError">
                <span class="canvas-data-flag">
                    <DrylIcon Name="Alert" Size="12" />
                    Not up to date
                </span>
            </DrylTooltip>
        }
    </div>
</DrylPresence>

@code {
    /// <summary>The node to render. Its <see cref="CanvasNode.Type"/> selects the mapped component.</summary>
    [Parameter, EditorRequired] public CanvasNode Node { get; set; } = default!;

    /// <summary>Everything this canvas shares with its nodes (form state, pulse tracker,
    /// data binder, intent callback) — one <c>IsFixed</c> cascade from <c>DrylCanvas</c>.</summary>
    [CascadingParameter] internal CanvasContext Ctx { get; set; } = default!;

    /// <summary>Supplied by an enclosing <c>form</c> node's view: which required fields failed
    /// the last submit. Null outside a form — the hint then never renders.</summary>
    [CascadingParameter] internal CanvasFormScope? FormScope { get; set; }

    private CanvasNode? _seededNode;

    // Parse + validate only on mutation: the patcher/reveal layers bump
    // CanvasNode.Version on every successful change (own props or children list),
    // so an unchanged stamp means both memos are still valid.
    private int _memoVersion = -1;
    private CanvasNode? _memoNode;
    private string? _memoError;
    private Type? _memoPropsType;
    private object? _memoProps;

    // The binding's live state, refreshed on every parameter set. Null for an unbound node,
    // which is the overwhelmingly common case and costs nothing.
    private CanvasBindingState? _bindingState;
    private CanvasData? _memoData;          // the data the effective props were built from
    private JsonElement? _effectiveProps;   // node props with the bound shape's props overwritten
    private string? _mapError;
    private bool _truncated;

    private void EnsureMemo()
    {
        // Identity AND stamp: Blazor reuses this view for a different node instance
        // (whole-tree replacement recycles ids), so the stamp alone is not a safe key.
        // The bound data is part of the key too — a refresh changes the props without
        // touching the node.
        if (ReferenceEquals(_memoNode, Node) && _memoVersion == Node.Version &&
            ReferenceEquals(_memoData, _bindingState?.Data))
            return;

        _memoNode = Node;
        _memoVersion = Node.Version;
        _memoData = _bindingState?.Data;
        _memoProps = null;
        _memoPropsType = null;
        _truncated = false;
        _mapError = null;

        _effectiveProps = Node.Props;
        if (_memoData is { } data)
            _effectiveProps = CanvasDataMapper.Apply(Node.Type, Node.Props, data, out _mapError, out _truncated);

        // Validate what will actually be rendered. A bound chart legitimately has no "labels"
        // in the spec — that is the whole point of binding — so validating the authored props
        // would reject exactly the artifacts data binding exists to enable.
        // The stand-in must carry Data and Action too: a button's validity depends on its action
        // (a bound button needs no intent), and dropping them silently fails the node.
        var subject = _memoData is null
            ? Node
            : new CanvasNode
            {
                Id = Node.Id, Type = Node.Type, Props = _effectiveProps,
                Children = Node.Children, Data = Node.Data, Action = Node.Action,
            };

        // A shape that cannot fill this node type is a data problem, not a props problem —
        // say so where the node is, in the same quiet placeholder the catalog uses.
        _memoError = _mapError ?? CanvasCatalog.Validate(subject);
    }

    // Registering on every parameter set is what makes a $field change re-key the binding:
    // the binder resolves the params again and moves the node onto the new key if it moved.
    private void SyncBinding()
    {
        var binder = Ctx.Binder;
        if (binder is null) return;

        if (Node.Data is { Source: not null } binding) binder.Register(Node.Id, binding);
        else if (_bindingState is not null) binder.Unregister(Node.Id);

        _bindingState = binder.StateOf(Node.Id);
    }

    private static DrylSkeleton.SkeletonVariant SkeletonFor(string type) => type switch
    {
        "lineChart" or "areaChart" or "barChart" or "donutChart" or "table"
            or "dataGrid" or "list" or "keyValue" or "image" or "code" or "accordion" =>
            DrylSkeleton.SkeletonVariant.Card,
        _ => DrylSkeleton.SkeletonVariant.Text,
    };

    private int _pulseTick;  // last change stamp we have seen for this node
    private int _pulseKey;   // bumped on every new stamp — re-keys the pulse overlay

    protected override void OnParametersSet()
    {
        SyncBinding();
        SeedFormOnce();
        SeedAccordionOnce();
        SyncFormScope();
        SyncPulse();
    }

    /// <summary>A node that leaves the tree must not keep its key alive in the binder.</summary>
    public void Dispose()
    {
        Ctx?.Binder?.Unregister(Node.Id);
        if (_subscribedScope is not null) _subscribedScope.OnChanged -= OnFormScopeChanged;
    }

    // ───── dataGrid ─────

    // Props<T> returns the same parsed object per node version, so keying the row list off that
    // reference keeps the Items reference stable across renders — DrylTable's itemsChanged logic
    // (and A8's "refresh pulses instead of rebuilding") depends on it.
    private object? _gridPropsRef;
    private IReadOnlyList<CanvasGridRow> _gridRows = [];

    private IReadOnlyList<CanvasGridRow> GridRows(DataGridNodeProps p)
    {
        if (ReferenceEquals(_gridPropsRef, p)) return _gridRows;
        _gridPropsRef = p;
        _gridRows = (p.Rows ?? []).Select((cells, i) => new CanvasGridRow(i, cells)).ToList();
        return _gridRows;
    }

    // ───── accordion ─────

    // Which sections are open — renderer-local UI state like the active tab, seeded once per
    // node INSTANCE (same reuse trap as _seededNode) from the "open" prop.
    private readonly HashSet<int> _openSections = new();
    private CanvasNode? _seededAccordion;

    private void ToggleSection(int index, bool open)
    {
        if (open) _openSections.Add(index);
        else _openSections.Remove(index);
    }

    private void SeedAccordionOnce()
    {
        if (Node.Type != "accordion" || ReferenceEquals(_seededAccordion, Node)) return;
        _seededAccordion = Node;
        _openSections.Clear();
        if (Props<AccordionNodeProps>() is { Open: { } open }) _openSections.Add(open);
    }

    // ───── form ─────

    private readonly CanvasFormScope _formScope = new();
    private CanvasFormScope? _subscribedScope;

    // A required hint only re-renders this field's view if it hears the form's submit —
    // the cascade is fixed, so the event is the signal.
    private void SyncFormScope()
    {
        if (ReferenceEquals(_subscribedScope, FormScope)) return;
        if (_subscribedScope is not null) _subscribedScope.OnChanged -= OnFormScopeChanged;
        _subscribedScope = FormScope;
        if (_subscribedScope is not null) _subscribedScope.OnChanged += OnFormScopeChanged;
    }

    private void OnFormScopeChanged() => InvokeAsync(StateHasChanged);

    // Missing = a required field whose value is null or a whitespace-only string.
    private async Task SubmitFormAsync(FormNodeProps p)
    {
        var missing = (p.Required ?? new List<string>())
            .Where(name => Ctx.Form.Get(name) is var v
                && (v is null || (v is string s && string.IsNullOrWhiteSpace(s))))
            .ToList();
        _formScope.SetMissing(missing);
        if (missing.Count > 0) return;

        if (Node.Action is { Name.Length: > 0 } action && Ctx.Actions is { } runner)
            await runner.InvokeAsync(Node.Id, p.SubmitLabel, action);
    }

    private RenderFragment RequiredHint(string name) => __builder =>
    {
        if (FormScope is null) return;
        <DrylPresence Visible="@FormScope.IsMissing(name)"
                      Transition="PresenceTransition.SlideUp" Speed="PresenceSpeed.Fast">
            <span class="canvas-field-required">
                <DrylIcon Name="Alert" Size="12" />
                Required
            </span>
        </DrylPresence>
    };

    // The run stamps a node on every applied setProps. A stamp we have not seen yet means
    // the content just changed underneath us — replay the pulse. Stamps are per-node and
    // monotonic, so repeated patches of the same node each get their own pulse, and a
    // fresh artifact (which clears them) never inherits a phantom one.
    private void SyncPulse()
    {
        var tick = Ctx.Pulse.TickOf(Node.Id);
        if (tick == _pulseTick) return;
        _pulseTick = tick;
        if (tick > 0) _pulseKey++;
    }

    // Interactive nodes seed their form value from the node's `value` prop, and only when
    // the field has no value yet — so a later re-render (or a patch to an unrelated prop)
    // never clobbers what the user has typed.
    // Seed once per node INSTANCE: Blazor reuses this view across whole-tree
    // replacements (same trap as the memo identity check), so a bool flag would
    // suppress seeding for a new artifact's node with a recycled id.
    private void SeedFormOnce()
    {
        if (ReferenceEquals(_seededNode, Node)) return;
        _seededNode = Node;
        if (!CanvasCatalog.IsInteractive(Node.Type)) return;

        switch (Node.Type)
        {
            case "inputText":
                if (Props<InputTextNodeProps>() is { Name: { } tn, Value: { } tv }) Seed(tn, tv);
                break;
            case "select":
                if (Props<SelectNodeProps>() is { Name: { } sn, Value: { } sv }) Seed(sn, sv);
                break;
            case "slider":
                if (Props<SliderNodeProps>() is { Name: { } rn, Value: { } rv }) Seed(rn, rv);
                break;
            case "toggle":
                if (Props<ToggleNodeProps>() is { Name: { } gn, Value: { } gv }) Seed(gn, gv);
                break;
        }
    }

    private void Seed(string name, object value)
    {
        if (Ctx.Form.Get(name) is null) Ctx.Form.Set(name, value);
    }

    // Two ways out of a button, and the choice is deliberate. A registered action is a host
    // command — it runs C#, not a chat turn. Everything else keeps the original behaviour, so a
    // host that registered no action at all sees exactly what it saw before.
    private async Task TriggerAsync(ButtonNodeProps p)
    {
        if (Node.Action is { Name: { Length: > 0 } } action && Ctx.Actions is { } runner)
        {
            await runner.InvokeAsync(Node.Id, p.Label, action);
            return;
        }

        if (!string.IsNullOrWhiteSpace(p.Intent)) await RaiseIntent(p.Intent!);
    }

    private async Task RaiseIntent(string intent) =>
        await Ctx.Intent.InvokeAsync(new CanvasInteraction(intent, Node.Id, Ctx.Form.Snapshot()));

    private Task PurgeSelf() => Ctx.Purge?.Invoke(Node.Id) ?? Task.CompletedTask;

    private RenderFragment RenderChildren => builder =>
    {
        var i = 0;
        foreach (var child in Node.Children ?? Enumerable.Empty<CanvasNode>())
        {
            builder.OpenComponent<CanvasNodeView>(i++);
            builder.SetKey(child.Id);
            builder.AddComponentParameter(1, nameof(Node), child);
            builder.CloseComponent();
        }
    };

    private T? Props<T>() where T : class
    {
        EnsureMemo();
        if (_memoPropsType == typeof(T)) return (T?)_memoProps;

        // The effective props: a bound node reads the data source's result, an unbound one its
        // own authored props. Either way this is the single place the props text comes from.
        var json = _effectiveProps is { } p && p.ValueKind is not (JsonValueKind.Null or JsonValueKind.Undefined)
            ? p.GetRawText()
            : "{}";
        CanvasJson.TryParse<T>(json, out var value);
        _memoProps = value;
        _memoPropsType = typeof(T);
        return value;
    }

