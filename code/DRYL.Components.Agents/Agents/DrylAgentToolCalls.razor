@namespace DRYL.Components.Agents
@implements IDisposable

@*  Thin wrapper: collapses the agent run's tool calls into a single quiet,
    gently-pulsing DrylToolCallGroup summary that expands to the individual
    DrylToolCall cards. Summary data (count, active tool, overall state, error,
    pending approvals) is derived from the run and handed to the group explicitly.
    Calls awaiting approval get their Approve / Deny pair wired to the run. *@

@if (Run is not null)
{
    var visible = Visible.ToList();
    if (visible.Count > 0)
    {
        var active = visible.FirstOrDefault(t => t.State is AiState.Thinking or AiState.Streaming);
        var pending = visible.Count(t => t.Approval == DrylToolApproval.Pending);

        <DrylToolCallGroup Count="visible.Count"
                           ActiveLabel="@active?.ToolName"
                           Ai="@(active?.State ?? (pending > 0 ? AiState.Proposed : AiState.None))"
                           HasError="@visible.Any(t => !string.IsNullOrEmpty(t.Error))"
                           PendingCount="pending"
                           OnApproveAll="ApproveAll"
                           OnDenyAll="DenyAll"
                           ApproveAllLabel="@ApproveAllLabel"
                           DenyAllLabel="@DenyAllLabel">
            @foreach (var t in visible)
            {
                <DrylToolCall @key="t.CallId"
                              ToolName="@t.ToolName"
                              Arguments="@t.Arguments"
                              Result="@t.Result"
                              Error="@t.Error"
                              Ai="@t.State"
                              Declined="@(t.Approval == DrylToolApproval.Declined)"
                              OnApprove="@(() => Run!.Approve(t.CallId))"
                              OnDeny="@(() => Run!.Deny(t.CallId))"
                              ApproveLabel="@ApproveLabel"
                              DenyLabel="@DenyLabel" />
            }
        </DrylToolCallGroup>
    }
}

@code {
    /// <summary>The agent run whose tool calls to visualise.</summary>
    [Parameter] public DrylRunBase? Run { get; set; }

    /// <summary>When true, render only the calls running or awaiting approval; otherwise the full trace (default).</summary>
    [Parameter] public bool ActiveOnly { get; set; }

    /// <summary>Visible text of each card's Approve button. Default "Approve".</summary>
    [Parameter] public string ApproveLabel { get; set; } = "Approve";

    /// <summary>Visible text of each card's Deny button. Default "Deny".</summary>
    [Parameter] public string DenyLabel { get; set; } = "Deny";

    /// <summary>Visible text of the group's Approve all button. Default "Approve all".</summary>
    [Parameter] public string ApproveAllLabel { get; set; } = "Approve all";

    /// <summary>Visible text of the group's Deny all button. Default "Deny all".</summary>
    [Parameter] public string DenyAllLabel { get; set; } = "Deny all";

    private DrylRunBase? _subscribed;

    private IEnumerable<DrylToolInvocation> Visible =>
        Run is null ? Enumerable.Empty<DrylToolInvocation>()
        : ActiveOnly ? Run.ToolCalls.Where(t => t.State is AiState.Thinking or AiState.Proposed)
        : Run.ToolCalls;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Run)) return;
        if (_subscribed is not null) _subscribed.OnChange -= HandleChange;
        _subscribed = Run;
        if (_subscribed is not null) _subscribed.OnChange += HandleChange;
    }

    private void HandleChange() => InvokeAsync(StateHasChanged);

    // Snapshot first: each decision changes the pending list it would be iterating.
    private void ApproveAll()
    {
        foreach (var t in Run?.PendingApprovals ?? []) Run!.Approve(t.CallId);
    }

    private void DenyAll()
    {
        foreach (var t in Run?.PendingApprovals ?? []) Run!.Deny(t.CallId);
    }

    public void Dispose()
    {
        if (_subscribed is not null) _subscribed.OnChange -= HandleChange;
    }
}
