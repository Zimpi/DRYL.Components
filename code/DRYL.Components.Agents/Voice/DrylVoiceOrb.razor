@namespace DRYL.Components.Agents
@using DRYL.Components.Ai
@inject IJSRuntime JS
@implements IAsyncDisposable

@*  ─────────────────────────────────────────────────────────
    DrylVoiceOrb — a voice, made visible.

    Nothing here is new: it is the shared .ai-aura vocabulary bent into a
    circle, composed from AuraLifecycle, AiAuraCss and DrylAuraElements like
    every other AI surface. A listening assistant reads the same here as
    anywhere else, the aura leaves gracefully, and an orb without a working
    session is the glass sphere alone.

    The level is the one thing the orb owns, and it never touches .NET: the
    JS module writes --voice-level straight onto this element and the CSS
    turns it into a scale. A level shipped over interop would re-render the
    circuit sixty times a second for a decoration.

    Usage:
      <DrylVoiceOrb Run="_voice" />
    ───────────────────────────────────────────────────────── *@

<div class="@RootCssClass"
     style="@FormattableString.Invariant($"--orb-size: {Size}px")"
     @ref="_el"
     aria-hidden="true">
    <DrylAuraElements Aura="_aura" GenTick="_genTick" />
    <div class="voice-orb-core"></div>
</div>

@code {
    /// <summary>The session the orb reflects. Without it the orb sits still.</summary>
    [Parameter] public DrylVoiceRun? Run { get; set; }

    /// <summary>Diameter in pixels. Default 96.</summary>
    [Parameter] public int Size { get; set; } = 96;

    /// <summary>Extra CSS class(es) merged onto the orb.</summary>
    [Parameter] public string? Class { get; set; }

    private const string ModulePath = "./_content/DRYL.Components.Agents/js/dryl-voice.js";

    private DrylVoiceRun? _subscribed;
    private ElementReference _el;
    private IJSObjectReference? _module;
    private bool _attached;

    private readonly AuraLifecycle _aura = new();
    private AiState _lastState = AiState.None;
    private int _genTick;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribed, Run))
        {
            if (_subscribed is not null) _subscribed.OnChange -= HandleChange;
            _subscribed = Run;
            if (_subscribed is not null) _subscribed.OnChange += HandleChange;
        }

        SyncAura();
    }

    // The run changes off the render thread; the lifecycle is only touched on it.
    private void HandleChange() => InvokeAsync(() =>
    {
        SyncAura();
        StateHasChanged();
    });

    private void SyncAura()
    {
        var state = Run?.State ?? AiState.None;
        if (state == AiState.Generated && _lastState != AiState.Generated) _genTick++;
        _lastState = state;
        _aura.Sync(state, () => InvokeAsync(StateHasChanged));
    }

    private string RootCssClass
    {
        get
        {
            var parts = new List<string> { "voice-orb" };
            AiAuraCss.Append(parts, _aura, AiAura.Comet);

            // Muted: the aura steps back and only the core keeps answering — the model's voice.
            if (Run?.IsMuted == true) parts.Add("voice-orb--muted");

            if (!string.IsNullOrWhiteSpace(Class)) parts.Add(Class!);
            return string.Join(' ', parts);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Pointing the meter at the orb is one-time wiring, not a per-frame call.
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _attached = true;
            await _module.InvokeVoidAsync("attachOrb", _el);
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
        catch (InvalidOperationException) { /* prerender — no JS */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscribed is not null) _subscribed.OnChange -= HandleChange;
        _aura.Dispose();

        if (!_attached || _module is null) return;

        try
        {
            await _module.InvokeVoidAsync("attachOrb", (object?)null);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
        catch (JSException) { /* already torn down */ }
    }
}
