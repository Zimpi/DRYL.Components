@namespace DRYL.Components.Dialogs
@using DRYL.Components

@*  Internal dialog used by IDrylDialogService.ShowAlertAsync. *@

<DrylDialog>
    <ChildContent>
        <p style="margin: 0; color: var(--fg-muted);">@Message</p>
    </ChildContent>
    <ActionContent>
        <DrylButton Variant="DrylButton.ButtonVariant.Primary" @onclick="Ok">
            @OkLabel
        </DrylButton>
    </ActionContent>
</DrylDialog>

@code {
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string OkLabel { get; set; } = "OK";

    [CascadingParameter] public IDrylDialogInstance Instance { get; set; } = default!;

    private void Ok() => Instance.Close(DialogResult.Ok());
}
