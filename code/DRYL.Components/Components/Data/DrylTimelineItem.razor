@namespace DRYL.Components
@implements IDisposable

@*  ─────────────────────────────────────────────────────────
    DrylTimelineItem — a single event inside a DrylTimeline.

    Renders a marker on the rail plus a title / timestamp / body.
    Variant tints the marker; the shared Ai state wraps the marker
    in the gradient aura (e.g. a tool call in flight).

    With OnClick the item becomes a step you can jump to: a native
    button stretched over the whole row (valid HTML, one tab stop,
    Enter/Space for free), Active marks the chosen one.

      <DrylTimeline AriaLabel="Route">
          @for (var i = 0; i < _stops.Count; i++)
          {
              var n = i;
              <DrylTimelineItem Number="n + 1" Title="@_stops[n]"
                                Active="n == _current" OnClick="() => _current = n" />
          }
      </DrylTimeline>
    ───────────────────────────────────────────────────────── *@

<div class="@RootCssClass" role="listitem"
     aria-current="@(Active && !Interactive ? "step" : null)"
     @attributes="AdditionalAttributes">
    <div class="timeline-gutter">
        <div class="@MarkerCssClass">
            <DrylAuraElements Aura="_aura" GenTick="_genTick" />
            @if (MarkerContent is not null)
            {
                <span class="timeline-marker-content">@MarkerContent</span>
            }
            else if (Number is { } number)
            {
                <span class="timeline-number">@number.ToString(System.Globalization.CultureInfo.InvariantCulture)</span>
            }
            else if (!string.IsNullOrEmpty(Icon))
            {
                <DrylIcon Name="@Icon" Size="13" />
            }
            else
            {
                <span class="timeline-dot"></span>
            }
        </div>
        <div class="timeline-line"></div>
    </div>

    <div class="timeline-body">
        @if (!string.IsNullOrEmpty(Title) || !string.IsNullOrEmpty(Timestamp))
        {
            <div class="timeline-head">
                @if (!string.IsNullOrEmpty(Title))
                {
                    <span class="timeline-title">@Title</span>
                }
                @if (!string.IsNullOrEmpty(Timestamp))
                {
                    <span class="timeline-time">@Timestamp</span>
                }
            </div>
        }
        @if (ChildContent is not null)
        {
            <div class="timeline-content">@ChildContent</div>
        }
    </div>

    @if (Interactive)
    {
        @*  Last in the row so it paints over the marker and the text: the whole item is the
            target, while the button itself carries the name and the current-step state. *@
        <button type="button"
                class="timeline-hit"
                aria-label="@(AriaLabel ?? Title)"
                aria-current="@(Active ? "step" : null)"
                disabled="@Disabled"
                @onclick="OnClick"></button>
    }
</div>

@code {
    /// <summary>Title line for the event.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Optional pre-formatted timestamp.</summary>
    [Parameter] public string? Timestamp { get; set; }

    /// <summary>Optional marker icon. When omitted, a dot is shown.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>A number in the marker — the step's position in a sequence. Wins over
    /// <see cref="Icon"/>.</summary>
    [Parameter] public int? Number { get; set; }

    /// <summary>Free content for the marker, e.g. a letter or a tiny avatar. Wins over
    /// <see cref="Number"/> and <see cref="Icon"/>.</summary>
    [Parameter] public RenderFragment? MarkerContent { get; set; }

    /// <summary>Makes the item a step the user can jump to: the whole row becomes one native
    /// button. Without a delegate the item stays static, exactly as before.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Marks the item as the current step: highlighted marker and
    /// <c>aria-current="step"</c>.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Disables the item's button when <see cref="OnClick"/> is set.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible name of the item's button. Leave <c>null</c> to use
    /// <see cref="Title"/>; set it when the item has no title.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Marker colour treatment.</summary>
    [Parameter] public TimelineVariant Variant { get; set; } = TimelineVariant.Default;

    /// <summary>Body content for the event.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>AI ambient state — wraps the marker in the gradient aura.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>AI aura variant. Leave <c>null</c> to inherit a surrounding <c>DrylAiScope</c> (ultimately <see cref="AiAura.Comet"/>).</summary>
    [Parameter] public AiAura? Aura { get; set; }

    /// <summary>Surrounding AI scope (supplied by <c>DrylAiScope</c>); used to resolve the aura variant.</summary>
    [CascadingParameter] private AiScope? Scope { get; set; }

    private AiAura EffectiveAura => AiScope.ResolveAura(Aura, Scope);

    /// <summary>Pass-through HTML attributes on the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Extra CSS class(es) merged onto the item's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly AuraLifecycle _aura = new();

    protected override void OnParametersSet()
    {
        if (Ai == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = Ai;
        _aura.Sync(Ai, () => InvokeAsync(StateHasChanged));
    }

    public void Dispose() => _aura.Dispose();

    private bool Interactive => OnClick.HasDelegate;

    private string RootCssClass
    {
        get
        {
            var parts = new List<string> { "timeline-item" };
            if (Interactive) parts.Add("is-interactive");
            if (Active) parts.Add("is-active");
            if (Disabled) parts.Add("is-disabled");
            if (!string.IsNullOrWhiteSpace(Class)) parts.Add(Class!);
            return string.Join(' ', parts);
        }
    }

    private string MarkerCssClass
    {
        get
        {
            var parts = new List<string> { "timeline-marker" };
            parts.Add(Variant switch
            {
                TimelineVariant.Accent  => "timeline-marker--accent",
                TimelineVariant.Success => "timeline-marker--success",
                TimelineVariant.Warning => "timeline-marker--warning",
                TimelineVariant.Danger  => "timeline-marker--danger",
                _ => "timeline-marker--default"
            });
            AiAuraCss.Append(parts, _aura, EffectiveAura);
            return string.Join(' ', parts);
        }
    }
}
