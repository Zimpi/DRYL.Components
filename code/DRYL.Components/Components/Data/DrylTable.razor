    // ───── Selection helpers ─────

    private async Task ClearSelection()
    {
        if (_selected.Count == 0) return;
        _selected.Clear();
        await SelectedItemsChanged.InvokeAsync(new HashSet<TItem>());
    }

    // ───── Pipeline ─────

    private async Task RebuildViewAsync()
    {
        if (DataProvider is not null)
        {
            await LoadFromProviderAsync();
            return;
        }

        var items = Items ?? [];
        var filtered = items.Where(MatchesSearch).Where(MatchesFilters);
        var sorted = ApplySort(filtered, _columns, _sort);
        var materialized = sorted as IList<TItem> ?? sorted.ToList();
        _filteredCount = materialized.Count;

        if (_pageSize > 0 && !Virtualize)
        {
            var maxPage = Math.Max(0, (int)Math.Ceiling((double)_filteredCount / _pageSize) - 1);
            if (_page > maxPage) _page = maxPage;
            _view = materialized.Skip(_page * _pageSize).Take(_pageSize).ToList();
        }
        else
        {
            _view = materialized is List<TItem> lst ? lst : materialized.ToList();
        }
    }

    private async Task LoadFromProviderAsync()
    {
        if (DataProvider is null) return;

        _dataProviderCts?.Cancel();
        _dataProviderCts = new CancellationTokenSource();
        var token = _dataProviderCts.Token;

        _serverLoading = true;
        StateHasChanged();

        try
        {
            var skip = _pageSize > 0 && !Virtualize ? _page * _pageSize : 0;
            var take = _pageSize > 0 && !Virtualize ? _pageSize : int.MaxValue;
            var request = new DataRequest(
                Skip: skip,
                Take: take,
                SearchText: _appliedSearch,
                Sort: _sort.ToArray(),
                Filters: _filters.Values.ToArray());

            var result = await DataProvider(request, token);
            if (token.IsCancellationRequested) return;

            _view = result.Items.ToList();
            _filteredCount = result.TotalCount;
        }
        catch (OperationCanceledException) { /* superseded */ }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _serverLoading = false;
                StateHasChanged();
            }
        }
    }

    // ───── Rendering helpers ─────

    private string HeaderCssClass(DrylColumn<TItem> col)
    {
        var classes = new List<string>();
        if (col.Sortable) classes.Add("tbl-th-sort");
        if (col.Filterable) classes.Add("tbl-th-filterable");
        if (col.Pinned == ColumnPin.Start) classes.Add("tbl-pin tbl-pin-start");
        else if (col.Pinned == ColumnPin.End) classes.Add("tbl-pin tbl-pin-end");
        if (_colDragKey == col.Key) classes.Add("tbl-th--col-dragging");
        else if (_colDragOverKey == col.Key) classes.Add("tbl-th--col-drop-target");
        if (col.Align != ColumnAlign.Start) classes.Add($"tbl-align-{col.Align.ToString().ToLowerInvariant()}");
        return string.Join(' ', classes);
    }

    private string? EffectiveWidth(DrylColumn<TItem> col) =>
        _columnWidths.TryGetValue(col.Key, out var w) ? w : col.Width;

    private string? HeaderStyle(DrylColumn<TItem> col)
    {
        var width = EffectiveWidth(col);
        return string.IsNullOrEmpty(width) ? null : $"width: {width}";
    }

    private string CellCssClass(DrylColumn<TItem> col, bool editing = false)
    {
        var classes = new List<string>();
        if (col.Primary) classes.Add("tbl-td-primary");
        if (editing) classes.Add("tbl-td-editing");
        if (col.Pinned == ColumnPin.Start) classes.Add("tbl-pin tbl-pin-start");
        else if (col.Pinned == ColumnPin.End) classes.Add("tbl-pin tbl-pin-end");
        if (col.Align != ColumnAlign.Start) classes.Add($"tbl-align-{col.Align.ToString().ToLowerInvariant()}");
        return string.Join(' ', classes);
    }

    private string? CellStyle(DrylColumn<TItem> col)
    {
        var parts = new List<string>();
        var width = EffectiveWidth(col);
        if (!string.IsNullOrEmpty(width)) parts.Add($"width: {width}");
        if (col.Align != ColumnAlign.Start) parts.Add($"text-align: {col.TextAlign}");
        return parts.Count == 0 ? null : string.Join("; ", parts);
    }

    private bool ShowAiEnter(TItem item) =>
        (Ai == AiState.Streaming || Ai == AiState.Generated) && !_seenItems.Contains(item);

    // True when the incoming Items carry at least one row we haven't rendered yet —
    // the signal that a streaming insert is worth morphing. Compared against the
    // last-rendered set (_seenItems, refreshed in OnAfterRenderAsync), so a re-handed
    // reference with unchanged content reports false and skips the transition.
    private bool HasNewRows() =>
        Items is not null && Items.Any(i => !_seenItems.Contains(i));

    private string RowCssClass(TItem item, int rowIndex)
    {
        var classes = new List<string>();
        if (_selected.Contains(item)) classes.Add("tbl-row--selected");
        if (IsEditingRow(item)) classes.Add("tbl-row--editing");
        if (ShowAiEnter(item)) classes.Add("tbl-row--ai-enter");
        if (ReorderColumnVisible && rowIndex >= 0)
        {
            if (_dragIndex == rowIndex) classes.Add("tbl-row--dragging");
            else if (_dragOverIndex == rowIndex) classes.Add("tbl-row--drop-target");
        }
        return classes.Count == 0 ? string.Empty : string.Join(' ', classes);
    }

    private async Task ToggleRow(TItem item)
    {
        if (!_selected.Remove(item))
            _selected.Add(item);
        await SelectedItemsChanged.InvokeAsync(new HashSet<TItem>(_selected));
    }

    private async Task ToggleAll(ChangeEventArgs e)
    {
        if (e.Value is true)
            foreach (var item in _view) _selected.Add(item);
        else
            foreach (var item in _view) _selected.Remove(item);

        await SelectedItemsChanged.InvokeAsync(new HashSet<TItem>(_selected));
    }

    private Task HandleRowClick(TItem item) =>
        OnRowClick.InvokeAsync(item);

    // ───── Row reorder ─────

    private string GripAriaLabel(int index)
    {
        var position = index + 1;
        return _view.Count > 0
            ? $"Reorder row {position} of {_view.Count}. Press Alt plus Arrow Up or Arrow Down to move."
            : "Reorder row.";
    }

    private void OnDragStart(int index)
    {
        if (!CanReorderNow) return;
        _dragIndex = index;
        _dragOverIndex = index;
    }

    private void OnDragEnter(int index)
    {
        if (_dragIndex is null || !CanReorderNow) return;
        _dragOverIndex = index;
    }

    private async Task OnDrop(int index)
    {
        // Clear the drag-highlight state before the morph so the drop-target
        // classes don't linger through the glide.
        var from = _dragIndex;
        _dragIndex = null;
        _dragOverIndex = null;
        if (from is int f)
            await MoveRow(f, index);
    }

    private void OnDragEnd()
    {
        _dragIndex = null;
        _dragOverIndex = null;
    }

    private async Task OnGripKeyDown(KeyboardEventArgs e, int index)
    {
        if (!CanReorderNow || !e.AltKey) return;
        var target = e.Key switch
        {
            "ArrowUp" => index - 1,
            "ArrowDown" => index + 1,
            _ => index
        };
        if (target == index || target < 0 || target >= _view.Count) return;
        await MoveRow(index, target);
        _pendingFocusGrip = target;
    }

    // Optimistically reorders the displayed view so the move is reflected immediately
    // (morphing via a view transition when AnimateReorder is active), then raises
    // OnRowReordered so the consumer can apply the same move to its backing collection.
    private async Task MoveRow(int from, int to)
    {
        if (!CanReorderNow) return;
        if (from < 0 || from >= _view.Count) return;
        to = Math.Clamp(to, 0, _view.Count - 1);
        if (from == to) return;

        await RunRowTransitionAsync(() =>
        {
            var item = _view[from];
            _view.RemoveAt(from);
            _view.Insert(to, item);
            return Task.CompletedTask;
        });
        await OnRowReordered.InvokeAsync(new RowReorderEventArgs(from, to));
    }

    // ───── Inline editing ─────

    /// <summary>
    /// Programmatically begins editing the given row. In <see cref="TableEditMode.Cell"/> mode the
    /// first editable column is activated. No-op when editing is disabled or the row has no
    /// editable columns.
    /// </summary>
    public void BeginEdit(TItem item)
    {
        if (!EditingEnabled || !HasEditableColumns) return;
        if (EditMode == TableEditMode.Cell)
        {
            var first = VisibleColumns.FirstOrDefault(c => c.IsEditable);
            if (first is null) return;
            StartEdit(item, first.Key);
        }
        else
        {
            StartEdit(item, null);
        }
    }

    /// <summary>
    /// Programmatically begins editing a single cell, identified by its column key. Honoured only
    /// when the table is in <see cref="TableEditMode.Cell"/> mode and the column is editable.
    /// </summary>
    public void BeginEditCell(TItem item, string columnKey)
    {
        if (!EditingEnabled) return;
        var col = _columns.FirstOrDefault(c => c.Key == columnKey);
        if (col is null || !col.IsEditable) return;
        StartEdit(item, EditMode == TableEditMode.Cell ? columnKey : null);
    }

    private void StartEdit(TItem item, string? columnKey)
    {
        _editingItem = item;
        _editingColumnKey = columnKey;
        _editBuffer = CloneRow is not null ? CloneRow(item) : item;
        _pendingFocusEditor = true;
    }

    private void ClearEditState()
    {
        _editingItem = default;
        _editBuffer = default;
        _editingColumnKey = null;
    }

    private void OnCellDoubleClick(TItem item, DrylColumn<TItem> col)
    {
        if (!EditingEnabled || !col.IsEditable) return;
        // Don't restart an in-progress edit (would discard buffered changes).
        if (IsEditingRow(item)) return;
        StartEdit(item, EditMode == TableEditMode.Cell ? col.Key : null);
    }

    private async Task OnEditKeyDown(KeyboardEventArgs e, TItem item)
    {
        if (!IsEditingRow(item)) return;
        switch (e.Key)
        {
            case "Enter": await CommitEdit(); break;
            case "Escape": await CancelEdit(); break;
        }
    }

    private async Task CommitEdit()
    {
        if (_editingItem is not TItem original) return;
        var edited = _editBuffer is TItem buffer ? buffer : original;
        ClearEditState();
        await OnRowCommitted.InvokeAsync(new RowEditEventArgs<TItem>(original, edited));
    }

    private async Task CancelEdit()
    {
        if (_editingItem is not TItem original) return;
        ClearEditState();
        await OnRowCancelled.InvokeAsync(original);
    }

    // ───── Column resize / reorder / pin ─────

    private static string? PinData(DrylColumn<TItem> col) => col.Pinned switch
    {
        ColumnPin.Start => "start",
        ColumnPin.End => "end",
        _ => null
    };

    // Seed the explicit order list (lazily) with the current pin-partitioned visual order so the
    // first move has a concrete order to mutate.
    private void EnsureColumnOrder()
    {
        if (_columnOrder.Count == 0)
            foreach (var c in OrderedColumns) _columnOrder.Add(c.Key);
    }

    private void OnColDragStart(DrylColumn<TItem> col)
    {
        if (!CanReorderColumn(col)) return;
        _colDragKey = col.Key;
        _colDragOverKey = col.Key;
    }

    private void OnColDragEnter(DrylColumn<TItem> col)
    {
        if (_colDragKey is null || !CanReorderColumn(col)) return;
        _colDragOverKey = col.Key;
    }

    private async Task OnColDrop(DrylColumn<TItem> col)
    {
        if (_colDragKey is string from && CanReorderColumn(col))
            await MoveColumn(from, col.Key);
        _colDragKey = null;
        _colDragOverKey = null;
    }

    private void OnColDragEnd()
    {
        _colDragKey = null;
        _colDragOverKey = null;
    }

    // Moves the column with key fromKey to the position of toKey. Reordering is confined to a
    // single pin group (you can't drag a column out of/into the frozen edges).
    private async Task MoveColumn(string fromKey, string toKey)
    {
        if (fromKey == toKey) return;
        var fromCol = _columns.FirstOrDefault(c => c.Key == fromKey);
        var toCol = _columns.FirstOrDefault(c => c.Key == toKey);
        if (fromCol is null || toCol is null || fromCol.Pinned != toCol.Pinned) return;

        EnsureColumnOrder();
        var from = _columnOrder.IndexOf(fromKey);
        var to = _columnOrder.IndexOf(toKey);
        if (from < 0 || to < 0) return;

        _columnOrder.RemoveAt(from);
        var targetIdx = _columnOrder.IndexOf(toKey);
        var insertIdx = from < to ? targetIdx + 1 : targetIdx;
        _columnOrder.Insert(insertIdx, fromKey);

        MarkPersistDirty();
        await Task.CompletedTask;
    }

    // One-step keyboard move among the reorderable columns of the same pin group.
    private async Task MoveColumnStep(DrylColumn<TItem> col, int dir)
    {
        var group = VisibleColumns.Where(c => c.Pinned == col.Pinned && CanReorderColumn(c)).ToList();
        var idx = group.FindIndex(c => c.Key == col.Key);
        var target = idx + dir;
        if (idx < 0 || target < 0 || target >= group.Count) return;
        await MoveColumn(col.Key, group[target].Key);
    }

    /// <summary>
    /// Invoked from the resize pointer helper when the user releases a column's drag handle.
    /// Stores the new width (in px) as a runtime override and persists it.
    /// </summary>
    [JSInvokable]
    public void OnColumnResized(string key, double widthPx)
    {
        if (widthPx <= 0) return;
        _columnWidths[key] = FormattableString.Invariant($"{Math.Round(widthPx)}px");
        MarkPersistDirty();
        InvokeAsync(StateHasChanged);
    }

    // ───── State persistence ─────

    private void MarkPersistDirty()
    {
        if (!string.IsNullOrEmpty(PersistStateKey)) _persistDirty = true;
    }

    private sealed record PersistedFilter(string Key, int Op, string? Text, List<string>? In);

    private sealed record PersistedState(
        List<SortDescriptor> Sort,
        List<PersistedFilter> Filters,
        int Page,
        int PageSize,
        List<string> Hidden,
        Dictionary<string, string>? Widths = null,
        List<string>? Order = null);

    private async Task RestoreStateAsync(string key)
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("dryl.storage.get", key);
            _stateRestored = true;
            if (string.IsNullOrEmpty(json)) return;

            var state = System.Text.Json.JsonSerializer.Deserialize<PersistedState>(json);
            if (state is null) return;

            _sort.Clear();
            foreach (var s in state.Sort) _sort.Add(s);

            _filters.Clear();
            foreach (var f in state.Filters)
            {
                var op = (FilterOperator)f.Op;
                if (op == FilterOperator.Contains && f.Text is not null)
                    _filters[f.Key] = new FilterDescriptor(f.Key, op, f.Text);
                else if (op == FilterOperator.In && f.In is { Count: > 0 })
                    _filters[f.Key] = new FilterDescriptor(f.Key, op,
                        new HashSet<object?>(f.In.Cast<object?>()));
            }

            _page = state.Page;
            if (state.PageSize > 0) { _pageSize = state.PageSize; _lastSeenPageSize = state.PageSize; }

            _hiddenColumns.Clear();
            foreach (var k in state.Hidden) _hiddenColumns.Add(k);

            _columnWidths.Clear();
            if (state.Widths is not null)
                foreach (var (k, w) in state.Widths) _columnWidths[k] = w;

            _columnOrder.Clear();
            if (state.Order is { Count: > 0 })
                _columnOrder.AddRange(state.Order);

            await RebuildViewAsync();
            StateHasChanged();
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or System.Text.Json.JsonException)
        {
            // Restore is best-effort — fall back to defaults.
            _stateRestored = true;
        }
    }

    private async Task PersistStateAsync(string key)
    {
        var filters = _filters.Values.Select(d =>
        {
            string? text = null;
            List<string>? inList = null;
            if (d.Operator == FilterOperator.Contains)
                text = d.Value as string;
            else if (d.Operator == FilterOperator.In && d.Value is HashSet<object?> set)
                inList = set.Select(v => v?.ToString() ?? string.Empty).ToList();
            return new PersistedFilter(d.ColumnKey, (int)d.Operator, text, inList);
        }).ToList();

        var state = new PersistedState(
            Sort: _sort.ToList(),
            Filters: filters,
            Page: _page,
            PageSize: _pageSize,
            Hidden: _hiddenColumns.ToList(),
            Widths: _columnWidths.Count > 0 ? new Dictionary<string, string>(_columnWidths) : null,
            Order: _columnOrder.Count > 0 ? _columnOrder.ToList() : null);

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(state);
            await JS.InvokeVoidAsync("dryl.storage.set", key, json);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // Persistence is best-effort.
        }
    }

    // ───── CSV export ─────

    private const string Utf8Bom = "﻿";

    private async Task ExportCsvAsync()
    {
        var columns = VisibleColumns.ToList();
        var rows = await BuildExportRowsAsync(CancellationToken.None);
        var csv = BuildCsv(columns, rows);
        // Prepend a UTF-8 BOM so Excel opens the file with the correct encoding.
        await JS.InvokeVoidAsync("dryl.download.csv", ExportFileName, Utf8Bom + csv);
    }

    // The rows to export: search + filters + sort applied, across ALL pages.
    // In client mode this is computed in-memory. In server (DataProvider) mode we
    // issue a dedicated request with the current search/sort/filters but Skip=0 /
    // Take=int.MaxValue so the export covers the full filtered set, not just the
    // page currently in view. Backends that cannot serve an unbounded Take should
    // cap it on their side.
    private async Task<List<TItem>> BuildExportRowsAsync(CancellationToken ct)
    {
        if (DataProvider is not null)
        {
            var request = new DataRequest(
                Skip: 0,
                Take: int.MaxValue,
                SearchText: _appliedSearch,
                Sort: _sort.ToArray(),
                Filters: _filters.Values.ToArray());

            var result = await DataProvider(request, ct);
            return result.Items.ToList();
        }

        var items = Items ?? [];
        var filtered = items.Where(MatchesSearch).Where(MatchesFilters);
        var sorted = ApplySort(filtered, _columns, _sort);
        return sorted.ToList();
    }

    private string BuildCsv(List<DrylColumn<TItem>> columns, List<TItem> rows)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(',', columns.Select(c => CsvField(c.DisplayTitle))));
        foreach (var item in rows)
            sb.AppendLine(string.Join(',', columns.Select(c => CsvField(FormatExportValue(c.GetValue(item))))));
        return sb.ToString();
    }

    // Numbers and dates are formatted with InvariantCulture so the CSV is stable
    // regardless of the server's locale (e.g. German "0,5" → "0.5").
    private static string FormatExportValue(object? value) => value switch
    {
        null => string.Empty,
        System.IFormattable f => f.ToString(null, System.Globalization.CultureInfo.InvariantCulture),
        _ => value.ToString() ?? string.Empty
    };

    // RFC 4180: quote a field containing a comma, quote or line break; escape inner quotes.
    private static string CsvField(string value)
    {
        if (value.IndexOfAny([',', '"', '\n', '\r']) >= 0)
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        return value;
    }

    public async ValueTask DisposeAsync()
    {
        _aura.Dispose();
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _dataProviderCts?.Cancel();
        _dataProviderCts?.Dispose();

        if (_resizeAttached)
        {
            try { await JS.InvokeVoidAsync("dryl.table.disposeColumnResize", _rootEl); }
            catch (Microsoft.JSInterop.JSException) { /* circuit gone */ }
            catch (Microsoft.JSInterop.JSDisconnectedException) { /* circuit gone */ }
        }
        _rowTransition?.Dispose();
        _dotNetRef?.Dispose();
    }
}
