@namespace DRYL.Components
@inherits InputBase<int?>
@implements IDisposable

@*  ─────────────────────────────────────────────────────────
    DrylRating — star-based rating input.

    Usage:
      <DrylRating @bind-Value="model.Stars" Label="Rating" />

    Keyboard — while the rating group is focused:
      ArrowLeft / ArrowRight — decrease / increase by one star
      Home — set to 1 star
      End — set to maximum stars

    Set <c>ReadOnly</c> to show a static rating (e.g. in a list).
    Set <c>AllowClear</c> to false to prevent un-rating once set.
    ───────────────────────────────────────────────────────── *@

<div class="field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="field-label" id="@_labelId">@Label</label>
    }

    <div class="@WrapperCssClass">
        <DrylAuraElements Aura="_aura" GenTick="_genTick" />
        <div class="rating-group" @key="_genTick"
             role="group"
             aria-labelledby="@(!string.IsNullOrEmpty(Label) ? _labelId : null)"
             aria-label="@(string.IsNullOrEmpty(Label) ? (AriaLabel ?? "Star rating") : null)"
             @onkeydown="HandleGroupKeyDown">
            @for (int i = 1; i <= MaxStars; i++)
            {
                var idx = i;
                var filled = idx <= ActiveCount;
                <button type="button"
                        class="@(filled ? "rating-btn rating-btn--filled" : "rating-btn")"
                        tabindex="@(idx == FocusTabStop ? 0 : -1)"
                        aria-label="@($"{idx} of {MaxStars} stars")"
                        aria-pressed="@(CurrentValue == idx ? "true" : "false")"
                        disabled="@(Disabled || ReadOnly)"
                        @onclick="() => SetRating(idx)"
                        @onmouseenter="() => _hoverValue = idx"
                        @onmouseleave="() => _hoverValue = null">
                    <svg viewBox="0 0 24 24" width="22" height="22"
                         fill="@(filled ? "currentColor" : "none")"
                         stroke="currentColor"
                         stroke-width="1.75"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>
                    </svg>
                </button>
            }
        </div>
    </div>

    @if (HasValidationError)
    {
        <div class="input-helper input-helper-error">
            @string.Join(" ", EditContext!.GetValidationMessages(FieldIdentifier))
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="input-helper">@HelperText</div>
    }
</div>

@code {
    /// <summary>Optional label displayed above the stars.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Helper text shown below the stars. Replaced by validation errors when present.</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>Total number of stars. Default is 5.</summary>
    [Parameter] public int MaxStars { get; set; } = 5;

    /// <summary>When true, the rating cannot be changed by the user (display-only).</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>When true, clicking the currently selected star clears the value. Default true.</summary>
    [Parameter] public bool AllowClear { get; set; } = true;

    /// <summary>If true, the input is greyed out and non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible label — required when <c>Label</c> is not set.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>AI ambient state — controls the gradient border, glow, and reveal animation.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>AI aura variant. Leave <c>null</c> to inherit a surrounding <c>DrylAiScope</c> (ultimately <see cref="AiAura.Comet"/>).</summary>
    [Parameter] public AiAura? Aura { get; set; }

    /// <summary>Surrounding AI scope (supplied by <c>DrylAiScope</c>); used to resolve the aura variant.</summary>
    [CascadingParameter] private AiScope? Scope { get; set; }

    private AiAura EffectiveAura => AiScope.ResolveAura(Aura, Scope);

    private readonly string _labelId = $"dryl-rating-lbl-{Guid.NewGuid():N}";
    private int? _hoverValue;
    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly AuraLifecycle _aura = new();

    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        if (ValueExpression is null)
            ValueExpression = () => Value;
        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Ai == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = Ai;
        _aura.Sync(Ai, () => InvokeAsync(StateHasChanged));
    }

    public void Dispose() => _aura.Dispose();

    private int ActiveCount => _hoverValue ?? (CurrentValue ?? 0);

    private int FocusTabStop => CurrentValue ?? 1;

    private bool HasValidationError =>
        EditContext is not null && EditContext.GetValidationMessages(FieldIdentifier).Any();

    private string WrapperCssClass
    {
        get
        {
            var cls = new List<string> { "rating-wrapper" };
            AiAuraCss.Append(cls, _aura, EffectiveAura);
            return string.Join(' ', cls);
        }
    }

    private void SetRating(int stars)
    {
        if (Disabled || ReadOnly) return;
        CurrentValue = (AllowClear && CurrentValue == stars) ? null : stars;
    }

    private void HandleGroupKeyDown(KeyboardEventArgs e)
    {
        if (Disabled || ReadOnly) return;
        switch (e.Key)
        {
            case "ArrowRight":
            case "ArrowUp":
                CurrentValue = Math.Min((CurrentValue ?? 0) + 1, MaxStars);
                break;
            case "ArrowLeft":
            case "ArrowDown":
                CurrentValue = CurrentValue > 1 ? CurrentValue - 1 : (AllowClear ? null : 1);
                break;
            case "Home":
                CurrentValue = 1;
                break;
            case "End":
                CurrentValue = MaxStars;
                break;
        }
    }

    protected override bool TryParseValueFromString(
        string? value,
        out int? result,
        out string validationErrorMessage)
    {
        if (string.IsNullOrEmpty(value))
        {
            result = null;
            validationErrorMessage = string.Empty;
            return true;
        }
        if (int.TryParse(value, out var n))
        {
            result = n;
            validationErrorMessage = string.Empty;
            return true;
        }
        result = null;
        validationErrorMessage = $"The value '{value}' is not a valid rating.";
        return false;
    }
}
