@namespace DRYL.Components
@typeparam TItem where TItem : class
@inherits InputBase<TItem?>
@implements IDisposable
@inject IJSRuntime JS

@*  ─────────────────────────────────────────────────────────
    DrylAutocomplete<TItem> — combobox with client-side
    filtering or server-side async search.

    Client-side (static list):
      <DrylAutocomplete @bind-Value="_country"
                        Items="@_countries"
                        DisplayText="c => c.Name"
                        Label="Country" />

    Client-side with custom filter:
      <DrylAutocomplete @bind-Value="_country"
                        Items="@_countries"
                        SearchFunc="@((q, items) => items.Where(c => c.Name.StartsWith(q)))"
                        DisplayText="c => c.Name" />

    Server-side async:
      <DrylAutocomplete @bind-Value="_user"
                        ItemsProvider="@SearchUsersAsync"
                        DisplayText="u => u.FullName"
                        Label="Assign to" />

    Custom item template:
      <DrylAutocomplete @bind-Value="_user" ...>
          <ItemTemplate Context="user">
              <strong>@user.FullName</strong>
              <span>@user.Email</span>
          </ItemTemplate>
      </DrylAutocomplete>

    Creating entries that do not exist yet (opt-in):
      <DrylAutocomplete TItem="string" @bind-Value="_tag"
                        Items="@_tags" DisplayText="s => s"
                        OnCreate="q => Task.FromResult<string?>(q)" />

    Keyboard: ArrowDown/Up navigate options, Enter selects,
    Escape closes, Tab accepts highlighted item (if any). With
    OnCreate, Enter/Tab without a highlight — and a press outside
    the field — commit the typed query: exact match or create.
    ───────────────────────────────────────────────────────── *@

<div class="field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="field-label" for="@_id">@Label</label>
    }

    <DrylPopover @ref="_popover"
                 @bind-Open="_isOpen"
                 Block="true"
                 MatchTriggerWidth="true"
                 TriggerTogglesOpen="false"
                 Surface="false"
                 CloseOnEscape="false"
                 OnClose="HandleClosed">
        <TriggerContent>
            <div class="@WrapperCssClass">
                <DrylAuraElements Aura="_aura" GenTick="_genTick" />

                <DrylIcon Name="Search" Size="16" Class="input-icon input-icon-leading" />

                <input id="@_id"
                       type="text"
                       class="@InputCssClass"
                       value="@_inputText"
                       data-dryl-input
                       placeholder="@Placeholder"
                       disabled="@Disabled"
                       autocomplete="off"
                       autocorrect="off"
                       spellcheck="false"
                       role="combobox"
                       aria-autocomplete="list"
                       aria-expanded="@(_isOpen ? "true" : "false")"
                       aria-controls="@_listboxId"
                       aria-activedescendant="@ActiveDescendant"
                       aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)"
                       aria-invalid="@(HasValidationError ? "true" : null)"
                       aria-describedby="@(ShowHelper ? _helperId : null)"
                       @oninput="HandleInput"
                       @onkeydown="HandleKeyDown"
                       @onfocus="HandleFocus"
                       @attributes="AdditionalAttributes" />

                @if (_isLoading)
                {
                    @* Positioning classes live on a neutral span: DrylSpinner's scoped
                       .spinner-wrap rule (position:relative) would out-cascade the global
                       .input-wrapper .input-icon (position:absolute) when the scoped
                       bundle loads after dryl.css, dropping the spinner into flex flow. *@
                    <span class="input-icon input-icon-trailing">
                        <DrylSpinner Size="DrylSpinner.SpinnerSize.Small" />
                    </span>
                }
            </div>
        </TriggerContent>
        <PanelContent>
            <div id="@_listboxId"
                 role="listbox"
                 class="autocomplete-panel"
                 aria-label="@(string.IsNullOrEmpty(Label) ? "Suggestions" : $"{Label} suggestions")">

                @{
                    var items = _filteredItems;
                    var showCreate = ShowCreateOption;
                }
                @if (_isLoading && items.Count == 0)
                {
                    <div class="autocomplete-loading" aria-live="polite">
                        @LoadingText
                    </div>
                }
                else if (items.Count == 0 && !showCreate)
                {
                    <div class="autocomplete-empty" aria-live="polite">
                        @EmptyText
                    </div>
                }
                else
                {
                    for (int i = 0; i < items.Count; i++)
                    {
                        var item = items[i];
                        var idx = i;
                        var isSelected = ReferenceEquals(item, CurrentValue);

                        <div id="@OptionId(idx)"
                             role="option"
                             class="@OptionCss(idx, isSelected)"
                             aria-selected="@(isSelected ? "true" : "false")"
                             @onclick="() => SelectItem(item)"
                             @onmouseenter="() => _highlightedIndex = idx"
                             @key="idx">
                            @if (ItemTemplate != null)
                            {
                                @ItemTemplate(item)
                            }
                            else
                            {
                                @GetDisplayText(item)
                            }
                        </div>
                    }
                }

                @if (OnCreate is not null)
                {
                    @* The create option is always the last option, so its index is the
                       item count and the options above keep theirs. It fades in and out
                       rather than popping as the query starts or stops matching. *@
                    var createIdx = items.Count;
                    <DrylPresence Visible="showCreate"
                                  Transition="PresenceTransition.Fade"
                                  Speed="PresenceSpeed.Fast"
                                  Class="autocomplete-create-presence">
                        <div id="@OptionId(createIdx)"
                             role="option"
                             class="@CreateOptionCss(createIdx, items.Count > 0)"
                             aria-selected="false"
                             @onclick="CreateFromQueryAsync"
                             @onmouseenter="() => _highlightedIndex = createIdx">
                            <span class="autocomplete-create-icon" aria-hidden="true">
                                <DrylIcon Name="Plus" Size="14" />
                            </span>
                            <span class="autocomplete-create-label">@CreateOptionText</span>
                        </div>
                    </DrylPresence>
                }
            </div>
        </PanelContent>
    </DrylPopover>

    @if (HasValidationError)
    {
        <div class="input-helper input-helper-error" id="@_helperId">
            @string.Join(" ", EditContext!.GetValidationMessages(FieldIdentifier))
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="input-helper" id="@_helperId">@HelperText</div>
    }
</div>

@code {
    /// <summary>Optional label shown above the input.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder text shown when the input is empty.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Helper text shown below the input. Replaced by validation errors when present.</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>Visual state override. An active validation error overrides this.</summary>
    [Parameter] public InputState State { get; set; } = InputState.Default;

    /// <summary>If true, the input is greyed out and non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible label — required when <c>Label</c> is not set.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>AI ambient state — controls the gradient border, glow, and reveal animation.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>Surrounding AI scope (supplied by <c>DrylAiScope</c>); an explicit <see cref="Ai"/> overrides it.</summary>
    [CascadingParameter] private AiScope? AiScopeContext { get; set; }

    /// <summary>Resolved AI state: explicit <see cref="Ai"/> wins, otherwise the inherited scope.</summary>
    private AiState EffectiveAi => AiScope.Resolve(Ai, AiScopeContext);

    /// <summary>AI aura variant. Leave <c>null</c> to inherit a surrounding <c>DrylAiScope</c> (ultimately <see cref="AiAura.Comet"/>).</summary>
    [Parameter] public AiAura? Aura { get; set; }

    /// <summary>Resolved aura variant: explicit <see cref="Aura"/> wins, otherwise the inherited scope, otherwise <see cref="AiAura.Comet"/>.</summary>
    private AiAura EffectiveAura => AiScope.ResolveAura(Aura, AiScopeContext);

    /// <summary>Static item list used with client-side filtering.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Client-side filter function. Receives the query and the full <c>Items</c> list.</summary>
    [Parameter] public Func<string, IEnumerable<TItem>, IEnumerable<TItem>>? SearchFunc { get; set; }

    /// <summary>
    /// Server-side search callback. Receives the current query and a CancellationToken.
    /// Takes precedence over <c>Items</c> / <c>SearchFunc</c>.
    /// </summary>
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<TItem>>>? ItemsProvider { get; set; }

    /// <summary>Custom template for each option in the dropdown.</summary>
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>Converts an item to its display string. Defaults to <c>item.ToString()</c>.</summary>
    [Parameter] public Func<TItem, string>? DisplayText { get; set; }

    /// <summary>
    /// Enables creating an entry that does not exist yet. Receives the trimmed query and
    /// returns the new item, or <c>null</c> to abort. The returned item becomes the bound
    /// value exactly like a picked one; adding it to <see cref="Items"/> or the provider's
    /// source is the host's concern. Leave <c>null</c> (default) for a pick-only field.
    /// </summary>
    [Parameter] public Func<string, Task<TItem?>>? OnCreate { get; set; }

    /// <summary>
    /// Text of the create option, built from the trimmed query. <c>null</c> (default)
    /// renders <c>Create "{query}"</c>. Only used when <see cref="OnCreate"/> is set.
    /// </summary>
    [Parameter] public Func<string, string>? CreateLabel { get; set; }

    /// <summary>Text shown in an open list without options. Default <c>"No results"</c>.</summary>
    [Parameter] public string EmptyText { get; set; } = "No results";

    /// <summary>Text shown while a provider search runs and nothing is listed yet. Default <c>"Searching…"</c>.</summary>
    [Parameter] public string LoadingText { get; set; } = "Searching…";

    private readonly string _id       = $"dryl-ac-{Guid.NewGuid():N}";
    private readonly string _listboxId = $"dryl-ac-lb-{Guid.NewGuid():N}";
    private readonly string _helperId  = $"dryl-help-{Guid.NewGuid():N}";

    private string _inputText = string.Empty;
    private IReadOnlyList<TItem> _filteredItems = Array.Empty<TItem>();
    // The query the listed results belong to; null until a filter has finished. With an
    // ItemsProvider the list lags the input by the debounce, and a commit must know that.
    private string? _resultsQuery;
    private bool _isOpen;
    private int _highlightedIndex = -1;
    private bool _isLoading;
    private bool _creating;
    private CancellationTokenSource? _searchCts;
    private bool _disposed;

    private DrylPopover? _popover;

    private TItem? _prevValue;
    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly AuraLifecycle _aura = new();

    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        if (ValueExpression is null)
            ValueExpression = () => Value;
        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (EffectiveAi == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = EffectiveAi;
        _aura.Sync(EffectiveAi, () => InvokeAsync(StateHasChanged));

        // Sync input text when the bound value changes externally
        if (!ReferenceEquals(CurrentValue, _prevValue))
        {
            _inputText = CurrentValue is not null ? GetDisplayText(CurrentValue) : string.Empty;
            _prevValue = CurrentValue;
        }
    }

    private void HandleFocus()
    {
        if (Disabled || _isOpen) return;
        if (string.IsNullOrEmpty(_inputText)) RunFilterAsync(string.Empty);
    }

    private void HandleInput(ChangeEventArgs e)
    {
        var query = e.Value?.ToString() ?? string.Empty;
        _inputText = query;
        CurrentValue = default; // clear until user explicitly picks
        _prevValue = default;
        _isOpen = true;
        RunFilterAsync(query);
    }

    private void RunFilterAsync(string query)
    {
        // Cancel any in-flight search
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var cts = _searchCts;

        // The search itself runs off the renderer; every write to component state and every
        // render goes back through InvokeAsync so it lands on the renderer's dispatcher.
        _ = Task.Run(async () =>
        {
            try
            {
                List<TItem> results;

                if (ItemsProvider != null)
                {
                    await InvokeAsync(() =>
                    {
                        if (cts.IsCancellationRequested || _disposed) return;
                        _isLoading = true;
                        StateHasChanged();
                    });

                    // Debounce
                    await Task.Delay(300, cts.Token);

                    results = (await ItemsProvider(query, cts.Token)).ToList();
                }
                else
                {
                    var source = Items ?? Array.Empty<TItem>();
                    results = (SearchFunc != null
                        ? SearchFunc(query, source)
                        : DefaultFilter(query, source)).ToList();
                }

                await InvokeAsync(() =>
                {
                    if (cts.IsCancellationRequested || _disposed) return;
                    _isLoading = false;
                    _filteredItems = results;
                    _resultsQuery = query;
                    _highlightedIndex = -1;
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException)
            {
                // expected on fast typing
            }
            catch
            {
                await InvokeAsync(() =>
                {
                    if (cts.IsCancellationRequested || _disposed) return;
                    _isLoading = false;
                    StateHasChanged();
                });
            }
        }, cts.Token);
    }

    private void CancelSearch()
    {
        _searchCts?.Cancel();
        _isLoading = false;
    }

    private static IEnumerable<TItem> DefaultFilter(string query, IEnumerable<TItem> items)
    {
        if (string.IsNullOrEmpty(query)) return items;
        return items.Where(i =>
            (i.ToString() ?? string.Empty).Contains(query, StringComparison.OrdinalIgnoreCase));
    }

    private void SelectItem(TItem item)
    {
        CurrentValue = item;
        _prevValue = item;
        _inputText = GetDisplayText(item);
        _isOpen = false;
        _highlightedIndex = -1;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var count = OptionCount;

        switch (e.Key)
        {
            case "ArrowDown":
                if (!_isOpen)
                {
                    _isOpen = true;
                    RunFilterAsync(_inputText);
                    break;
                }
                _highlightedIndex = Math.Min(_highlightedIndex + 1, count - 1);
                await ScrollHighlightedIntoView();
                break;

            case "ArrowUp":
                _highlightedIndex = Math.Max(_highlightedIndex - 1, 0);
                await ScrollHighlightedIntoView();
                break;

            case "Enter":
                if (_isOpen && _highlightedIndex >= 0 && _highlightedIndex < count)
                    await ActivateOptionAsync(_highlightedIndex, resetOnAbort: false);
                else if (OnCreate is not null)
                    await CommitQueryAsync(resetOnAbort: false);
                break;

            case "Escape":
                _isOpen = false;
                _inputText = CurrentValue is not null ? GetDisplayText(CurrentValue) : string.Empty;
                break;

            case "Tab":
                if (_isOpen && _highlightedIndex >= 0 && _highlightedIndex < count)
                    await ActivateOptionAsync(_highlightedIndex, resetOnAbort: true);
                else if (OnCreate is not null)
                    await CommitQueryAsync(resetOnAbort: true);
                _isOpen = false;
                break;
        }
    }

    /// <summary>Picks the option at <paramref name="index"/>: an item, or the create option after the last item.</summary>
    private async Task ActivateOptionAsync(int index, bool resetOnAbort)
    {
        if (index < _filteredItems.Count)
            SelectItem(_filteredItems[index]);
        else if (ShowCreateOption)
            await CreateAsync(TrimmedQuery, resetOnAbort);
    }

    /// <summary>
    /// Called by DrylPopover when it closes on a press outside the field. With
    /// <see cref="OnCreate"/> a pending query is committed so typed text is not lost;
    /// otherwise the input text reverts to the bound value.
    /// </summary>
    private async Task HandleClosed()
    {
        if (OnCreate is not null && await CommitQueryAsync(resetOnAbort: true)) return;
        _inputText = CurrentValue is not null ? GetDisplayText(CurrentValue) : string.Empty;
    }

    /// <summary>
    /// Commits the typed query: the item whose display text matches it exactly, otherwise a
    /// new one from <see cref="OnCreate"/>. Returns whether the field now holds a value for
    /// the query. Only reached from UI events, so it runs on the renderer's dispatcher.
    /// </summary>
    private async Task<bool> CommitQueryAsync(bool resetOnAbort)
    {
        var query = TrimmedQuery;
        if (query.Length == 0 || OnCreate is null) return false;
        if (CurrentValue is not null && GetDisplayText(CurrentValue) == _inputText) return true;

        var match = await ResolveExactMatchAsync(query);
        if (match is not null)
        {
            CancelSearch();
            SelectItem(match);
            return true;
        }
        return await CreateAsync(query, resetOnAbort);
    }

    /// <summary>
    /// Finds an exact match for <paramref name="query"/>. With an ItemsProvider whose listed
    /// results belong to an older query, the provider is asked for the current one first —
    /// otherwise a fast Enter would create a duplicate of an item the list had not shown yet.
    /// </summary>
    private async Task<TItem?> ResolveExactMatchAsync(string query)
    {
        var match = FindExactMatch(query);
        if (match is not null || ItemsProvider is null || _resultsQuery == _inputText) return match;

        try
        {
            var fresh = await ItemsProvider(query, CancellationToken.None);
            return fresh.FirstOrDefault(i => IsExactMatch(i, query));
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return null;
        }
    }

    private Task CreateFromQueryAsync() => CreateAsync(TrimmedQuery, resetOnAbort: false);

    private async Task<bool> CreateAsync(string query, bool resetOnAbort)
    {
        if (OnCreate is null || query.Length == 0 || _creating) return false;

        _creating = true;
        CancelSearch();
        TItem? created;
        try
        {
            created = await OnCreate(query);
        }
        finally
        {
            _creating = false;
        }

        if (_disposed) return false;
        if (created is null)
        {
            if (resetOnAbort)
            {
                _isOpen = false;
                _inputText = CurrentValue is not null ? GetDisplayText(CurrentValue) : string.Empty;
            }
            return false;
        }

        SelectItem(created);
        return true;
    }

    private string TrimmedQuery => _inputText.Trim();

    private bool IsExactMatch(TItem item, string trimmedQuery) =>
        string.Equals(GetDisplayText(item).Trim(), trimmedQuery, StringComparison.OrdinalIgnoreCase);

    /// <summary>The first listed item — or, without a provider, the first of <see cref="Items"/> — whose display text equals the query.</summary>
    private TItem? FindExactMatch(string trimmedQuery)
    {
        foreach (var item in _filteredItems)
            if (IsExactMatch(item, trimmedQuery)) return item;

        if (ItemsProvider is null && Items is not null)
            foreach (var item in Items)
                if (IsExactMatch(item, trimmedQuery)) return item;

        return null;
    }

    /// <summary>Whether the list ends with the create option.</summary>
    private bool ShowCreateOption
    {
        get
        {
            if (OnCreate is null) return false;
            var query = TrimmedQuery;
            return query.Length > 0 && FindExactMatch(query) is null;
        }
    }

    private int OptionCount => _filteredItems.Count + (ShowCreateOption ? 1 : 0);

    private string CreateOptionText
    {
        get
        {
            var query = TrimmedQuery;
            return CreateLabel?.Invoke(query) ?? $"Create \"{query}\"";
        }
    }

    private async Task ScrollHighlightedIntoView()
    {
        if (_popover is not null)
            await JS.InvokeVoidAsync("dryl.autocomplete.scrollOptionIntoView", _popover.PanelElement, _highlightedIndex);
    }

    private string GetDisplayText(TItem item) =>
        DisplayText?.Invoke(item) ?? item.ToString() ?? string.Empty;

    private string OptionId(int idx) => $"opt-{_id}-{idx}";

    private string? ActiveDescendant =>
        _highlightedIndex >= 0 ? OptionId(_highlightedIndex) : null;

    // ── CSS helpers ────────────────────────────────────────

    private string WrapperCssClass
    {
        get
        {
            var classes = new List<string> { "input-wrapper" };
            AiAuraCss.Append(classes, _aura, EffectiveAura);
            return string.Join(' ', classes);
        }
    }

    private string InputCssClass
    {
        get
        {
            var c = "input has-leading-icon";
            if (_isLoading) c += " has-trailing-icon";
            if (HasValidationError || State == InputState.Error)   c += " input-error";
            else if (State == InputState.Success)                  c += " input-success";
            return c;
        }
    }

    private string OptionCss(int idx, bool isSelected)
    {
        var c = "autocomplete-option";
        if (idx == _highlightedIndex) c += " is-highlighted";
        if (isSelected) c += " is-selected";
        return c;
    }

    private string CreateOptionCss(int idx, bool hasItemsAbove)
    {
        var c = "autocomplete-option autocomplete-create";
        if (hasItemsAbove) c += " has-items-above";
        if (idx == _highlightedIndex) c += " is-highlighted";
        return c;
    }

    // ── Form plumbing ──────────────────────────────────────

    private bool HasValidationError =>
        EditContext is not null && EditContext.GetValidationMessages(FieldIdentifier).Any();

    private bool ShowHelper => HasValidationError || !string.IsNullOrEmpty(HelperText);

    protected override bool TryParseValueFromString(
        string? value,
        out TItem? result,
        out string validationErrorMessage)
    {
        result = default;
        validationErrorMessage = string.Empty;
        return true;
    }

    public void Dispose()
    {
        _disposed = true;
        _aura.Dispose();
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
