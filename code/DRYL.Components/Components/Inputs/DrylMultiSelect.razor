@namespace DRYL.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

@*  ─────────────────────────────────────────────────────────
    DrylMultiSelect — multi-selection dropdown.

    Built on the shared DrylPopover primitive (anchor, positioning and
    click-outside dismissal), so the listbox is portaled to <body> and
    escapes any ancestor overflow / backdrop-filter containing block —
    e.g. a glass card that would otherwise clip it.

    Usage:
      <DrylMultiSelect @bind-SelectedValues="_selected"
                       Label="Tags"
                       Items="@_tagItems"
                       Placeholder="Select tags…" />

      @code {
          private IReadOnlyList<string> _selected = [];
          private static readonly SelectItem[] _tagItems =
          [
              new("blazor",  "Blazor"),
              new("dotnet",  ".NET"),
              new("css",     "CSS"),
          ];
      }

    The panel stays open while selecting; use Escape or Tab to close.
    Keyboard: ArrowDown/Up navigate, Space/Enter toggle highlighted,
    Escape/Tab closes.
    ───────────────────────────────────────────────────────── *@

<div class="field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="field-label" for="@_triggerId">@Label</label>
    }

    <DrylPopover @ref="_popover"
                 @bind-Open="_isOpen"
                 Block="true"
                 MatchTriggerWidth="true"
                 TriggerTogglesOpen="false"
                 Surface="false"
                 CloseOnEscape="false"
                 OnClose="ResetHighlight">
        <TriggerContent>
            <div class="@WrapperCssClass">
                <DrylAuraElements Aura="_aura" GenTick="_genTick" />

                @* Trigger *@
                <div id="@_triggerId"
                     @ref="_trigger"
                     class="@TriggerCssClass"
                     tabindex="@(Disabled ? -1 : 0)"
                     role="combobox"
                     aria-haspopup="listbox"
                     aria-expanded="@(_isOpen ? "true" : "false")"
                     aria-controls="@_listboxId"
                     aria-activedescendant="@ActiveDescendant"
                     aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)"
                     aria-describedby="@(ShowHelper ? _helperId : null)"
                     @onclick="Toggle"
                     @onkeydown="HandleKeyDown">

                    @if (SelectedValues.Count == 0)
                    {
                        <span class="select-placeholder multiselect-placeholder">@(Placeholder ?? "Select options…")</span>
                    }
                    else
                    {
                        <div class="multiselect-chips">
                            @foreach (var val in VisibleChips)
                            {
                                var v = val;
                                var lbl = _items.FirstOrDefault(i => i.Value == v)?.Label ?? v;
                                <span class="chip">
                                    <span class="chip-text">@lbl</span>
                                    <button type="button" class="chip-remove"
                                            tabindex="-1"
                                            aria-label="@($"Remove {lbl}")"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => RemoveValue(v)">
                                        <DrylIcon Name="X" Size="10" />
                                    </button>
                                </span>
                            }
                            @if (OverflowCount > 0)
                            {
                                <span class="chip-overflow">+@OverflowCount</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </TriggerContent>
        <PanelContent>
            @* Listbox panel *@
            <div id="@_listboxId"
                 role="listbox"
                 class="select-panel"
                 aria-multiselectable="true"
                 aria-label="@(string.IsNullOrEmpty(Label) ? "Options" : $"{Label} options")">

                @if (_items.Count == 0)
                {
                    <div class="select-empty">No options</div>
                }
                else
                {
                    for (int i = 0; i < _items.Count; i++)
                    {
                        var item  = _items[i];
                        var idx   = i;
                        var isHl  = idx == _highlightedIndex;
                        var isSel = SelectedValues.Contains(item.Value);

                        <div id="@($"msopt-{_triggerId}-{idx}")"
                             role="option"
                             class="@OptionCss(isHl, isSel)"
                             aria-selected="@(isSel ? "true" : "false")"
                             @onclick="() => ToggleItem(item)"
                             @onmouseenter="() => _highlightedIndex = idx"
                             @onmousedown:preventDefault
                             @key="idx">
                            <input type="checkbox" class="checkbox multiselect-check"
                                   checked="@isSel"
                                   tabindex="-1"
                                   @onclick:stopPropagation="true"
                                   @onchange="() => ToggleItem(item)" />
                            <span>@item.Label</span>
                        </div>
                    }
                }
            </div>
        </PanelContent>
    </DrylPopover>

    @if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="input-helper" id="@_helperId">@HelperText</div>
    }
</div>

@code {
    /// <summary>Optional label shown above the multi-select.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder shown when nothing is selected.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Helper text shown below the control.</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>The selectable options.</summary>
    [Parameter] public IEnumerable<SelectItem>? Items { get; set; }

    /// <summary>Currently selected values.</summary>
    [Parameter] public IReadOnlyList<string> SelectedValues { get; set; } = [];

    /// <summary>Raised when the selection changes.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> SelectedValuesChanged { get; set; }

    /// <summary>Maximum number of chips shown before collapsing to "+N".</summary>
    [Parameter] public int MaxVisibleChips { get; set; } = 3;

    /// <summary>Visual state.</summary>
    [Parameter] public InputState State { get; set; } = InputState.Default;

    /// <summary>If true, the control is greyed out and non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible label — required if <c>Label</c> is not set.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>AI ambient state — controls the gradient border, glow, and reveal animation.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>AI aura variant. Leave <c>null</c> to inherit a surrounding <c>DrylAiScope</c> (ultimately <see cref="AiAura.Comet"/>).</summary>
    [Parameter] public AiAura? Aura { get; set; }

    /// <summary>Surrounding AI scope (supplied by <c>DrylAiScope</c>); used to resolve the aura variant.</summary>
    [CascadingParameter] private AiScope? Scope { get; set; }

    private AiAura EffectiveAura => AiScope.ResolveAura(Aura, Scope);

    private readonly string _triggerId = $"dryl-msel-{Guid.NewGuid():N}";
    private readonly string _listboxId = $"dryl-msel-lb-{Guid.NewGuid():N}";
    private readonly string _helperId  = $"dryl-help-{Guid.NewGuid():N}";

    private List<SelectItem> _items = [];
    private bool _isOpen;
    private int _highlightedIndex = -1;

    private DrylPopover? _popover;
    private ElementReference _trigger;
    private bool _attached;
    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly AuraLifecycle _aura = new();

    protected override void OnParametersSet()
    {
        if (Ai == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = Ai;
        _aura.Sync(Ai, () => InvokeAsync(StateHasChanged));
        _items = Items?.ToList() ?? [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _attached) return;
        // Suppress the browser's default page-scroll for the navigation keys so
        // HandleKeyDown can move the option highlight. Tab/Enter/Escape stay live.
        try
        {
            await JS.InvokeVoidAsync("dryl.keynav.attach", _trigger);
            _attached = true;
        }
        catch (JSDisconnectedException) { /* circuit closing during prerender — ignore */ }
    }

    private void Toggle()
    {
        if (Disabled) return;
        _isOpen = !_isOpen;
        _highlightedIndex = -1;
    }

    private async Task ToggleItem(SelectItem item)
    {
        var current = new List<string>(SelectedValues);
        if (current.Contains(item.Value))
            current.Remove(item.Value);
        else
            current.Add(item.Value);

        await SelectedValuesChanged.InvokeAsync(current.AsReadOnly());
    }

    private async Task RemoveValue(string value)
    {
        var current = new List<string>(SelectedValues);
        current.Remove(value);
        await SelectedValuesChanged.InvokeAsync(current.AsReadOnly());
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var count = _items.Count;
        switch (e.Key)
        {
            case "ArrowDown":
                if (!_isOpen) { _isOpen = true; _highlightedIndex = 0; break; }
                _highlightedIndex = Math.Min(_highlightedIndex + 1, count - 1);
                await ScrollHighlightedIntoView();
                break;

            case "ArrowUp":
                if (_isOpen && _highlightedIndex > 0)
                {
                    _highlightedIndex--;
                    await ScrollHighlightedIntoView();
                }
                break;

            case "Enter":
            case " ":
                if (_isOpen && _highlightedIndex >= 0 && _highlightedIndex < count)
                    await ToggleItem(_items[_highlightedIndex]);
                else if (!_isOpen)
                    _isOpen = true;
                break;

            case "Escape":
            case "Tab":
                _isOpen = false;
                _highlightedIndex = -1;
                break;
        }
    }

    private async Task ScrollHighlightedIntoView()
    {
        if (_popover is not null)
            await JS.InvokeVoidAsync("dryl.autocomplete.scrollOptionIntoView", _popover.PanelElement, _highlightedIndex);
    }

    /// <summary>Called by DrylPopover when it closes itself (click-outside).</summary>
    private void ResetHighlight() => _highlightedIndex = -1;

    private IEnumerable<string> VisibleChips =>
        SelectedValues.Take(MaxVisibleChips);

    private int OverflowCount =>
        Math.Max(0, SelectedValues.Count - MaxVisibleChips);

    private string? ActiveDescendant =>
        _isOpen && _highlightedIndex >= 0 ? $"msopt-{_triggerId}-{_highlightedIndex}" : null;

    private string WrapperCssClass
    {
        get
        {
            var classes = new List<string> { "input-wrapper" };
            AiAuraCss.Append(classes, _aura, EffectiveAura);
            return string.Join(' ', classes);
        }
    }

    private string TriggerCssClass
    {
        get
        {
            var c = "multiselect-trigger";
            if (_isOpen)   c += " select--open";
            if (Disabled)  c += " select--disabled";
            if (State == InputState.Error)   c += " input-error";
            else if (State == InputState.Success) c += " input-success";
            return c;
        }
    }

    private static string OptionCss(bool isHighlighted, bool isSelected)
    {
        var c = "select-option multiselect-option";
        if (isHighlighted) c += " is-highlighted";
        if (isSelected)    c += " is-selected";
        return c;
    }

    private bool ShowHelper => !string.IsNullOrEmpty(HelperText);

    public async ValueTask DisposeAsync()
    {
        _aura.Dispose();
        if (!_attached) return;
        try { await JS.InvokeVoidAsync("dryl.keynav.detach", _trigger); }
        catch (JSDisconnectedException) { /* circuit already gone — ignore */ }
        catch (JSException) { /* element/listener already gone — ignore */ }
    }
}
