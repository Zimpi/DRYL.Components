@namespace DRYL.Components
@inherits InputBase<TimeOnly?>
@implements IDisposable
@inject IJSRuntime JS

@*  ─────────────────────────────────────────────────────────
    DrylTimePicker — time-only picker with a scrollable panel.

    Built on the shared DrylPopover primitive (anchor, positioning and
    click-outside dismissal); DrylTimePicker keeps the hour/minute
    columns, scroll-to-active and commit/cancel behaviour.

    Usage:
      <DrylTimePicker @bind-Value="model.MeetingTime"
                      Label="Meeting time"
                      MinuteStep="15" />

    Panel opens on click or focus. Scroll or click a row in the
    hour and minute columns to build the time, then press Done
    (or Enter) to commit. Escape closes without committing.
    ───────────────────────────────────────────────────────── *@

<div class="field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="field-label" for="@_id">@Label</label>
    }

    <DrylPopover @ref="_popover"
                 @bind-Open="_isOpen"
                 Block="true"
                 TriggerTogglesOpen="false"
                 Surface="false"
                 CloseOnEscape="false">
        <TriggerContent>
            <div class="@WrapperCssClass">
                <DrylAuraElements Aura="_aura" GenTick="_genTick" />

                <input id="@_id"
                       @ref="_input"
                       type="text"
                       class="@InputCssClass"
                       value="@DisplayValue"
                       readonly
                       @onfocus="Open"
                       @onclick="Open"
                       placeholder="@(Placeholder ?? "hh:mm")"
                       disabled="@Disabled"
                       aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)"
                       aria-invalid="@(HasValidationError ? "true" : null)"
                       aria-describedby="@(ShowHelper ? _helperId : null)"
                       aria-haspopup="dialog"
                       aria-expanded="@(_isOpen ? "true" : "false")" />

                <DrylIcon Name="Clock" Size="16" Class="input-icon input-icon-trailing" />
            </div>
        </TriggerContent>
        <PanelContent>
            <div class="time-panel"
                 role="dialog"
                 aria-label="Pick a time"
                 tabindex="-1"
                 @onkeydown="HandlePanelKeyDown">

                <div class="time-columns">
                    <div class="time-col" aria-label="Hours">
                        @foreach (var h in AvailableHours)
                        {
                            var hour = h;
                            <button type="button"
                                    class="@(hour == _selectedHour ? "time-cell is-selected" : "time-cell")"
                                    @onclick="() => SelectHour(hour)">
                                @hour.ToString("D2")
                            </button>
                        }
                    </div>
                    <div class="time-col-sep" aria-hidden="true">:</div>
                    <div class="time-col" aria-label="Minutes">
                        @foreach (var m in AvailableMinutes)
                        {
                            var minute = m;
                            <button type="button"
                                    class="@(minute == _selectedMinute ? "time-cell is-selected" : "time-cell")"
                                    @onclick="() => SelectMinute(minute)">
                                @minute.ToString("D2")
                            </button>
                        }
                    </div>
                </div>

                <div class="time-footer">
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="ClosePanel">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="Commit">Done</button>
                </div>
            </div>
        </PanelContent>
    </DrylPopover>

    @if (HasValidationError)
    {
        <div class="input-helper input-helper-error" id="@_helperId">
            @string.Join(" ", EditContext!.GetValidationMessages(FieldIdentifier))
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="input-helper" id="@_helperId">@HelperText</div>
    }
</div>

@code {
    /// <summary>Optional label shown above the input.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder shown when no time is selected. Default "hh:mm".</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Helper text shown below. Replaced by validation errors when present.</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>Visual state override (Default / Error / Success).</summary>
    [Parameter] public InputState State { get; set; } = InputState.Default;

    /// <summary>If true, the input is greyed out and non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible label — required when <c>Label</c> is not set.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>AI ambient state — controls the gradient border, glow, and reveal animation.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>AI aura variant. Leave <c>null</c> to inherit a surrounding <c>DrylAiScope</c> (ultimately <see cref="AiAura.Comet"/>).</summary>
    [Parameter] public AiAura? Aura { get; set; }

    /// <summary>Surrounding AI scope (supplied by <c>DrylAiScope</c>); used to resolve the aura variant.</summary>
    [CascadingParameter] private AiScope? Scope { get; set; }

    private AiAura EffectiveAura => AiScope.ResolveAura(Aura, Scope);

    /// <summary>Earliest selectable time. Null means no lower bound.</summary>
    [Parameter] public TimeOnly? Min { get; set; }

    /// <summary>Latest selectable time. Null means no upper bound.</summary>
    [Parameter] public TimeOnly? Max { get; set; }

    /// <summary>Minute granularity shown in the panel. Common values: 1, 5, 10, 15, 30.</summary>
    [Parameter] public int MinuteStep { get; set; } = 1;

    private readonly string _id       = $"dryl-time-{Guid.NewGuid():N}";
    private readonly string _helperId = $"dryl-help-{Guid.NewGuid():N}";
    private DrylPopover? _popover;
    private bool _isOpen;
    private bool _shouldScroll;
    private bool _shouldRestoreFocus;
    private bool _suppressOpenOnce;
    private ElementReference _input;
    private int? _selectedHour;
    private int? _selectedMinute;
    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly AuraLifecycle _aura = new();

    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        if (ValueExpression is null)
            ValueExpression = () => Value;
        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Ai == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = Ai;
        _aura.Sync(Ai, () => InvokeAsync(StateHasChanged));
    }

    public void Dispose() => _aura.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldScroll && _isOpen && _popover is not null)
        {
            _shouldScroll = false;
            await JS.InvokeVoidAsync("dryl.timepicker.scrollToActive", _popover.PanelElement);
            // The panel carries the keydown handler (Escape, Enter), so the focus
            // has to be in it — it stayed on the input before, which left both
            // keys dead. The panel itself, never a cell: focusing a cell would
            // scroll its column back and undo the line above.
            await JS.InvokeVoidAsync("dryl.timepicker.focusPanel", _popover.PanelElement);
        }

        // Focus lives in the panel while it is open, so a close would drop it on
        // <body>. Hand it back to the input — but the input opens the panel on
        // focus, so arm a one-shot suppression first: the focus event reaches the
        // circuit before this interop call's result does, so setting the flag
        // afterwards would be too late. If JS reports it did not move focus (the
        // user put it elsewhere), the suppression is dropped again unused.
        if (_shouldRestoreFocus && !_isOpen && _popover is not null)
        {
            _shouldRestoreFocus = false;
            _suppressOpenOnce = true;
            var restored = await JS.InvokeAsync<bool>(
                "dryl.timepicker.restoreFocus", _popover.PanelElement, _input);
            if (!restored) _suppressOpenOnce = false;
        }
    }

    private IEnumerable<int> AvailableHours
    {
        get
        {
            var start = Min?.Hour ?? 0;
            var end   = Max?.Hour ?? 23;
            return Enumerable.Range(start, end - start + 1);
        }
    }

    private IEnumerable<int> AvailableMinutes
    {
        get
        {
            var step = Math.Max(1, MinuteStep);
            var all = Enumerable.Range(0, 60).Where(m => m % step == 0);
            if (_selectedHour is not null)
            {
                if (_selectedHour == Min?.Hour) all = all.Where(m => m >= (Min?.Minute ?? 0));
                if (_selectedHour == Max?.Hour) all = all.Where(m => m <= (Max?.Minute ?? 59));
            }
            return all;
        }
    }

    private string DisplayValue => CurrentValue?.ToString("HH:mm") ?? string.Empty;

    private bool HasValidationError =>
        EditContext is not null && EditContext.GetValidationMessages(FieldIdentifier).Any();

    private bool ShowHelper => HasValidationError || !string.IsNullOrEmpty(HelperText);

    private string WrapperCssClass
    {
        get
        {
            var cls = new List<string> { "input-wrapper" };
            AiAuraCss.Append(cls, _aura, EffectiveAura);
            return string.Join(' ', cls);
        }
    }

    private string InputCssClass
    {
        get
        {
            var cls = "input has-trailing-icon";
            if (HasValidationError || State == InputState.Error) cls += " input-error";
            else if (State == InputState.Success)                cls += " input-success";
            return cls;
        }
    }

    private void Open()
    {
        // Our own focus() on the input, handing focus back after a close, must
        // not reopen what the user just closed.
        if (_suppressOpenOnce)
        {
            _suppressOpenOnce = false;
            return;
        }
        if (_isOpen || Disabled) return;
        _isOpen = true;
        InitPending();
        _shouldScroll = true;
    }

    private void InitPending()
    {
        _selectedHour   = CurrentValue?.Hour   ?? 12;
        _selectedMinute = CurrentValue?.Minute  ?? 0;
        // Snap minute to nearest step
        var step = Math.Max(1, MinuteStep);
        _selectedMinute = (int)Math.Round((double)(_selectedMinute ?? 0) / step) * step;
        _selectedMinute = Math.Min(_selectedMinute ?? 0, 59 - (59 % step));
    }

    private void SelectHour(int hour) => _selectedHour = hour;

    private void SelectMinute(int minute) => _selectedMinute = minute;

    private void Commit()
    {
        if (_selectedHour is not null && _selectedMinute is not null)
        {
            int h = _selectedHour.Value;
            int m = _selectedMinute.Value;
            var t = new TimeOnly(h, m);
            if (Min.HasValue && t < Min) t = Min.Value;
            if (Max.HasValue && t > Max) t = Max.Value;
            CurrentValue = t;
        }
        ClosePanel();
    }

    /// <summary>Closes the panel and asks for the focus back on the input.</summary>
    private void ClosePanel()
    {
        _isOpen = false;
        _shouldRestoreFocus = true;
    }

    private void HandlePanelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ClosePanel();
        else if (e.Key == "Enter") Commit();
    }

    protected override bool TryParseValueFromString(
        string? value,
        out TimeOnly? result,
        out string validationErrorMessage)
    {
        if (string.IsNullOrEmpty(value))
        {
            result = null;
            validationErrorMessage = string.Empty;
            return true;
        }
        if (TimeOnly.TryParseExact(value, "HH:mm", null, System.Globalization.DateTimeStyles.None, out var t))
        {
            result = t;
            validationErrorMessage = string.Empty;
            return true;
        }
        result = null;
        validationErrorMessage = $"'{value}' is not a valid time.";
        return false;
    }
}
