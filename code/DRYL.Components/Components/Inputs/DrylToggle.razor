@namespace DRYL.Components
@inherits InputBase<bool>

@*  ─────────────────────────────────────────────────────────
    DrylToggle — boolean switch with sliding thumb.

    Usage:
      <DrylToggle @bind-Value="model.DarkMode" Label="Dark mode (always on)" />

    Layout is label-left / switch-right, justified. The knob's leading edge
    runs ahead and its trailing edge springs after, so it stretches in travel;
    pressed it goes wide and flat. The track fades into the accent gradient and,
    after a user change, sends one glow pulse when it turns on (data-touched).
    ───────────────────────────────────────────────────────── *@

<label class="@RowCssClass">
    <span class="choice-label">
        @if (ChildContent is not null) { @ChildContent }
        else { @Label }
    </span>

    <input id="@_id"
           type="checkbox"
           class="toggle"
           checked="@CurrentValue"
           @onchange="HandleChange"
           disabled="@Disabled"
           data-touched="@_touched"
           aria-label="@(ChildContent is null && string.IsNullOrEmpty(Label) ? AriaLabel : null)"
           @attributes="AdditionalAttributes" />
</label>

@code {
    /// <summary>Plain-text label displayed to the left of the switch.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Rich label content. Takes precedence over <c>Label</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>If true, the toggle is greyed out and non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible label — required when no visible label is rendered.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private readonly string _id = $"dryl-toggle-{Guid.NewGuid():N}";

    // Set by the first user change; the glow pulse plays only from then on, never on first render.
    private bool _touched;

    private string RowCssClass => Disabled ? "row choice choice--end choice--disabled" : "row choice choice--end";

    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        if (ValueExpression is null)
            ValueExpression = () => Value;
        return base.SetParametersAsync(parameters);
    }

    private void HandleChange(ChangeEventArgs e)
    {
        _touched = true;
        CurrentValue = (bool)(e.Value ?? false);
    }

    protected override bool TryParseValueFromString(
        string? value,
        out bool result,
        out string validationErrorMessage)
    {
        result = bool.TryParse(value, out var v) && v;
        validationErrorMessage = string.Empty;
        return true;
    }
}
