@namespace DRYL.Components
@inherits InputBase<bool>

@*  ─────────────────────────────────────────────────────────
    DrylCheckbox — boolean checkbox with animated checkmark.

    Usage:
      <DrylCheckbox @bind-Value="model.AcceptTerms">I accept the terms</DrylCheckbox>
      <DrylCheckbox @bind-Value="model.HotReload" Label="Enable hot-reload" />

    The accent fill springs up from the centre and the check draws itself left
    to right; after a user change the box sends one glow pulse (data-touched).
    ───────────────────────────────────────────────────────── *@

<label class="@RowCssClass">
    <input id="@_id"
           type="checkbox"
           class="checkbox"
           checked="@CurrentValue"
           @onchange="HandleChange"
           disabled="@Disabled"
           data-touched="@_touched"
           aria-label="@(ChildContent is null && string.IsNullOrEmpty(Label) ? AriaLabel : null)"
           @attributes="AdditionalAttributes" />

    @if (ChildContent is not null)
    {
        <span class="choice-label">@ChildContent</span>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        <span class="choice-label">@Label</span>
    }
</label>

@code {
    /// <summary>Plain-text label displayed next to the checkbox.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Rich label content. Takes precedence over <c>Label</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>If true, the checkbox is greyed out and non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible label — required when no visible label is rendered.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private readonly string _id = $"dryl-check-{Guid.NewGuid():N}";

    // Set by the first user change; the glow pulse plays only from then on, never on first render.
    private bool _touched;

    private string RowCssClass => Disabled ? "row choice choice--disabled" : "row choice";

    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        if (ValueExpression is null)
            ValueExpression = () => Value;
        return base.SetParametersAsync(parameters);
    }

    private void HandleChange(ChangeEventArgs e)
    {
        _touched = true;
        CurrentValue = (bool)(e.Value ?? false);
    }

    protected override bool TryParseValueFromString(
        string? value,
        out bool result,
        out string validationErrorMessage)
    {
        result = bool.TryParse(value, out var v) && v;
        validationErrorMessage = string.Empty;
        return true;
    }
}
