@namespace DRYL.Components
@inherits InputBase<string>
@implements IAsyncDisposable
@inject IJSRuntime JS

@*  ─────────────────────────────────────────────────────────
    DrylInputMask — formatted input with an auto-applied mask.

    Usage:
      <DrylInputMask @bind-Value="model.Phone"
                     Mask="MaskType.Phone"
                     Label="Phone number" />

      <DrylInputMask @bind-Value="model.Iban"
                     Mask="MaskType.Custom"
                     CustomPattern="AA## #### #### #### #### ##"
                     Label="IBAN" />

    Mask pattern syntax:
      #  — one digit (0–9)
      A  — one letter (a–z, A–Z), forced to upper-case
      Any other character — treated as a literal separator.

    Predefined masks (MaskType enum):
      Phone       +## ### ### ####
      Iban        AA## #### #### #### #### ##
      PostalCode  #####
      CreditCard  #### #### #### ####

    The bound value is the masked (formatted) string.
    ───────────────────────────────────────────────────────── *@

<div class="field">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="field-label" for="@_id">@Label</label>
    }

    <div class="@WrapperCssClass">
        <DrylAuraElements Aura="_aura" GenTick="_genTick" />

        @if (!string.IsNullOrEmpty(LeadingIcon))
        {
            <DrylIcon Name="@LeadingIcon" Size="16" Class="input-icon input-icon-leading" />
        }

        <input id="@_id"
               @ref="_inputEl"
               class="@InputCssClass"
               type="text"
               value="@CurrentValueAsString"
               data-dryl-input
               placeholder="@EffectivePlaceholder"
               disabled="@Disabled"
               spellcheck="false"
               autocomplete="off"
               aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)"
               aria-invalid="@(HasValidationError ? "true" : null)"
               aria-describedby="@(ShowHelper ? _helperId : null)"
               @attributes="AdditionalAttributes" />
    </div>

    @if (HasValidationError)
    {
        <div class="input-helper input-helper-error" id="@_helperId">
            @string.Join(" ", EditContext!.GetValidationMessages(FieldIdentifier))
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="input-helper" id="@_helperId">@HelperText</div>
    }
</div>

@code {
    /// <summary>Predefined mask type. Use <see cref="MaskType.Custom"/> and set <see cref="CustomPattern"/> for a custom mask.</summary>
    [Parameter] public MaskType Mask { get; set; } = MaskType.Phone;

    /// <summary>Custom mask pattern. Required when <see cref="Mask"/> is <see cref="MaskType.Custom"/>. Use # for digit, A for letter.</summary>
    [Parameter] public string? CustomPattern { get; set; }

    /// <summary>Optional label shown above the input.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder text. Defaults to a visual representation of the mask pattern.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Helper text shown below. Replaced by validation errors when present.</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>Visual state override (Default / Error / Success).</summary>
    [Parameter] public InputState State { get; set; } = InputState.Default;

    /// <summary>If true, the input is greyed out and non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible label — required when <c>Label</c> is not set.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>AI ambient state — controls the gradient border, glow, and reveal animation.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>AI aura variant. Leave <c>null</c> to inherit a surrounding <c>DrylAiScope</c> (ultimately <see cref="AiAura.Comet"/>).</summary>
    [Parameter] public AiAura? Aura { get; set; }

    /// <summary>Surrounding AI scope (supplied by <c>DrylAiScope</c>); used to resolve the aura variant.</summary>
    [CascadingParameter] private AiScope? Scope { get; set; }

    private AiAura EffectiveAura => AiScope.ResolveAura(Aura, Scope);

    /// <summary>Optional DrylIcon name rendered in the leading (left) slot.</summary>
    [Parameter] public string? LeadingIcon { get; set; }

    private static readonly Dictionary<MaskType, string> Patterns = new()
    {
        [MaskType.Phone]      = "+## ### ### ####",
        [MaskType.Iban]       = "AA## #### #### #### #### ##",
        [MaskType.PostalCode] = "#####",
        [MaskType.CreditCard] = "#### #### #### ####",
    };

    private readonly string _id       = $"dryl-mask-{Guid.NewGuid():N}";
    private readonly string _helperId = $"dryl-help-{Guid.NewGuid():N}";
    private ElementReference _inputEl;
    private DotNetObjectReference<DrylInputMask>? _dotnetRef;
    private bool _jsReady;
    private string? _attachedPattern;
    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly AuraLifecycle _aura = new();

    private string ActivePattern =>
        Mask == MaskType.Custom ? (CustomPattern ?? string.Empty) : Patterns[Mask];

    private string EffectivePlaceholder =>
        Placeholder ?? ActivePattern.Replace('#', '_').Replace('A', '_');

    public override Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        if (ValueExpression is null)
            ValueExpression = () => Value;
        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Ai == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = Ai;
        _aura.Sync(Ai, () => InvokeAsync(StateHasChanged));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsReady = true;
            _dotnetRef = DotNetObjectReference.Create(this);
        }
        // Re-attach when the pattern changes (e.g., Mask or CustomPattern switch)
        var pattern = ActivePattern;
        if (_jsReady && _attachedPattern != pattern && !string.IsNullOrEmpty(pattern))
        {
            _attachedPattern = pattern;
            await JS.InvokeVoidAsync("dryl.inputmask.attach", _inputEl, pattern, _dotnetRef);
        }
    }

    /// <summary>Called by the JS mask handler whenever the formatted value changes.</summary>
    [JSInvokable]
    public void OnMaskedValue(string maskedValue)
    {
        if (CurrentValueAsString != maskedValue)
        {
            CurrentValueAsString = maskedValue;
            StateHasChanged();
        }
    }

    private bool HasValidationError =>
        EditContext is not null && EditContext.GetValidationMessages(FieldIdentifier).Any();

    private bool ShowHelper => HasValidationError || !string.IsNullOrEmpty(HelperText);

    private string WrapperCssClass
    {
        get
        {
            var cls = new List<string> { "input-wrapper" };
            if (!string.IsNullOrEmpty(LeadingIcon)) cls.Add("has-leading-icon");
            AiAuraCss.Append(cls, _aura, EffectiveAura);
            return string.Join(' ', cls);
        }
    }

    private string InputCssClass
    {
        get
        {
            var cls = "input";
            if (!string.IsNullOrEmpty(LeadingIcon)) cls += " has-leading-icon";
            if (HasValidationError || State == InputState.Error) cls += " input-error";
            else if (State == InputState.Success)                cls += " input-success";
            return cls;
        }
    }

    protected override bool TryParseValueFromString(
        string? value,
        out string result,
        out string validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = string.Empty;
        return true;
    }

    public async ValueTask DisposeAsync()
    {
        _aura.Dispose();
        if (_jsReady)
        {
            try { await JS.InvokeVoidAsync("dryl.inputmask.detach", _inputEl); }
            catch { /* ignore */ }
        }
        _dotnetRef?.Dispose();
    }
}
