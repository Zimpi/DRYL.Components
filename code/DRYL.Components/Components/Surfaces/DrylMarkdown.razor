@namespace DRYL.Components
@inherits DrylAiAware
@implements IDisposable
@using Markdig
@using Markdig.Syntax
@using Markdig.Syntax.Inlines
@using System.Text

@*  ─────────────────────────────────────────────────────────
    DrylMarkdown — renders Markdown (CommonMark + GFM) into DRYL's
    glass aesthetic. The natural sink for LLM output: bind it to a
    streaming completion and it re-renders as tokens arrive.

    Fenced code blocks are delegated to DrylCodeBlock (language label
    + copy button). All other Markdown is rendered to HTML by Markdig
    with raw HTML disabled, so model-authored "<script>…" is escaped
    rather than executed; attribute blocks are off and link/image
    targets are limited to safe schemes (see DropUnsafeTargets).

    Usage:
      <DrylMarkdown Content="@_answer" Ai="@_state" />
    ───────────────────────────────────────────────────────── *@

<div class="@RootCssClass" @attributes="AdditionalAttributes">
    <DrylAuraElements Aura="_aura" GenTick="_genTick" />

    <div class="md-content">
        @foreach (var seg in _segments)
        {
            if (seg.IsCode)
            {
                <DrylCodeBlock Code="@seg.Text" Language="@seg.Language" />
            }
            else
            {
                @((MarkupString)seg.Text)
            }
        }
    </div>
</div>

@code {
    /// <summary>The Markdown source to render.</summary>
    [Parameter] public string? Content { get; set; }

    // AI ambient state (Ai) and aura variant (Aura) are inherited from DrylAiAware; both
    // resolve against a surrounding DrylAiScope via EffectiveAi / EffectiveAura.

    /// <summary>Pass-through HTML attributes on the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Extra CSS class(es) merged onto the markdown root's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    // Content is untrusted (model-authored), so three doors stay shut:
    //  - raw HTML is disabled, so <script> and <img onerror> are escaped;
    //  - the generic-attributes extension is removed from the advanced set,
    //    because "{onclick=…}" / "{style=…}" would otherwise put any attribute
    //    on any element (an onmouseover on a heading needs no click at all);
    //  - every link, image and autolink target is checked after parsing
    //    (DropUnsafeTargets), because Markdig passes javascript:/data: through.
    private static readonly MarkdownPipeline _pipeline = BuildPipeline();

    private static MarkdownPipeline BuildPipeline()
    {
        var builder = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .DisableHtml();
        builder.Extensions.RemoveAll(e => e is Markdig.Extensions.GenericAttributes.GenericAttributesExtension);
        return builder.Build();
    }

    private static readonly string[] _linkSchemes = { "http", "https", "mailto", "tel" };
    private static readonly string[] _imageSchemes = { "http", "https" };

    // Replaces every link, image or autolink whose target is not allowed by its
    // own content: a link keeps its text, an image its alt text, an autolink its
    // literal URL. Runs on the parsed tree, before anything is rendered.
    private static void DropUnsafeTargets(MarkdownDocument document)
    {
        foreach (var link in document.Descendants<LinkInline>().ToList())
        {
            if (IsAllowedTarget(link.Url, link.IsImage ? _imageSchemes : _linkSchemes)) continue;
            var child = link.FirstChild;
            while (child is not null)
            {
                var next = child.NextSibling;
                child.Remove();
                link.InsertBefore(child);
                child = next;
            }
            link.Remove();
        }

        foreach (var autolink in document.Descendants<AutolinkInline>().ToList())
        {
            if (autolink.IsEmail || IsAllowedTarget(autolink.Url, _linkSchemes)) continue;
            autolink.ReplaceBy(new LiteralInline(autolink.Url ?? string.Empty));
        }
    }

    // A target is read the way a browser reads it: whitespace and control
    // characters are ignored (browsers strip them, so "java\tscript:" is
    // javascript:) and the scheme is case-insensitive. Markdig has already
    // decoded character references. A target without a scheme — relative path,
    // fragment, query, protocol-relative — is always allowed.
    internal static bool IsAllowedTarget(string? url, string[] schemes)
    {
        if (string.IsNullOrEmpty(url)) return true;

        var sb = new StringBuilder(url.Length);
        foreach (var c in url)
        {
            if (c > ' ' && c != '\u007F') sb.Append(char.ToLowerInvariant(c));
        }
        var target = sb.ToString();

        var end = target.IndexOfAny(new[] { ':', '/', '?', '#' });
        if (end <= 0 || target[end] != ':') return true;

        var scheme = target[..end];
        return Array.IndexOf(schemes, scheme) >= 0;
    }

    private readonly List<Segment> _segments = new();
    private string? _lastContent;
    private int _parseCount;

    /// <summary>Total Markdig parses performed — test seam for the content memo.</summary>
    internal int ParseCount => _parseCount;

    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly DRYL.Components.Ai.AuraLifecycle _aura = new();

    private readonly record struct Segment(bool IsCode, string Text, string? Language);

    protected override void OnParametersSet()
    {
        if (EffectiveAi == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = EffectiveAi;
        // Keep the aura mounted (and fading) for one beat after leaving AI mode so it
        // dissolves rather than snapping away when a completion settles back to None.
        _aura.Sync(EffectiveAi, () => InvokeAsync(StateHasChanged));
        if (Content != _lastContent)
        {
            _lastContent = Content;
            BuildSegments();
        }
    }

    public void Dispose() => _aura.Dispose();

    private void BuildSegments()
    {
        _segments.Clear();
        if (string.IsNullOrEmpty(Content)) return;

        // Streaming re-parses the accumulated text on every chunk, and a chunk
        // boundary can split a UTF-16 surrogate pair (e.g. mid-emoji), leaving a
        // lone surrogate at the tail. Markdig's AutoIdentifier (from advanced
        // extensions) urilizes heading text through ICU normalization, which
        // throws ArgumentException("invalid Unicode code points") on an unpaired
        // surrogate. Drop unpaired surrogates so the partial parse stays valid;
        // the next chunk delivers the pair and the character renders normally.
        _parseCount++;
        var document = Markdown.Parse(StripLoneSurrogates(Content!), _pipeline);
        DropUnsafeTargets(document);

        var sb = new StringBuilder();
        using var writer = new StringWriter(sb);
        var renderer = new Markdig.Renderers.HtmlRenderer(writer);
        _pipeline.Setup(renderer);

        void FlushHtml()
        {
            if (sb.Length == 0) return;
            _segments.Add(new Segment(false, sb.ToString(), null));
            sb.Clear();
        }

        foreach (var block in document)
        {
            if (block is CodeBlock codeBlock)
            {
                FlushHtml();
                var language = (codeBlock as FencedCodeBlock)?.Info;
                _segments.Add(new Segment(true, codeBlock.Lines.ToString(), language));
            }
            else
            {
                renderer.Render(block);
                writer.Flush();
            }
        }

        FlushHtml();
    }

    // Returns the string with any unpaired UTF-16 surrogate removed (a valid
    // high+low pair is kept intact). Allocation-free when the input is already
    // well-formed, which is the overwhelmingly common case.
    private static string StripLoneSurrogates(string s)
    {
        var hasSurrogate = false;
        for (var i = 0; i < s.Length; i++)
        {
            if (char.IsSurrogate(s[i])) { hasSurrogate = true; break; }
        }
        if (!hasSurrogate) return s;

        var sb = new StringBuilder(s.Length);
        for (var i = 0; i < s.Length; i++)
        {
            var c = s[i];
            if (char.IsHighSurrogate(c))
            {
                if (i + 1 < s.Length && char.IsLowSurrogate(s[i + 1]))
                {
                    sb.Append(c);
                    sb.Append(s[++i]);
                }
                // else: unpaired high surrogate — drop it
            }
            else if (char.IsLowSurrogate(c))
            {
                // unpaired low surrogate — drop it
            }
            else
            {
                sb.Append(c);
            }
        }
        return sb.ToString();
    }

    private string RootCssClass
    {
        get
        {
            var parts = new List<string> { "md" };
            DRYL.Components.Ai.AiAuraCss.Append(parts, _aura, EffectiveAura);
            if (!string.IsNullOrWhiteSpace(Class)) parts.Add(Class!);
            return string.Join(' ', parts);
        }
    }
}
