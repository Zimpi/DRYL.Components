@namespace DRYL.Components
@inherits DrylAiAware
@inject IJSRuntime JS
@implements IAsyncDisposable

@*  ─────────────────────────────────────────────────────────
    DrylCard — glass surface with optional cursor spotlight or 3D
    depth warp.

    Usage:
      <DrylCard>
        <h3>Service health</h3>
        <p>All systems operational.</p>
      </DrylCard>

      <DrylCard Spotlight="false" Padding="CardPadding.Tight">
        ...
      </DrylCard>

      <DrylCard Depth="DepthGlassIntensity.Medium">
        ... tilts in 3D toward the pointer ...
      </DrylCard>

    Requires wwwroot/js/dryl.js to be loaded for the spotlight / depth
    warp to track the pointer.
    ───────────────────────────────────────────────────────── *@

<div @ref="_el"
     class="@CssClass"
     style="@VtStyle"
     data-vt-depth="@VtDepthMarker"
     @attributes="AdditionalAttributes">
    @if (_aura.Present)
    {
        <div class="ai-aura-ring" aria-hidden="true"></div>
        <div class="ai-aura-comet" aria-hidden="true"></div>
        <div class="ai-aura-glow" aria-hidden="true"></div>
        @if (_aura.RenderState == AiState.Generated && !_aura.Exiting)
        {
            <div class="ai-aura-wash" aria-hidden="true" @key="_genTick"></div>
        }
    }
    @if (Depth is not null)
    {
        <div class="dg-sheen"></div>
        <div class="dg-specular"></div>
        <div class="dg-content">
            @ChildContent
        </div>
    }
    else if (Spotlight)
    {
        <div class="spotlight-fx"></div>
        <div class="spotlight-content">
            @ChildContent
        </div>
    }
    else
    {
        @ChildContent
    }
</div>

@code {
    /// <summary>If true, an interactive cursor-following spotlight is rendered. Ignored when <see cref="Depth"/> is set.</summary>
    [Parameter] public bool Spotlight { get; set; } = true;

    /// <summary>
    /// When set, the card becomes a 3D depth-warp surface that tilts toward the
    /// pointer (the same effect as <see cref="DrylDepthGlass"/>). Supersedes
    /// <see cref="Spotlight"/>. Leave null for a flat card.
    /// </summary>
    [Parameter] public DepthGlassIntensity? Depth { get; set; }

    /// <summary>Padding preset for the card. Use <see cref="CardPadding.None"/> for custom layout.</summary>
    [Parameter] public CardPadding Padding { get; set; } = CardPadding.Default;

    // AI ambient state (the Ai parameter) is inherited from DrylAiAware; it controls the
    // gradient border, glow, and reveal animation, and resolves against a surrounding DrylAiScope.

    /// <summary>Card body content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Pass-through HTML attributes (e.g. role, data-*, @onclick).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Extra CSS class(es) merged onto the card's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Marks this card as a shared-element morph endpoint for view transitions
    /// (<see cref="Motion.IDrylViewTransition"/>): renders <c>view-transition-name</c>
    /// with this value. Must be a valid CSS identifier (letters, digits, <c>-</c>,
    /// <c>_</c>) and unique among elements simultaneously in the DOM — a duplicate
    /// name voids the entire transition. Supply a stable per-instance id, same
    /// discipline as <c>@key</c>. Null (default) opts out.
    /// </summary>
    [Parameter] public string? ViewTransitionName { get; set; }

    /// <summary>
    /// How much "Depth Glass" a morph of this card gets — <see cref="DrylViewTransitionStyle.Glide"/>
    /// (default, viscous shape settle only) or <see cref="DrylViewTransitionStyle.DepthGlass"/>
    /// (adds the translucency pulse + mercury merge; reserve for rare, high-meaning merges).
    /// Ignored unless <see cref="ViewTransitionName"/> is set.
    /// </summary>
    [Parameter] public DrylViewTransitionStyle ViewTransitionStyle { get; set; } = DrylViewTransitionStyle.Glide;

    private ElementReference _el;
    private bool _tracking;
    private bool _depthTracked;
    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly DRYL.Components.Ai.AuraLifecycle _aura = new();

    protected override void OnParametersSet()
    {
        if (EffectiveAi == AiState.Generated && _prevAi != AiState.Generated)
        {
            // Force the wash element to be re-keyed so its one-shot animation re-runs
            // every time the consumer transitions back into Generated.
            _genTick++;
        }
        _prevAi = EffectiveAi;

        // Keep the aura mounted (and fading) for one beat after leaving AI mode so it
        // dissolves rather than snapping away.
        _aura.Sync(EffectiveAi, () => InvokeAsync(StateHasChanged));
    }

    private bool VtDepth =>
        !string.IsNullOrWhiteSpace(ViewTransitionName)
        && ViewTransitionStyle == DrylViewTransitionStyle.DepthGlass;

    // Marker attribute the JS bridge keys on to lazily inject the #dryl-merge filter.
    private string? VtDepthMarker => VtDepth ? "" : null;

    private string? VtStyle =>
        string.IsNullOrWhiteSpace(ViewTransitionName)
            ? null
            : VtDepth
                ? $"view-transition-name: {ViewTransitionName}; view-transition-class: dryl-depth"
                : $"view-transition-name: {ViewTransitionName}";

    private string CssClass
    {
        get
        {
            var pad = Padding switch
            {
                CardPadding.None    => "p-0",
                CardPadding.Tight   => "p-tight",
                CardPadding.Loose   => "p-loose",
                _ => "p-default"
            };
            var classes = new List<string> { "glass-card", pad };
            if (Depth is { } depth)
            {
                classes.Add("dg-warp");
                classes.Add(depth switch
                {
                    DepthGlassIntensity.Subtle => "dg--subtle",
                    DepthGlassIntensity.Strong => "dg--strong",
                    _ => "dg--medium"
                });
            }
            else if (Spotlight)
            {
                classes.Add("spotlight-card");
            }
            if (_aura.Present)
            {
                classes.Add("ai-aura");
                if (EffectiveAura == AiAura.Aurora) classes.Add("ai-aura--aurora");
                if (_aura.Exiting) classes.Add("ai-aura--out");
                switch (_aura.RenderState)
                {
                    case AiState.Thinking:  classes.Add("ai-thinking");  break;
                    case AiState.Streaming: classes.Add("ai-streaming"); break;
                    case AiState.Generated: classes.Add("ai-generated"); break;
                }
            }
            if (!string.IsNullOrWhiteSpace(Class)) classes.Add(Class!);
            return string.Join(' ', classes);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (Depth is not null)
        {
            await JS.InvokeVoidAsync("dryl.depthglass.track", _el);
            _tracking = true;
            _depthTracked = true;
        }
        else if (Spotlight)
        {
            await JS.InvokeVoidAsync("dryl.spotlight.track", _el);
            _tracking = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _aura.Dispose();

        // Only call into JS if a listener was actually attached (i.e. we ran past
        // first render in the browser). Guards against the static prerender pass
        // where no JS runtime / DOM element exists.
        if (_tracking)
        {
            var fn = _depthTracked ? "dryl.depthglass.untrack" : "dryl.spotlight.untrack";
            try { await JS.InvokeVoidAsync(fn, _el); }
            catch { /* circuit gone or element already removed */ }
        }
    }

    public enum CardPadding { None, Tight, Default, Loose }
}
