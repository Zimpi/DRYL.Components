@namespace DRYL.Components
@implements IDisposable
@using System.Globalization

@*  ─────────────────────────────────────────────────────────
    DrylProgress — linear progress bar, drawn as a row of glass cells.

    Usage:
      <DrylProgress Value="64" ShowLabel="true" />
      <DrylProgress Value="3" Max="5" Variant="ProgressVariant.Success" />
      <DrylProgress Indeterminate="true" />
      <DrylProgress Value="42" Ai="AiState.Streaming" />

    The track is a row of glass cells (one per unit when Max is a whole
    number from 1 to 12, otherwise 20). One gradient runs across every
    cell; the leading lit cell is filled partially. Each cell clips its own
    fill, so the AI aura on the wrapper is never clipped.
    ───────────────────────────────────────────────────────── *@

<div class="progress-field @Class" @attributes="AdditionalAttributes">
    @if (ShowLabelRow)
    {
        <div class="progress-label-row">
            <span>
                @if (Label is not null)
                {
                    @Label
                }
                else if (!string.IsNullOrEmpty(LabelText))
                {
                    @LabelText
                }
            </span>
            @if (ShowLabel && !Indeterminate)
            {
                <span class="progress-pct">@PctText</span>
            }
        </div>
    }

    <div class="@WrapCssClass">
        <DrylAuraElements Aura="_aura" GenTick="_genTick" />

        <div class="@TrackCssClass"
             style="@TrackStyle"
             role="progressbar"
             aria-valuemin="0"
             aria-valuemax="@Max.ToString(CultureInfo.InvariantCulture)"
             aria-valuenow="@AriaValueNow"
             aria-label="@AriaLabel">
            @for (var i = 0; i < CellCount; i++)
            {
                var cell = i;
                <span class="@CellCssClass(cell)" style="@CellStyle(cell)"></span>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Current value, between 0 and <see cref="Max"/>.</summary>
    [Parameter] public double Value { get; set; }

    /// <summary>Maximum value. Default 100.</summary>
    [Parameter] public double Max { get; set; } = 100;

    /// <summary>When true, shows an animated sweep instead of a fixed fill.</summary>
    [Parameter] public bool Indeterminate { get; set; }

    /// <summary>Colour treatment of the fill.</summary>
    [Parameter] public ProgressVariant Variant { get; set; } = ProgressVariant.Accent;

    /// <summary>Bar thickness.</summary>
    [Parameter] public ProgressSize Size { get; set; } = ProgressSize.Medium;

    /// <summary>When true, shows the percentage at the trailing edge of the label row.</summary>
    [Parameter] public bool ShowLabel { get; set; }

    /// <summary>Plain-text label shown at the leading edge of the label row.</summary>
    [Parameter] public string? LabelText { get; set; }

    /// <summary>Custom label content — overrides <see cref="LabelText"/>.</summary>
    [Parameter] public RenderFragment? Label { get; set; }

    /// <summary>Accessible label for the progress bar.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>AI ambient state — controls the gradient border, glow, and reveal animation.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>AI aura variant. Leave <c>null</c> to inherit a surrounding <c>DrylAiScope</c> (ultimately <see cref="AiAura.Comet"/>).</summary>
    [Parameter] public AiAura? Aura { get; set; }

    /// <summary>Surrounding AI scope (supplied by <c>DrylAiScope</c>); used to resolve the state and the aura variant.</summary>
    [CascadingParameter] private AiScope? Scope { get; set; }

    private AiAura EffectiveAura => AiScope.ResolveAura(Aura, Scope);

    /// <summary>Resolved AI state: an explicit <see cref="Ai"/> wins, otherwise the surrounding <c>DrylAiScope</c>'s state.</summary>
    private AiState EffectiveAi => AiScope.Resolve(Ai, Scope);

    /// <summary>Pass-through HTML attributes on the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Extra CSS class(es) merged onto the progress field's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    // AiState.Proposed is rendered like None: a progress bar reports how far work has come,
    // so nothing on it waits for a human decision (I20).
    private AiState Shown => EffectiveAi == AiState.Proposed ? AiState.None : EffectiveAi;

    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly AuraLifecycle _aura = new();

    // Cell bookkeeping. _units is how many cells the current value fills (fractional);
    // _fromUnits is what it filled before the last change, so the newly filled cells
    // can stagger outward from the previous leading edge. Both start at zero, so a
    // freshly mounted bar fills in from the left.
    private double _units;
    private double _fromUnits;

    /// <summary>The number of cells the row is drawn with.</summary>
    internal const int DefaultCellCount = 20;

    private int CellCount =>
        Max >= 1 && Max <= 12 && Math.Abs(Max - Math.Round(Max)) < 1e-9
            ? (int)Math.Round(Max)
            : DefaultCellCount;

    protected override void OnParametersSet()
    {
        var units = Percent / 100 * CellCount;
        if (Math.Abs(units - _units) > 1e-9)
        {
            _fromUnits = _units;
            _units = units;
        }

        if (Shown == AiState.Generated && _prevAi != AiState.Generated) _genTick++;
        _prevAi = Shown;
        _aura.Sync(Shown, () => InvokeAsync(StateHasChanged));
    }

    public void Dispose() => _aura.Dispose();

    // The value the bar actually draws. Everything the component reports — the fill
    // width, the percentage and aria-valuenow — is derived from this one number, so a
    // Value outside 0..Max cannot make the drawn bar and the announced value disagree.
    private double ClampedValue => Max <= 0 ? 0 : Math.Clamp(Value, 0, Max);

    private double Percent
    {
        get
        {
            if (Max <= 0) return 0;
            return ClampedValue / Max * 100;
        }
    }

    private string PctText => FormattableString.Invariant($"{Percent:0}%");

    private string? AriaValueNow =>
        Indeterminate ? null : ClampedValue.ToString(CultureInfo.InvariantCulture);

    private bool IsComplete => !Indeterminate && Percent >= 100;

    private string TrackStyle => FormattableString.Invariant($"--n: {CellCount}");

    // How much of cell i is filled, 0..1.
    private double CellFill(int i) => Math.Round(Math.Clamp(_units - i, 0, 1), 3);

    // Index of the leading lit cell, or -1 when nothing is lit.
    private int LeadIndex => _units <= 0 ? -1 : Math.Min(CellCount - 1, (int)Math.Ceiling(_units) - 1);

    // Stagger order of cell i in the current change: 0 for the first cell that
    // changes, counting outward from the previous leading edge.
    private int StaggerOrder(int i) =>
        _units >= _fromUnits
            ? Math.Max(0, i - (int)Math.Floor(_fromUnits))
            : Math.Max(0, (int)Math.Ceiling(_fromUnits) - 1 - i);

    private string CellStyle(int i) =>
        FormattableString.Invariant($"--i: {i}; --k: {StaggerOrder(i)}; --f: {CellFill(i):0.###}");

    private string CellCssClass(int i)
    {
        if (Indeterminate) return "progress-cell";
        var f = CellFill(i);
        var parts = new List<string>(4) { "progress-cell" };
        if (f > 0) parts.Add("is-lit");
        if (f >= 1) parts.Add("is-full");
        if (i == LeadIndex && !IsComplete) parts.Add("is-lead");
        return string.Join(' ', parts);
    }

    private bool ShowLabelRow =>
        Label is not null
        || !string.IsNullOrEmpty(LabelText)
        || (ShowLabel && !Indeterminate);

    private string WrapCssClass
    {
        get
        {
            var parts = new List<string> { "progress-wrap" };
            AiAuraCss.Append(parts, _aura, EffectiveAura);
            return string.Join(' ', parts);
        }
    }

    private string TrackCssClass
    {
        get
        {
            var parts = new List<string> { "progress" };
            if (Size == ProgressSize.Small) parts.Add("progress--sm");
            else if (Size == ProgressSize.Large) parts.Add("progress--lg");
            switch (Variant)
            {
                case ProgressVariant.Success: parts.Add("progress--success"); break;
                case ProgressVariant.Warning: parts.Add("progress--warning"); break;
                case ProgressVariant.Danger:  parts.Add("progress--danger");  break;
            }
            if (Indeterminate) parts.Add("progress--indeterminate");
            if (IsComplete) parts.Add("progress--complete");
            return string.Join(' ', parts);
        }
    }
}
