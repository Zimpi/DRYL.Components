@namespace DRYL.Components
@implements IDisposable

@*  ─────────────────────────────────────────────────────────
    DrylAlert — feedback banner for notices, status messages and AI content.

    Usage:
      <DrylAlert Kind="AlertKind.Success" Title="Saved">
          All changes were applied successfully.
      </DrylAlert>

      <DrylAlert Kind="AlertKind.Ai" Title="AI-generated content"
                 Ai="AiState.Generated" Dismissible OnDismiss="HandleDismiss">
          The following content was produced by an AI model and should be
          reviewed before use.
      </DrylAlert>

    • Kind picks the icon and accent colour (Info / Success / Warning / Danger / Ai).
    • Ai drives the animated gradient border — chosen independently of Kind, so a
      Warning alert can signal that its check is still running.
    • Icon="" suppresses the icon entirely.
    • Dismissible shows a dismiss button; OnDismiss delivers the callback.
    ───────────────────────────────────────────────────────── *@

<div class="@CssClass"
     role="@AriaRole"
     aria-live="@AriaLive"
     @attributes="AdditionalAttributes">

    @* AI aura overlays — mounted while the aura is present (live or fading out) *@
    <DrylAuraElements Aura="_aura" GenTick="_genTick" />

    @* Icon-Chip *@
    @if (!string.IsNullOrEmpty(ResolvedIcon))
    {
        <div class="ico" aria-hidden="true">
            <DrylIcon Name="@ResolvedIcon" Size="14" />
        </div>
    }

    @* Text area: title + body *@
    <div class="alert-content">
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="title">@Title</div>
        }
        @if (ChildContent is not null)
        {
            <div class="body">@ChildContent</div>
        }
    </div>

    @* Optional dismiss button *@
    @if (Dismissible)
    {
        <button class="alert-dismiss"
                type="button"
                aria-label="Dismiss notification"
                @onclick="HandleDismiss">
            <DrylIcon Name="X" Size="14" />
        </button>
    }
</div>

@code {
    /// <summary>Semantic variant — drives the icon and the accent colour.</summary>
    [Parameter] public AlertKind Kind { get; set; } = AlertKind.Info;

    /// <summary>Optional title, shown in bold above the body text.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Icon override. An empty string <c>""</c> suppresses the icon entirely.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>When true, a dismiss button is shown.</summary>
    [Parameter] public bool Dismissible { get; set; }

    /// <summary>Raised when the user dismisses the alert.</summary>
    [Parameter] public EventCallback OnDismiss { get; set; }

    /// <summary>Ambient AI state — drives the gradient border, the glow and the reveal animation.</summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>AI aura variant. Leave <c>null</c> to inherit a surrounding <c>DrylAiScope</c> (ultimately <see cref="AiAura.Comet"/>).</summary>
    [Parameter] public AiAura? Aura { get; set; }

    /// <summary>Surrounding AI scope (supplied by <c>DrylAiScope</c>); resolves the aura variant.</summary>
    [CascadingParameter] private AiScope? Scope { get; set; }

    private AiAura EffectiveAura => AiScope.ResolveAura(Aura, Scope);

    /// <summary>Body content of the alert.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Pass-through HTML attributes (e.g. data-*, style for layout overrides).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Extra CSS class(es) merged onto the alert's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    private AiState _prevAi = AiState.None;
    private int _genTick;
    private readonly AuraLifecycle _aura = new();

    protected override void OnParametersSet()
    {
        // Re-anchor the wash element so the one-shot animation replays.
        if (Ai == AiState.Generated && _prevAi != AiState.Generated)
            _genTick++;
        _prevAi = Ai;
        _aura.Sync(Ai, () => InvokeAsync(StateHasChanged));
    }

    public void Dispose() => _aura.Dispose();

    private string? ResolvedIcon
    {
        get
        {
            // An explicit override wins; "" means no icon
            if (Icon is not null) return Icon.Length == 0 ? null : Icon;
            return Kind switch
            {
                AlertKind.Success => "Check",
                AlertKind.Warning => "Alert",
                AlertKind.Danger  => "Alert",
                AlertKind.Ai      => "Sparkle",
                _                 => "Info"         // Info + Fallback
            };
        }
    }

    // Danger/Warning -> role="alert" + aria-live="assertive" (interrupts the screen reader)
    // everything else -> role="status" + aria-live="polite"
    private string AriaRole  => Kind == AlertKind.Danger || Kind == AlertKind.Warning ? "alert"      : "status";
    private string AriaLive  => Kind == AlertKind.Danger || Kind == AlertKind.Warning ? "assertive"  : "polite";

    private string CssClass
    {
        get
        {
            var kind = Kind switch
            {
                AlertKind.Success => "success",
                AlertKind.Warning => "warning",
                AlertKind.Danger  => "danger",
                AlertKind.Ai      => "ai",
                _                 => "info"
            };

            var classes = new List<string> { "alert", kind };

            if (Dismissible)              classes.Add("is-dismissible");
            AiAuraCss.Append(classes, _aura, EffectiveAura);

            if (!string.IsNullOrWhiteSpace(Class)) classes.Add(Class!);
            return string.Join(' ', classes);
        }
    }

    private async Task HandleDismiss()
    {
        if (OnDismiss.HasDelegate)
            await OnDismiss.InvokeAsync();
    }

    /// <summary>Semantic variant of the alert.</summary>
    public enum AlertKind { Info, Success, Warning, Danger, Ai }
}
