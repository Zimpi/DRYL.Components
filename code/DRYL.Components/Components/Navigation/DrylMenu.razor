@namespace DRYL.Components
@inject IJSRuntime JS

@*  ─────────────────────────────────────────────────────────
    DrylMenu — dropdown action menu anchored to a trigger.

    Built on the shared DrylPopover primitive: the popover owns
    open/close, positioning and click-outside dismissal; DrylMenu adds
    the menu role, keyboard navigation and item-driven close.

    Usage:
      <DrylMenu>
        <Trigger>
          <DrylButton TrailingIcon="ChevronDown">Actions</DrylButton>
        </Trigger>
        <Items>
          <DrylMenuItem Icon="edit" OnClick="Edit">Edit</DrylMenuItem>
          <DrylMenuItem Separator />
          <DrylMenuItem Icon="trash" Variant="DrylMenuItem.MenuItemVariant.Danger" OnClick="Delete">
            Delete
          </DrylMenuItem>
        </Items>
      </DrylMenu>
    ───────────────────────────────────────────────────────── *@

<DrylPopover @ref="_popover"
             @bind-Open="_isOpen"
             Block="@Block"
             Placement="@MappedPlacement"
             PanelRole="menu"
             PanelAriaLabel="@Label"
             CloseOnEscape="false"
             OnOpen="HandleOpened"
             OnKeyDown="HandleKeyDown"
             Class="@Class"
             @attributes="AdditionalAttributes">
    <TriggerContent>
        @Trigger
    </TriggerContent>
    <PanelContent>
        <CascadingValue Value="this" IsFixed="true">
            @Items
        </CascadingValue>
    </PanelContent>
</DrylPopover>

@code {
    /// <summary>Content that opens the menu — typically a DrylButton.</summary>
    [Parameter] public RenderFragment? Trigger { get; set; }

    /// <summary>Menu body — place DrylMenuItem components here.</summary>
    [Parameter] public RenderFragment? Items { get; set; }

    /// <summary>Accessible label for the menu panel (aria-label).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Where the panel opens relative to the trigger.</summary>
    [Parameter] public MenuPlacement Placement { get; set; } = MenuPlacement.BottomStart;

    /// <summary>If true, the anchor div stretches to full width of its container.</summary>
    [Parameter] public bool Block { get; set; }

    /// <summary>Pass-through HTML attributes on the outer anchor element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Extra CSS class(es) merged onto the menu's popover anchor.</summary>
    [Parameter] public string? Class { get; set; }

    private bool _isOpen;
    private bool _shouldFocusPanel;
    private DrylPopover? _popover;

    private PopoverPlacement MappedPlacement => Placement switch
    {
        MenuPlacement.BottomEnd => PopoverPlacement.BottomEnd,
        MenuPlacement.TopStart  => PopoverPlacement.TopStart,
        MenuPlacement.TopEnd    => PopoverPlacement.TopEnd,
        _                       => PopoverPlacement.BottomStart
    };

    private void HandleOpened() => _shouldFocusPanel = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldFocusPanel && _isOpen && _popover is not null)
        {
            _shouldFocusPanel = false;
            await JS.InvokeVoidAsync("dryl.menu.focusPanel", _popover.PanelElement);
        }
    }

    internal void CloseFromItem()
    {
        _isOpen = false;
        StateHasChanged();
        if (_popover is not null)
            _ = JS.InvokeVoidAsync("dryl.menu.focusTrigger", _popover.AnchorElement).AsTask();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_popover is null) return;
        switch (e.Key)
        {
            case "Escape":
                _isOpen = false;
                StateHasChanged();
                await JS.InvokeVoidAsync("dryl.menu.focusTrigger", _popover.AnchorElement);
                break;
            case "ArrowDown":
                await JS.InvokeVoidAsync("dryl.menu.navigate", _popover.PanelElement, "down");
                break;
            case "ArrowUp":
                await JS.InvokeVoidAsync("dryl.menu.navigate", _popover.PanelElement, "up");
                break;
            case "Home":
                await JS.InvokeVoidAsync("dryl.menu.navigate", _popover.PanelElement, "first");
                break;
            case "End":
                await JS.InvokeVoidAsync("dryl.menu.navigate", _popover.PanelElement, "last");
                break;
            case "Tab":
                _isOpen = false;
                StateHasChanged();
                break;
        }
    }

    /// <summary>Controls where the menu panel opens relative to its trigger.</summary>
    public enum MenuPlacement
    {
        /// <summary>Below the trigger, left-aligned.</summary>
        BottomStart,
        /// <summary>Below the trigger, right-aligned.</summary>
        BottomEnd,
        /// <summary>Above the trigger, left-aligned.</summary>
        TopStart,
        /// <summary>Above the trigger, right-aligned.</summary>
        TopEnd
    }
}
