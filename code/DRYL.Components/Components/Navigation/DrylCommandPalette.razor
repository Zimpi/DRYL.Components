@namespace DRYL.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IServiceProvider Services
@using DRYL.Components.Dialogs

@*  ─────────────────────────────────────────────────────────
    DrylCommandPalette — full-screen command launcher overlay.

    Opens via @bind-Open or the global Ctrl+K (Cmd+K) hotkey.

    Two ways to feed it, freely combined:
      • Legacy: a static Items array or an async SearchProvider
        (CommandItem — Navigate / Action / AiIntent), unchanged.
      • Declarative: <DrylCommand> children (with optional
        <DrylCommandArgument>s) that self-register into the shared
        ICommandRegistry; consumer code may add dynamic commands to
        the same registry. The palette fuzzy-matches and renders them
        alongside the legacy items, with one OnRun(CommandContext) path.

    Supply a Resolver (ICommandResolver) to turn a natural-language
    query into one confirmable command suggestion (the AI seam — the
    core ships no implementation and references no AI package).

    Keyboard: Arrow Up/Down navigate, Enter executes, Escape closes,
    Ctrl+K opens from anywhere (unless HotKey="false").
    ───────────────────────────────────────────────────────── *@

@* Always-mounted host: declarative DrylCommands register even while closed. *@
<CascadingValue Value="_registry" IsFixed="true">
    @ChildContent
</CascadingValue>

@if (Open)
{
    <div class="dialog-backdrop"
         @ref="_backdrop"
         @onclick="HandleBackdropClick">

        <div class="@PaletteCssClass"
             role="dialog"
             aria-modal="true"
             aria-label="@(AriaLabel ?? "Command palette")"
             @onclick:stopPropagation="true"
             @ref="_palette">

            <DrylAuraElements Aura="_aura" GenTick="_genTick" />

            <div class="@SearchRowCss">
                @if (_resolving)
                {
                    <div class="ai-aura-ring" aria-hidden="true"></div>
                    <div class="ai-aura-comet" aria-hidden="true"></div>
                    <div class="ai-aura-glow" aria-hidden="true"></div>
                }
                <DrylIcon Name="Search" Size="16" Class="cmd-search-icon" />
                <input class="cmd-search-input"
                       type="text"
                       value="@_query"
                       data-dryl-input
                       placeholder="@Placeholder"
                       autocomplete="off"
                       autocorrect="off"
                       spellcheck="false"
                       role="combobox"
                       aria-autocomplete="list"
                       aria-expanded="true"
                       aria-controls="@_listId"
                       aria-activedescendant="@ActiveDescendant"
                       @ref="_searchInput"
                       @oninput="HandleInput"
                       @onkeydown="HandleKeyDown" />
                @if (_resolving)
                {
                    <DrylAiIndicator State="AiState.Thinking" Class="cmd-ai-pill">Thinking…</DrylAiIndicator>
                }
                else if (_isLoading)
                {
                    <DrylSpinner Size="DrylSpinner.SpinnerSize.Small"
                                 Class="cmd-search-spinner" />
                }
                <kbd class="cmd-search-kbd" aria-hidden="true">Esc</kbd>
            </div>

            <div class="cmd-divider" role="separator"></div>

            @if (_fillingCommand is not null)
            {
                <div class="cmd-args">
                    <div class="cmd-args-head">
                        <DrylTooltip Text="Back">
                            <DrylButton Variant="DrylButton.ButtonVariant.Ghost"
                                        Size="DrylButton.ButtonSize.Small"
                                        LeadingIcon="ChevronLeft"
                                        AriaLabel="Back"
                                        OnClick="CancelArgFill" />
                        </DrylTooltip>
                        <span class="cmd-args-title">@_fillingCommand.Title</span>
                    </div>

                    @foreach (var arg in _fillingCommand.Arguments)
                    {
                        var name = arg.Name;
                        <div class="cmd-args-field" @key="name">
                            @switch (arg.Type)
                            {
                                case CommandArgType.Boolean:
                                    <DrylToggle Value="@AsBool(name)"
                                                ValueChanged="@(v => _fillValues[name] = v)"
                                                Label="@(arg.Description ?? name)" />
                                    break;
                                case CommandArgType.Choice:
                                    <DrylSelect Value="@AsString(name)"
                                                ValueChanged="@(v => _fillValues[name] = v)"
                                                Items="@ToItems(arg.Options)"
                                                Label="@(arg.Description ?? name)" />
                                    break;
                                default:
                                    <DrylInputText Value="@AsString(name)"
                                                   ValueChanged="@(v => _fillValues[name] = v)"
                                                   Label="@(arg.Description ?? name)"
                                                   Placeholder="@name" />
                                    break;
                            }
                        </div>
                    }

                    <div class="cmd-args-actions">
                        <DrylButton Variant="DrylButton.ButtonVariant.Primary"
                                    Class="cmd-args-confirm"
                                    OnClick="ConfirmArgFill">
                            Run
                        </DrylButton>
                    </div>
                </div>
            }
            else
            {
                <div class="cmd-results"
                     id="@_listId"
                     role="listbox"
                     @ref="_list">

                    @{
                        var flat = Flat();
                    }
                    @if (!_isLoading && flat.Count == 0)
                    {
                        <div class="cmd-empty" aria-live="polite">@EmptyText</div>
                    }
                    else
                    {
                        var idx = 0;

                        @if (_suggestion is not null)
                        {
                            var sIdx = idx++;
                            var sFocused = sIdx == _focusedIndex;
                            <div id="@ItemId(sIdx)"
                                 role="option"
                                 class="@RowCss(_suggestion, sFocused)"
                                 aria-selected="@(sFocused ? "true" : "false")"
                                 @onclick="() => RunRowAsync(_suggestion)"
                                 @onmouseenter="@(() => _focusedIndex = sIdx)"
                                 @key="@("suggestion")">
                                <span class="cmd-item-icon">
                                    <DrylIcon Name="Sparkle" Size="14" />
                                </span>
                                <span class="cmd-item-body">
                                    <span class="cmd-item-label">@_suggestion.Label</span>
                                    @if (!string.IsNullOrEmpty(_suggestion.Description))
                                    {
                                        <span class="cmd-item-desc">@_suggestion.Description</span>
                                    }
                                </span>
                                <DrylIcon Name="ArrowRight" Size="12" Class="cmd-item-trailing cmd-item-trailing--ai" />
                            </div>
                        }

                        @foreach (var group in OrderedGroups())
                        {
                            if (group.key.Length > 0)
                            {
                                <div class="cmd-category" role="presentation" aria-hidden="true">
                                    @group.key
                                </div>
                            }

                            foreach (var row in group.rows)
                            {
                                var rIdx = idx++;
                                var isFocused = rIdx == _focusedIndex;
                                var current = row;
                                <div id="@ItemId(rIdx)"
                                     role="option"
                                     class="@RowCss(current, isFocused)"
                                     aria-selected="@(isFocused ? "true" : "false")"
                                     aria-disabled="@(current.Disabled ? "true" : null)"
                                     @onclick="() => RunRowAsync(current)"
                                     @onmouseenter="@(() => _focusedIndex = rIdx)"
                                     @key="rIdx">

                                    @if (!string.IsNullOrEmpty(current.Icon))
                                    {
                                        <span class="cmd-item-icon">
                                            <DrylIcon Name="@current.Icon" Size="14" />
                                        </span>
                                    }

                                    <span class="cmd-item-body">
                                        <span class="cmd-item-label">@current.Label</span>
                                        @if (!string.IsNullOrEmpty(current.Description))
                                        {
                                            <span class="cmd-item-desc">@current.Description</span>
                                        }
                                    </span>

                                    @if (!string.IsNullOrEmpty(current.Shortcut))
                                    {
                                        <kbd class="cmd-item-shortcut" aria-hidden="true">@current.Shortcut</kbd>
                                    }
                                    else if (current.Trailing == RowTrailing.Navigate)
                                    {
                                        <DrylIcon Name="ArrowRight" Size="12" Class="cmd-item-trailing" />
                                    }
                                    else if (current.Trailing == RowTrailing.Ai)
                                    {
                                        <DrylIcon Name="Sparkle" Size="12" Class="cmd-item-trailing cmd-item-trailing--ai" />
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            }

            @if (Ai != AiState.None)
            {
                <div class="cmd-divider" role="separator"></div>
                <div class="@AiPanelCssClass"
                     aria-live="polite"
                     aria-label="AI result">
                    <DrylAiIndicator State="@Ai" />
                    @AiContent
                </div>
            }
        </div>
    </div>
}

@code {
    // ── Parameters ────────────────────────────────────────────

    /// <summary>Controls whether the palette overlay is visible. Supports @bind-Open.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Fires when the Open state changes — enables two-way @bind-Open binding.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Placeholder text for the search input.</summary>
    [Parameter] public string Placeholder { get; set; } = "Search commands…";

    /// <summary>Empty-state text shown when no command matches.</summary>
    [Parameter] public string EmptyText { get; set; } = "Keine Treffer";

    /// <summary>Maximum number of registry commands shown for a query. Legacy items are not capped.</summary>
    [Parameter] public int MaxResults { get; set; } = 8;

    /// <summary>Enables the global ⌘K / Ctrl+K toggle. Defaults to true.</summary>
    [Parameter] public bool HotKey { get; set; } = true;

    /// <summary>Static item list used when <see cref="SearchProvider"/> is not set.</summary>
    [Parameter] public CommandItem[]? Items { get; set; }

    /// <summary>
    /// Async search provider invoked with the current query string.
    /// Takes precedence over <see cref="Items"/> when set.
    /// A 250 ms debounce prevents excessive calls during fast typing.
    /// </summary>
    [Parameter] public Func<string, Task<CommandItem[]>>? SearchProvider { get; set; }

    /// <summary>
    /// Optional AI seam. When set, a natural-language query is resolved into a single confirmable
    /// command suggestion shown at the top of the list. The core references no AI package; supply an
    /// implementation (e.g. <c>DRYL.Components.Agents.DrylAiCommandResolver</c>).
    /// </summary>
    [Parameter] public ICommandResolver? Resolver { get; set; }

    /// <summary>
    /// AI result panel state. When non-None the palette shell shows the shared AI aura
    /// and an AI result panel appears below the results list.
    /// Defaults to <see cref="AiState.None"/> — AI styling is opt-in.
    /// </summary>
    [Parameter] public AiState Ai { get; set; } = AiState.None;

    /// <summary>AI aura variant. Leave <c>null</c> to inherit a surrounding <c>DrylAiScope</c> (ultimately <see cref="AiAura.Comet"/>).</summary>
    [Parameter] public AiAura? Aura { get; set; }

    /// <summary>Surrounding AI scope (supplied by <c>DrylAiScope</c>); used to resolve the aura variant.</summary>
    [CascadingParameter] private AiScope? Scope { get; set; }

    private AiAura EffectiveAura => AiScope.ResolveAura(Aura, Scope);

    /// <summary>Content rendered inside the AI result panel when <see cref="Ai"/> is non-None.</summary>
    [Parameter] public RenderFragment? AiContent { get; set; }

    /// <summary>Hosts declarative <see cref="DrylCommand"/> children.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>ARIA label for the palette dialog element. Defaults to "Command palette".</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Additional CSS classes applied to the palette panel element.</summary>
    [Parameter] public string? Class { get; set; }

    // ── Result row model ───────────────────────────────────────

    private enum RowTrailing { None, Navigate, Ai }

    private sealed record PaletteRow(
        string Label, string? Description, string? Icon, string? Group,
        string? Shortcut, bool Disabled, bool Destructive, bool IsSuggestion,
        RowTrailing Trailing, Func<Task> Run);

    // ── State ──────────────────────────────────────────────────

    private readonly string _listId     = $"dryl-cmd-list-{Guid.NewGuid():N}";
    private readonly string _itemPrefix = $"dryl-cmd-item-{Guid.NewGuid():N}";

    private string  _query         = string.Empty;
    private bool    _isLoading;
    private int     _focusedIndex  = 0;
    private bool    _jsReady;
    private bool    _prevOpen;
    private bool    _shouldAttachModal;
    private bool    _modalAttached;

    private AiState _prevAi  = AiState.None;
    private int     _genTick;
    private readonly AuraLifecycle _aura = new();

    private bool _resolving;
    private PaletteRow? _suggestion;

    private DrylCommand? _fillingCommand;
    private Dictionary<string, object?> _fillValues = new();

    private ICommandRegistry _registry = default!;
    private IDrylDialogService? _dialogs;

    private CancellationTokenSource?                    _searchCts;
    private DotNetObjectReference<DrylCommandPalette>?  _dotnetRef;
    private List<PaletteRow>                            _displayRows = new();

    private ElementReference _backdrop;
    private ElementReference _palette;
    private ElementReference _searchInput;
    private ElementReference _list;

    // ── Lifecycle ──────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _registry = Services.GetService(typeof(ICommandRegistry)) as ICommandRegistry
                    ?? new CommandRegistry();
        _dialogs  = Services.GetService(typeof(IDrylDialogService)) as IDrylDialogService;
        _registry.OnChanged += OnRegistryChanged;
    }

    private void OnRegistryChanged()
    {
        if (Open)
            _ = InvokeAsync(() => { RunSearch(_query); });
    }

    protected override void OnParametersSet()
    {
        if (Ai == AiState.Generated && _prevAi != AiState.Generated)
            _genTick++;
        _prevAi = Ai;
        _aura.Sync(Ai, () => InvokeAsync(StateHasChanged));

        // Rising edge: palette just opened
        if (Open && !_prevOpen)
        {
            _query             = string.Empty;
            _focusedIndex      = 0;
            _suggestion        = null;
            _resolving         = false;
            _fillingCommand    = null;
            _shouldAttachModal = true;
            RunSearch(string.Empty);
        }
        _prevOpen = Open;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotnetRef = DotNetObjectReference.Create(this);
            if (HotKey)
                await JS.InvokeVoidAsync("dryl.commandpalette.attachGlobal", _dotnetRef);
            _jsReady = true;
        }

        if (_shouldAttachModal && _jsReady && Open)
        {
            _shouldAttachModal = false;
            // Portal the backdrop to <body> so it is always in the root stacking
            // context, even when the component is rendered deep inside a page.
            await JS.InvokeVoidAsync("dryl.commandpalette.portal", _backdrop);
            await JS.InvokeVoidAsync("dryl.modal.attach",
                _backdrop, _dotnetRef,
                new { closeOnEscape = true, trapFocus = true });
            _modalAttached = true;
            await JS.InvokeVoidAsync("dryl.commandpalette.focusInput", _searchInput);
        }
    }

    // ── JS-invokable callbacks ─────────────────────────────────

    /// <summary>Called by dryl.modal when Escape is pressed inside the backdrop.</summary>
    [JSInvokable]
    public Task OnEscape() => CloseAsync();

    /// <summary>Called by dryl.commandpalette when Ctrl+K is pressed outside an input.</summary>
    [JSInvokable]
    public async Task OnGlobalOpen()
    {
        if (!Open)
        {
            Open = true;
            await OpenChanged.InvokeAsync(true);
            StateHasChanged();
        }
    }

    // ── Open / Close ───────────────────────────────────────────

    private async Task CloseAsync()
    {
        if (_modalAttached)
        {
            await JS.InvokeVoidAsync("dryl.modal.detach", _backdrop);
            _modalAttached = false;
        }
        _fillingCommand = null;
        Open = false;
        await OpenChanged.InvokeAsync(false);
        StateHasChanged();
    }

    private void HandleBackdropClick() => _ = CloseAsync();

    // ── Search ─────────────────────────────────────────────────

    private void HandleInput(ChangeEventArgs e)
    {
        _query        = e.Value?.ToString() ?? string.Empty;
        _focusedIndex = 0;
        _suggestion   = null;
        RunSearch(_query);
    }

    private void RunSearch(string query)
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var cts = _searchCts;

        _ = Task.Run(async () =>
        {
            try
            {
                CommandItem[] legacy;

                if (SearchProvider != null)
                {
                    _isLoading = true;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(250, cts.Token);
                    legacy     = await SearchProvider(query);
                    _isLoading = false;
                }
                else
                {
                    legacy = ClientFilter(Items ?? [], query);
                }

                if (cts.IsCancellationRequested) return;

                var rows = new List<PaletteRow>();
                foreach (var item in legacy)
                    rows.Add(LegacyRow(item));
                foreach (var cmd in CommandFuzzyMatcher.Match(_registry.Commands, query, MaxResults))
                    rows.Add(CommandRow(cmd));

                _displayRows  = rows;
                _focusedIndex = 0;
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) { /* fast typing — expected */ }
            catch
            {
                _isLoading = false;
                await InvokeAsync(StateHasChanged);
            }

            if (!cts.IsCancellationRequested)
                await ResolveAsync(query, cts.Token);
        }, cts.Token);
    }

    private async Task ResolveAsync(string query, CancellationToken token)
    {
        if (Resolver is null || string.IsNullOrWhiteSpace(query))
        {
            _suggestion = null;
            return;
        }

        try
        {
            _resolving = true;
            await InvokeAsync(StateHasChanged);

            var commands = _registry.Commands.Where(c => !c.Disabled).ToList();
            if (commands.Count == 0) return;

            var resolution = await Resolver.ResolveAsync(query, commands, token);
            if (token.IsCancellationRequested) return;

            _suggestion = resolution is null ? null : BuildSuggestionRow(resolution);
        }
        catch (OperationCanceledException) { /* superseded query — expected */ }
        catch { /* a resolver failure must never break manual search */ }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _resolving = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private static CommandItem[] ClientFilter(CommandItem[] src, string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return src;
        return src.Where(i =>
            i.Label.Contains(query, StringComparison.OrdinalIgnoreCase) ||
            (i.Description?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (i.Category?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
        ).ToArray();
    }

    // ── Row projection ─────────────────────────────────────────

    private PaletteRow LegacyRow(CommandItem item) => new(
        item.Label, item.Description, item.Icon, item.Category,
        Shortcut: null, Disabled: false, Destructive: false, IsSuggestion: false,
        Trailing: item.Type switch
        {
            CommandItemType.Navigate => RowTrailing.Navigate,
            CommandItemType.AiIntent => RowTrailing.Ai,
            _                        => RowTrailing.None,
        },
        Run: () => ExecuteLegacyAsync(item));

    private PaletteRow CommandRow(DrylCommand cmd) => new(
        cmd.Title, cmd.Description, cmd.Icon, cmd.Group,
        cmd.Shortcut, cmd.Disabled, cmd.Destructive, IsSuggestion: false,
        Trailing: RowTrailing.None,
        Run: () => SelectCommandAsync(cmd));

    private PaletteRow BuildSuggestionRow(CommandResolution res) => new(
        res.Command.Title, res.Command.Description, res.Command.Icon, Group: null,
        Shortcut: null, Disabled: false, Destructive: res.Command.Destructive, IsSuggestion: true,
        Trailing: RowTrailing.Ai,
        Run: () => RunResolvedAsync(res));

    // ── Grouping / flattening ──────────────────────────────────

    private List<(string key, List<PaletteRow> rows)> OrderedGroups()
    {
        var dict  = new Dictionary<string, List<PaletteRow>>(StringComparer.OrdinalIgnoreCase);
        var order = new List<string>();

        foreach (var row in _displayRows)
        {
            var key = row.Group ?? string.Empty;
            if (!dict.TryGetValue(key, out var list))
            {
                list = new List<PaletteRow>();
                dict[key] = list;
                order.Add(key);
            }
            list.Add(row);
        }

        var result = new List<(string, List<PaletteRow>)>();
        foreach (var key in order.Where(k => k.Length > 0).OrderBy(k => k, StringComparer.OrdinalIgnoreCase))
            result.Add((key, dict[key]));
        if (dict.TryGetValue(string.Empty, out var ungrouped))
            result.Add((string.Empty, ungrouped));
        return result;
    }

    private List<PaletteRow> Flat()
    {
        var list = new List<PaletteRow>();
        if (_suggestion is not null) list.Add(_suggestion);
        foreach (var group in OrderedGroups())
            list.AddRange(group.rows);
        return list;
    }

    // ── Keyboard navigation ────────────────────────────────────

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        var flat  = Flat();
        var count = flat.Count;
        if (count == 0 && e.Key is not "Escape") return;

        switch (e.Key)
        {
            case "ArrowDown":
                _focusedIndex = (_focusedIndex + 1) % Math.Max(1, count);
                await JS.InvokeVoidAsync("dryl.commandpalette.scrollItemIntoView",
                    _list, ItemId(_focusedIndex));
                break;

            case "ArrowUp":
                _focusedIndex = (_focusedIndex - 1 + Math.Max(1, count)) % Math.Max(1, count);
                await JS.InvokeVoidAsync("dryl.commandpalette.scrollItemIntoView",
                    _list, ItemId(_focusedIndex));
                break;

            case "Enter":
                if (_focusedIndex >= 0 && _focusedIndex < count)
                    await RunRowAsync(flat[_focusedIndex]);
                break;

            case "Escape":
                await CloseAsync();
                break;
        }
    }

    // ── Execution ──────────────────────────────────────────────

    private Task RunRowAsync(PaletteRow row) => row.Disabled ? Task.CompletedTask : row.Run();

    private async Task ExecuteLegacyAsync(CommandItem item)
    {
        switch (item.Type)
        {
            case CommandItemType.Navigate:
                if (!string.IsNullOrEmpty(item.Href))
                {
                    await CloseAsync();
                    Nav.NavigateTo(item.Href);
                }
                break;

            case CommandItemType.Action:
                await CloseAsync();
                await item.Action.InvokeAsync();
                break;

            case CommandItemType.AiIntent:
                // Keep the palette open so the AI result panel can display the response.
                await item.AiAction.InvokeAsync();
                break;
        }
    }

    private async Task SelectCommandAsync(DrylCommand cmd)
    {
        if (cmd.Disabled) return;
        if (cmd.Arguments.Count > 0)
        {
            OpenArgFill(cmd, seed: null);
            return;
        }
        await RunCommandAsync(cmd, new CommandContext(
            new Dictionary<string, object?>(), _searchCts?.Token ?? default));
    }

    private async Task RunResolvedAsync(CommandResolution res)
    {
        var cmd = res.Command;
        var missingRequired = cmd.Arguments.Any(a =>
            a.Required && (!res.Arguments.TryGetValue(a.Name, out var v) || v is null));

        if (cmd.Arguments.Count > 0 && missingRequired)
        {
            OpenArgFill(cmd, res.Arguments);
            return;
        }
        await RunCommandAsync(cmd, new CommandContext(res.Arguments, _searchCts?.Token ?? default));
    }

    private async Task RunCommandAsync(DrylCommand cmd, CommandContext ctx)
    {
        if (cmd.Destructive && _dialogs is not null)
        {
            var result = await _dialogs.ShowConfirmAsync(
                "Confirm action", cmd.Title, "Run", "Cancel");
            if (result.Canceled) return;
        }
        await CloseAsync();
        await cmd.RunAsync(ctx);
    }

    // ── Argument fill ──────────────────────────────────────────

    private void OpenArgFill(DrylCommand cmd, IReadOnlyDictionary<string, object?>? seed)
    {
        _fillingCommand = cmd;
        _fillValues     = new Dictionary<string, object?>();
        if (seed is not null)
            foreach (var kv in seed)
                _fillValues[kv.Key] = kv.Value;
        StateHasChanged();
    }

    private void CancelArgFill()
    {
        _fillingCommand = null;
        StateHasChanged();
    }

    private async Task ConfirmArgFill()
    {
        var cmd = _fillingCommand;
        if (cmd is null) return;
        await RunCommandAsync(cmd, BuildContext(cmd));
    }

    private CommandContext BuildContext(DrylCommand cmd)
    {
        var dict = new Dictionary<string, object?>();
        foreach (var arg in cmd.Arguments)
        {
            _fillValues.TryGetValue(arg.Name, out var raw);
            dict[arg.Name] = arg.Type switch
            {
                CommandArgType.Number  => double.TryParse(raw?.ToString(),
                                              System.Globalization.NumberStyles.Any,
                                              System.Globalization.CultureInfo.InvariantCulture,
                                              out var d) ? d : null,
                CommandArgType.Boolean => raw is bool b ? b : bool.TryParse(raw?.ToString(), out var bb) && bb,
                _                      => raw?.ToString(),
            };
        }
        return new CommandContext(dict, _searchCts?.Token ?? default);
    }

    private string AsString(string name) =>
        _fillValues.TryGetValue(name, out var v) ? v?.ToString() ?? string.Empty : string.Empty;

    private bool AsBool(string name) =>
        _fillValues.TryGetValue(name, out var v) && v is bool b && b;

    private static SelectItem[] ToItems(string[]? options) =>
        (options ?? Array.Empty<string>()).Select(o => new SelectItem(o, o)).ToArray();

    // ── CSS helpers ────────────────────────────────────────────

    private string PaletteCssClass
    {
        get
        {
            var parts = new List<string> { "cmd-palette" };
            AiAuraCss.Append(parts, _aura, EffectiveAura);
            if (!string.IsNullOrWhiteSpace(Class)) parts.Add(Class);
            return string.Join(' ', parts);
        }
    }

    private string SearchRowCss
    {
        get
        {
            var parts = new List<string> { "cmd-search-row" };
            if (_resolving) { parts.Add("ai-aura"); parts.Add("ai-thinking"); }
            return string.Join(' ', parts);
        }
    }

    private string AiPanelCssClass
    {
        get
        {
            var parts = new List<string> { "cmd-ai-panel" };
            switch (Ai)
            {
                case AiState.Thinking:  parts.Add("ai-thinking");  break;
                case AiState.Streaming: parts.Add("ai-streaming"); break;
                case AiState.Generated: parts.Add("ai-generated"); break;
            }
            return string.Join(' ', parts);
        }
    }

    private static string RowCss(PaletteRow row, bool isFocused)
    {
        var parts = new List<string> { "cmd-item" };
        if (isFocused) parts.Add("is-focused");
        if (row.Disabled) parts.Add("is-disabled");
        if (row.Destructive) parts.Add("cmd-item--danger");
        if (row.IsSuggestion) parts.Add("cmd-item--ai");
        return string.Join(' ', parts);
    }

    private string ItemId(int index) => $"{_itemPrefix}-{index}";

    private string? ActiveDescendant =>
        Flat().Count > 0 ? ItemId(_focusedIndex) : null;

    // ── Disposal ───────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        _aura.Dispose();

        if (_registry is not null)
            _registry.OnChanged -= OnRegistryChanged;

        _searchCts?.Cancel();
        _searchCts?.Dispose();

        if (_jsReady)
        {
            try
            {
                await JS.InvokeVoidAsync("dryl.commandpalette.detachGlobal", _dotnetRef);
                if (_modalAttached)
                    await JS.InvokeVoidAsync("dryl.modal.detach", _backdrop);
            }
            catch (JSDisconnectedException) { /* circuit torn down — safe to ignore */ }
        }

        _dotnetRef?.Dispose();
    }
}
