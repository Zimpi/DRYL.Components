@namespace DRYL.Components
@inject IJSRuntime JS
@implements IAsyncDisposable

@*  ─────────────────────────────────────────────────────────
    DrylReveal — animates its content in as it scrolls into view.

    An IntersectionObserver (via dryl.motion) adds the revealed state
    the first time the wrapper enters the viewport; direct children
    tween in, optionally staggered. Use it on content-heavy or
    marketing surfaces for a motion.dev-style scroll entrance
    (rule 2.12).

    Usage:
      <DrylReveal Transition="RevealTransition.Rise" Stagger>
          <DrylCard>One</DrylCard>
          <DrylCard>Two</DrylCard>
          <DrylCard>Three</DrylCard>
      </DrylReveal>

    Honours prefers-reduced-motion: content shows immediately with no
    movement.
    ───────────────────────────────────────────────────────── *@

<div class="@WrapperCss" @ref="_el" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>The content to reveal. Direct children are the animated units.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Which entrance animation the children play.</summary>
    [Parameter] public RevealTransition Transition { get; set; } = RevealTransition.Rise;

    /// <summary>If true, successive direct children animate in one after another (stagger).</summary>
    [Parameter] public bool Stagger { get; set; }

    /// <summary>If true (default), reveal happens once; if false, content re-hides when scrolled away.</summary>
    [Parameter] public bool Once { get; set; } = true;

    /// <summary>Fraction of the element that must be visible to trigger the reveal (0–1).</summary>
    [Parameter] public double Threshold { get; set; } = 0.15;

    /// <summary>Extra CSS class(es) merged onto the wrapper element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through HTML attributes on the wrapper element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _el;
    private bool _attached;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var opts = new { stagger = Stagger, once = Once, threshold = Threshold };
        try
        {
            await JS.InvokeVoidAsync("dryl.motion.observe", _el, (object?)null, opts);
            _attached = true;
        }
        catch (JSDisconnectedException) { /* circuit gone */ }
    }

    private string WrapperCss
    {
        get
        {
            var parts = new List<string>
            {
                "reveal",
                Transition switch
                {
                    RevealTransition.Fade    => "reveal--fade",
                    RevealTransition.ScaleIn => "reveal--scale-in",
                    _ => "reveal--rise"
                }
            };
            if (!string.IsNullOrWhiteSpace(Class)) parts.Add(Class!);
            return string.Join(' ', parts);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_attached)
        {
            try { await JS.InvokeVoidAsync("dryl.motion.unobserve", _el); }
            catch (JSDisconnectedException) { /* circuit gone */ }
            catch (InvalidOperationException) { /* prerender — no JS */ }
        }
    }
}
