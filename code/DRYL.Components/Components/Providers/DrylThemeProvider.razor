@namespace DRYL.Components
@using DRYL.Components.Theming
@inject IDrylThemeService ThemeService
@inject IJSRuntime JS
@implements IDisposable

@*  ─────────────────────────────────────────────────────────
    DrylThemeProvider — applies the active DrylTheme's seed
    custom properties to :root.

    Place once in your root layout, above the other providers:
        <DrylThemeProvider Theme="DrylThemes.Nebula" />

    On render it writes the seeds into an inline <style> for
    :root, so first paint (incl. Blazor Server prerender) is
    correct with no JS. Runtime theme changes are pushed to
    document.documentElement via dryl.theme.apply, where the
    registered @property color seeds + :root transition make
    the derived color-mix chain glide.
    ───────────────────────────────────────────────────────── *@

<style nonce="@Nonce">@($":root {{ {_vars} }}")</style>
@((MarkupString)_modeScript)

@code {
    /// <summary>
    /// The theme to apply. When omitted, <see cref="DrylThemes.Default"/> (the
    /// signature DRYL look) is used. Passing a different theme later applies it,
    /// so the parameter can be bound to a field. A theme set at runtime through
    /// <see cref="IDrylThemeService"/> stays until this parameter itself changes.
    /// </summary>
    [Parameter] public DrylTheme? Theme { get; set; }

    /// <summary>
    /// The color mode to start in — a startup value only: changing it on a
    /// mounted provider has no effect. Defaults to <see cref="DrylColorMode.System"/>
    /// (follow the OS). A persisted explicit user choice — made earlier via
    /// <see cref="IDrylThemeService.SetModeAsync"/> — wins over this parameter.
    /// To switch the mode at runtime, call <see cref="IDrylThemeService.SetModeAsync"/>.
    /// </summary>
    [Parameter] public DrylColorMode Mode { get; set; } = DrylColorMode.System;

    /// <summary>
    /// The Content Security Policy nonce of the current response. The provider
    /// writes an inline <c>&lt;style&gt;</c> and an inline <c>&lt;script&gt;</c>;
    /// under a policy without <c>'unsafe-inline'</c> pass the nonce here and both
    /// carry it. Leave null when your policy allows inline code or you have none.
    /// </summary>
    [Parameter] public string? Nonce { get; set; }

    private string _vars = "";
    private string _modeScript = "";
    private bool _attached;
    private bool _persist = true;

    // The Theme parameter as last applied. Compared against the parameter, not
    // against the service: a theme picked at runtime must survive the next
    // parent render that passes the unchanged parameter again.
    private DrylTheme? _appliedParameter;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += HandleChangedAsync;
        ThemeService.OnModeChanged += HandleModeChangedAsync;

        if (Theme is not null && !Equals(Theme, ThemeService.Current))
        {
            // Updates _vars through the handler; JS is skipped because we are not
            // attached yet, so the inline <style> below carries the initial paint.
            await ThemeService.SetThemeAsync(Theme);
        }

        _appliedParameter = Theme;
        _vars = ThemeService.Current.ToCssVariables();

        // Pre-paint restore script: runs during HTML parsing, before first paint,
        // so a persisted explicit choice (or this Mode fallback) never flashes.
        // Kept in sync with dryl.theme.applyMode/storedMode in dryl.js.
        var p = Mode switch { DrylColorMode.Light => "light", DrylColorMode.Dark => "dark", _ => "" };
        var nonce = string.IsNullOrEmpty(Nonce)
            ? ""
            : " nonce=\"" + System.Net.WebUtility.HtmlEncode(Nonce) + "\"";
        _modeScript =
            "<script" + nonce + ">(function(){try{var p='" + p + "';" +
            "var m=localStorage.getItem('dryl-color-mode');" +
            "m=(m==='light'||m==='dark')?m:p;" +
            "if(m){document.documentElement.setAttribute('data-dryl-mode',m);}}catch(e){}})();</script>";
    }

    protected override async Task OnParametersSetAsync()
    {
        // Records compare by value, so an equal theme built anew on every parent
        // render (Theme="@(new DrylTheme { … })") is not applied again.
        if (Theme is null || Equals(Theme, _appliedParameter)) return;
        _appliedParameter = Theme;
        if (!Equals(Theme, ThemeService.Current))
            await ThemeService.SetThemeAsync(Theme);
    }

    private async Task HandleChangedAsync()
    {
        _vars = ThemeService.Current.ToCssVariables();
        await InvokeAsync(StateHasChanged);

        if (_attached)
        {
            try { await JS.InvokeVoidAsync("dryl.theme.apply", _vars); }
            catch (JSDisconnectedException) { /* circuit gone */ }
        }
    }

    private async Task HandleModeChangedAsync()
    {
        await InvokeAsync(StateHasChanged);

        if (_attached)
        {
            var mode = ThemeService.CurrentMode switch
            {
                DrylColorMode.Light => "light",
                DrylColorMode.Dark => "dark",
                _ => "system",
            };
            try { await JS.InvokeVoidAsync("dryl.theme.applyMode", mode, _persist); }
            catch (JSDisconnectedException) { /* circuit gone */ }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // After the first render the inline <style>/pre-paint script have painted;
        // subsequent changes go through JS so the @property transition can interpolate.
        if (!firstRender) return;
        _attached = true;

        // Sync the C# CurrentMode with whatever the pre-paint script actually
        // applied (a persisted localStorage choice takes precedence over the
        // Mode parameter — see the script built in OnInitializedAsync).
        string? stored = null;
        try { stored = await JS.InvokeAsync<string?>("dryl.theme.storedMode"); }
        catch (JSDisconnectedException) { return; }

        var startup = stored switch
        {
            "light" => DrylColorMode.Light,
            "dark" => DrylColorMode.Dark,
            _ => Mode,
        };
        if (startup != ThemeService.CurrentMode)
        {
            _persist = false; // startup sync is not a user choice — don't touch localStorage
            try { await ThemeService.SetModeAsync(startup); }
            finally { _persist = true; }
        }
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleChangedAsync;
        ThemeService.OnModeChanged -= HandleModeChangedAsync;
    }
}
