@namespace DRYL.Components.Agents
@using DRYL.Components.Ai
@implements IDisposable

@*  ─────────────────────────────────────────────────────────
    DrylAiCanvas — renders an AI-built artifact (a DrylCanvasRun)
    as a live tree of curated DRYL components.

    The header carries the artifact title and a DrylAiIndicator that
    reflects the run's state; a visually-hidden aria-live region
    announces build/update/ready/failure to assistive tech. The body
    recursively renders the spec's root via CanvasNodeView, which
    receives the run, the shared form state and the intent callback as
    cascading values.

    The whole surface is an AI aura host (the shared DrylToolCall idiom):
    an ai-aura ring/comet that breathes with the run state and flashes
    once on completion.

    Usage:
      <DrylAiCanvas Run="_canvasRun"
                    OnInteraction="i => _chat.Send(i.ToPromptMessage())" />
    ───────────────────────────────────────────────────────── *@

<div class="@RootCssClass" @attributes="AdditionalAttributes">
    <DrylAuraElements Aura="_aura" GenTick="_genTick" />

    <div class="canvas-head">
        <span class="canvas-title">@(Run?.Spec?.Title ?? "Artifact")</span>
        <DrylAiIndicator State="@(Run?.State ?? AiState.None)">@StatusLabel</DrylAiIndicator>
    </div>

    <div class="canvas-live" aria-live="polite">@_announcement</div>

    <div class="canvas-body" @ref="_bodyEl">
        @if (Run?.Error is not null)
        {
            <DrylAlert Kind="DrylAlert.AlertKind.Danger" Title="Artifact failed">@Run.Error.Message</DrylAlert>
        }
        else if (Run?.Spec?.Root is { } root)
        {
            <CascadingValue Value="Run" IsFixed="true">
                <CascadingValue Value="_form" IsFixed="true">
                    <CascadingValue Name="CanvasIntent" Value="_intentCallback">
                        <CanvasNodeView Node="root" />
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        }
        else
        {
            <DrylEmptyState Title="No artifact yet">Ask the assistant to create one.</DrylEmptyState>
        }
    </div>
</div>

@code {
    /// <summary>The canvas run to render. Rebinding to a different run resets the interactive form state.</summary>
    [Parameter] public DrylCanvasRun? Run { get; set; }

    /// <summary>Raised when the user triggers a button intent inside the artifact.
    /// Send <c>interaction.ToPromptMessage()</c> as the next chat turn to route it to the AI.</summary>
    [Parameter] public EventCallback<CanvasInteraction> OnInteraction { get; set; }

    /// <summary>Extra CSS class(es) merged onto the canvas root.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Pass-through HTML attributes on the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    // The body element — Task 9 attaches the FLIP/move JS to it. Declared now so the ref exists.
    private ElementReference _bodyEl;

    private DrylCanvasRun? _subscribed;
    private CanvasFormState _form = new();
    private EventCallback<CanvasInteraction> _intentCallback;

    private int _genTick;
    private AiState _prevState = AiState.None;
    private readonly AuraLifecycle _aura = new();
    private string? _announcement;

    protected override void OnInitialized() =>
        _intentCallback = EventCallback.Factory.Create<CanvasInteraction>(this, i => OnInteraction.InvokeAsync(i));

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribed, Run))
        {
            if (_subscribed is not null) _subscribed.OnChange -= HandleChange;
            _subscribed = Run;
            _form = new CanvasFormState();     // fresh form for a fresh artifact
            if (_subscribed is not null) _subscribed.OnChange += HandleChange;
        }

        var state = Run?.State ?? AiState.None;
        if (state == AiState.Generated && _prevState != AiState.Generated) _genTick++;
        _prevState = state;
        _aura.Sync(state, () => InvokeAsync(StateHasChanged));
        UpdateAnnouncement();
    }

    private void HandleChange() => InvokeAsync(() =>
    {
        var state = Run?.State ?? AiState.None;
        if (state == AiState.Generated && _prevState != AiState.Generated) _genTick++;
        _prevState = state;
        _aura.Sync(state, () => InvokeAsync(StateHasChanged));
        UpdateAnnouncement();
        StateHasChanged();
    });

    // Keeps the aria-live region in step with the run so screen-reader users hear where
    // the AI is at work without reading a label (rule 2.9).
    private void UpdateAnnouncement()
    {
        if (Run is null) { _announcement = null; return; }

        if (Run.Error is not null)
        {
            _announcement = "Artifact failed.";
            return;
        }

        _announcement = Run.State switch
        {
            AiState.Streaming => "Building artifact…",
            AiState.Generated when Run.Round > 1 =>
                FormattableString.Invariant($"Artifact updated, {Run.ChangedIds.Count} changes."),
            AiState.Generated => "Artifact ready.",
            _ => _announcement,
        };
    }

    private string StatusLabel => (Run?.State ?? AiState.None) switch
    {
        AiState.Streaming => "Building",
        AiState.Thinking => "Working",
        AiState.Generated => "Ready",
        _ => "Idle",
    };

    private string RootCssClass
    {
        get
        {
            var parts = new List<string> { "ai-canvas", "glass-card" };
            AiAuraCss.Append(parts, _aura, AiAura.Comet);
            if (!string.IsNullOrWhiteSpace(Class)) parts.Add(Class!);
            return string.Join(' ', parts);
        }
    }

    public void Dispose()
    {
        if (_subscribed is not null) _subscribed.OnChange -= HandleChange;
        _aura.Dispose();
    }
}
