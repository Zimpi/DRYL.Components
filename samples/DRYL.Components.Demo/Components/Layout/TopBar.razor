@using Microsoft.AspNetCore.Components.Routing

@*  Global website top bar — shared by LandingLayout and MainLayout.
    Brand + primary nav (Get Started, Components) on the left, a Ctrl+K
    search trigger, GitHub link and version badge on the right.
    Renders DrylAppBar directly so it stays the grid "topbar" child. *@

<DrylAppBar>
    <a href="" class="brand topbar-brand">
        <div class="brand-mark">
            <img src="favicon.png" alt="" class="brand-mark-logo" />
        </div>
        <div style="display: flex; flex-direction: column;">
            <span class="brand-name">DRYL</span>
            <span class="brand-sub">v0.1 · WIP</span>
        </div>
    </a>

    <nav class="topbar-nav" aria-label="Primary">
        <NavLink class="topbar-link" href="getting-started">Get Started</NavLink>
        <NavLink class="topbar-link" href="components">Components</NavLink>
    </nav>

    <div class="topbar-spacer"></div>

    <button type="button" class="search topbar-search-trigger" @onclick="OnSearch" aria-label="Search components">
        <DrylIcon Name="Search" Size="14" />
        <span class="topbar-search-label">Search components…</span>
        <DrylKbd Keys="@(new[] { "Ctrl", "K" })" />
    </button>

    <a class="topbar-icon-link"
       href="@ComponentCatalog.RepoUrl"
       target="_blank"
       rel="noopener"
       aria-label="GitHub repository">
        <DrylIcon Name="Code" Size="18" />
    </a>

    <DrylBadge Kind="DrylBadge.BadgeKind.Warning">Pre-0.1</DrylBadge>
</DrylAppBar>

@code {
    /// <summary>Invoked when the search trigger is clicked — the host layout opens its command palette.</summary>
    [Parameter] public EventCallback OnSearch { get; set; }
}
