@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    DemoToc — reiner Container; JS (demo-toc.js) übernimmt Scanning,
    Rendering und Navigation-Tracking via MutationObserver.
*@

<nav @ref="_el" class="demo-toc" aria-label="Auf dieser Seite"></nav>

@code {
    private ElementReference _el;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try   { await JS.InvokeVoidAsync("drylToc.init", _el); }
        catch (JSException) { /* prerender — JS nicht verfügbar */ }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("drylToc.destroy"); }
        catch (JSException) { }
    }
}
