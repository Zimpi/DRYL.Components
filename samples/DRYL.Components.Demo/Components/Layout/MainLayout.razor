@inherits LayoutComponentBase

<DrylLayout>
    <TopBar OnSearch="OpenPalette" />

    <DrylDrawer @bind-Open="_drawerOpen">
        <NavMenu />
    </DrylDrawer>

    <DrylMainContent>
        <div class="demo-page-wrap">
            <div class="demo-page-content">
                @Body
            </div>
            <DemoToc />
        </div>
    </DrylMainContent>
</DrylLayout>

<DrylCommandPalette @bind-Open="_cmdOpen"
                    Items="@ComponentCatalog.ToCommandItems()"
                    Placeholder="Search components…" />

<DrylDialogProvider />
<DrylToastProvider Position="ToastPosition.BottomRight" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool _drawerOpen;
    private bool _cmdOpen;

    private void OpenPalette() => _cmdOpen = true;
}
