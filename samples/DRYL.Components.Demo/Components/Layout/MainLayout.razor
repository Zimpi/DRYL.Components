@inherits LayoutComponentBase

@*  The website's own chrome is built from the DRYL app-shell components and
    doubles as a live reference for them: a Pinnable DrylDrawer (collapse state
    persisted to localStorage) with Header / Content / Footer slots, collapsed
    from the DrylAppBar via ShowSidebarToggle, and DrylLayout coordinating the
    grid reflow. On mobile the same drawer becomes the hamburger overlay. *@

<DrylLayout SidebarWidth="260px">
    <TopBar OnSearch="OpenPalette" ShowSidebarToggle="true" />

    <DrylDrawer Mode="SidebarMode.Pinnable"
                PersistStateKey="dryl.demo.sidebar"
                @bind-Open="_drawerOpen"
                @bind-Collapsed="_navCollapsed">
        <Header>
            <div class="brand">
                <div class="brand-mark">
                    <img src="favicon.png" alt="" class="brand-mark-logo" />
                </div>
                <div class="brand-text sidebar-collapse-hide">
                    <span class="brand-name">DRYL</span>
                    <span class="brand-sub">v0.1 · WIP</span>
                </div>
            </div>
        </Header>
        <Content>
            <NavMenu />
        </Content>
        <Footer>
            <DrylNavGroup Title="Project">
                <DrylNavLink Href="@ComponentCatalog.RepoUrl" Icon="Code" External>GitHub</DrylNavLink>
            </DrylNavGroup>
        </Footer>
    </DrylDrawer>

    <DrylMainContent>
        <div class="demo-page-wrap">
            <div class="demo-page-content">
                @Body
            </div>
            <DemoToc />
        </div>
    </DrylMainContent>
</DrylLayout>

<DrylCommandPalette @bind-Open="_cmdOpen"
                    Items="@ComponentCatalog.ToCommandItems()"
                    Placeholder="Search components…" />

<DrylDialogProvider />
<DrylToastProvider Position="ToastPosition.BottomRight" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool _drawerOpen;
    private bool _navCollapsed;
    private bool _cmdOpen;

    private void OpenPalette() => _cmdOpen = true;
}
