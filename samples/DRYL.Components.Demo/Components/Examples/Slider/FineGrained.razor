<div class="col" style="gap: var(--sp-4); max-width: 560px;">
    <DrylSlider @bind-Value="_opacity"
                Label="Opacity"
                Min="0" Max="1" Step="0.01" />
    <DrylSlider @bind-Value="_temperature"
                Label="Temperature (°C)"
                Min="-40" Max="60" Step="0.5" />
</div>

@code {
    private double _opacity = 1.0;
    private double _temperature = 21.5;
}
