<div class="col" style="gap: var(--sp-4); max-width: 360px;">
    <DrylImage Src="@Sample" Alt="AI-generated artwork"
               Ratio="DrylImage.ImageRatio.Square"
               Rounded="DrylImage.ImageRounded.Lg"
               Ai="@_ai"
               Progress="@(_ai == AiState.Streaming ? (int?)(int)_progress : null)" />

    <div class="row" style="gap: var(--sp-2); flex-wrap: wrap;">
        @foreach (var s in Enum.GetValues<AiState>())
        {
            <DrylButton Variant="@(_ai == s ? DrylButton.ButtonVariant.Primary : DrylButton.ButtonVariant.Ghost)"
                        Size="DrylButton.ButtonSize.Small"
                        @onclick="() => _ai = s">@s.ToString()</DrylButton>
        }
    </div>

    @if (_ai == AiState.Streaming)
    {
        <DrylSlider @bind-Value="_progress" Min="0" Max="100" Label="Sharpen progress" />
    }
</div>

@code {
    private AiState _ai = AiState.Thinking;
    private double _progress = 35;

    // Inline gradient stand-in for a freshly generated image.
    private const string Sample =
        "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='400'>" +
        "<defs><radialGradient id='g' cx='0.35' cy='0.35' r='0.8'>" +
        "<stop offset='0' stop-color='%237c5cff'/><stop offset='0.6' stop-color='%2322d3ee'/>" +
        "<stop offset='1' stop-color='%23070708'/></radialGradient></defs>" +
        "<rect width='400' height='400' fill='url(%23g)'/>" +
        "<circle cx='150' cy='150' r='60' fill='white' fill-opacity='0.18'/></svg>";
}
