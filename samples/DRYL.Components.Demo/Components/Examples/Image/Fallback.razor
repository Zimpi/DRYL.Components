<div class="row" style="gap: var(--sp-4); flex-wrap: wrap; align-items: flex-start;">
    <div style="width: 200px;">
        <DrylImage Src="/does-not-exist.jpg" Alt="Quarterly revenue chart"
                   Ratio="DrylImage.ImageRatio.Video"
                   Rounded="DrylImage.ImageRounded.Md" />
        <p class="lead" style="margin-top: var(--sp-2);">Broken → icon + alt fallback</p>
    </div>

    <div style="width: 200px;">
        <DrylImage Src="/also-missing.png" Alt="Team avatar"
                   FallbackIcon="User"
                   Ratio="DrylImage.ImageRatio.Square"
                   Rounded="DrylImage.ImageRounded.Md" />
        <p class="lead" style="margin-top: var(--sp-2);">Custom <code>FallbackIcon</code></p>
    </div>

    <div style="width: 200px;">
        <DrylImage Src="/missing-primary.jpg" FallbackSrc="@Sample"
                   Alt="With a fallback source"
                   Ratio="DrylImage.ImageRatio.Video"
                   Rounded="DrylImage.ImageRounded.Md" />
        <p class="lead" style="margin-top: var(--sp-2);"><code>FallbackSrc</code> recovers</p>
    </div>
</div>

@code {
    private const string Sample =
        "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='225'>" +
        "<defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>" +
        "<stop offset='0' stop-color='%237c5cff'/><stop offset='1' stop-color='%2322d3ee'/>" +
        "</linearGradient></defs><rect width='400' height='225' fill='%23070708'/>" +
        "<rect width='400' height='225' fill='url(%23g)' opacity='0.5'/></svg>";
}
