<div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); max-width: 720px;">
    <DrylInputNumber @bind-Value="_count"
                     Label="Item count"
                     Min="0"
                     Max="999"
                     Step="1"
                     ShowStepper="true" />
    <DrylInputNumber @bind-Value="_port"
                     Label="Port"
                     Placeholder="8080"
                     Min="1"
                     Max="65535"
                     LeadingIcon="Server" />
</div>

@code {
    private int _count = 5;
    private int? _port;
}
