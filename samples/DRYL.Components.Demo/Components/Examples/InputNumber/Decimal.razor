<div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); max-width: 720px;">
    <DrylInputNumber @bind-Value="_price"
                     Label="Price"
                     Min="0m"
                     Max="9999m"
                     Step="0.01m"
                     LeadingIcon="DollarSign"
                     HelperText="Up to two decimal places." />
    <DrylInputNumber @bind-Value="_ratio"
                     Label="Compression ratio"
                     Min="0.0"
                     Max="1.0"
                     Step="0.01"
                     HelperText="0 – 1" />
</div>

@code {
    private decimal _price = 29.99m;
    private double _ratio = 0.75;
}
