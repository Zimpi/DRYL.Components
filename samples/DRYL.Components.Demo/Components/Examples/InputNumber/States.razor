<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); max-width: 1080px;">
    <DrylInputNumber @bind-Value="_count"
                     Label="Success" State="InputState.Success" />
    <DrylInputNumber @bind-Value="_count"
                     Label="Error" State="InputState.Error" />
    <DrylInputNumber @bind-Value="_count"
                     Label="Disabled" Disabled="true" />
</div>

@code {
    private int _count = 5;
}
