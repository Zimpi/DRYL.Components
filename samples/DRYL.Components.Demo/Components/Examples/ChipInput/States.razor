<div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); max-width: 720px;">
    <DrylChipInput Tags="@(new[] { "blazor", "dotnet" })"
                   Label="Success"
                   State="InputState.Success"
                   HelperText="Tags look good." />
    <DrylChipInput Tags="@(new[] { "invalid tag" })"
                   Label="Error"
                   State="InputState.Error"
                   HelperText="Some tags are invalid." />
    <DrylChipInput Tags="@(new[] { "read", "only" })"
                   Label="Disabled"
                   Disabled="true" />
    <DrylChipInput @bind-Tags="_labels"
                   Label="No label (AriaLabel)" />
</div>

@code {
    private IReadOnlyList<string> _labels = ["blazor", "ui"];
}
