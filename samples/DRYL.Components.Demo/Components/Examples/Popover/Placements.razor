<div class="row" style="gap: var(--sp-4); flex-wrap: wrap;">
    @foreach (var p in Enum.GetValues<PopoverPlacement>())
    {
        <DrylPopover Placement="p">
            <TriggerContent>
                <DrylButton Variant="DrylButton.ButtonVariant.Secondary"
                            Size="DrylButton.ButtonSize.Small">@p.ToString()</DrylButton>
            </TriggerContent>
            <PanelContent>
                <div style="font-size: 13px; color: var(--fg-muted); min-width: 160px;">
                    Panel @p.ToString()
                </div>
            </PanelContent>
        </DrylPopover>
    }
</div>
