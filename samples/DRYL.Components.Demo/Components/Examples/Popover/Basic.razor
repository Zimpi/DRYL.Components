<DrylPopover @bind-Open="_open1">
    <TriggerContent>
        <DrylButton TrailingIcon="ChevronDown">Open popover</DrylButton>
    </TriggerContent>
    <PanelContent>
        <div class="col" style="gap: var(--sp-2); min-width: 220px;">
            <strong style="font-size: 13px;">Quick actions</strong>
            <p style="font-size: 13px; color: var(--fg-muted); margin: 0;">
                Click outside or press Escape to dismiss.
            </p>
            <DrylButton Size="DrylButton.ButtonSize.Small"
                        Variant="DrylButton.ButtonVariant.Secondary"
                        @onclick="() => _open1 = false">Got it</DrylButton>
        </div>
    </PanelContent>
</DrylPopover>

@code {
    private bool _open1;
}
