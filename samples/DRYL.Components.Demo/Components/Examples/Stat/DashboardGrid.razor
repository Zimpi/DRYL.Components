<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--sp-4);">
    <DrylStat Label="Active users" Value="12,480" Icon="User"
              Delta="+12.4%" Direction="DeltaDirection.Up">
        <Sparkline><DrylSparkline Data="@_up" Kind="SparklineKind.Area" /></Sparkline>
    </DrylStat>

    <DrylStat Label="Error rate" Value="0.42%" Icon="Activity"
              Delta="-3.1%" Direction="DeltaDirection.Down">
        <Sparkline><DrylSparkline Data="@_down" Kind="SparklineKind.Line" ShowLastDot="true" /></Sparkline>
    </DrylStat>

    <DrylStat Label="Requests / min" Value="8.2k" Icon="Bolt"
              Delta="0.0%" Direction="DeltaDirection.Neutral">
        <Sparkline><DrylSparkline Data="@_flat" Kind="SparklineKind.Bar" /></Sparkline>
    </DrylStat>

    <DrylStat Label="Revenue" Value="$48,210" Icon="Star"
              Delta="+8.7%" Direction="DeltaDirection.Up" />
</div>

@code {
    private readonly double[] _up   = { 3, 4, 4, 6, 5, 8, 7, 10, 12 };
    private readonly double[] _down = { 12, 10, 11, 8, 9, 6, 5, 4, 3 };
    private readonly double[] _flat = { 6, 7, 6, 8, 7, 6, 7, 8, 7 };
}
