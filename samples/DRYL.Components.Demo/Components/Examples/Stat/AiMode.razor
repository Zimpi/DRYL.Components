<div style="max-width: 280px;">
    <DrylStat Label="Forecast (next 7d)" Value="14,900" Icon="Sparkle"
              Delta="+19.5%" Direction="DeltaDirection.Up" Ai="@_ai">
        <Sparkline><DrylSparkline Data="@_up" Kind="SparklineKind.Area" /></Sparkline>
    </DrylStat>
</div>
<div class="row" style="gap: var(--sp-2); flex-wrap: wrap;">
    @foreach (var s in Enum.GetValues<AiState>())
    {
        <DrylButton Variant="DrylButton.ButtonVariant.Ghost" Size="DrylButton.ButtonSize.Small"
                    @onclick="() => _ai = s">@s.ToString()</DrylButton>
    }
</div>

@code {
    private readonly double[] _up = { 3, 4, 4, 6, 5, 8, 7, 10, 12 };
    private AiState _ai = AiState.Generated;
}
