@* A vertical rule splits inline items — drop it inside a horizontal stack. *@
<div class="glass-card p-default" style="display: inline-block;">
    <DrylStack Direction="DrylStack.StackDirection.Horizontal"
               Gap="DrylStack.StackGap.Md"
               Align="DrylStack.StackAlign.Center">
        <DrylButton Variant="DrylButton.ButtonVariant.Ghost" Size="DrylButton.ButtonSize.Small">Edit</DrylButton>
        <DrylDivider Orientation="DrylDivider.DividerOrientation.Vertical" />
        <DrylButton Variant="DrylButton.ButtonVariant.Ghost" Size="DrylButton.ButtonSize.Small">Duplicate</DrylButton>
        <DrylDivider Orientation="DrylDivider.DividerOrientation.Vertical" />
        <DrylButton Variant="DrylButton.ButtonVariant.Ghost" Size="DrylButton.ButtonSize.Small">Delete</DrylButton>
    </DrylStack>
</div>
