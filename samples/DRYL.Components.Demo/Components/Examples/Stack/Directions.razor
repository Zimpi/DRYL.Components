<DrylStack Gap="DrylStack.StackGap.Lg">
    @* Vertical (default). *@
    <DrylStack Gap="DrylStack.StackGap.Sm">
        <DrylBadge>Vertical</DrylBadge>
        <DrylButton Variant="DrylButton.ButtonVariant.Secondary">One</DrylButton>
        <DrylButton Variant="DrylButton.ButtonVariant.Secondary">Two</DrylButton>
    </DrylStack>

    <DrylDivider />

    @* Horizontal with a wider gap. *@
    <DrylStack Direction="DrylStack.StackDirection.Horizontal"
               Gap="DrylStack.StackGap.Md"
               Align="DrylStack.StackAlign.Center">
        <DrylBadge>Horizontal</DrylBadge>
        <DrylButton Variant="DrylButton.ButtonVariant.Secondary">One</DrylButton>
        <DrylButton Variant="DrylButton.ButtonVariant.Secondary">Two</DrylButton>
    </DrylStack>
</DrylStack>
