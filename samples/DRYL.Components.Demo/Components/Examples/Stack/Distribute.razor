@* Justify="Between" pushes the title and action to opposite ends — the
   classic header row, without reaching for a utility class. *@
<div class="glass-card p-default">
    <DrylStack Direction="DrylStack.StackDirection.Horizontal"
               Justify="DrylStack.StackJustify.Between"
               Align="DrylStack.StackAlign.Center">
        <DrylTypo Variant="DrylTypo.TypoVariant.H4">Team members</DrylTypo>
        <DrylButton Variant="DrylButton.ButtonVariant.Primary" Size="DrylButton.ButtonSize.Small">Invite</DrylButton>
    </DrylStack>
</div>
