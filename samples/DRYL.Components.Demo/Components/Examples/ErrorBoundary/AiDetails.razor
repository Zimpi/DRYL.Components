<div class="row" style="gap: var(--sp-2); margin-bottom: var(--sp-2);">
    <DrylButton Variant="DrylButton.ButtonVariant.Danger"
                Size="DrylButton.ButtonSize.Small"
                LeadingIcon="Alert"
                OnClick="@(() => _boom = true)">
        Fail AI request
    </DrylButton>
</div>

<div style="max-width: 640px;">
    <DrylErrorBoundary Title="The report couldn't be generated"
                       Description="The model timed out before finishing. Try again in a moment."
                       Ai="AiState.Generated"
                       ShowDetails="true"
                       OnRetry="@(() => _boom = false)">
        @if (_boom) { throw new TimeoutException("Upstream model request exceeded 30s deadline."); }
        <DrylAlert Kind="DrylAlert.AlertKind.Ai" Title="Report ready" Ai="AiState.Generated">
            The generated report rendered successfully.
        </DrylAlert>
    </DrylErrorBoundary>
</div>

@code {
    private bool _boom;
}
