@* A standalone DrylAppBar showing the Start / Center / End slots and Raised elevation.
   Setting any of the three slots switches the bar from a single flex row to a
   balanced three-region layout, keeping Center optically centred. *@
<DrylAppBar Elevation="AppBarElevation.Raised">
    <Start>
        <DrylIcon Name="Sparkle" Size="18" />
        <strong>DRYL</strong>
        <DrylBadge Kind="DrylBadge.BadgeKind.Neutral">v0.1</DrylBadge>
    </Start>
    <Center>
        <DrylBadge Kind="DrylBadge.BadgeKind.Accent" Dot="true">Dashboard</DrylBadge>
    </Center>
    <End>
        <DrylButton Variant="DrylButton.ButtonVariant.Ghost" Size="DrylButton.ButtonSize.Small" AriaLabel="Notifications">
            <DrylIcon Name="Bell" Size="16" />
        </DrylButton>
        <DrylAvatar Initials="JD" Size="AvatarSize.Small" />
    </End>
</DrylAppBar>
