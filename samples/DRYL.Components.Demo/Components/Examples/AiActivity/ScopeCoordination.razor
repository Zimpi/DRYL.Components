@implements IDisposable
@inject IDrylAiActivityService AiActivity

<div class="col" style="gap: var(--sp-4);">
    <div class="row">
        <DrylButton OnClick="Run" Loading="_running">Generate across the scope</DrylButton>
        <DrylButton Variant="DrylButton.ButtonVariant.Ghost" OnClick="Clear" Disabled="_running">Clear</DrylButton>
    </div>

    @* Nothing inside sets an Ai parameter — they all inherit the scope's state. *@
    <DrylAiScope Key="demo-scope">
        <div class="col" style="gap: var(--sp-3);">
            <DrylCard Spotlight="false">
                <span class="eyebrow">Card · inherits the scope</span>
                <p style="margin-top: var(--sp-2);">No <code>Ai</code> here — it lights up because it sits inside the scope.</p>
            </DrylCard>

            <DrylInputText Label="Prompt" Placeholder="Ask the model…" @bind-Value="_prompt" />

            <div class="row">
                <DrylButton>Scoped button</DrylButton>
                <DrylAiIndicator State="_state" />
            </div>
        </div>
    </DrylAiScope>
</div>

@code {
    private bool _running;
    private string _prompt = string.Empty;
    private AiState _state = AiState.None;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized() => AiActivity.OnChanged += OnChanged;

    private void OnChanged(string key)
    {
        if (key != "demo-scope") return;
        _state = AiActivity.GetState("demo-scope");
        InvokeAsync(StateHasChanged);
    }

    private async Task Run()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        try
        {
            _running = true;
            using var op = AiActivity.Begin("demo-scope", AiState.Thinking);
            await Task.Delay(1400, ct);
            op.Streaming();
            await Task.Delay(1600, ct);
            op.Generated();
            await Task.Delay(1200, ct);
            // op disposed here → scope settles back to None
        }
        catch (OperationCanceledException) { }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    private void Clear()
    {
        _cts?.Cancel();
        AiActivity.Clear("demo-scope");
    }

    public void Dispose()
    {
        AiActivity.OnChanged -= OnChanged;
        _cts?.Cancel();
        _cts?.Dispose();
        AiActivity.Clear("demo-scope");
    }
}
