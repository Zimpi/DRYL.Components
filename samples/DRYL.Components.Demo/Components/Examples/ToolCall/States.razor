<div class="col" style="gap: var(--sp-3);">
    <DrylToolCall ToolName="get_weather" State="AiState.Thinking"
                  Arguments="@_args" />
    <DrylToolCall ToolName="get_weather" State="AiState.Generated"
                  Arguments="@_args" Result="@_result" DefaultExpanded="true" />
    <DrylToolCall ToolName="charge_card" State="AiState.None"
                  Arguments="@_chargeArgs" Error="Insufficient funds (402)." />
</div>

@code {
    private const string _args = """{ "city": "Berlin", "unit": "celsius" }""";
    private const string _result = """{ "tempC": 19, "condition": "Partly cloudy" }""";
    private const string _chargeArgs = """{ "amount": 4200, "currency": "EUR" }""";
}
