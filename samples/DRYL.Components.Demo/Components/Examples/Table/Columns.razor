<DrylTable TItem="MetricRow" Items="@_rows" AriaLabel="Regional metrics"
           Height="320px"
           ResizableColumns
           ReorderableColumns>
    <Columns>
        <DrylColumn TItem="MetricRow" Field="@(r => r.Region)" Title="Region"
                    Primary Pinned="ColumnPin.Start" Width="160px" />
        <DrylColumn TItem="MetricRow" Field="@(r => r.Users)"    Title="Users"    Align="ColumnAlign.End" Width="120px" />
        <DrylColumn TItem="MetricRow" Field="@(r => r.Sessions)" Title="Sessions" Align="ColumnAlign.End" Width="120px" />
        <DrylColumn TItem="MetricRow" Field="@(r => r.Bounce)"   Title="Bounce %" Align="ColumnAlign.End" Width="120px" />
        <DrylColumn TItem="MetricRow" Field="@(r => r.Revenue)"  Title="Revenue"  Align="ColumnAlign.End" Width="140px">
            <CellTemplate Context="r">@r.Revenue.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</CellTemplate>
        </DrylColumn>
        <DrylColumn TItem="MetricRow" Field="@(r => r.Growth)" Title="Growth"
                    Align="ColumnAlign.End" Pinned="ColumnPin.End" Width="120px" Reorderable="false">
            <CellTemplate Context="r">
                <span style="color: @(r.Growth >= 0 ? "var(--success)" : "var(--danger)");">
                    @(r.Growth >= 0 ? "+" : "")@r.Growth%
                </span>
            </CellTemplate>
        </DrylColumn>
    </Columns>
</DrylTable>

<p style="color: var(--fg-muted); font-size: 12px; margin-top: var(--sp-3);">
    Drag a column header to reorder, or focus one and press Alt + Arrow Left/Right.
    Drag a header's right edge to resize. The Region and Growth columns are frozen to the edges.
</p>

@code {
    private readonly List<MetricRow> _rows =
    [
        new("North America", 48200, 91300, 38.2, 184000m, 12),
        new("Europe",        39100, 77800, 41.0, 152000m, 8),
        new("Asia Pacific",  52600, 104200, 35.7, 168000m, 21),
        new("Latin America", 18400, 33900, 44.5, 61000m, -3),
        new("Middle East",   12700, 24100, 39.8, 47000m, 6),
        new("Africa",        9800,  17600, 46.1, 28000m, 14),
    ];

    private record MetricRow(string Region, int Users, int Sessions, double Bounce, decimal Revenue, int Growth);
}
