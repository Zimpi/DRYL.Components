<DrylTable TItem="ProductRow" Items="@_rows" AriaLabel="Inventory"
           Editable
           CloneRow="@(r => r.Clone())"
           OnRowCommitted="OnCommitted">
    <Columns>
        <DrylColumn TItem="ProductRow" Field="@(p => p.Sku)" Title="SKU" Primary Width="120px" />

        <DrylColumn TItem="ProductRow" Field="@(p => p.Name)" Title="Product">
            <EditTemplate Context="p">
                <DrylInputText @bind-Value="p.Name" aria-label="Product name" />
            </EditTemplate>
        </DrylColumn>

        <DrylColumn TItem="ProductRow" Field="@(p => p.Stock)" Title="Stock"
                    Align="ColumnAlign.End" Width="140px">
            <CellTemplate Context="p">@p.Stock</CellTemplate>
            <EditTemplate Context="p">
                <DrylInputNumber TValue="int" @bind-Value="p.Stock" Min="0" aria-label="Stock" />
            </EditTemplate>
        </DrylColumn>

        <DrylColumn TItem="ProductRow" Field="@(p => p.Status)" Title="Status" Width="160px">
            <CellTemplate Context="p">
                <DrylBadge Kind="@StatusKind(p.Status)">@p.Status</DrylBadge>
            </CellTemplate>
            <EditTemplate Context="p">
                <DrylSelect @bind-Value="p.Status" Items="@_statusItems" aria-label="Status" />
            </EditTemplate>
        </DrylColumn>
    </Columns>
</DrylTable>

<p style="color: var(--fg-muted); font-size: 12px; margin-top: var(--sp-3);">
    Double-click a row or press the pencil to edit. Enter saves, Escape cancels.
    @if (_lastCommit is not null)
    {
        <span style="color: var(--fg); font-family: var(--font-mono);"> — last saved: @_lastCommit</span>
    }
</p>

@code {
    private string? _lastCommit;

    private readonly List<ProductRow> _rows =
    [
        new() { Sku = "DRL-001", Name = "Glass Panel Kit",   Stock = 42, Status = "In stock"  },
        new() { Sku = "DRL-014", Name = "Accent Glow Strip", Stock = 7,  Status = "Low stock" },
        new() { Sku = "DRL-027", Name = "Aura Ring Module",  Stock = 0,  Status = "Backorder" },
        new() { Sku = "DRL-039", Name = "Token Swatch Set",  Stock = 118, Status = "In stock" },
    ];

    private static readonly SelectItem[] _statusItems =
    [
        new("In stock",  "In stock"),
        new("Low stock", "Low stock"),
        new("Backorder", "Backorder"),
    ];

    // CloneRow hands the editor an isolated copy, so OnRowCommitted applies it back onto the
    // original element in the backing list (and Escape simply discards the copy).
    private void OnCommitted(RowEditEventArgs<ProductRow> e)
    {
        e.Item.Name   = e.EditedItem.Name;
        e.Item.Stock  = e.EditedItem.Stock;
        e.Item.Status = e.EditedItem.Status;
        _lastCommit   = $"{e.Item.Sku} · {e.Item.Name} · {e.Item.Stock} · {e.Item.Status}";
    }

    private static DrylBadge.BadgeKind StatusKind(string status) => status switch
    {
        "In stock"  => DrylBadge.BadgeKind.Success,
        "Low stock" => DrylBadge.BadgeKind.Warning,
        _           => DrylBadge.BadgeKind.Danger,
    };

    private sealed class ProductRow
    {
        public string Sku { get; set; } = "";
        public string Name { get; set; } = "";
        public int Stock { get; set; }
        public string Status { get; set; } = "";

        public ProductRow Clone() => (ProductRow)MemberwiseClone();
    }
}
