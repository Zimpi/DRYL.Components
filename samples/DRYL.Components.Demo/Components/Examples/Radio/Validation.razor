@using System.ComponentModel.DataAnnotations

<EditForm Model="@_model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <div class="col" style="gap: var(--sp-3);">
        <div style="max-width: 360px;">
            <DrylRadioGroup @bind-Value="_model.Region" Label="Region">
                <DrylRadio Value="@("eu-west")"  Label="EU West (Frankfurt)" />
                <DrylRadio Value="@("us-east")"  Label="US East (Virginia)" />
                <DrylRadio Value="@("ap-south")" Label="AP South (Singapore)" />
            </DrylRadioGroup>
        </div>
        <div class="row" style="align-items: center;">
            <DrylButton IsSubmit="true" LeadingIcon="Check">Deploy</DrylButton>
            @if (_submitted)
            {
                <DrylBadge Kind="DrylBadge.BadgeKind.Success" Dot="true">Deploying to @_model.Region</DrylBadge>
            }
        </div>
    </div>
</EditForm>

@code {
    private readonly DemoModel _model = new();
    private bool _submitted;

    private void HandleValidSubmit() => _submitted = true;

    private class DemoModel
    {
        [Required(ErrorMessage = "Please select a region.")]
        public string? Region { get; set; }
    }
}
