<DrylStack Gap="DrylStack.StackGap.Md">
    @* Accent-gradient fill for hero headings. *@
    <DrylTypo Variant="DrylTypo.TypoVariant.H1" Gradient>Dark, glassy, alive.</DrylTypo>

    @* Variant drives the look; As picks the tag — H2 look on a semantic h1. *@
    <DrylTypo Variant="DrylTypo.TypoVariant.H2" As="h1">Styled H2, rendered &lt;h1&gt;</DrylTypo>

    @* Centred body text. *@
    <DrylTypo Variant="DrylTypo.TypoVariant.Body" Align="DrylTypo.TypoAlign.Center">
        Centred copy.
    </DrylTypo>
</DrylStack>
