<DrylNotifications Items="@_items" ShowClearAll="false" />

@code {
    // Entries with a non-None Ai carry the shared AI aura, so asynchronous AI results stand out
    // in the inbox exactly like AI activity elsewhere in the library.
    private readonly List<DrylNotification> _items =
    [
        new() { Title = "Your report was generated", Message = "The Q2 revenue summary is ready to view.", Ai = AiState.Generated, Timestamp = DateTimeOffset.Now.AddMinutes(-1) },
        new() { Title = "Agent is summarizing 142 tickets", Message = "This may take a moment…", Ai = AiState.Thinking, Timestamp = DateTimeOffset.Now.AddMinutes(-2) },
        new() { Title = "Draft reply ready", Message = "3 suggestions based on the thread.", Ai = AiState.Generated, Read = true, Timestamp = DateTimeOffset.Now.AddHours(-1) },
    ];
}
