<div class="row" style="gap: var(--sp-6); flex-wrap: wrap;">
    @* Default DRYL dot. *@
    <DrylList>
        <DrylListItem>Pure black surfaces</DrylListItem>
        <DrylListItem>Translucent glass layers</DrylListItem>
        <DrylListItem>Violet → cyan accents</DrylListItem>
    </DrylList>

    @* Disc bullets. *@
    <DrylList Variant="DrylList.ListVariant.Disc">
        <DrylListItem>Design tokens</DrylListItem>
        <DrylListItem>Motion vocabulary</DrylListItem>
        <DrylListItem>AI-native states</DrylListItem>
    </DrylList>

    @* Dash bullets. *@
    <DrylList Variant="DrylList.ListVariant.Dash">
        <DrylListItem>No light theme</DrylListItem>
        <DrylListItem>No external JS</DrylListItem>
        <DrylListItem>No hardcoded colors</DrylListItem>
    </DrylList>

    @* Ordered, decimal numbering. *@
    <DrylList Ordered Variant="DrylList.ListVariant.Decimal">
        <DrylListItem>Sketch the API</DrylListItem>
        <DrylListItem>Use existing classes</DrylListItem>
        <DrylListItem>Verify in the prototype</DrylListItem>
    </DrylList>
</div>
