<div class="glass-card p-default" style="max-width: 420px;">
    <DrylScrollArea MaxHeight="220px">
        <div class="col" style="gap: var(--sp-2);">
            @for (var i = 1; i <= 30; i++)
            {
                <div style="padding: var(--sp-2) var(--sp-3); border: 1px solid var(--line); border-radius: var(--r-md);">
                    Log line @i — service responded in @(20 + i) ms
                </div>
            }
        </div>
    </DrylScrollArea>
</div>
