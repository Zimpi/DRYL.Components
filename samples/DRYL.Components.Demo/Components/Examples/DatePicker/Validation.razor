@using System.ComponentModel.DataAnnotations

<EditForm Model="_form" OnValidSubmit="HandleValidSubmit" style="max-width: 320px;">
    <DataAnnotationsValidator />
    <div class="col" style="gap: var(--sp-4);">
        <DrylDatePicker @bind-Value="_form.DeadlineDate" Label="Deadline" />
        <DrylButton type="submit">Submit</DrylButton>
        @if (_submitted)
        {
            <DrylAlert Variant="AlertVariant.Success">Submitted successfully!</DrylAlert>
        }
    </div>
</EditForm>

@code {
    private bool _submitted;
    private readonly DeadlineModel _form = new();

    private void HandleValidSubmit() => _submitted = true;

    private class DeadlineModel
    {
        [Required(ErrorMessage = "Please select a deadline.")]
        public DateOnly? DeadlineDate { get; set; }
    }
}
