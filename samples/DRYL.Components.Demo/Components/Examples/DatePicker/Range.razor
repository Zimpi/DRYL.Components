<div style="max-width: 320px;">
    <DrylDatePicker Range
                    @bind-RangeStart="_rangeStart"
                    @bind-RangeEnd="_rangeEnd"
                    Label="Campaign period" />
</div>
@if (_rangeStart.HasValue || _rangeEnd.HasValue)
{
    <p>
        From <strong>@(_rangeStart?.ToString("d MMM yyyy") ?? "–")</strong>
        to <strong>@(_rangeEnd?.ToString("d MMM yyyy") ?? "–")</strong>
    </p>
}

@code {
    private DateOnly? _rangeStart;
    private DateOnly? _rangeEnd;
}
