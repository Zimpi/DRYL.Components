<div class="row">
    <DrylMenu Label="Row options">
        <Trigger>
            <DrylButton Variant="DrylButton.ButtonVariant.Ghost"
                        LeadingIcon="MoreHorizontal"
                        AriaLabel="More options" />
        </Trigger>
        <Items>
            <DrylMenuItem Icon="Eye" OnClick="@(() => Log("View"))">View details</DrylMenuItem>
            <DrylMenuItem Icon="Edit" OnClick="@(() => Log("Edit"))">Edit</DrylMenuItem>
            <DrylMenuItem Separator />
            <DrylMenuItem Icon="Trash"
                          Variant="DrylMenuItem.MenuItemVariant.Danger"
                          OnClick="@(() => Log("Delete"))">
                Delete
            </DrylMenuItem>
        </Items>
    </DrylMenu>
</div>

@code {
    private void Log(string action) { }
}
