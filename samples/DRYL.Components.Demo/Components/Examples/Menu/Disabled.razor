<div class="row">
    <DrylMenu Label="File">
        <Trigger>
            <DrylButton Variant="DrylButton.ButtonVariant.Ghost" LeadingIcon="Folder">
                File
            </DrylButton>
        </Trigger>
        <Items>
            <DrylMenuItem Icon="File" OnClick="@(() => Log("New"))">New</DrylMenuItem>
            <DrylMenuItem Icon="FolderOpen" OnClick="@(() => Log("Open"))">Open</DrylMenuItem>
            <DrylMenuItem Icon="Save" Disabled="true">Save (no permission)</DrylMenuItem>
            <DrylMenuItem Separator />
            <DrylMenuItem Icon="LogOut" OnClick="@(() => Log("Close"))">Close</DrylMenuItem>
        </Items>
    </DrylMenu>
</div>

@code {
    private void Log(string action) { }
}
