<div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); max-width: 720px;">
    <DrylInputText @bind-Value="_search"
                   Label="Search"
                   Placeholder="Search components..."
                   LeadingIcon="Search" />
    <DrylInputText @bind-Value="_url"
                   Label="URL"
                   Type="url"
                   Placeholder="https://"
                   TrailingIcon="ArrowRight" />
</div>

@code {
    private string? _search;
    private string? _url;
}
