<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); max-width: 1080px;">
    <DrylInputText @bind-Value="_successValue"
                   Label="Success"
                   State="InputState.Success"
                   HelperText="Looks good." />
    <DrylInputText @bind-Value="_errorValue"
                   Label="Error (manual)"
                   State="InputState.Error"
                   HelperText="Something is wrong." />
    <DrylInputText @bind-Value="_disabledValue"
                   Label="Disabled"
                   Disabled="true"
                   Placeholder="Can't touch this" />
</div>

@code {
    private string? _successValue = "All good";
    private string? _errorValue = "Not so good";
    private string? _disabledValue;
}
