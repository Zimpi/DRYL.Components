<div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); max-width: 720px;">
    <DrylInputText @bind-Value="_plain"
                   Label="Plain"
                   Placeholder="Type something" />
    <DrylInputText @bind-Value="_withHelper"
                   Label="With helper"
                   Placeholder="janedoe"
                   HelperText="Lowercase letters and digits only." />
</div>

@code {
    private string? _plain;
    private string? _withHelper;
}
