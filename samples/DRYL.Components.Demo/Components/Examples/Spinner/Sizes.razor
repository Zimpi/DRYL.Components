<div class="glass-card" style="padding: var(--sp-5);">
    <div class="row" style="gap: var(--sp-6); align-items: flex-end; flex-wrap: wrap;">

        <div class="col" style="gap: var(--sp-4); align-items: center;">
            <span style="color: var(--fg-dim); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;">Ring</span>
            <div class="row" style="gap: var(--sp-5); align-items: flex-end;">
                <div class="col" style="gap: var(--sp-2); align-items: center;">
                    <DrylSpinner Variant="DrylSpinner.SpinnerVariant.Ring" Size="DrylSpinner.SpinnerSize.Small" />
                    <span style="color: var(--fg-faint); font-size: 11px;">Sm</span>
                </div>
                <div class="col" style="gap: var(--sp-2); align-items: center;">
                    <DrylSpinner Variant="DrylSpinner.SpinnerVariant.Ring" Size="DrylSpinner.SpinnerSize.Medium" />
                    <span style="color: var(--fg-faint); font-size: 11px;">Md</span>
                </div>
                <div class="col" style="gap: var(--sp-2); align-items: center;">
                    <DrylSpinner Variant="DrylSpinner.SpinnerVariant.Ring" Size="DrylSpinner.SpinnerSize.Large" />
                    <span style="color: var(--fg-faint); font-size: 11px;">Lg</span>
                </div>
            </div>
        </div>

        <div style="width: 1px; height: 48px; background: var(--line);"></div>

        <div class="col" style="gap: var(--sp-4); align-items: center;">
            <span style="color: var(--fg-dim); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;">Dots</span>
            <div class="row" style="gap: var(--sp-5); align-items: flex-end;">
                <div class="col" style="gap: var(--sp-2); align-items: center;">
                    <DrylSpinner Variant="DrylSpinner.SpinnerVariant.Dots" Size="DrylSpinner.SpinnerSize.Small" />
                    <span style="color: var(--fg-faint); font-size: 11px;">Sm</span>
                </div>
                <div class="col" style="gap: var(--sp-2); align-items: center;">
                    <DrylSpinner Variant="DrylSpinner.SpinnerVariant.Dots" Size="DrylSpinner.SpinnerSize.Medium" />
                    <span style="color: var(--fg-faint); font-size: 11px;">Md</span>
                </div>
                <div class="col" style="gap: var(--sp-2); align-items: center;">
                    <DrylSpinner Variant="DrylSpinner.SpinnerVariant.Dots" Size="DrylSpinner.SpinnerSize.Large" />
                    <span style="color: var(--fg-faint); font-size: 11px;">Lg</span>
                </div>
            </div>
        </div>

        <div style="width: 1px; height: 48px; background: var(--line);"></div>

        <div class="col" style="gap: var(--sp-4); align-items: center;">
            <span style="color: var(--fg-dim); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;">Pulse</span>
            <div class="row" style="gap: var(--sp-5); align-items: flex-end;">
                <div class="col" style="gap: var(--sp-2); align-items: center;">
                    <DrylSpinner Variant="DrylSpinner.SpinnerVariant.Pulse" Size="DrylSpinner.SpinnerSize.Small" />
                    <span style="color: var(--fg-faint); font-size: 11px;">Sm</span>
                </div>
                <div class="col" style="gap: var(--sp-2); align-items: center;">
                    <DrylSpinner Variant="DrylSpinner.SpinnerVariant.Pulse" Size="DrylSpinner.SpinnerSize.Medium" />
                    <span style="color: var(--fg-faint); font-size: 11px;">Md</span>
                </div>
                <div class="col" style="gap: var(--sp-2); align-items: center;">
                    <DrylSpinner Variant="DrylSpinner.SpinnerVariant.Pulse" Size="DrylSpinner.SpinnerSize.Large" />
                    <span style="color: var(--fg-faint); font-size: 11px;">Lg</span>
                </div>
            </div>
        </div>

    </div>
</div>
