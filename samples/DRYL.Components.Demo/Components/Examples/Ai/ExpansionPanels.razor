@implements IDisposable

<div class="col" style="gap: var(--sp-3);">
    <div class="row">
        <DrylButton OnClick="RunExpansionLifecycle" Loading="_running" LeadingIcon="Sparkle"
                    Ai="@(_running ? AiState.Thinking : AiState.None)">
            @if (_running) { <text>Generating…</text> } else { <text>Generate panel content</text> }
        </DrylButton>
        <DrylButton Variant="DrylButton.ButtonVariant.Ghost" OnClick="Reset" Disabled="_running">Reset</DrylButton>
    </div>

    <div>
        <DrylExpansion Title="Deployment summary · DACH" Icon="Rocket"
                       IsOpen="_open" IsOpenChanged="v => _open = v"
                       Ai="_state">
            <ChildContent>
                @if (string.IsNullOrEmpty(_content))
                {
                    <p style="color: var(--fg-dim); font-style: italic;">Content will stream here…</p>
                }
                else
                {
                    <p>@_content</p>
                }
            </ChildContent>
        </DrylExpansion>
        <DrylExpansion Title="Incident log" Icon="Alert">
            <ChildContent><p>No active incidents. Last resolved 3 days ago.</p></ChildContent>
        </DrylExpansion>
        <DrylExpansion Title="Environment" Icon="Server">
            <ChildContent><p>Production — eu-west-1 — 4 replicas healthy.</p></ChildContent>
        </DrylExpansion>
    </div>
</div>

@code {
    private AiState _state = AiState.None;
    private bool _open;
    private bool _running;
    private string _content = "";
    private CancellationTokenSource? _cts;

    private async Task RunExpansionLifecycle()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        try
        {
            _running = true;
            _open = false;
            _content = "";
            _state = AiState.Thinking;
            StateHasChanged();
            await Task.Delay(1000, ct);

            _open = true;
            _state = AiState.Streaming;
            StateHasChanged();

            const string fullText = "14 successful deployments in the last 24 hours across eu-west-1 and us-east-2. Average deploy time: 38 s. No rollbacks. Peak traffic handled at 2026-05-25T18:42Z — 4,810 req/s, all instances healthy. Next scheduled release: 2026-05-26T08:00Z.";
            foreach (var word in fullText.Split(' '))
            {
                ct.ThrowIfCancellationRequested();
                _content += (_content.Length == 0 ? "" : " ") + word;
                StateHasChanged();
                await Task.Delay(60, ct);
            }

            _state = AiState.Generated;
            StateHasChanged();
            await Task.Delay(900, ct);

            _state = AiState.Active;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    private void Reset()
    {
        _cts?.Cancel();
        _state = AiState.None;
        _open = false;
        _content = "";
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
