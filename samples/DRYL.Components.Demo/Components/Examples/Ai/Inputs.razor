<EditForm Model="@_model">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--sp-4);">
        <DrylInputText @bind-Value="_model.None"      Label="None"      Ai="AiState.None"      Placeholder="Default input" />
        <DrylInputText @bind-Value="_model.Active"    Label="Active"    Ai="AiState.Active"    Placeholder="Persistent AI mode" LeadingIcon="Sparkle" />
        <DrylInputText @bind-Value="_model.Thinking"  Label="Thinking"  Ai="AiState.Thinking"  Placeholder="Tool call running…" />
        <DrylInputText @bind-Value="_model.Streaming" Label="Streaming" Ai="AiState.Streaming" Placeholder="Tokens arriving" />
    </div>

    <div style="margin-top: var(--sp-4);">
        <DrylTextarea @bind-Value="_model.Long"
                      Label="Generated content"
                      Ai="AiState.Generated"
                      Placeholder="Model output appears here."
                      Rows="4" />
    </div>
</EditForm>

@code {
    private readonly InputModel _model = new();

    private sealed class InputModel
    {
        public string None { get; set; } = "";
        public string Active { get; set; } = "Ask the assistant…";
        public string Thinking { get; set; } = "";
        public string Streaming { get; set; } = "Q3 sales summa";
        public string Long { get; set; } = "Q3 sales in DACH closed up 14.2% YoY, driven by 1,284 net-new accounts in week 2026-W18.";
    }
}
