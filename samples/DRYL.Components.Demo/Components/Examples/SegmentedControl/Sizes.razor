<div class="col" style="gap: var(--sp-4); align-items: flex-start;">
    <DrylSegmentedControl @bind-Value="_v" Size="SegmentedSize.Small" AriaLabel="Small">
        <DrylSegment Value="@("day")" Label="Day" />
        <DrylSegment Value="@("week")" Label="Week" />
        <DrylSegment Value="@("month")" Label="Month" />
    </DrylSegmentedControl>

    <DrylSegmentedControl @bind-Value="_v" Size="SegmentedSize.Medium" AriaLabel="Medium">
        <DrylSegment Value="@("day")" Label="Day" />
        <DrylSegment Value="@("week")" Label="Week" />
        <DrylSegment Value="@("month")" Label="Month" />
    </DrylSegmentedControl>

    <DrylSegmentedControl @bind-Value="_v" Size="SegmentedSize.Large" AriaLabel="Large">
        <DrylSegment Value="@("day")" Label="Day" />
        <DrylSegment Value="@("week")" Label="Week" />
        <DrylSegment Value="@("month")" Label="Month" />
    </DrylSegmentedControl>
</div>

@code {
    private string _v = "week";
}
