<DrylSegmentedControl @bind-Value="_v" Block AriaLabel="Alignment">
    <DrylSegment Value="@("left")" Label="Left" />
    <DrylSegment Value="@("center")" Label="Center" />
    <DrylSegment Value="@("right")" Label="Right" />
    <DrylSegment Value="@("justify")" Label="Justify" />
</DrylSegmentedControl>

@code {
    private string _v = "center";
}
