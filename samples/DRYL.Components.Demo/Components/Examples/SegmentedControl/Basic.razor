<div class="col" style="gap: var(--sp-3);">
    <DrylSegmentedControl @bind-Value="_view" AriaLabel="View mode">
        <DrylSegment Value="@("list")" Label="List" />
        <DrylSegment Value="@("board")" Label="Board" />
        <DrylSegment Value="@("calendar")" Label="Calendar" />
    </DrylSegmentedControl>

    <span class="lead">Selected: <code>@_view</code></span>
</div>

@code {
    private string _view = "list";
}
