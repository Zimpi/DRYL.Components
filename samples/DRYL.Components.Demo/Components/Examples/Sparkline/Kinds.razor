<div class="row" style="gap: var(--sp-6); align-items: center;">
    <div class="col" style="gap: var(--sp-1);">
        <DrylSparkline Data="@_series" Kind="SparklineKind.Line" ShowLastDot="true" />
        <span class="eyebrow">Line</span>
    </div>
    <div class="col" style="gap: var(--sp-1);">
        <DrylSparkline Data="@_series" Kind="SparklineKind.Area" />
        <span class="eyebrow">Area</span>
    </div>
    <div class="col" style="gap: var(--sp-1);">
        <DrylSparkline Data="@_series" Kind="SparklineKind.Bar" />
        <span class="eyebrow">Bar</span>
    </div>
</div>

@code {
    private readonly double[] _series = { 3, 5, 4, 8, 6, 9, 7, 12, 10, 14 };
}
