@implements IDisposable

<div class="row">
    <DrylButton LeadingIcon="Sparkle"
                Ai="@(_running ? AiState.Thinking : AiState.None)"
                OnClick="@(() => _open = true)">
        @if (_running) { <text>AI thinking…</text> } else { <text>Open AI palette</text> }
    </DrylButton>
</div>

<DrylCommandPalette @bind-Open="_open"
                    Items="@_items"
                    Placeholder="Search AI intents…"
                    Ai="_state">
    <AiContent>
        @if (_state == AiState.Thinking)
        {
            <span style="color: var(--fg-dim);">Calling tool…</span>
        }
        else if (_state is AiState.Streaming or AiState.Generated)
        {
            <span>@_streamedText</span>
        }
    </AiContent>
</DrylCommandPalette>

@code {
    private bool _open;
    private AiState _state = AiState.None;
    private bool _running;
    private string _streamedText = string.Empty;
    private CancellationTokenSource? _cts;

    private CommandItem[] _items =>
    [
        new() { Label = "Summarise this page",       Icon = "Quote",  Type = CommandItemType.AiIntent, AiAction = EventCallback.Factory.Create(this, () => RunAiAsync("summarise")), Category = "AI Intents" },
        new() { Label = "Explain the selected code", Icon = "Code",   Type = CommandItemType.AiIntent, AiAction = EventCallback.Factory.Create(this, () => RunAiAsync("explain")),   Category = "AI Intents" },
        new() { Label = "Draft a pull-request body", Icon = "Edit",   Type = CommandItemType.AiIntent, AiAction = EventCallback.Factory.Create(this, () => RunAiAsync("draft PR")),  Category = "AI Intents" },
        new() { Label = "Go to AI Mode docs",        Icon = "Sparkle",Type = CommandItemType.Navigate, Href = "/ai" },
    ];

    private static readonly Dictionary<string, string> _responses = new()
    {
        ["summarise"] = "This page demonstrates the DrylCommandPalette — a full-screen command launcher with static items, async search, keyboard navigation, category grouping and an AI result panel driven by the shared AiState vocabulary.",
        ["explain"]   = "The component obtains an ElementReference via @ref, then passes it to dryl.modal.attach for focus trap and scroll lock. Arrow key navigation is handled in C# and keeps the focused item scrolled into view.",
        ["draft PR"]  = "feat: add DrylCommandPalette\n\nIntroduces a full-screen command launcher with @bind-Open, static Items, async SearchProvider, three CommandItemType variants and an AI result panel.",
    };

    private async Task RunAiAsync(string intent)
    {
        if (_running) return;

        _running = true;
        _streamedText = string.Empty;
        _state = AiState.Thinking;
        StateHasChanged();

        _cts = new CancellationTokenSource();
        var cts = _cts;

        try
        {
            await Task.Delay(1200, cts.Token);

            _state = AiState.Streaming;
            StateHasChanged();

            var response = _responses.GetValueOrDefault(intent, "Done.");
            foreach (var ch in response)
            {
                if (cts.IsCancellationRequested) break;
                _streamedText += ch;
                if (_streamedText.Length % 4 == 0)
                {
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(18, cts.Token);
                }
            }

            if (!cts.IsCancellationRequested)
            {
                await Task.Delay(300, cts.Token);
                _state = AiState.Generated;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { /* palette closed mid-stream */ }
        finally
        {
            _running = false;
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
