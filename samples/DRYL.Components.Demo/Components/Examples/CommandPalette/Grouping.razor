<div class="row">
    <DrylButton LeadingIcon="Command"
                Variant="DrylButton.ButtonVariant.Secondary"
                OnClick="@(() => _open = true)">
        Open grouped palette
    </DrylButton>
</div>

<DrylCommandPalette @bind-Open="_open"
                    Items="@_items"
                    Placeholder="Search by category…" />

@code {
    private bool _open;

    private CommandItem[] _items =>
    [
        new() { Label = "Buttons",      Icon = "Bolt",   Type = CommandItemType.Navigate, Href = "/buttons", Category = "Components" },
        new() { Label = "Cards",        Icon = "Layers", Type = CommandItemType.Navigate, Href = "/cards",   Category = "Components" },
        new() { Label = "Dialog",       Icon = "Box",    Type = CommandItemType.Navigate, Href = "/dialog",  Category = "Components" },
        new() { Label = "Inputs",       Icon = "Type",   Type = CommandItemType.Navigate, Href = "/inputs",  Category = "Components" },
        new() { Label = "Copy URL",     Icon = "Copy",   Type = CommandItemType.Action,   Action = EventCallback.Factory.Create(this, () => {}),  Category = "Actions" },
        new() { Label = "Toggle theme", Icon = "Moon",   Type = CommandItemType.Action,   Action = EventCallback.Factory.Create(this, () => {}),  Category = "Actions" },
        new() { Label = "Help",         Icon = "Info",   Type = CommandItemType.Navigate, Href = "/" },
    ];
}
