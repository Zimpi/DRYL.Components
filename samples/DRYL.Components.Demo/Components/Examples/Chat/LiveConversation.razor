<div style="max-width: 720px;">
    <DrylChat Height="520px">
        <ChildContent>
            @foreach (var m in _messages)
            {
                <DrylMessage Role="@m.Role"
                             Author="@m.Author"
                             Timestamp="@m.Timestamp"
                             AvatarIcon="@(m.Role == MessageRole.Assistant ? "Sparkle" : null)"
                             Typing="@m.Typing"
                             Ai="@m.Ai">
                    @m.Text
                </DrylMessage>
            }
        </ChildContent>
        <Footer>
            <DrylChatComposer @bind-Value="_draft"
                              Placeholder="Ask DRYL AI…"
                              Disabled="@_busy"
                              Ai="@(_busy ? AiState.Thinking : AiState.None)"
                              OnSend="HandleSend" />
        </Footer>
    </DrylChat>
</div>

@code {
    private sealed class ChatMsg
    {
        public MessageRole Role { get; set; }
        public string? Author { get; set; }
        public string? Timestamp { get; set; }
        public string? Text { get; set; }
        public AiState Ai { get; set; } = AiState.None;
        public bool Typing { get; set; }
    }

    private readonly List<ChatMsg> _messages = new()
    {
        new ChatMsg { Role = MessageRole.Assistant, Author = "DRYL AI", Text = "Hi! Ask me anything about your data.", Timestamp = "09:20" }
    };

    private string? _draft;
    private bool _busy;

    private async Task HandleSend(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || _busy) return;
        _busy = true;

        _messages.Add(new ChatMsg
        {
            Role = MessageRole.User,
            Author = "You",
            Text = text,
            Timestamp = DateTime.Now.ToString("HH:mm")
        });
        StateHasChanged();

        var reply = new ChatMsg { Role = MessageRole.Assistant, Author = "DRYL AI", Typing = true, Ai = AiState.Thinking };
        _messages.Add(reply);
        StateHasChanged();
        await Task.Delay(900);

        reply.Typing = false;
        reply.Ai = AiState.Streaming;
        reply.Text = "";
        var full = "Here's what I found: the trend is up 12% week-over-week, driven mostly by the EU region.";
        foreach (var word in full.Split(' '))
        {
            reply.Text += (reply.Text!.Length == 0 ? "" : " ") + word;
            StateHasChanged();
            await Task.Delay(60);
        }

        reply.Ai = AiState.Generated;
        reply.Timestamp = DateTime.Now.ToString("HH:mm");
        StateHasChanged();
        await Task.Delay(900);
        reply.Ai = AiState.None;

        _busy = false;
        StateHasChanged();
    }
}
