<div class="glass-card p-default">
    <DrylPagination CurrentPage="@_page"
                    PageSize="@_size"
                    TotalCount="247"
                    CurrentPageChanged="@(p => _page = p)"
                    PageSizeChanged="@(s => { _size = s; _page = 0; })" />
</div>

@code {
    private int _page;
    private int _size = 20;
}
