<div class="col" style="gap: var(--sp-3); max-width: 640px;">
    <DrylAlert Kind="DrylAlert.AlertKind.Ai" Title="Active — persistentes AI-Signal"
               Ai="AiState.Active">
        Dieser Alert ist dauerhaft als KI-getriebene Oberfläche markiert.
    </DrylAlert>
    <DrylAlert Kind="DrylAlert.AlertKind.Ai" Title="Thinking — Tool Call läuft"
               Ai="AiState.Thinking">
        Das Modell verarbeitet gerade eine Anfrage.
    </DrylAlert>
    <DrylAlert Kind="DrylAlert.AlertKind.Ai" Title="Streaming — Tokens kommen an"
               Ai="AiState.Streaming">
        Inhalt wird schrittweise generiert…
    </DrylAlert>
    <DrylAlert Kind="DrylAlert.AlertKind.Ai" Title="Generated — Inhalt bereit"
               Ai="AiState.Generated">
        Die Analyse wurde abgeschlossen. Bitte prüfe das Ergebnis vor der Verwendung.
    </DrylAlert>
    <DrylAlert Kind="DrylAlert.AlertKind.Warning" Title="Warning + AI Thinking"
               Ai="AiState.Thinking">
        KI-Variante ist nicht Pflicht — jede Variante kann AI-Mode aktivieren.
    </DrylAlert>
</div>
