<div class="col" style="gap: var(--sp-4);">
    <DrylCodeBlock Language="typescript" Code="@_ts" />
    <DrylCodeBlock Language="python" Code="@_python" />
    <DrylCodeBlock Language="sql" Code="@_sql" />
    <DrylCodeBlock Language="html" Code="@_html" />
    <DrylCodeBlock Language="css" Code="@_css" />
</div>

@code {
    private const string _ts = """
        // Stream a chat completion
        async function* chat(prompt: string): AsyncGenerator<string> {
            const res = await fetch("/api/chat", { method: "POST", body: prompt });
            const reader = res.body!.getReader();
            for (let n = 0; n < 100; n++) {
                const { value, done } = await reader.read();
                if (done) break;
                yield new TextDecoder().decode(value);
            }
        }
        """;

    private const string _python = """
        # Filter adults from a list of people
        from dataclasses import dataclass

        @dataclass
        class Person:
            name: str
            age: int

        def adults(people: list[Person]) -> list[Person]:
            return [p for p in people if p.age >= 18]
        """;

    private const string _sql = """
        -- Top 5 customers by revenue
        SELECT c.name, SUM(o.total) AS revenue
        FROM customers c
        JOIN orders o ON o.customer_id = c.id
        WHERE o.created_at >= '2026-01-01'
        GROUP BY c.name
        ORDER BY revenue DESC
        LIMIT 5;
        """;

    private const string _html = """
