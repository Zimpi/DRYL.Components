@using Microsoft.AspNetCore.Components.Forms

<div style="max-width: 480px;">
    <DrylFileUpload FilesChanged="HandleFiles"
                    Label="Profile picture"
                    Accept="image/*"
                    MaxFileSizeBytes="@(5L * 1024 * 1024)"
                    HelperText="Drag a photo here or click to browse." />
</div>

@code {
    private List<IBrowserFile> _files = [];

    private void HandleFiles(IReadOnlyList<IBrowserFile> files) => _files = files.ToList();
}
