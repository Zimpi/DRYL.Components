@using Microsoft.AspNetCore.Components.Forms

<div style="max-width: 480px;">
    <DrylFileUpload FilesChanged="HandleFiles"
                    Multiple="true"
                    Label="Attachments"
                    Accept=".pdf,.docx,.xlsx,.png,.jpg"
                    MaxFileSizeBytes="@(10L * 1024 * 1024)" />
</div>
@if (_files.Count > 0)
{
    <p class="input-helper">@_files.Count file(s) selected — total @FormatBytes(_files.Sum(f => f.Size))</p>
}

@code {
    private List<IBrowserFile> _files = [];

    private void HandleFiles(IReadOnlyList<IBrowserFile> files) => _files = files.ToList();

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1_073_741_824 => FormattableString.Invariant($"{bytes / 1_073_741_824.0:F1} GB"),
        >= 1_048_576     => FormattableString.Invariant($"{bytes / 1_048_576.0:F1} MB"),
        >= 1_024         => FormattableString.Invariant($"{bytes / 1_024.0:F0} KB"),
        _                => $"{bytes} B"
    };
}
