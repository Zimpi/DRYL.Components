@using System.ComponentModel.DataAnnotations

<EditForm Model="@_model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <div class="col" style="gap: var(--sp-4);">
        <DrylInputOtp @bind-Value="_model.Code"
                      Label="Enter your 6-digit verification code"
                      HelperText="Check your authenticator app or SMS." />
        <button type="submit" class="btn btn-primary" style="align-self: flex-start;">Verify</button>
        @if (_verified)
        {
            <p style="color: var(--success); font-size: 13px;">Code accepted!</p>
        }
    </div>
</EditForm>

@code {
    private bool _verified;
    private OtpModel _model = new();

    private void HandleValidSubmit() => _verified = true;

    private class OtpModel
    {
        [Required(ErrorMessage = "Code is required.")]
        [StringLength(6, MinimumLength = 6, ErrorMessage = "Please enter all 6 digits.")]
        public string Code { get; set; } = "";
    }
}
