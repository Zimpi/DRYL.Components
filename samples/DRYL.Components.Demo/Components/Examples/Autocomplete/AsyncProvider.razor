<div style="max-width: 320px;">
    <DrylAutocomplete TItem="string"
                      @bind-Value="_asyncResult"
                      ItemsProvider="@SearchCountriesAsync"
                      Label="Country (server search)"
                      Placeholder="Type to search…" />
</div>
@if (_asyncResult is not null)
{
    <p>Selected: <strong>@_asyncResult</strong></p>
}

@code {
    private string? _asyncResult;

    private static readonly string[] _countries =
    [
        "Austria", "Belgium", "Bulgaria", "Croatia", "Cyprus", "Czechia",
        "Denmark", "Estonia", "Finland", "France", "Germany", "Greece",
        "Hungary", "Ireland", "Italy", "Latvia", "Lithuania", "Luxembourg",
        "Malta", "Netherlands", "Poland", "Portugal", "Romania", "Slovakia",
        "Slovenia", "Spain", "Sweden", "Switzerland", "United Kingdom",
        "United States", "Canada", "Australia", "Japan", "South Korea",
        "Brazil", "Mexico", "Argentina", "India", "China", "Singapore"
    ];

    private async Task<IEnumerable<string>> SearchCountriesAsync(string query, CancellationToken ct)
    {
        await Task.Delay(500, ct); // simulate network latency
        return string.IsNullOrEmpty(query)
            ? _countries
            : _countries.Where(c => c.Contains(query, StringComparison.OrdinalIgnoreCase));
    }
}
