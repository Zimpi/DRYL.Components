<div style="max-width: 320px;">
    <DrylAutocomplete TItem="string"
                      @bind-Value="_country"
                      Items="@_countries"
                      SearchFunc="@((q, items) => items.Where(c => c.StartsWith(q, StringComparison.OrdinalIgnoreCase)))"
                      Label="Country (starts-with)"
                      Placeholder="Type a letter…" />
</div>
@if (_country is not null)
{
    <p>Selected: <strong>@_country</strong></p>
}

@code {
    private string? _country;

    private static readonly string[] _countries =
    [
        "Austria", "Belgium", "Bulgaria", "Croatia", "Cyprus", "Czechia",
        "Denmark", "Estonia", "Finland", "France", "Germany", "Greece",
        "Hungary", "Ireland", "Italy", "Latvia", "Lithuania", "Luxembourg",
        "Malta", "Netherlands", "Poland", "Portugal", "Romania", "Slovakia",
        "Slovenia", "Spain", "Sweden", "Switzerland", "United Kingdom",
        "United States", "Canada", "Australia", "Japan", "South Korea",
        "Brazil", "Mexico", "Argentina", "India", "China", "Singapore"
    ];
}
