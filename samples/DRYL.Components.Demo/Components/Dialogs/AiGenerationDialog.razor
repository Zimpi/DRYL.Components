@namespace DRYL.Components.Demo.Components.Dialogs
@implements IDisposable

@*  Human-in-the-Middle demo dialog.
    Lifecycle:
      Thinking  →  Streaming  →  Generated  →  Active (idle, editable)
    User Approve closes with the (possibly edited) text. Cancel discards.
*@

<DrylDialog Icon="Sparkle" Ai="@_ai">
    <ChildContent>
        <div class="col" style="gap: var(--sp-4);">
            <div class="row" style="gap: var(--sp-3); align-items: center;">
                <DrylAiIndicator State="@_ai" />
                <span style="color: var(--fg-muted); font-size: 12px;">
                    @_statusLabel
                </span>
            </div>

            @if (_phase == Phase.Streaming || _phase == Phase.Thinking)
            {
                <div style="min-height: 140px; padding: var(--sp-4);
                            background: var(--glass-1); border: 1px solid var(--line);
                            border-radius: var(--r-md); color: var(--fg);
                            font-family: var(--font-mono); font-size: 13px;
                            line-height: 1.6; white-space: pre-wrap;">@_streamed<span class="caret">▍</span></div>
            }
            else if (_phase == Phase.Review)
            {
                <div class="col" style="gap: var(--sp-2);">
                    <span class="eyebrow">Edit before approving</span>
                    <DrylTextarea @bind-Value="_streamed" Ai="@_ai" />
                </div>
            }

            <p style="margin: 0; color: var(--fg-dim); font-size: 12px;">
                Prompt: <code>@Prompt</code>
            </p>
        </div>
    </ChildContent>
    <ActionContent>
        <DrylButton Variant="DrylButton.ButtonVariant.Ghost" @onclick="Cancel">
            Cancel
        </DrylButton>
        <DrylButton Variant="DrylButton.ButtonVariant.Primary"
                    LeadingIcon="Check"
                    Disabled="@(_phase != Phase.Review)"
                    @onclick="Approve">
            Approve
        </DrylButton>
    </ActionContent>
</DrylDialog>

<style>
    .caret { color: var(--accent-a); animation: caretBlink 1.1s steps(1) infinite; }
    @@keyframes caretBlink { 50% { opacity: 0; } }
</style>

@code {
    [Parameter] public string Prompt { get; set; } = "Write a one-paragraph summary.";

    [CascadingParameter] public IDrylDialogInstance Instance { get; set; } = default!;

    private enum Phase { Thinking, Streaming, Review }

    private Phase _phase = Phase.Thinking;
    private AiState _ai = AiState.Thinking;
    private string _streamed = "";
    private CancellationTokenSource? _cts;

    private string _statusLabel = "Asking the model…";

    private const string MockResponse =
        "DRYL is a dark-only, glass-surfaced component library for Blazor that " +
        "treats AI as a first-class state of the UI. Every interactive surface " +
        "can opt into an AiState — Thinking, Streaming, Generated — and inherits " +
        "the same rotating gradient ring and breathing glow, so the user can feel " +
        "where the AI is at work without ever reading a label.";

    protected override void OnInitialized()
    {
        _cts = new CancellationTokenSource();
        _ = RunStreamAsync(_cts.Token);
    }

    private async Task RunStreamAsync(CancellationToken ct)
    {
        try
        {
            // Tool-call phase — short pause to show the Thinking pulse.
            await Task.Delay(550, ct);
            if (ct.IsCancellationRequested) return;

            _phase = Phase.Streaming;
            _ai = AiState.Streaming;
            _statusLabel = "Streaming tokens…";
            await InvokeAsync(StateHasChanged);

            // Stream the mock response token by token.
            var words = MockResponse.Split(' ');
            for (int i = 0; i < words.Length; i++)
            {
                if (ct.IsCancellationRequested) return;
                _streamed += (i == 0 ? "" : " ") + words[i];
                await InvokeAsync(StateHasChanged);
                await Task.Delay(45, ct);
            }

            // One-shot reveal.
            _ai = AiState.Generated;
            _statusLabel = "Generated — review and approve.";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(900, ct);
            if (ct.IsCancellationRequested) return;

            // Settle to Active so the ring keeps signalling AI presence while editable.
            _phase = Phase.Review;
            _ai = AiState.Active;
            _statusLabel = "Edit if you like, then Approve.";
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { /* dialog dismissed during stream */ }
    }

    private void Approve() => Instance.Close(DialogResult.Ok(_streamed));
    private void Cancel() => Instance.Cancel();

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
