@namespace DRYL.Components.Demo.Components.Dialogs

<DrylDialog Icon="User">
    <ChildContent>
        <div class="col" style="gap: var(--sp-4);">
            <p style="margin: 0;">
                This dialog received a <code>UserId</code> parameter from the caller
                and exposes a small form. Submit it with <strong>Save</strong> to
                resolve the awaited <code>DialogResult</code>.
            </p>

            <div class="col" style="gap: var(--sp-3);">
                <DrylInputText Label="Display name" @bind-Value="_name"
                               Placeholder="Jane Doe" />
                <DrylTextarea Label="Bio" @bind-Value="_bio"
                              Placeholder="A short description…" />
            </div>

            <div class="col" style="gap: var(--sp-1);">
                <span class="eyebrow">Received user id</span>
                <code style="color: var(--fg);">@UserId</code>
            </div>
        </div>
    </ChildContent>
    <ActionContent>
        <DrylButton Variant="DrylButton.ButtonVariant.Ghost" @onclick="Cancel">
            Cancel
        </DrylButton>
        <DrylButton Variant="DrylButton.ButtonVariant.Primary"
                    LeadingIcon="Check" @onclick="Save">
            Save
        </DrylButton>
    </ActionContent>
</DrylDialog>

@code {
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public string InitialName { get; set; } = "";

    [CascadingParameter] public IDrylDialogInstance Instance { get; set; } = default!;

    private string _name = "";
    private string _bio = "";

    protected override void OnInitialized()
    {
        _name = InitialName;
    }

    private void Save() =>
        Instance.Close(DialogResult.Ok(new SampleResult(_name, _bio)));

    private void Cancel() => Instance.Cancel();

    public record SampleResult(string Name, string Bio);
}
