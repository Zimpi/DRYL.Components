@inject ExampleSourceProvider Sources

@*  Renders an example component live (Preview tab) alongside the exact source
    text that produced it (Code tab), read from the embedded example file.
    The Source key is the path under Components/Examples, e.g. "Button/Variants". *@

<section class="col demo-example" style="gap: var(--sp-3);">
    @if (!string.IsNullOrEmpty(Title))
    {
        <h3>@Title</h3>
    }
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="lead">@Description</p>
    }

    <div class="demo-example-card">
        <DrylTabs AriaLabel="@($"{Title} example")">
            <DrylTab Label="Preview" Icon="Eye">
                <div class="demo-example-preview">
                    @ChildContent
                </div>
            </DrylTab>
            <DrylTab Label="Code" Icon="Code">
                <div class="demo-example-code">
                    <DrylCodeBlock Language="html" Code="@_source" ShowLineNumbers />
                </div>
            </DrylTab>
        </DrylTabs>
    </div>
</section>

@code {
    /// <summary>Optional section heading (also indexed by the on-page TOC).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Optional explanatory line shown under the heading.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Example key under Components/Examples without extension, e.g. "Button/Variants".</summary>
    [Parameter, EditorRequired] public string Source { get; set; } = "";

    /// <summary>The live example — normally the matching example component, e.g. &lt;Examples.Button.Variants /&gt;.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _source = "";

    protected override void OnParametersSet() => _source = Sources.Get(Source);
}
