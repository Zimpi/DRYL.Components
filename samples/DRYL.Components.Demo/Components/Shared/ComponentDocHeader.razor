@*  Standard header for a component documentation page. Pulls category, name,
    AI-awareness and the "View source" link from the ComponentCatalog by slug,
    so every page header stays consistent and current. *@

@if (_entry is not null)
{
    <div class="col doc-header" style="gap: var(--sp-2);">
        <span class="eyebrow">@_entry.Category</span>

        <div class="row" style="align-items: center; gap: var(--sp-3); flex-wrap: wrap;">
            <h2 style="margin: 0;">@(_entry.ClassName ?? _entry.Title)</h2>
            @if (_entry.Ai)
            {
                <DrylBadge Kind="DrylBadge.BadgeKind.Accent" Dot="true">AI-aware</DrylBadge>
            }
        </div>

        <p class="lead">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @_entry.Summary
            }
        </p>

        <div class="row" style="gap: var(--sp-3);">
            <a class="doc-source-link"
               href="@ComponentCatalog.SourceUrl(_entry)"
               target="_blank"
               rel="noopener">
                <DrylIcon Name="Code" Size="14" />
                <span>View source</span>
            </a>
        </div>
    </div>
}

@code {
    /// <summary>Route slug of the component (must match a ComponentCatalog entry), e.g. "buttons".</summary>
    [Parameter, EditorRequired] public string Slug { get; set; } = "";

    /// <summary>Optional richer description; falls back to the catalog summary when omitted.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ComponentDocEntry? _entry;

    protected override void OnParametersSet() => _entry = ComponentCatalog.FindBySlug(Slug);
}
