@page "/overview"

<PageTitle>DRYL — Overview</PageTitle>

@*  The showcase page: one realistic AI-product screen ("Mission Control")
    composed entirely of DRYL components. Every state is static so the page
    always screenshots the same way — the only motion is the CSS-driven
    AI vocabulary (ring, glow, shimmer), which is exactly what should be felt. *@

<div class="col fade-in ov-page">

    @* ── Header ─────────────────────────────────────────────── *@
    <div class="ov-header">
        <div class="col" style="gap: var(--sp-2);">
            <span class="eyebrow">DRYL · Every pixel below is a component</span>
            <h2>Mission Control</h2>
            <p class="lead" style="margin: 0;">
                A live agent fleet, rendered in DRYL — dark, glassy, and aware of the AI working inside it.
            </p>
        </div>
        <div class="row" style="gap: var(--sp-3); align-items: center; flex-wrap: wrap;">
            <DrylAiIndicator State="AiState.Streaming" />
            <DrylAvatarGroup Max="3">
                <DrylAvatar Name="Ada Lovelace" Status="AvatarStatus.Online" />
                <DrylAvatar Name="Alan Turing" Status="AvatarStatus.Online" />
                <DrylAvatar Name="Grace Hopper" />
                <DrylAvatar Name="Edsger Dijkstra" />
            </DrylAvatarGroup>
            <DrylTooltip Text="Notifications">
                <DrylButton Variant="DrylButton.ButtonVariant.Ghost" LeadingIcon="Bell" AriaLabel="Notifications" />
            </DrylTooltip>
            <DrylButton Variant="DrylButton.ButtonVariant.Primary" LeadingIcon="Sparkle">Ask AI</DrylButton>
        </div>
    </div>

    @* ── KPI row ────────────────────────────────────────────── *@
    <div class="ov-kpis">
        <DrylStat Label="Tokens / min" Value="48.2k" Icon="Bolt"
                  Delta="+12.4%" Direction="DeltaDirection.Up">
            <Sparkline><DrylSparkline Data="@_tokens" Kind="SparklineKind.Area" /></Sparkline>
        </DrylStat>
        <DrylStat Label="Active agents" Value="24" Icon="Sparkle"
                  Delta="+3" Direction="DeltaDirection.Up">
            <Sparkline><DrylSparkline Data="@_agents" Kind="SparklineKind.Bar" /></Sparkline>
        </DrylStat>
        <DrylStat Label="p95 latency" Value="412 ms" Icon="Activity"
                  Delta="-8.1%" Direction="DeltaDirection.Down">
            <Sparkline><DrylSparkline Data="@_latency" Kind="SparklineKind.Line" ShowLastDot="true" /></Sparkline>
        </DrylStat>
        <DrylStat Label="Cost / hour" Value="$7.42" Icon="Hash"
                  Delta="+2.3%" Direction="DeltaDirection.Up">
            <Sparkline><DrylSparkline Data="@_cost" Kind="SparklineKind.Area" /></Sparkline>
        </DrylStat>
    </div>

    @* ── Fleet table + Copilot ──────────────────────────────── *@
    <div class="ov-main">
        <div class="col" style="gap: var(--sp-3); min-width: 0;">
            <DrylTable TItem="AgentRow" Items="@_fleet" AriaLabel="Agent fleet"
                       ShowToolbar Searchable Selectable PageSize="10">
                <Columns>
                    <DrylColumn TItem="AgentRow" Field="@(a => a.Name)" Title="Agent" Sortable Searchable Primary />
                    <DrylColumn TItem="AgentRow" Field="@(a => a.Model)" Title="Model" Sortable />
                    <DrylColumn TItem="AgentRow" Field="@(a => a.Status)" Title="Status" Sortable>
                        <CellTemplate Context="a">
                            <DrylBadge Kind="@StatusKind(a.Status)" Dot="true">@a.Status</DrylBadge>
                        </CellTemplate>
                    </DrylColumn>
                    <DrylColumn TItem="AgentRow" Field="@(a => a.TokensPerMin)" Title="Tokens/min"
                                Sortable Align="ColumnAlign.End" Width="110px">
                        <CellTemplate Context="a">@a.TokensPerMin.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</CellTemplate>
                    </DrylColumn>
                    <DrylColumn TItem="AgentRow" Field="@(a => a.P95Ms)" Title="p95"
                                Sortable Align="ColumnAlign.End" Width="90px">
                        <CellTemplate Context="a">@($"{a.P95Ms} ms")</CellTemplate>
                    </DrylColumn>
                    <DrylColumn TItem="AgentRow" Field="@(a => a.Name)" Title="Trend" Width="120px">
                        <CellTemplate Context="a">
                            <DrylSparkline Data="@a.Trend" Kind="SparklineKind.Line" />
                        </CellTemplate>
                    </DrylColumn>
                </Columns>
            </DrylTable>
        </div>

        <DrylCard Ai="AiState.Active" Spotlight="false" Padding="DrylCard.CardPadding.Tight">
            <div class="col" style="gap: var(--sp-3);">
                <div class="row" style="justify-content: space-between; align-items: center;">
                    <div class="row" style="gap: var(--sp-2); align-items: center;">
                        <DrylIcon Name="Sparkle" Size="16" />
                        <strong>DRYL Copilot</strong>
                    </div>
                    <DrylBadge Kind="DrylBadge.BadgeKind.Accent" Dot="true">Streaming</DrylBadge>
                </div>
                <DrylChat Height="332px">
                    <ChildContent>
                        <DrylMessage Role="MessageRole.Assistant" Author="Copilot" Timestamp="14:01"
                                     AvatarIcon="Sparkle">
                            Watching the 14:00 canary deploy. Ask me anything about the fleet.
                        </DrylMessage>
                        <DrylMessage Role="MessageRole.User" Author="You" Timestamp="14:02">
                            Which agents regressed after the deploy?
                        </DrylMessage>
                        <DrylMessage Role="MessageRole.Assistant" Author="Copilot" Timestamp="14:02"
                                     AvatarIcon="Sparkle" Ai="AiState.Streaming">
                            Two agents regressed: <strong>support-triage</strong> is up 38&nbsp;ms on p95 and
                            <strong>code-review</strong> shows +0.8% tool-call errors. Rolling the canary back to
                        </DrylMessage>
                    </ChildContent>
                    <Footer>
                        <DrylChatComposer Placeholder="Ask about your fleet…"
                                          Disabled="true"
                                          Ai="AiState.Streaming" />
                    </Footer>
                </DrylChat>
            </div>
        </DrylCard>
    </div>

    @* ── Agent trace · Rollout · Model controls ─────────────── *@
    <div class="ov-grid-3">
        <DrylCard Spotlight="false" Padding="DrylCard.CardPadding.Tight">
            <div class="col" style="gap: var(--sp-3);">
                <div class="row" style="justify-content: space-between; align-items: center;">
                    <strong>Agent trace</strong>
                    <DrylAiIndicator State="AiState.Thinking" />
                </div>
                <DrylTimeline AriaLabel="Agent trace">
                    <DrylTimelineItem Title="Prompt received" Timestamp="14:02:11"
                                      Icon="Check" Variant="TimelineVariant.Success" />
                    <DrylTimelineItem Title="Plan" Timestamp="14:02:12">
                        <DrylToolCall ToolName="retrieve_metrics" State="AiState.Generated"
                                      Arguments="@_metricsArgs" Result="@_metricsResult" />
                    </DrylTimelineItem>
                    <DrylTimelineItem Title="Act" Timestamp="14:02:14" Variant="TimelineVariant.Accent">
                        <DrylToolCall ToolName="rollback_canary" State="AiState.Thinking"
                                      Arguments="@_rollbackArgs" />
                    </DrylTimelineItem>
                    <DrylTimelineItem Title="Compose summary" Ai="AiState.Streaming" />
                </DrylTimeline>
            </div>
        </DrylCard>

        <DrylCard Spotlight="false" Padding="DrylCard.CardPadding.Tight">
            <div class="col" style="gap: var(--sp-4);">
                <div class="row" style="justify-content: space-between; align-items: center;">
                    <strong>Canary rollout</strong>
                    <DrylBadge Kind="DrylBadge.BadgeKind.Warning" Dot="true">Rolling back</DrylBadge>
                </div>
                <DrylProgress Value="42" Variant="ProgressVariant.Accent" ShowLabel="true" LabelText="Canary traffic" />
                <DrylProgress Value="100" Variant="ProgressVariant.Success" ShowLabel="true" LabelText="Eval suite" />
                <DrylProgress Value="68" Variant="ProgressVariant.Warning" ShowLabel="true" LabelText="Token budget" />
                <DrylAlert Kind="DrylAlert.AlertKind.Ai" Title="Incident summary ready" Ai="AiState.Generated">
                    Root cause drafted from 3 traces — review before posting to the channel.
                </DrylAlert>
            </div>
        </DrylCard>

        <DrylCard Spotlight="false" Padding="DrylCard.CardPadding.Tight">
            <div class="col" style="gap: var(--sp-4);">
                <strong>Model controls</strong>
                <DrylInputText @bind-Value="_systemPrompt" Label="System prompt"
                               LeadingIcon="Sparkle" Ai="AiState.Streaming" />
                <DrylSelect @bind-Value="_model" Label="Model" Items="@_models" />
                <DrylSlider @bind-Value="_temperature" Label="Temperature"
                            Min="0" Max="1" Step="0.05" />
                <DrylChipInput @bind-Tags="_tags" Label="Routing tags" />
                <div class="row" style="gap: var(--sp-5); flex-wrap: wrap;">
                    <DrylToggle @bind-Value="_streamTokens" Label="Stream tokens" />
                    <DrylToggle @bind-Value="_toolCalls" Label="Tool calls" />
                </div>
                <DrylRating Value="4" Label="Answer quality" ReadOnly="true" />
            </div>
        </DrylCard>
    </div>

    @* ── Wiring + design language ───────────────────────────── *@
    <div class="ov-bottom">
        <DrylCodeBlock Language="csharp" Code="@_wiring" ShowLineNumbers Ai="AiState.Generated" />

        <DrylCard Spotlight="false" Padding="DrylCard.CardPadding.Tight">
            <div class="col" style="gap: var(--sp-4);">
                <strong>One design language</strong>
                <div class="row" style="flex-wrap: wrap;">
                    <DrylBadge Dot="true">Idle</DrylBadge>
                    <DrylBadge Kind="DrylBadge.BadgeKind.Accent" Dot="true">Live</DrylBadge>
                    <DrylBadge Kind="DrylBadge.BadgeKind.Success" Dot="true">Healthy</DrylBadge>
                    <DrylBadge Kind="DrylBadge.BadgeKind.Warning" Dot="true">Throttled</DrylBadge>
                    <DrylBadge Kind="DrylBadge.BadgeKind.Danger" Dot="true">Failing</DrylBadge>
                </div>
                <DrylDivider />
                <div class="row" style="flex-wrap: wrap;">
                    <DrylButton Variant="DrylButton.ButtonVariant.Primary" Size="DrylButton.ButtonSize.Small">Deploy</DrylButton>
                    <DrylButton Variant="DrylButton.ButtonVariant.Secondary" Size="DrylButton.ButtonSize.Small">Preview</DrylButton>
                    <DrylButton Variant="DrylButton.ButtonVariant.Ghost" Size="DrylButton.ButtonSize.Small">Logs</DrylButton>
                    <DrylButton Variant="DrylButton.ButtonVariant.Danger" Size="DrylButton.ButtonSize.Small">Rollback</DrylButton>
                </div>
                <DrylDivider />
                <DrylSegmentedControl @bind-Value="_view" AriaLabel="View mode">
                    <DrylSegment Value="@("fleet")" Label="Fleet" Icon="Grid" />
                    <DrylSegment Value="@("traces")" Label="Traces" Icon="Activity" />
                    <DrylSegment Value="@("evals")" Label="Evals" Icon="Check" />
                </DrylSegmentedControl>
                <div class="row" style="gap: var(--sp-2); align-items: center; color: var(--fg-muted);">
                    <DrylKbd Keys="@(new[] { "Ctrl", "K" })" />
                    <span style="font-size: 12px;">opens the command palette — try it.</span>
                </div>
            </div>
        </DrylCard>
    </div>

</div>

@code {
    // ── KPI sparkline data ──────────────────────────────────
    private readonly double[] _tokens  = { 18, 22, 21, 26, 30, 28, 34, 41, 48 };
    private readonly double[] _agents  = { 14, 16, 15, 18, 19, 21, 20, 23, 24 };
    private readonly double[] _latency = { 610, 580, 545, 560, 510, 470, 455, 430, 412 };
    private readonly double[] _cost    = { 5.1, 5.4, 5.2, 5.9, 6.3, 6.1, 6.8, 7.1, 7.4 };

    // ── Fleet table ─────────────────────────────────────────
    private sealed record AgentRow(string Name, string Model, string Status, int TokensPerMin, int P95Ms, double[] Trend);

    private readonly List<AgentRow> _fleet =
    [
        new("support-triage",  "claude-fable-5",   "Degraded",  8420, 689, new double[] { 3, 4, 4, 5, 7, 9, 12, 14 }),
        new("code-review",     "claude-opus-4-8",  "Throttled", 6210, 512, new double[] { 6, 7, 6, 8, 9, 11, 10, 12 }),
        new("release-notes",   "claude-sonnet-4-6","Online",    3980, 388, new double[] { 8, 7, 8, 7, 6, 7, 6, 6 }),
        new("doc-search",      "claude-haiku-4-5", "Online",   12440, 142, new double[] { 5, 6, 5, 6, 5, 5, 6, 5 }),
        new("eval-runner",     "claude-sonnet-4-6","Online",    2210, 305, new double[] { 4, 4, 5, 4, 5, 4, 4, 5 }),
        new("ticket-router",   "claude-haiku-4-5", "Online",    9105, 118, new double[] { 7, 7, 6, 7, 8, 7, 7, 8 }),
        new("incident-scribe", "claude-fable-5",   "Online",    1840, 421, new double[] { 2, 3, 3, 4, 3, 4, 5, 4 }),
    ];

    private static DrylBadge.BadgeKind StatusKind(string status) => status switch
    {
        "Online"    => DrylBadge.BadgeKind.Success,
        "Throttled" => DrylBadge.BadgeKind.Warning,
        "Degraded"  => DrylBadge.BadgeKind.Danger,
        _           => DrylBadge.BadgeKind.Neutral,
    };

    // ── Agent trace tool calls ──────────────────────────────
    private const string _metricsArgs   = """{ "window": "15m", "since": "14:00 deploy" }""";
    private const string _metricsResult = """{ "regressed": ["support-triage", "code-review"], "p95_delta_ms": 38 }""";
    private const string _rollbackArgs  = """{ "service": "code-review", "target": "v2.4.1" }""";

    // ── Model controls ──────────────────────────────────────
    private static readonly SelectItem[] _models =
    [
        new("claude-fable-5",    "claude-fable-5"),
        new("claude-opus-4-8",   "claude-opus-4-8"),
        new("claude-sonnet-4-6", "claude-sonnet-4-6"),
        new("claude-haiku-4-5",  "claude-haiku-4-5"),
    ];

    private string? _systemPrompt = "You are a concise incident-response copilot…";
    private string? _model = "claude-fable-5";
    private double _temperature = 0.7;
    private IReadOnlyList<string> _tags = ["incidents", "canary", "de-DE"];
    private bool _streamTokens = true;
    private bool _toolCalls = true;
    private string _view = "fleet";

    // ── Wiring snippet ──────────────────────────────────────
    private const string _wiring = """
        // One enum drives the whole AI vocabulary — on every component.
        _ai = AiState.Thinking;                       // tool call in flight
        await foreach (var chunk in chat.GetStreamingResponseAsync(prompt))
        {
            _ai = AiState.Streaming;                  // ring + glow speed up
            _text += chunk.Text;
            StateHasChanged();
        }
        _ai = AiState.Generated;                      // one-shot reveal wash
        """;
}
