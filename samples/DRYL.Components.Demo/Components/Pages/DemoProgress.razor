@page "/progress"

<PageTitle>DRYL — Progress</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="progress">
        Linear progress bar. Determinate by default; set
        <code>Indeterminate</code> for an animated sweep. Variants tint the
        fill, and the shared <code>Ai</code> state wraps the bar in the gradient
        aura for model-driven progress.
    </ComponentDocHeader>

    <DemoExample Title="Determinate" Source="Progress/Determinate">
        <DRYL.Components.Demo.Components.Examples.Progress.Determinate />
    </DemoExample>

    <DemoExample Title="Variants" Source="Progress/Variants">
        <DRYL.Components.Demo.Components.Examples.Progress.Variants />
    </DemoExample>

    <DemoExample Title="Sizes" Source="Progress/Sizes">
        <DRYL.Components.Demo.Components.Examples.Progress.Sizes />
    </DemoExample>

    <DemoExample Title="Indeterminate" Source="Progress/Indeterminate">
        <DRYL.Components.Demo.Components.Examples.Progress.Indeterminate />
    </DemoExample>

    <DemoExample Title="AI mode" Source="Progress/AiMode"
                 Description="The bar adopts the shared AI aura; the pulse speed follows the state.">
        <DRYL.Components.Demo.Components.Examples.Progress.AiMode />
    </DemoExample>

</div>
