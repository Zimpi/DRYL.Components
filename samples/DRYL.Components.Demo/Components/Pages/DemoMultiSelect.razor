@page "/multiselect"

<PageTitle>DRYL — Multi Select</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="multiselect">
        Multi-selection dropdown with removable chips. Bind via <code>@@bind-SelectedValues</code>.
        The panel stays open while selecting — close with Escape or Tab.
    </ComponentDocHeader>

    <DemoExample Title="Basics" Source="MultiSelect/Basics">
        <DRYL.Components.Demo.Components.Examples.MultiSelect.Basics />
    </DemoExample>

    <DemoExample Title="Chip overflow" Source="MultiSelect/Overflow"
                 Description="When more than MaxVisibleChips items are selected, a &quot;+N&quot; badge appears.">
        <DRYL.Components.Demo.Components.Examples.MultiSelect.Overflow />
    </DemoExample>

    <DemoExample Title="States" Source="MultiSelect/States">
        <DRYL.Components.Demo.Components.Examples.MultiSelect.States />
    </DemoExample>

    <DemoExample Title="AI mode" Source="MultiSelect/AiMode">
        <DRYL.Components.Demo.Components.Examples.MultiSelect.AiMode />
    </DemoExample>

</div>
