@page "/tables"

<PageTitle>DRYL — Table</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <div class="col" style="gap: var(--sp-2);">
        <span class="eyebrow">Data</span>
        <h2>DrylTable</h2>
        <p class="lead">
            Glass data table with declarative columns, click-to-sort, global search,
            per-column filters, pagination, grouping, row-expansion, bulk-actions,
            virtualization, column visibility, state persistence, row selection and
            an optional KPI summary bar. Optional <code>DataProvider</code> for
            server-side loading.
        </p>
    </div>

    @* ─── Filters + pagination ─── *@
    <section class="col" style="gap: var(--sp-3);">
        <h3>Filters and pagination</h3>
        <p>
            Mark columns <code>Filterable</code> for a per-column filter popover (Text or
            Select inferred from the field type). Set <code>PageSize</code> for the
            paginated footer. Active filters appear as chips in the toolbar.
        </p>

        <DrylTable TItem="ServiceRow"
                   Items="@_largeServices"
                   AriaLabel="Services — filterable"
                   ShowToolbar
                   Searchable
                   PageSize="10">
            <Columns>
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Name)"
                            Title="Service"
                            Sortable Searchable Filterable Primary />
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Environment)"
                            Title="Environment"
                            Sortable Searchable Filterable
                            FilterType="ColumnFilterType.Select">
                    <CellTemplate Context="svc">
                        <DrylBadge>@svc.Environment</DrylBadge>
                    </CellTemplate>
                </DrylColumn>
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Status)"
                            Title="Status"
                            Sortable Searchable Filterable
                            FilterType="ColumnFilterType.Select">
                    <CellTemplate Context="svc">
                        @if (svc.Status == "healthy")
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Success" Dot>healthy</DrylBadge>
                        }
                        else if (svc.Status == "throttled")
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Warning" Dot>throttled</DrylBadge>
                        }
                        else
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Danger" Dot>failed</DrylBadge>
                        }
                    </CellTemplate>
                </DrylColumn>
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.LatencyMs)"
                            Title="Latency"
                            Sortable Align="ColumnAlign.End" Width="120px">
                    <CellTemplate Context="svc">@(svc.LatencyMs.HasValue ? $"{svc.LatencyMs} ms" : "—")</CellTemplate>
                </DrylColumn>
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.LastSeen)"
                            Title="Last seen" />
            </Columns>
        </DrylTable>
    </section>

    @* ─── Standalone pagination ─── *@
    <section class="col" style="gap: var(--sp-3);">
        <h3>DrylPagination — standalone</h3>
        <p>
            The pagination control is also usable on its own — pass any
            <code>CurrentPage</code>, <code>PageSize</code> and <code>TotalCount</code>.
        </p>
        <div class="glass-card p-0" style="overflow: hidden;">
            <DrylPagination CurrentPage="@_standalonePage"
                            PageSize="@_standaloneSize"
                            TotalCount="237"
                            OnPageChanged="@(p => _standalonePage = p)"
                            OnPageSizeChanged="@(s => { _standaloneSize = s; _standalonePage = 0; })" />
        </div>
    </section>

    @* ─── With toolbar (search + sort) ─── *@
    <section class="col" style="gap: var(--sp-3);">
        <h3>Toolbar — search and sort</h3>
        <p>
            Add <code>Searchable</code> and <code>ShowToolbar</code> to enable the global search.
            Mark columns <code>Sortable</code> to make their headers click-to-sort. Hold <kbd>Shift</kbd>
            and click a second header for multi-sort.
        </p>

        <DrylTable TItem="ServiceRow"
                   Items="@_services"
                   AriaLabel="Services"
                   ShowToolbar
                   Searchable
                   Selectable
                   SelectedItems="@_selected"
                   SelectedItemsChanged="@(s => _selected = s)"
                   OnRowClick="@(s => _lastClicked = s.Name)">

            <SummaryContent>
                <DrylTableKpi Label="Requests / min"
                              Value="12,847"
                              Delta="+8.2%"
                              DeltaKind="DrylTableKpi.KpiDeltaKind.Positive"
                              Trend="DrylTableKpi.KpiTrend.Up"
                              SparklineData="@_sparkRequests" />

                <DrylTableKpi Label="p95 Latency"
                              Value="84 ms"
                              Delta="-12 ms"
                              DeltaKind="DrylTableKpi.KpiDeltaKind.Positive"
                              Trend="DrylTableKpi.KpiTrend.Down"
                              SparklineData="@_sparkLatency" />

                <DrylTableKpi Label="Error Rate"
                              Value="0.04%"
                              Delta="+0.01%"
                              DeltaKind="DrylTableKpi.KpiDeltaKind.Negative"
                              Trend="DrylTableKpi.KpiTrend.Up"
                              SparklineData="@_sparkErrors" />

                <DrylTableKpi Label="Active Users"
                              Value="1,204"
                              Delta="+142"
                              DeltaKind="DrylTableKpi.KpiDeltaKind.Positive"
                              Trend="DrylTableKpi.KpiTrend.Up"
                              SparklineData="@_sparkUsers" />
            </SummaryContent>

            <Columns>
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Name)"
                            Title="Service"
                            Sortable Searchable Primary>
                    <CellTemplate Context="svc">
                        <div class="row" style="gap: var(--sp-2);">
                            <DrylIcon Name="Server" Size="14" />
                            @svc.Name
                        </div>
                    </CellTemplate>
                </DrylColumn>

                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Environment)"
                            Title="Environment"
                            Sortable Searchable>
                    <CellTemplate Context="svc">
                        <DrylBadge>@svc.Environment</DrylBadge>
                    </CellTemplate>
                </DrylColumn>

                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Status)"
                            Title="Status"
                            Sortable Searchable>
                    <CellTemplate Context="svc">
                        @if (svc.Status == "healthy")
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Success" Dot>healthy</DrylBadge>
                        }
                        else if (svc.Status == "throttled")
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Warning" Dot>throttled</DrylBadge>
                        }
                        else
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Danger" Dot>failed</DrylBadge>
                        }
                    </CellTemplate>
                </DrylColumn>

                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.LatencyMs)"
                            Title="Latency"
                            Sortable Align="ColumnAlign.End" Width="120px">
                    <CellTemplate Context="svc">
                        @(svc.LatencyMs.HasValue ? $"{svc.LatencyMs} ms" : "—")
                    </CellTemplate>
                </DrylColumn>

                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.LastSeen)"
                            Title="Last seen" />

                <DrylColumn TItem="ServiceRow" Title="" Width="56px" Align="ColumnAlign.End">
                    <CellTemplate Context="svc">
                        <DrylButton Variant="DrylButton.ButtonVariant.Ghost"
                                    Size="DrylButton.ButtonSize.Small"
                                    AriaLabel="More actions"
                                    LeadingIcon="Dots" />
                    </CellTemplate>
                </DrylColumn>
            </Columns>
        </DrylTable>

        @if (_selected.Count > 0)
        {
            <p style="color: var(--fg-muted); font-size: 12px; font-family: var(--font-mono);">
                @_selected.Count row(s) selected
                @if (!string.IsNullOrEmpty(_lastClicked))
                {
                    <span> · last clicked: @_lastClicked</span>
                }
            </p>
        }
    </section>

    @* ─── Grouping + Row expansion + Row actions + Bulk actions ─── *@
    <section class="col" style="gap: var(--sp-3);">
        <h3>Grouping, detail rows, row actions, bulk actions</h3>
        <p>
            Pass <code>GroupBy</code> to cluster rows under collapsible mono headers.
            <code>DetailTemplate</code> adds an expand chevron with a detail panel below
            each row. <code>RowActions</code> appends a per-row actions column and
            <code>BulkActions</code> floats a bar above the toolbar while rows are selected.
        </p>

        <DrylTable TItem="ServiceRow"
                   Items="@_largeServices"
                   AriaLabel="Services — grouped"
                   ShowToolbar Searchable
                   Selectable
                   SelectedItems="@_phase3Selected"
                   SelectedItemsChanged="@(s => _phase3Selected = s)"
                   GroupBy="@(s => s.Environment)"
                   PageSize="20">
            <Columns>
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Name)" Title="Service"
                            Sortable Searchable Primary />
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Status)" Title="Status"
                            Sortable Filterable FilterType="ColumnFilterType.Select">
                    <CellTemplate Context="svc">
                        @if (svc.Status == "healthy")
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Success" Dot>healthy</DrylBadge>
                        }
                        else if (svc.Status == "throttled")
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Warning" Dot>throttled</DrylBadge>
                        }
                        else
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Danger" Dot>failed</DrylBadge>
                        }
                    </CellTemplate>
                </DrylColumn>
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.LatencyMs)" Title="Latency"
                            Sortable Align="ColumnAlign.End" Width="120px">
                    <CellTemplate Context="svc">@(svc.LatencyMs.HasValue ? $"{svc.LatencyMs} ms" : "—")</CellTemplate>
                </DrylColumn>
                <DrylColumn TItem="ServiceRow" Field="@(s => s.LastSeen)" Title="Last seen" />
            </Columns>

            <DetailTemplate Context="svc">
                <div class="col" style="gap: var(--sp-3);">
                    <div class="row" style="gap: var(--sp-2); color: var(--fg-muted); font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;">
                        <DrylIcon Name="Info" Size="12" />
                        Details — @svc.Name
                    </div>
                    <div class="row" style="gap: var(--sp-5); flex-wrap: wrap;">
                        <div class="col" style="gap: 2px;">
                            <span style="color: var(--fg-dim); font-size: 11px;">Environment</span>
                            <span>@svc.Environment</span>
                        </div>
                        <div class="col" style="gap: 2px;">
                            <span style="color: var(--fg-dim); font-size: 11px;">Status</span>
                            <span>@svc.Status</span>
                        </div>
                        <div class="col" style="gap: 2px;">
                            <span style="color: var(--fg-dim); font-size: 11px;">Latency</span>
                            <span>@(svc.LatencyMs.HasValue ? $"{svc.LatencyMs} ms" : "—")</span>
                        </div>
                        <div class="col" style="gap: 2px;">
                            <span style="color: var(--fg-dim); font-size: 11px;">Last seen</span>
                            <span>@svc.LastSeen</span>
                        </div>
                    </div>
                </div>
            </DetailTemplate>

            <RowActions Context="svc">
                <DrylButton Variant="DrylButton.ButtonVariant.Ghost"
                            Size="DrylButton.ButtonSize.Small"
                            LeadingIcon="Settings"
                            AriaLabel="Edit"
                            OnClick="@(() => _lastClicked = $"Edit {svc.Name}")" />
                <DrylButton Variant="DrylButton.ButtonVariant.Ghost"
                            Size="DrylButton.ButtonSize.Small"
                            LeadingIcon="Dots"
                            AriaLabel="More" />
            </RowActions>

            <BulkActions Context="selected">
                <DrylButton Variant="DrylButton.ButtonVariant.Secondary"
                            Size="DrylButton.ButtonSize.Small"
                            LeadingIcon="Download">
                    Export @selected.Count
                </DrylButton>
                <DrylButton Variant="DrylButton.ButtonVariant.Danger"
                            Size="DrylButton.ButtonSize.Small"
                            LeadingIcon="X"
                            OnClick="@(() => DeletePhase3Selected())">
                    Delete
                </DrylButton>
            </BulkActions>
        </DrylTable>
    </section>

    @* ─── Row reorder ─── *@
    <section class="col" style="gap: var(--sp-3);">
        <h3>Row reorder — drag &amp; keyboard</h3>
        <p>
            Set <code>Reorderable</code> to add a leading grip handle. Drag a row to a new
            position, or focus the handle and press <kbd>Alt</kbd> + <kbd>↑</kbd> / <kbd>↓</kbd>
            for a keyboard-accessible move. Handle <code>OnRowReordered</code> to persist the
            new order — here it renumbers the priority column. Reordering needs a plain client
            list: it is ignored under <code>Virtualize</code>, <code>GroupBy</code> or
            <code>DataProvider</code>, and the handle is disabled while a column sort is active.
        </p>

        <DrylTable TItem="TaskRow"
                   Items="@_reorderTasks"
                   AriaLabel="Tasks — reorderable"
                   Reorderable
                   OnRowReordered="OnTaskReordered">
            <Columns>
                <DrylColumn TItem="TaskRow" Field="@(t => t.Priority)" Title="#"
                            Width="56px" Align="ColumnAlign.End" Primary />
                <DrylColumn TItem="TaskRow" Field="@(t => t.Title)" Title="Task" Primary />
                <DrylColumn TItem="TaskRow" Field="@(t => t.Owner)" Title="Owner" />
            </Columns>
        </DrylTable>

        @if (!string.IsNullOrEmpty(_lastReorder))
        {
            <p style="color: var(--fg-muted); font-size: 12px; font-family: var(--font-mono);">@_lastReorder</p>
        }
    </section>

    @* ─── Virtualization ─── *@
    <section class="col" style="gap: var(--sp-3);">
        <h3>Virtualization — 10 000 rows</h3>
        <p>
            Set <code>Virtualize</code> and a fixed <code>Height</code> to render only
            the rows currently in view via <code>Microsoft.AspNetCore.Components.Web.Virtualization</code>.
            Pagination is suppressed; the header stays sticky to the top of the scroll area.
        </p>

        <DrylTable TItem="ServiceRow"
                   Items="@_virtualServices"
                   AriaLabel="Services — virtualized"
                   ShowToolbar Searchable
                   Virtualize
                   Height="480px">
            <Columns>
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Name)" Title="Service"
                            Sortable Searchable Primary />
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Environment)" Title="Environment"
                            Sortable />
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Status)" Title="Status" Sortable />
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.LatencyMs)" Title="Latency"
                            Sortable Align="ColumnAlign.End" Width="120px">
                    <CellTemplate Context="svc">@(svc.LatencyMs.HasValue ? $"{svc.LatencyMs} ms" : "—")</CellTemplate>
                </DrylColumn>
            </Columns>
        </DrylTable>
    </section>

    @* ─── Column visibility + state persistence ─── *@
    <section class="col" style="gap: var(--sp-3);">
        <h3>Column visibility, CSV export &amp; state persistence</h3>
        <p>
            Set <code>AllowColumnVisibility</code> to expose a Settings-icon menu that
            toggles columns on and off. Set <code>ShowExport</code> to add a CSV export
            button — the download honours the active search, filters and sort, includes
            only the visible columns, and covers the full filtered set across all pages.
            Set <code>PersistStateKey</code> to remember sort, filters, page, page-size and
            hidden columns in <code>localStorage</code> across reloads. Mark a column
            <code>Hidden</code> to start it collapsed.
        </p>

        <DrylTable TItem="ServiceRow"
                   Items="@_largeServices"
                   AriaLabel="Services — persisted"
                   ShowToolbar Searchable
                   AllowColumnVisibility
                   ShowExport
                   ExportFileName="services.csv"
                   PersistStateKey="dryl-demo-services"
                   PageSize="10">
            <Columns>
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Name)" Title="Service"
                            Sortable Searchable Primary />
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Environment)" Title="Environment"
                            Sortable Filterable FilterType="ColumnFilterType.Select" />
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.Status)" Title="Status"
                            Sortable Filterable FilterType="ColumnFilterType.Select" />
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.LatencyMs)" Title="Latency"
                            Sortable Align="ColumnAlign.End" Width="120px" Hidden />
                <DrylColumn TItem="ServiceRow"
                            Field="@(s => s.LastSeen)" Title="Last seen" />
            </Columns>
        </DrylTable>
    </section>

    @* ─── Without toolbar ─── *@
    <section class="col" style="gap: var(--sp-3);">
        <h3>Plain table — no toolbar</h3>
        <p>Omit <code>ShowToolbar</code> for a stripped-down table with only the columns.</p>

        <DrylTable TItem="ServiceRow" Items="@_services" AriaLabel="Services — plain">
            <Columns>
                <DrylColumn TItem="ServiceRow" Field="@(s => s.Name)" Title="Service" Primary />
                <DrylColumn TItem="ServiceRow" Field="@(s => s.Environment)" Title="Environment" />
                <DrylColumn TItem="ServiceRow" Field="@(s => s.Status)" Title="Status">
                    <CellTemplate Context="svc">
                        @if (svc.Status == "healthy")
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Success" Dot>healthy</DrylBadge>
                        }
                        else if (svc.Status == "throttled")
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Warning" Dot>throttled</DrylBadge>
                        }
                        else
                        {
                            <DrylBadge Kind="DrylBadge.BadgeKind.Danger" Dot>failed</DrylBadge>
                        }
                    </CellTemplate>
                </DrylColumn>
                <DrylColumn TItem="ServiceRow" Field="@(s => s.LatencyMs)" Title="Latency" Align="ColumnAlign.End">
                    <CellTemplate Context="svc">@(svc.LatencyMs.HasValue ? $"{svc.LatencyMs} ms" : "—")</CellTemplate>
                </DrylColumn>
            </Columns>
        </DrylTable>
    </section>

    @* ─── Loading state ─── *@
    <section class="col" style="gap: var(--sp-3);">
        <h3>Loading state</h3>
        <div class="row" style="gap: var(--sp-2); margin-bottom: var(--sp-2);">
            <DrylButton Variant="DrylButton.ButtonVariant.Secondary"
                        Size="DrylButton.ButtonSize.Small"
                        OnClick="@ToggleLoading">
                Toggle loading
            </DrylButton>
        </div>

        <DrylTable TItem="ServiceRow" Items="@_services" AriaLabel="Services — loading" Loading="@_loading">
            <Columns>
                <DrylColumn TItem="ServiceRow" Field="@(s => s.Name)" Title="Service" Primary />
                <DrylColumn TItem="ServiceRow" Field="@(s => s.Status)" Title="Status" />
            </Columns>
        </DrylTable>
    </section>

    @* ─── Empty state ─── *@
    <section class="col" style="gap: var(--sp-3);">
        <h3>Empty state</h3>
        <DrylTable TItem="ServiceRow" Items="@_emptyServices" AriaLabel="Services — empty">
            <Columns>
                <DrylColumn TItem="ServiceRow" Field="@(s => s.Name)" Title="Service" Primary />
                <DrylColumn TItem="ServiceRow" Field="@(s => s.Status)" Title="Status" />
            </Columns>
            <EmptyContent>
                <div class="col" style="align-items: center; gap: var(--sp-2);">
                    <DrylIcon Name="Database" Size="24" />
                    <span>No services found</span>
                </div>
            </EmptyContent>
        </DrylTable>
    </section>

    @* ─── KPI tiles standalone ─── *@
    <section class="col" style="gap: var(--sp-3);">
        <h3>KPI delta kinds</h3>
        <p>
            <code>DeltaKind</code> controls color independently of <code>Trend</code>.
            Lower latency is positive; higher error rate is negative.
        </p>
        <div class="glass-card p-0 tbl-root">
            <div class="tbl-summary">
                <DrylTableKpi Label="Positive delta"
                              Value="99.9%"
                              Delta="+0.3%"
                              DeltaKind="DrylTableKpi.KpiDeltaKind.Positive"
                              Trend="DrylTableKpi.KpiTrend.Up"
                              SparklineData="@_sparkUsers" />

                <DrylTableKpi Label="Negative delta"
                              Value="2.4%"
                              Delta="+0.8%"
                              DeltaKind="DrylTableKpi.KpiDeltaKind.Negative"
                              Trend="DrylTableKpi.KpiTrend.Up"
                              SparklineData="@_sparkErrors" />

                <DrylTableKpi Label="Neutral (no trend)"
                              Value="1,024"
                              Delta="±0"
                              SparklineData="@_sparkRequests" />

                <DrylTableKpi Label="No delta"
                              Value="42"
                              SparklineData="@_sparkLatency" />
            </div>
        </div>
    </section>

</div>

@code {
    private IReadOnlySet<ServiceRow> _selected = new HashSet<ServiceRow>();
    private string? _lastClicked;
    private bool _loading;
    private static readonly ServiceRow[] _emptyServices = [];

    private readonly List<ServiceRow> _services =
    [
        new("auth-service",       "prod",    "healthy",   24,  "vor 12s"),
        new("billing-worker",     "prod",    "throttled", 142, "vor 1m"),
        new("search-index",       "staging", "healthy",   38,  "vor 3m"),
        new("media-pipeline",     "prod",    "failed",    null,"vor 4m"),
        new("report-generator",   "dev",     "healthy",   56,  "vor 9m"),
        new("notify-dispatcher",  "prod",    "healthy",   18,  "vor 14s"),
        new("token-rotator",      "prod",    "throttled", 210, "vor 2m"),
        new("cdn-purge",          "staging", "healthy",   44,  "vor 6m"),
    ];

    // Sparkline sample data
    private readonly IReadOnlyList<double> _sparkRequests = [9800, 10200, 10800, 11200, 12000, 11800, 12400, 12847];
    private readonly IReadOnlyList<double> _sparkLatency  = [120, 110, 102, 98, 91, 96, 88, 84];
    private readonly IReadOnlyList<double> _sparkErrors   = [0.01, 0.02, 0.01, 0.03, 0.04, 0.03, 0.04, 0.04];
    private readonly IReadOnlyList<double> _sparkUsers    = [820, 900, 960, 1020, 1080, 1100, 1160, 1204];

    private void ToggleLoading() => _loading = !_loading;

    // ───── Phase 2 demo state ─────
    private int _standalonePage;
    private int _standaloneSize = 20;

    private readonly List<ServiceRow> _largeServices = BuildLargeDataset(53);

    // ───── Phase 3 + 4 demo state ─────
    private IReadOnlySet<ServiceRow> _phase3Selected = new HashSet<ServiceRow>();
    private readonly List<ServiceRow> _virtualServices = BuildLargeDataset(10_000);

    private void DeletePhase3Selected()
    {
        foreach (var item in _phase3Selected)
            _largeServices.Remove(item);
        _phase3Selected = new HashSet<ServiceRow>();
    }

    private static List<ServiceRow> BuildLargeDataset(int count)
    {
        var envs = new[] { "prod", "staging", "dev" };
        var statuses = new[] { "healthy", "throttled", "failed" };
        var prefixes = new[] { "auth", "billing", "search", "media", "report", "notify", "cdn", "token", "image", "queue", "audit", "metric" };
        var suffixes = new[] { "service", "worker", "index", "pipeline", "generator", "dispatcher", "rotator", "purge", "uploader" };
        var rng = new Random(42);
        var rows = new List<ServiceRow>(count);
        for (var i = 0; i < count; i++)
        {
            var name = $"{prefixes[i % prefixes.Length]}-{suffixes[(i * 3) % suffixes.Length]}-{i + 1:D2}";
            rows.Add(new ServiceRow(
                Name: name,
                Environment: envs[rng.Next(envs.Length)],
                Status: statuses[rng.Next(statuses.Length)],
                LatencyMs: rng.NextDouble() < 0.15 ? null : rng.Next(8, 280),
                LastSeen: $"vor {rng.Next(1, 59)}{(rng.NextDouble() < 0.5 ? "s" : "m")}"));
        }
        return rows;
    }

    private record ServiceRow(string Name, string Environment, string Status, int? LatencyMs, string LastSeen);

    // ───── Row reorder demo state ─────
    private string? _lastReorder;

    private readonly List<TaskRow> _reorderTasks =
    [
        new() { Priority = 1, Title = "Triage incoming alerts",      Owner = "On-call" },
        new() { Priority = 2, Title = "Review billing reconciliation", Owner = "Finance" },
        new() { Priority = 3, Title = "Ship search relevance patch",  Owner = "Search" },
        new() { Priority = 4, Title = "Rotate signing keys",          Owner = "Platform" },
        new() { Priority = 5, Title = "Draft incident retrospective", Owner = "SRE" },
    ];

    private void OnTaskReordered(RowReorderEventArgs e)
    {
        var item = _reorderTasks[e.OldIndex];
        _reorderTasks.RemoveAt(e.OldIndex);
        _reorderTasks.Insert(e.NewIndex, item);
        for (var i = 0; i < _reorderTasks.Count; i++)
            _reorderTasks[i].Priority = i + 1;
        _lastReorder = $"Moved \"{item.Title}\" from #{e.OldIndex + 1} to #{e.NewIndex + 1}";
    }

    private sealed class TaskRow
    {
        public int Priority { get; set; }
        public string Title { get; set; } = "";
        public string Owner { get; set; } = "";
    }
}
