@page "/notifications"

<PageTitle>DRYL — Notifications</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="notifications">
        A bell trigger with an unread-count badge and a popover inbox panel — the
        persistent notification centre every app shell needs. Bind it to
        <code>IDrylNotificationService</code> and push entries from anywhere, or drive it
        from your own state. AI-generated entries carry the shared AI aura.
    </ComponentDocHeader>

    <DemoExample Title="Service-driven" Source="Notifications/ServiceDriven"
                 Description="With no Items, the bell binds to IDrylNotificationService (registered by AddDrylComponents). Push entries from anywhere — background jobs, AI completions — and the unread badge updates live. Open the panel and click a row to mark it read.">
        <DRYL.Components.Demo.Components.Examples.Notifications.ServiceDriven />
    </DemoExample>

    <DemoExample Title="Controlled" Source="Notifications/Controlled"
                 Description="Pass Items and handle OnMarkRead / OnMarkAllRead / OnRemove / OnClear to drive the inbox from your own state instead of the service.">
        <DRYL.Components.Demo.Components.Examples.Notifications.Controlled />
    </DemoExample>

    <DemoExample Title="AI-generated entries" Source="Notifications/AiEntries"
                 Description="Set a notification's Ai to Thinking / Generated and the row carries the shared AI aura — ideal for asynchronous AI results like “Your report was generated” or “Agent task finished”.">
        <DRYL.Components.Demo.Components.Examples.Notifications.AiEntries />
    </DemoExample>

</div>
