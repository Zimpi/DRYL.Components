@page "/stepper"

<PageTitle>DRYL — Stepper</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="stepper">
        Multi-step wizard container. Steps register themselves via a cascading
        parent reference — the same pattern as DrylTabs. Each step can carry
        its own <code>StepState</code> (Pending / Active / Completed / Error)
        and optionally an AI ambient ring via the shared <code>Ai</code> parameter.
    </ComponentDocHeader>

    <DemoExample Title="Horizontal" Source="Stepper/Horizontal">
        <DRYL.Components.Demo.Components.Examples.Stepper.Horizontal />
    </DemoExample>

    <DemoExample Title="Vertical" Source="Stepper/Vertical">
        <DRYL.Components.Demo.Components.Examples.Stepper.Vertical />
    </DemoExample>

    <DemoExample Title="Step states" Source="Stepper/States"
                 Description="Completed shows a check mark, Error shows an X. Click any step to activate it.">
        <DRYL.Components.Demo.Components.Examples.Stepper.States />
    </DemoExample>

    <DemoExample Title="AI mode" Source="Stepper/AiMode"
                 Description="A step with Ai=&quot;AiState.Thinking&quot; shows the rotating gradient ring around its header.">
        <DRYL.Components.Demo.Components.Examples.Stepper.AiMode />
    </DemoExample>

    <DemoExample Title="Disabled step" Source="Stepper/Disabled"
                 Description="A disabled step cannot be activated by clicking.">
        <DRYL.Components.Demo.Components.Examples.Stepper.Disabled />
    </DemoExample>

</div>
