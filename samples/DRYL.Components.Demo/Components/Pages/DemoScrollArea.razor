@page "/scroll-area"

<PageTitle>DRYL — Scroll Area</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="scroll-area">
        A scrollable region with a consistent, thin DRYL scrollbar — for
        sidebars, log viewers, code blocks and long lists. Pure CSS, no JS.
        Set <code>MaxHeight</code> for vertical scrolling or
        <code>Horizontal</code> with <code>MaxWidth</code> for horizontal.
    </ComponentDocHeader>

    <DemoExample Title="Vertical" Source="ScrollArea/Vertical">
        <DRYL.Components.Demo.Components.Examples.ScrollArea.Vertical />
    </DemoExample>

    <DemoExample Title="Horizontal" Source="ScrollArea/Horizontal">
        <DRYL.Components.Demo.Components.Examples.ScrollArea.Horizontal />
    </DemoExample>

</div>
