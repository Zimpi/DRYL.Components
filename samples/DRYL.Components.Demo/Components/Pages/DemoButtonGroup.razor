@page "/button-group"

<PageTitle>DRYL — Button Group &amp; Split Button</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="button-group">
        Cluster related actions into one segmented control, or pair a primary action
        with a caret menu of secondary variants — both composed from the existing
        <code>DrylButton</code> and <code>DrylMenu</code> primitives.
    </ComponentDocHeader>

    <DemoExample Title="Button group — clustered actions" Source="ButtonGroup/Clustered"
                 Description="Wrap related DrylButtons in DrylButtonGroup. Inner corners flatten and borders merge so the cluster reads as one outline.">
        <DRYL.Components.Demo.Components.Examples.ButtonGroup.Clustered />
    </DemoExample>

    <DemoExample Title="Toggle group — exclusive selection" Source="ButtonGroup/Toggle"
                 Description="Bind each segment's Pressed to drive an exclusive choice — the selected segment lights up via the shared btn--active surface.">
        <DRYL.Components.Demo.Components.Examples.ButtonGroup.Toggle />
    </DemoExample>

    <DemoExample Title="Split button — primary action + variants" Source="ButtonGroup/Split"
                 Description="DrylSplitButton joins a main action to a caret that opens a DrylMenu. Place DrylMenuItems in the MenuItems slot.">
        <DRYL.Components.Demo.Components.Examples.ButtonGroup.Split />
    </DemoExample>

</div>
