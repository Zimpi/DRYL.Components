@page "/datepicker"

<PageTitle>DRYL — Date Picker</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="datepicker">
        A keyboard-navigable calendar panel bound to <code>DateOnly?</code>.
        Supports a date range mode, Min/Max constraints, and AI ambient state
        for when a model pre-fills or computes the date.
    </ComponentDocHeader>

    <DemoExample Title="Single date" Source="DatePicker/SingleDate">
        <DRYL.Components.Demo.Components.Examples.DatePicker.SingleDate />
    </DemoExample>

    <DemoExample Title="Min / Max" Source="DatePicker/MinMax">
        <DRYL.Components.Demo.Components.Examples.DatePicker.MinMax />
    </DemoExample>

    <DemoExample Title="Date range" Source="DatePicker/Range">
        <DRYL.Components.Demo.Components.Examples.DatePicker.Range />
    </DemoExample>

    <DemoExample Title="EditForm validation" Source="DatePicker/Validation">
        <DRYL.Components.Demo.Components.Examples.DatePicker.Validation />
    </DemoExample>

    <DemoExample Title="AI mode" Source="DatePicker/AiMode">
        <DRYL.Components.Demo.Components.Examples.DatePicker.AiMode />
    </DemoExample>

    <DemoExample Title="Disabled" Source="DatePicker/Disabled">
        <DRYL.Components.Demo.Components.Examples.DatePicker.Disabled />
    </DemoExample>

</div>
