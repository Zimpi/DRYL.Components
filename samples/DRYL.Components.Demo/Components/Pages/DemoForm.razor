@page "/forms"

<PageTitle>DRYL — Form Controls</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <div class="col" style="gap: var(--sp-2);">
        <span class="eyebrow">Inputs</span>
        <h2>Form Controls</h2>
        <p class="lead">
            Every form control DRYL ships, side by side, bound to a single EditForm.
            Text, textarea, select, search, checkbox, toggle — all using the same
            <code>InputBase&lt;T&gt;</code> contract.
        </p>
    </div>

    <EditForm Model="@_model">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-6);">

            <div class="col" style="gap: var(--sp-4);">
                <DrylInputText @bind-Value="_model.ProjectName"
                               Label="Project Name"
                               Placeholder="DRYL.Internal.Tools" />

                <DrylTextarea @bind-Value="_model.Description"
                              Label="Description"
                              Placeholder="Tell us about your project..."
                              Rows="4" />

                <DrylSelect @bind-Value="_model.Environment"
                            Label="Environment">
                    <option value="Production">Production</option>
                    <option value="Staging">Staging</option>
                    <option value="Development">Development</option>
                </DrylSelect>
            </div>

            <div class="col" style="gap: var(--sp-4);">
                <div class="field">
                    <label class="field-label">Search</label>
                    <div class="search" style="width: 100%;">
                        <DrylIcon Name="Search" Size="14" />
                        <input placeholder="Find anything..." />
                        <span class="kbd">⌘K</span>
                    </div>
                </div>

                <DrylInputText @bind-Value="_model.Email"
                               Label="Email"
                               Type="email"
                               Placeholder="@EmailPlaceholder" />

                <div class="field">
                    <label class="field-label">Options</label>
                    <div class="col" style="gap: var(--sp-2); margin-top: 6px;">
                        <DrylCheckbox @bind-Value="_model.HotReload" Label="Enable hot-reload" />
                        <DrylCheckbox @bind-Value="_model.AutoDeploy" Label="Auto-deploy on push" />
                        <DrylToggle @bind-Value="_model.DarkMode" Label="Dark mode (always on)" />
                        <DrylToggle @bind-Value="_model.WeeklyDigest" Label="Send weekly digest" />
                    </div>
                </div>
            </div>

        </div>
    </EditForm>

    <div class="col" style="gap: var(--sp-2);">
        <span class="eyebrow">Live model</span>
        <pre class="code-block" style="font-size: 12px;">@ModelJson</pre>
    </div>

</div>

@code {
    private const string EmailPlaceholder = "d@dryl.dev";

    private readonly FormModel _model = new()
    {
        ProjectName  = "DRYL.Internal.Tools",
        Environment  = "Production",
        HotReload    = true,
        AutoDeploy   = true,
        DarkMode     = true,
        WeeklyDigest = true,
    };

    private string ModelJson => System.Text.Json.JsonSerializer.Serialize(
        _model,
        new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

    private class FormModel
    {
        public string? ProjectName  { get; set; }
        public string? Description  { get; set; }
        public string? Environment  { get; set; }
        public string? Email        { get; set; }
        public bool    HotReload    { get; set; }
        public bool    AutoDeploy   { get; set; }
        public bool    DarkMode     { get; set; }
        public bool    WeeklyDigest { get; set; }
    }
}
