@page "/chat"

<PageTitle>DRYL — Chat</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="chat">
        Conversation surface. <code>DrylChat</code> hosts a scrollable message
        log and a pinned composer; <code>DrylMessage</code> renders each bubble
        and carries its own <code>Ai</code> state — so an assistant reply can
        think, stream and reveal using the shared AI vocabulary. Press Enter to
        send, Shift+Enter for a newline.
    </ComponentDocHeader>

    <DemoExample Title="Simulated assistant" Source="Chat/LiveConversation">
        <DRYL.Components.Demo.Components.Examples.Chat.LiveConversation />
    </DemoExample>

    <DemoExample Title="Message states" Source="Chat/MessageStates">
        <DRYL.Components.Demo.Components.Examples.Chat.MessageStates />
    </DemoExample>

</div>
