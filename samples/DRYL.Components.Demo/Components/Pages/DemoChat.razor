@page "/chat"
@using System.Threading

<PageTitle>DRYL — Chat</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <div class="col" style="gap: var(--sp-2);">
        <span class="eyebrow">Surfaces</span>
        <h2>DrylChat</h2>
        <p class="lead">
            Conversation surface. <code>DrylChat</code> hosts a scrollable message
            log and a pinned composer; <code>DrylMessage</code> renders each bubble
            and carries its own <code>Ai</code> state — so an assistant reply can
            think, stream and reveal using the shared AI vocabulary. Press Enter to
            send, Shift+Enter for a newline.
        </p>
    </div>

    @* ── Live conversation ────────────────────────────────── *@
    <section class="col" style="gap: var(--sp-3); max-width: 720px;">
        <h3>Simulated assistant</h3>
        <DrylChat Height="520px">
            <ChildContent>
                @foreach (var m in _messages)
                {
                    <DrylMessage Role="@m.Role"
                                 Author="@m.Author"
                                 Timestamp="@m.Timestamp"
                                 AvatarIcon="@(m.Role == MessageRole.Assistant ? "Sparkle" : null)"
                                 Typing="@m.Typing"
                                 Ai="@m.Ai">
                        @m.Text
                    </DrylMessage>
                }
            </ChildContent>
            <Footer>
                <DrylChatComposer @bind-Value="_draft"
                                  Placeholder="Ask DRYL AI…"
                                  Disabled="@_busy"
                                  Ai="@(_busy ? AiState.Thinking : AiState.None)"
                                  OnSend="HandleSend" />
            </Footer>
        </DrylChat>
    </section>

    @* ── States ───────────────────────────────────────────── *@
    <section class="col" style="gap: var(--sp-3); max-width: 720px;">
        <h3>Message states</h3>
        <DrylChat Height="auto" AutoScroll="false">
            <DrylMessage Role="MessageRole.System">Today</DrylMessage>
            <DrylMessage Role="MessageRole.User" Author="You" Timestamp="09:24">
                Summarise the Q2 incident report.
            </DrylMessage>
            <DrylMessage Role="MessageRole.Assistant" Author="DRYL AI" AvatarIcon="Sparkle" Typing="true" />
            <DrylMessage Role="MessageRole.Assistant" Author="DRYL AI" AvatarIcon="Sparkle"
                         Ai="AiState.Streaming">
                The Q2 incident was caused by a cascading timeout in the auth service…
            </DrylMessage>
            <DrylMessage Role="MessageRole.Assistant" Author="DRYL AI" AvatarIcon="Sparkle"
                         Ai="AiState.Generated">
                Summary ready — 3 root causes, 2 action items.
            </DrylMessage>
        </DrylChat>
    </section>

</div>

@code {
    private sealed class ChatMsg
    {
        public MessageRole Role { get; set; }
        public string? Author { get; set; }
        public string? Timestamp { get; set; }
        public string? Text { get; set; }
        public AiState Ai { get; set; } = AiState.None;
        public bool Typing { get; set; }
    }

    private readonly List<ChatMsg> _messages = new()
    {
        new ChatMsg { Role = MessageRole.Assistant, Author = "DRYL AI", Text = "Hi! Ask me anything about your data.", Timestamp = "09:20" }
    };

    private string? _draft;
    private bool _busy;

    private async Task HandleSend(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || _busy) return;
        _busy = true;

        _messages.Add(new ChatMsg
        {
            Role = MessageRole.User,
            Author = "You",
            Text = text,
            Timestamp = DateTime.Now.ToString("HH:mm")
        });
        StateHasChanged();

        // Thinking — typing dots
        var reply = new ChatMsg { Role = MessageRole.Assistant, Author = "DRYL AI", Typing = true, Ai = AiState.Thinking };
        _messages.Add(reply);
        StateHasChanged();
        await Task.Delay(900);

        // Streaming — reveal tokens
        reply.Typing = false;
        reply.Ai = AiState.Streaming;
        reply.Text = "";
        var full = "Here's what I found: the trend is up 12% week-over-week, driven mostly by the EU region.";
        foreach (var word in full.Split(' '))
        {
            reply.Text += (reply.Text!.Length == 0 ? "" : " ") + word;
            StateHasChanged();
            await Task.Delay(60);
        }

        // Generated — one-shot reveal, then settle
        reply.Ai = AiState.Generated;
        reply.Timestamp = DateTime.Now.ToString("HH:mm");
        StateHasChanged();
        await Task.Delay(900);
        reply.Ai = AiState.None;

        _busy = false;
        StateHasChanged();
    }
}
