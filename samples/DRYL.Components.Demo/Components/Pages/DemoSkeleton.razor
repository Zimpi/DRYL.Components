@page "/skeleton"

<PageTitle>DRYL — Skeleton</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="skeleton">
        AI-native content placeholder. While data loads, skeleton blocks communicate
        <em>what shape the content will take</em>. In AI workflows,
        <code>AiState.Streaming</code> shifts the shimmer to a violet-cyan gradient —
        a visual signal that the model is actively writing into these placeholder blocks.
    </ComponentDocHeader>

    <DemoExample Title="Variants" Source="Skeleton/Variants">
        <DRYL.Components.Demo.Components.Examples.Skeleton.Variants />
    </DemoExample>

    <DemoExample Title="Sizes" Source="Skeleton/Sizes">
        <DRYL.Components.Demo.Components.Examples.Skeleton.Sizes />
    </DemoExample>

    <DemoExample Title="AI Mode" Source="Skeleton/AiMode"
                 Description="Skeleton blocks respond to the same AiState lifecycle. Streaming shifts the shimmer to a violet-cyan gradient.">
        <DRYL.Components.Demo.Components.Examples.Skeleton.AiMode />
    </DemoExample>

    <DemoExample Title="AI lifecycle — live simulation" Source="Skeleton/Lifecycle"
                 Description="None → Thinking → Streaming → Generated → None. The skeleton fades out on Generated, then real content rises into place.">
        <DRYL.Components.Demo.Components.Examples.Skeleton.Lifecycle />
    </DemoExample>

    <DemoExample Title="Card and Avatar with AI mode" Source="Skeleton/CardAvatar">
        <DRYL.Components.Demo.Components.Examples.Skeleton.CardAvatar />
    </DemoExample>

    <DemoExample Title="Custom layout" Source="Skeleton/Custom"
                 Description="Use Variant=&quot;Custom&quot; with ChildContent to compose skeleton layouts that match any design.">
        <DRYL.Components.Demo.Components.Examples.Skeleton.Custom />
    </DemoExample>

</div>
