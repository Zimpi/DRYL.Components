@page "/input-password"
@using System.ComponentModel.DataAnnotations

<PageTitle>DRYL — Password Input</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <div class="col" style="gap: var(--sp-2);">
        <span class="eyebrow">Inputs</span>
        <h2>DrylInputPassword</h2>
        <p class="lead">
            Password input with a show/hide eye toggle. Inherits <code>InputBase&lt;string&gt;</code>
            — works inside any <code>EditForm</code> with DataAnnotations validation.
        </p>
    </div>

    <EditForm Model="@_model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <div class="col" style="gap: var(--sp-6);">

            <section class="col" style="gap: var(--sp-3);">
                <h3>Basics</h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); max-width: 720px;">
                    <DrylInputPassword @bind-Value="_model.Password"
                                       Label="Password"
                                       Placeholder="••••••••" />
                    <DrylInputPassword @bind-Value="_model.WithHelper"
                                       Label="API key"
                                       HelperText="Stored encrypted — shown once." />
                </div>
            </section>

            <section class="col" style="gap: var(--sp-3);">
                <h3>States</h3>
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); max-width: 1080px;">
                    <DrylInputPassword @bind-Value="_model.Success"
                                       Label="Success"
                                       State="InputState.Success"
                                       HelperText="Strong password." />
                    <DrylInputPassword @bind-Value="_model.Error"
                                       Label="Error"
                                       State="InputState.Error"
                                       HelperText="Too weak." />
                    <DrylInputPassword @bind-Value="_model.Dummy"
                                       Disabled="true"
                                       Label="Disabled"
                                       Placeholder="••••••••" />
                </div>
            </section>

            <section class="col" style="gap: var(--sp-3);">
                <h3>Live validation</h3>
                <div style="max-width: 360px;">
                    <DrylInputPassword @bind-Value="_model.Confirmed"
                                       Label="New password"
                                       HelperText="Must be at least 8 characters." />
                </div>
                <div class="row" style="align-items: center;">
                    <DrylButton IsSubmit="true" LeadingIcon="Check">Save password</DrylButton>
                    @if (_submitted)
                    {
                        <DrylBadge Kind="DrylBadge.BadgeKind.Success" Dot="true">Saved!</DrylBadge>
                    }
                </div>
            </section>

            <section class="col" style="gap: var(--sp-3);">
                <h3>AI mode</h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); max-width: 720px;">
                    <DrylInputPassword @bind-Value="_model.Dummy" Label="Thinking" Ai="AiState.Thinking" />
                    <DrylInputPassword @bind-Value="_model.Dummy" Label="Generated" Ai="AiState.Generated" />
                </div>
            </section>

        </div>
    </EditForm>

</div>

@code {
    private readonly DemoModel _model = new();
    private bool _submitted;

    private void HandleValidSubmit() => _submitted = true;

    private class DemoModel
    {
        public string? Password { get; set; }
        public string? WithHelper { get; set; }
        public string? Success { get; set; } = "v3ryStr0ng!";
        public string? Error { get; set; } = "abc";
        public string? Dummy { get; set; }

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8, ErrorMessage = "Must be at least 8 characters.")]
        public string? Confirmed { get; set; }
    }
}
