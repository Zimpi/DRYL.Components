@page "/tabs"

<PageTitle>DRYL — Tabs</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="tabs">
        Classic horizontal tabs with a gliding gradient underline. The active
        tab's underline scales in on selection; the panel below fades in.
        Every tab can opt into AI mode individually to signal "something is
        happening here" — same vocabulary as the rest of the library.
    </ComponentDocHeader>

    <DemoExample Title="Default" Source="Tabs/Default">
        <DRYL.Components.Demo.Components.Examples.Tabs.Default />
    </DemoExample>

    <DemoExample Title="With icons" Source="Tabs/Icons">
        <DRYL.Components.Demo.Components.Examples.Tabs.Icons />
    </DemoExample>

    <DemoExample Title="With trailing slot" Source="Tabs/Trailing">
        <DRYL.Components.Demo.Components.Examples.Tabs.Trailing />
    </DemoExample>

    <DemoExample Title="Disabled tab" Source="Tabs/Disabled">
        <DRYL.Components.Demo.Components.Examples.Tabs.Disabled />
    </DemoExample>

    <DemoExample Title="Two-way binding" Source="Tabs/TwoWayBinding">
        <DRYL.Components.Demo.Components.Examples.Tabs.TwoWayBinding />
    </DemoExample>

    <DemoExample Title="AI on a single tab" Source="Tabs/AiSingle">
        <DRYL.Components.Demo.Components.Examples.Tabs.AiSingle />
    </DemoExample>

</div>
