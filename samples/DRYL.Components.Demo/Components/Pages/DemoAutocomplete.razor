@page "/autocomplete"

<PageTitle>DRYL — Autocomplete</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="autocomplete">
        Generic combobox with client-side filtering or server-side async search.
        Fully keyboard-navigable (ArrowDown/Up, Enter, Escape), ARIA combobox
        pattern, EditForm integration, and AI ambient state for when a model
        pre-fills the selection.
    </ComponentDocHeader>

    <DemoExample Title="Static list" Source="Autocomplete/StaticList">
        <DRYL.Components.Demo.Components.Examples.Autocomplete.StaticList />
    </DemoExample>

    <DemoExample Title="Custom SearchFunc (starts-with)" Source="Autocomplete/CustomSearch">
        <DRYL.Components.Demo.Components.Examples.Autocomplete.CustomSearch />
    </DemoExample>

    <DemoExample Title="Custom ItemTemplate" Source="Autocomplete/CustomTemplate">
        <DRYL.Components.Demo.Components.Examples.Autocomplete.CustomTemplate />
    </DemoExample>

    <DemoExample Title="Async ItemsProvider" Source="Autocomplete/AsyncProvider"
                 Description="Simulates a 500ms server round-trip. Rapid typing cancels in-flight requests.">
        <DRYL.Components.Demo.Components.Examples.Autocomplete.AsyncProvider />
    </DemoExample>

    <DemoExample Title="EditForm validation" Source="Autocomplete/Validation">
        <DRYL.Components.Demo.Components.Examples.Autocomplete.Validation />
    </DemoExample>

    <DemoExample Title="AI mode" Source="Autocomplete/AiMode">
        <DRYL.Components.Demo.Components.Examples.Autocomplete.AiMode />
    </DemoExample>

    <DemoExample Title="Disabled" Source="Autocomplete/Disabled">
        <DRYL.Components.Demo.Components.Examples.Autocomplete.Disabled />
    </DemoExample>

</div>
