@page "/ai"

<PageTitle>DRYL — AI Mode</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="ai">
        DRYL components are designed for seamless AI integration. Set <code>Ai="AiState.X"</code> on any
        AI-aware component to mark it as AI-driven — rotating gradient border, breathing glow, one-shot
        reveals. Pair it with <code>Microsoft.Extensions.AI</code> tool calling so the UI breathes with
        the model.
    </ComponentDocHeader>

    <DemoExample Title="States — DrylCard with Ai" Source="Ai/States"
                 Description="The same surface in each of the five states. Spotlight disabled so the AI ring is the only signal.">
        <DRYL.Components.Demo.Components.Examples.Ai.States />
    </DemoExample>

    <DemoExample Title="Lifecycle simulation" Source="Ai/Lifecycle"
                 Description="Walk a card through None → Thinking → Streaming → Generated → Active.">
        <DRYL.Components.Demo.Components.Examples.Ai.Lifecycle />
    </DemoExample>

    <DemoExample Title="Inputs — DrylInputText &amp; DrylTextarea" Source="Ai/Inputs"
                 Description="The same five states wrapping the form field itself — useful for chat prompts and AI-bound inputs.">
        <DRYL.Components.Demo.Components.Examples.Ai.Inputs />
    </DemoExample>

    <DemoExample Title="Streaming rows — DrylTable with Ai" Source="Ai/StreamingRows"
                 Description="Stream rows the way a model would: a tool call fires, rows arrive one by one, only new rows animate.">
        <DRYL.Components.Demo.Components.Examples.Ai.StreamingRows />
    </DemoExample>

    <DemoExample Title="Buttons — DrylButton with Ai" Source="Ai/Buttons"
                 Description="The AI parameter is additive: the variant's fill stays, a rotating gradient ring is drawn around it.">
        <DRYL.Components.Demo.Components.Examples.Ai.Buttons />
    </DemoExample>

    <DemoExample Title="Expansion panels — DrylExpansion with Ai" Source="Ai/ExpansionPanels"
                 Description="Signal that a panel's content was produced by or is waiting on the model. The first panel streams its body in real time.">
        <DRYL.Components.Demo.Components.Examples.Ai.ExpansionPanels />
    </DemoExample>

    <DemoExample Title="DrylAiIndicator" Source="Ai/Indicator"
                 Description="Tiny status pill that adapts label and pulse speed to the AI state; announces changes via aria-live.">
        <DRYL.Components.Demo.Components.Examples.Ai.Indicator />
    </DemoExample>

    <DemoExample Title="Integration sketch" Source="Ai/Integration"
                 Description="Wiring with Microsoft.Extensions.AI.">
        <DRYL.Components.Demo.Components.Examples.Ai.Integration />
    </DemoExample>

</div>
