@page "/dialog"
@inject IDrylDialogService Dialogs

<PageTitle>DRYL — Dialog</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <div class="col" style="gap: var(--sp-2);">
        <span class="eyebrow">Surfaces</span>
        <h2>DrylDialog</h2>
        <p class="lead">
            Service-driven glass dialog. Open via <code>IDrylDialogService.ShowAsync&lt;TDialog&gt;</code>,
            await the result, edit your state. First-class support for the
            <strong>"human in the middle"</strong> flow — the model proposes,
            the user reviews, the user approves or edits.
        </p>
    </div>

    <section class="col" style="gap: var(--sp-3);">
        <h3>Convenience — Confirm &amp; Alert</h3>
        <p style="margin: 0; color: var(--fg-muted);">
            <code>ShowConfirmAsync</code> returns <code>DialogResult</code> with
            <code>Canceled = false</code> on confirm; <code>ShowAlertAsync</code> always returns OK.
        </p>
        <div class="row" style="gap: var(--sp-3);">
            <DrylButton Variant="DrylButton.ButtonVariant.Secondary" @onclick="OpenConfirm">
                Show confirm
            </DrylButton>
            <DrylButton Variant="DrylButton.ButtonVariant.Ghost" @onclick="OpenAlert">
                Show alert
            </DrylButton>
            <DrylButton Variant="DrylButton.ButtonVariant.Danger"
                        LeadingIcon="X" @onclick="OpenDestructive">
                Delete project…
            </DrylButton>
        </div>
        @if (!string.IsNullOrEmpty(_lastResult))
        {
            <p style="margin: 0; color: var(--fg-muted); font-family: var(--font-mono); font-size: 12px;">
                Last result: <span style="color: var(--fg);">@_lastResult</span>
            </p>
        }
    </section>

    <section class="col" style="gap: var(--sp-3);">
        <h3>Custom dialog with typed result</h3>
        <p style="margin: 0; color: var(--fg-muted);">
            <code>SampleDialog</code> receives a <code>UserId</code> parameter and returns a
            <code>SampleResult</code> record. Tab through the form — the focus trap keeps you inside.
        </p>
        <div class="row" style="gap: var(--sp-3);">
            <DrylButton Variant="DrylButton.ButtonVariant.Primary"
                        LeadingIcon="User" @onclick="OpenSample">
                Open sample dialog
            </DrylButton>
        </div>
        @if (_sampleResult is not null)
        {
            <DrylCard Spotlight="false" Padding="DrylCard.CardPadding.Tight">
                <div class="col" style="gap: var(--sp-2);">
                    <span class="eyebrow">Returned payload</span>
                    <div><strong>Name:</strong> @_sampleResult.Name</div>
                    <div><strong>Bio:</strong> @_sampleResult.Bio</div>
                </div>
            </DrylCard>
        }
    </section>

    <section class="col" style="gap: var(--sp-3);">
        <h3>Sizes</h3>
        <p style="margin: 0; color: var(--fg-muted);">
            Four width presets via <code>DialogOptions.Size</code>.
        </p>
        <div class="row" style="gap: var(--sp-3); flex-wrap: wrap;">
            <DrylButton Variant="DrylButton.ButtonVariant.Secondary"
                        @onclick="@(() => OpenSized(DialogSize.Small))">
                Small (420px)
            </DrylButton>
            <DrylButton Variant="DrylButton.ButtonVariant.Secondary"
                        @onclick="@(() => OpenSized(DialogSize.Medium))">
                Medium (640px)
            </DrylButton>
            <DrylButton Variant="DrylButton.ButtonVariant.Secondary"
                        @onclick="@(() => OpenSized(DialogSize.Large))">
                Large (960px)
            </DrylButton>
            <DrylButton Variant="DrylButton.ButtonVariant.Secondary"
                        @onclick="@(() => OpenSized(DialogSize.Fullscreen))">
                Fullscreen
            </DrylButton>
        </div>
    </section>

    <section class="col" style="gap: var(--sp-3);">
        <h3>Human in the Middle — AI flow</h3>
        <p style="margin: 0; color: var(--fg-muted);">
            User triggers an action → the model streams a proposal into the dialog →
            the user reviews, edits, and approves (or cancels). The dialog walks the
            standard <code>AiState</code> lifecycle:
            <strong>Thinking → Streaming → Generated → Active</strong>.
        </p>
        <div class="row" style="gap: var(--sp-3);">
            <DrylButton Variant="DrylButton.ButtonVariant.Primary"
                        LeadingIcon="Sparkle"
                        Ai="AiState.Active"
                        @onclick="OpenAiDialog">
                Generate summary…
            </DrylButton>
        </div>
        @if (!string.IsNullOrEmpty(_approvedText))
        {
            <DrylCard Spotlight="false" Padding="DrylCard.CardPadding.Tight" Ai="AiState.Generated">
                <div class="col" style="gap: var(--sp-2);">
                    <span class="eyebrow">Approved by user</span>
                    <p style="margin: 0; color: var(--fg);">@_approvedText</p>
                </div>
            </DrylCard>
        }
    </section>

</div>

@code {
    private string _lastResult = "";
    private SampleDialog.SampleResult? _sampleResult;
    private string _approvedText = "";

    private async Task OpenConfirm()
    {
        var result = await Dialogs.ShowConfirmAsync(
            "Discard changes?",
            "Your unsaved edits will be lost. This cannot be undone.");
        _lastResult = result.Canceled ? "Canceled" : "Confirmed";
    }

    private async Task OpenAlert()
    {
        await Dialogs.ShowAlertAsync(
            "Deployment failed",
            "Check the logs for stack trace details.");
        _lastResult = "Alert dismissed";
    }

    private async Task OpenDestructive()
    {
        var result = await Dialogs.ShowConfirmAsync(
            "Delete project?",
            "All resources will be permanently removed.",
            confirmLabel: "Delete",
            cancelLabel: "Keep");
        _lastResult = result.Canceled ? "Kept" : "Deleted";
    }

    private async Task OpenSample()
    {
        var p = new DialogParameters
        {
            ["UserId"] = Guid.NewGuid(),
            ["InitialName"] = "Jane Doe"
        };
        var reference = await Dialogs.ShowAsync<SampleDialog>(
            "Edit profile",
            p,
            new DialogOptions { Size = DialogSize.Medium });

        var result = await reference.Result;
        _sampleResult = result.DataAs<SampleDialog.SampleResult>();
    }

    private async Task OpenSized(DialogSize size)
    {
        var reference = await Dialogs.ShowAsync<SampleDialog>(
            $"Sized: {size}",
            new DialogParameters { ["UserId"] = Guid.NewGuid() },
            new DialogOptions { Size = size });
        await reference.Result;
    }

    private async Task OpenAiDialog()
    {
        var p = new DialogParameters
        {
            ["Prompt"] = "Summarize what DRYL is in two sentences."
        };
        var reference = await Dialogs.ShowAsync<AiGenerationDialog>(
            "AI summary",
            p,
            new DialogOptions { Size = DialogSize.Medium, Ai = AiState.Thinking });

        var result = await reference.Result;
        if (!result.Canceled)
        {
            _approvedText = result.DataAs<string>() ?? "";
        }
    }
}
