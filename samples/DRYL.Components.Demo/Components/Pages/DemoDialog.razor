@page "/dialog"

<PageTitle>DRYL — Dialog</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="dialog">
        Service-driven glass dialog. Open via <code>IDrylDialogService.ShowAsync&lt;TDialog&gt;</code>,
        await the result, edit your state. First-class support for the
        <strong>"human in the middle"</strong> flow — the model proposes,
        the user reviews, the user approves or edits.
    </ComponentDocHeader>

    <DemoExample Title="Convenience — Confirm &amp; Alert" Source="Dialog/ConfirmAlert"
                 Description="ShowConfirmAsync returns DialogResult with Canceled = false on confirm; ShowAlertAsync always returns OK.">
        <DRYL.Components.Demo.Components.Examples.Dialog.ConfirmAlert />
    </DemoExample>

    <DemoExample Title="Custom dialog with typed result" Source="Dialog/CustomTyped"
                 Description="SampleDialog receives a UserId parameter and returns a SampleResult record. The focus trap keeps you inside.">
        <DRYL.Components.Demo.Components.Examples.Dialog.CustomTyped />
    </DemoExample>

    <DemoExample Title="Sizes" Source="Dialog/Sizes"
                 Description="Four width presets via DialogOptions.Size.">
        <DRYL.Components.Demo.Components.Examples.Dialog.Sizes />
    </DemoExample>

    <DemoExample Title="Human in the Middle — AI flow" Source="Dialog/HumanInMiddle"
                 Description="The model streams a proposal into the dialog; the user reviews, edits and approves. Walks Thinking → Streaming → Generated → Active.">
        <DRYL.Components.Demo.Components.Examples.Dialog.HumanInMiddle />
    </DemoExample>

</div>
