@page "/expansion"

<PageTitle>DRYL — Expansion Panels</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <div class="col" style="gap: var(--sp-2);">
        <span class="eyebrow">Layout</span>
        <h2>DrylExpansion</h2>
        <p class="lead">
            Collapsible glass panels. Stack them together — they share their borders
            and form a single connected list. When a panel opens it detaches from its
            siblings with a gap and rounded corners. Body height animates without
            squeezing the content.
        </p>
    </div>

    <section class="col" style="gap: var(--sp-3);">
        <h3>Default — stacked group</h3>
        <div>
            <DrylExpansion Title="Panel One">
                <p>Content for panel one. Any markup is welcome here — paragraphs, lists, nested components.</p>
            </DrylExpansion>
            <DrylExpansion Title="Panel Two">
                <p>Content for panel two. The body animates open and closed without squeezing its content.</p>
            </DrylExpansion>
            <DrylExpansion Title="Panel Three">
                <p>Content for panel three.</p>
            </DrylExpansion>
            <DrylExpansion Title="Panel Four">
                <p>Content for panel four. Closed panels share their borders and form a flat connected list.</p>
            </DrylExpansion>
        </div>
    </section>

    <section class="col" style="gap: var(--sp-3);">
        <h3>With leading icon</h3>
        <div>
            <DrylExpansion Title="Service Health" Icon="Server">
                <p>All systems operational. 99.98% uptime over the last 30 days.</p>
            </DrylExpansion>
            <DrylExpansion Title="Deployments" Icon="Rocket">
                <p>14 successful, 0 failed in the last 24 hours.</p>
                <div style="margin-top: var(--sp-3);">
                    <DrylBadge Kind="DrylBadge.BadgeKind.Success" Dot="true">Healthy</DrylBadge>
                </div>
            </DrylExpansion>
            <DrylExpansion Title="Alerts" Icon="Alert">
                <p>No active alerts. Last incident resolved 3 days ago.</p>
            </DrylExpansion>
        </div>
    </section>

    <section class="col" style="gap: var(--sp-3);">
        <h3>With trailing content</h3>
        <div>
            <DrylExpansion Title="Dependencies">
                <HeaderTrailingContent>
                    <DrylBadge Kind="DrylBadge.BadgeKind.Success">Up to date</DrylBadge>
                </HeaderTrailingContent>
                <ChildContent>
                    <p>All 142 packages are current. No vulnerabilities detected.</p>
                </ChildContent>
            </DrylExpansion>
            <DrylExpansion Title="Environment Variables">
                <HeaderTrailingContent>
                    <DrylBadge Kind="DrylBadge.BadgeKind.Warning">12 configured</DrylBadge>
                </HeaderTrailingContent>
                <ChildContent>
                    <p>Manage secrets and runtime configuration for each environment.</p>
                </ChildContent>
            </DrylExpansion>
        </div>
    </section>

    <section class="col" style="gap: var(--sp-3);">
        <h3>Disabled</h3>
        <div>
            <DrylExpansion Title="Panel One">
                <p>This panel can be toggled.</p>
            </DrylExpansion>
            <DrylExpansion Title="Locked Panel" Icon="Lock" Disabled="true">
                <p>This content is inaccessible.</p>
            </DrylExpansion>
            <DrylExpansion Title="Panel Three">
                <p>This panel can also be toggled.</p>
            </DrylExpansion>
        </div>
    </section>

    <section class="col" style="gap: var(--sp-3);">
        <h3>Single panel</h3>
        <DrylExpansion Title="Standalone" Icon="Info">
            <p>A single <code>DrylExpansion</code> renders with full border-radius on all corners.</p>
        </DrylExpansion>
    </section>

    <section class="col" style="gap: var(--sp-3);">
        <h3>Pre-opened with two-way binding</h3>
        <p style="margin-bottom: var(--sp-3);">
            <code>@@bind-IsOpen</code> lets you control state externally.
            Panel two starts open: <strong>@(_panel2Open ? "open" : "closed")</strong>
        </p>
        <div>
            <DrylExpansion Title="Panel One">
                <p>Toggle me.</p>
            </DrylExpansion>
            <DrylExpansion Title="Panel Two (pre-opened)" @bind-IsOpen="_panel2Open">
                <p>This panel starts open because <code>IsOpen</code> was initialised to <code>true</code>.</p>
            </DrylExpansion>
            <DrylExpansion Title="Panel Three">
                <p>Toggle me too.</p>
            </DrylExpansion>
        </div>
        <div class="row" style="margin-top: var(--sp-3);">
            <DrylButton Variant="DrylButton.ButtonVariant.Secondary"
                        @onclick="() => _panel2Open = !_panel2Open">
                Toggle Panel Two from outside
            </DrylButton>
        </div>
    </section>

</div>

@code {
    private bool _panel2Open = true;
}
