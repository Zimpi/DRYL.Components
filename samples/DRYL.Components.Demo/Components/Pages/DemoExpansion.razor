@page "/expansion"

<PageTitle>DRYL — Expansion Panels</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="expansion">
        Collapsible glass panels. Stack them together — they share their borders
        and form a single connected list. When a panel opens it detaches from its
        siblings with a gap and rounded corners. Body height animates without
        squeezing the content.
    </ComponentDocHeader>

