@page "/app-shell"

<PageTitle>DRYL — App Shell</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="app-shell">
        The application chrome: <code>DrylLayout</code> wires a <code>DrylAppBar</code>,
        a <code>DrylDrawer</code> sidebar and <code>DrylMainContent</code> into a single
        CSS-grid shell. The app bar exposes <code>Start</code> / <code>Center</code> /
        <code>End</code> slots and a <code>Raised</code> elevation; the drawer adds
        operating modes (Auto / Static / Collapsible / Pinnable / Flyout) and an
        icon-rail collapse that reflows the body. This very website runs on it.
    </ComponentDocHeader>

    <DemoExample Title="App bar — slots &amp; elevation" Source="AppShell/AppBarSlots">
        <DRYL.Components.Demo.Components.Examples.AppShell.AppBarSlots />
    </DemoExample>

    <DemoExample Title="Collapsible sidebar shell"
                 Description="DrylLayout coordinates the app-bar toggle with the drawer's collapsed state — the grid column animates to an icon rail and back."
                 Source="AppShell/CollapsibleShell">
        <DRYL.Components.Demo.Components.Examples.AppShell.CollapsibleShell />
    </DemoExample>

    <section class="col" style="gap: var(--sp-3);">
        <h3>Sidebar modes</h3>
        <p class="lead">
            <code>DrylDrawer.Mode</code> selects how the sidebar occupies space.
            <strong>Auto</strong> (default) is an in-flow column on desktop and a
            flyout overlay on mobile. <strong>Static</strong> is always a column.
            <strong>Collapsible</strong> adds the icon-rail toggle shown above.
            <strong>Pinnable</strong> persists that collapsed state to
            <code>localStorage</code>. <strong>Flyout</strong> always overlays the
            content, trapping focus and closing on <kbd>Esc</kbd> or backdrop click.
        </p>
        <DrylCodeBlock Language="html" ShowLineNumbers Code="@_modesSource" />
    </section>

</div>

@code {
    private const string _modesSource = """
        @* Pinnable: collapsed state survives a page reload. *@
        <DrylDrawer Mode="SidebarMode.Pinnable" PersistStateKey="dryl.nav" @bind-Collapsed="navCollapsed">
            <Header><AppBrand /></Header>
            <Content>
                <DrylNavGroup Title="Library">
                    <DrylNavLink Href="" Icon="Home" Match="NavLinkMatch.All">Overview</DrylNavLink>
                </DrylNavGroup>
            </Content>
            <Footer><DrylNavLink Href="settings" Icon="Settings">Settings</DrylNavLink></Footer>
        </DrylDrawer>

        @* Flyout: always an overlay; Esc / backdrop close it, focus is trapped. *@
        <DrylDrawer Mode="SidebarMode.Flyout" @bind-Open="navOpen">
            <DrylNavGroup Title="Menu">
                <DrylNavLink Href="profile" Icon="User">Profile</DrylNavLink>
            </DrylNavGroup>
        </DrylDrawer>
        """;
}
