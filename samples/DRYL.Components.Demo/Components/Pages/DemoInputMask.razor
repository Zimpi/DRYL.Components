@page "/input-mask"

<PageTitle>DRYL — Input Mask</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="input-mask">
        Masked input that auto-formats structured data as the user types.
        Pick a predefined <code>MaskType</code> (Phone, IBAN, postal code,
        credit card) or pass a <code>CustomPattern</code> using
        <code>#</code> for digits and <code>A</code> for letters.
    </ComponentDocHeader>

    <DemoExample Title="Predefined masks" Source="InputMask/Predefined">
        <DRYL.Components.Demo.Components.Examples.InputMask.Predefined />
    </DemoExample>

    <DemoExample Title="Custom pattern" Source="InputMask/CustomPattern">
        <DRYL.Components.Demo.Components.Examples.InputMask.CustomPattern />
    </DemoExample>

    <DemoExample Title="States" Source="InputMask/States">
        <DRYL.Components.Demo.Components.Examples.InputMask.States />
    </DemoExample>

    <DemoExample Title="AI mode" Source="InputMask/AiMode">
        <DRYL.Components.Demo.Components.Examples.InputMask.AiMode />
    </DemoExample>

    <DemoExample Title="Form validation" Source="InputMask/Validation">
        <DRYL.Components.Demo.Components.Examples.InputMask.Validation />
    </DemoExample>

    <DemoExample Title="Live preview" Source="InputMask/LivePreview">
        <DRYL.Components.Demo.Components.Examples.InputMask.LivePreview />
    </DemoExample>

</div>
