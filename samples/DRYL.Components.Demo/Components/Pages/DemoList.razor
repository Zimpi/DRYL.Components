@page "/list"

<PageTitle>DRYL — List</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="list">
        A token-driven list container. Pick a marker <code>Variant</code> (DRYL dot, disc,
        dash or ordered decimal), a <code>Density</code>, and optional hairline
        <code>Dividers</code>. Items take an <code>Icon</code>, <code>Start</code> / <code>End</code>
        slots, <code>Selected</code> / <code>Disabled</code> states and become keyboard-focusable
        when given an <code>OnClick</code>. Nest a <code>DrylList</code> inside an item for sub-lists.
    </ComponentDocHeader>

    <DemoExample Title="Markers" Source="List/Markers">
        <DRYL.Components.Demo.Components.Examples.List.Markers />
    </DemoExample>

    <DemoExample Title="Interactive rows, icons &amp; slots" Source="List/Interactive">
        <DRYL.Components.Demo.Components.Examples.List.Interactive />
    </DemoExample>

    <DemoExample Title="Nesting" Source="List/Nested">
        <DRYL.Components.Demo.Components.Examples.List.Nested />
    </DemoExample>

</div>
