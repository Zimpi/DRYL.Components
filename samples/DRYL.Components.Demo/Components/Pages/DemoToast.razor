@page "/toasts"

<PageTitle>DRYL — Toast</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="toasts">
        Service-driven glass notifications with a spring entrance, a one-shot
        shine sweep and a hover-pausable progress bar. Variants stay glassy under
        their semantic color, and AI mode dominates the visual when the toast is
        communicating model activity in the background.
    </ComponentDocHeader>

    <DemoExample Title="Variants" Source="Toast/Variants"
                 Description="Four semantic flavors plus a neutral default — each keeps the dark glass surface with a colored left rail, icon chip and soft glow.">
        <DRYL.Components.Demo.Components.Examples.Toast.Variants />
    </DemoExample>

    <DemoExample Title="Title + message" Source="Toast/TitleMessage"
                 Description="Pass a title for emphasis; the body sits below in a quieter weight.">
        <DRYL.Components.Demo.Components.Examples.Toast.TitleMessage />
    </DemoExample>

    <DemoExample Title="Custom content — buttons inside the toast" Source="Toast/CustomContent"
                 Description="Use Show<TComponent> to drop any component into the body. It receives IDrylToastInstance to close its own toast — perfect for an Undo.">
        <DRYL.Components.Demo.Components.Examples.Toast.CustomContent />
    </DemoExample>

    <DemoExample Title="AI-aware toasts" Source="Toast/AiAware"
                 Description="Set ToastOptions.Ai and the AI aura takes over the visual; the variant accent survives only on the icon chip.">
        <DRYL.Components.Demo.Components.Examples.Toast.AiAware />
    </DemoExample>

    <DemoExample Title="Duration &amp; persistence" Source="Toast/Duration"
                 Description="Default duration is 5 s. Duration = 0 keeps the toast open until dismissed. Hovering pauses the timer.">
        <DRYL.Components.Demo.Components.Examples.Toast.Duration />
    </DemoExample>

    <DemoExample Title="Stack — fire a bunch at once" Source="Toast/Stack"
                 Description="Toasts stack vertically at the chosen anchor; new ones spring in from the nearest edge.">
        <DRYL.Components.Demo.Components.Examples.Toast.Stack />
    </DemoExample>

</div>
