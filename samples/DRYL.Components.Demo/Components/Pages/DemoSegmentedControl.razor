@page "/segmented-control"

<PageTitle>DRYL — Segmented Control</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="segmented-control">
        A compact, iOS-style switcher for exclusive view or mode selection in
        toolbars and headers — List / Board / Calendar, Day / Week / Month. A glass
        track holds equal-width segments and a single accent indicator glides between
        them. Bind the chosen value with <code>@@bind-Value</code>; it carries no
        panel of its own.
    </ComponentDocHeader>

    <DemoExample Title="Basic" Source="SegmentedControl/Basic">
        <DRYL.Components.Demo.Components.Examples.SegmentedControl.Basic />
    </DemoExample>

    <DemoExample Title="Icons and labels" Source="SegmentedControl/IconsAndLabels">
        <DRYL.Components.Demo.Components.Examples.SegmentedControl.IconsAndLabels />
    </DemoExample>

    <DemoExample Title="Sizes" Source="SegmentedControl/Sizes"
                 Description="Small, Medium (default) and Large mirror the DrylButton height scale.">
        <DRYL.Components.Demo.Components.Examples.SegmentedControl.Sizes />
    </DemoExample>

    <DemoExample Title="Block" Source="SegmentedControl/Block"
                 Description="Stretches to fill its container; segments share the width equally.">
        <DRYL.Components.Demo.Components.Examples.SegmentedControl.Block />
    </DemoExample>

    <DemoExample Title="Disabled" Source="SegmentedControl/Disabled"
                 Description="Disable a single segment or the whole control. Disabled segments are skipped by keyboard navigation.">
        <DRYL.Components.Demo.Components.Examples.SegmentedControl.Disabled />
    </DemoExample>

</div>
