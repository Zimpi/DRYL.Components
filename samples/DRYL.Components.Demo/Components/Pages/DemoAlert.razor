@page "/alerts"

<PageTitle>DRYL — Alerts</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="alerts">
        Feedback-Banner für Hinweise, Statusmeldungen und KI-generierte Inhalte.
        Fünf Varianten, optionaler Titel, Schließen-Button und vollständige AI-Mode-Unterstützung.
    </ComponentDocHeader>

    <DemoExample Title="Varianten" Source="Alert/Varianten">
        <DRYL.Components.Demo.Components.Examples.Alert.Varianten />
    </DemoExample>

    <DemoExample Title="Nur Nachricht — kein Titel" Source="Alert/NoTitle">
        <DRYL.Components.Demo.Components.Examples.Alert.NoTitle />
    </DemoExample>

    <DemoExample Title="Dismissible" Source="Alert/Dismissible"
                 Description="Alerts können mit einem Schließen-Button versehen werden. OnDismiss liefert das Callback.">
        <DRYL.Components.Demo.Components.Examples.Alert.Dismissible />
    </DemoExample>

    <DemoExample Title="Kein Icon" Source="Alert/NoIcon"
                 Description="Mit Icon=&quot;&quot; wird das Icon-Chip komplett unterdrückt.">
        <DRYL.Components.Demo.Components.Examples.Alert.NoIcon />
    </DemoExample>

    <DemoExample Title="AI Mode — alle Zustände" Source="Alert/AiStates"
                 Description="Der Ai-Parameter treibt Gradientrahmen, Glow und den One-Shot-Reveal unabhängig von der semantischen Variante.">
        <DRYL.Components.Demo.Components.Examples.Alert.AiStates />
    </DemoExample>

    <DemoExample Title="Lifecycle-Simulation" Source="Alert/Lifecycle"
                 Description="Führt den Alert durch None → Thinking → Streaming → Generated → Active.">
        <DRYL.Components.Demo.Components.Examples.Alert.Lifecycle />
    </DemoExample>

</div>
