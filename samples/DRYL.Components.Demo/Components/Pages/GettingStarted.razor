@page "/getting-started"

<PageTitle>DRYL — Get Started</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <div class="col" style="gap: var(--sp-2);">
        <span class="eyebrow">Get Started</span>
        <h2>Add DRYL to your app</h2>
        <p class="lead">
            DRYL is a single NuGet package with zero JavaScript dependencies. Add the package,
            register the services, reference the stylesheet and script, and you are ready to go.
        </p>
    </div>

    <section class="col" style="gap: var(--sp-3);">
        <h3>1 · Install the package</h3>
        <DrylCodeBlock Language="bash" Code="@_install" />
    </section>

    <section class="col" style="gap: var(--sp-3);">
        <h3>2 · Register the services</h3>
        <p class="lead">In <code>Program.cs</code>, register the DRYL services alongside Razor components.</p>
        <DrylCodeBlock Language="csharp" Code="@_register" ShowLineNumbers />
    </section>

    <section class="col" style="gap: var(--sp-3);">
        <h3>3 · Reference the assets</h3>
        <p class="lead">
            Add the stylesheet to the <code>&lt;head&gt;</code> and the script before the closing
            <code>&lt;/body&gt;</code> of your host page (<code>App.razor</code> or <code>_Host.cshtml</code>).
        </p>
        <DrylCodeBlock Language="html" Code="@_assets" ShowLineNumbers />
    </section>

    <section class="col" style="gap: var(--sp-3);">
        <h3>4 · Import the namespace</h3>
        <p class="lead">Add a using to <code>_Imports.razor</code> so the components are in scope everywhere.</p>
        <DrylCodeBlock Language="csharp" Code="@_imports" />
    </section>

    <DemoExample Title="5 · Use a component"
                 Description="That's it — drop a component into any page. Switch to the Code tab to see the markup."
                 Source="GettingStarted/Hello" >
        <DRYL.Components.Demo.Components.Examples.GettingStarted.Hello />
    </DemoExample>

</div>

@code {
    private const string _install = "dotnet add package DRYL.Components";

    private const string _register = """
        using DRYL.Components;

        var builder = WebApplication.CreateBuilder(args);

        builder.Services.AddRazorComponents()
            .AddInteractiveServerComponents();

        // Register DRYL services (dialogs, toasts, …)
        builder.Services.AddDrylComponents();
        """;

    private const string _assets = """
        <head>
            <!-- … -->
            <link rel="stylesheet" href="_content/DRYL.Components/dryl.css" />
        </head>
        <body>
            <!-- … -->
            <script src="_content/DRYL.Components/js/dryl.js"></script>
        </body>
        """;

    private const string _imports = "@using DRYL.Components";
}
