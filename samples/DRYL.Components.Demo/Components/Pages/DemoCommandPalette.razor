@page "/command-palette"

<PageTitle>DRYL — Command Palette</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="command-palette">
        A full-screen command launcher overlay that unifies navigation, actions and AI intents in a
        single keyboard-first entry point. Press <code>Ctrl K</code> anywhere in the app, or use the
        buttons below to open each variant.
    </ComponentDocHeader>

    <DemoExample Title="Basic — static items" Source="CommandPalette/Basic"
                 Description="Pass a CommandItem[] to Items; the palette filters client-side. Three item types: Navigate, Action, AiIntent.">
        <DRYL.Components.Demo.Components.Examples.CommandPalette.Basic />
    </DemoExample>

    <DemoExample Title="Category grouping" Source="CommandPalette/Grouping"
                 Description="Set CommandItem.Category to cluster items under named headers, alpha-sorted before uncategorised items.">
        <DRYL.Components.Demo.Components.Examples.CommandPalette.Grouping />
    </DemoExample>

    <DemoExample Title="Async SearchProvider" Source="CommandPalette/AsyncSearch"
                 Description="Provide a Func<string, Task<CommandItem[]>> for server-driven search. A 250 ms debounce prevents excessive calls.">
        <DRYL.Components.Demo.Components.Examples.CommandPalette.AsyncSearch />
    </DemoExample>

    <DemoExample Title="AI intent — result panel" Source="CommandPalette/AiIntent"
                 Description="AiIntent items keep the palette open after selection so the AI result panel can stream its response.">
        <DRYL.Components.Demo.Components.Examples.CommandPalette.AiIntent />
    </DemoExample>

</div>
