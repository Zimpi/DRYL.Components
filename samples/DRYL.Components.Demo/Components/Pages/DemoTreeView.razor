@page "/tree"

<PageTitle>DRYL — Tree View</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="tree">
        Hierarchical tree with full keyboard navigation (WAI-ARIA tree pattern):
        arrows move and expand/collapse, Home/End jump, Enter/Space select.
        Nodes own their expand state; the view owns selection via
        <code>@@bind-SelectedValue</code>.
    </ComponentDocHeader>

    <DemoExample Title="Hierarchical tree" Source="TreeView/Files">
        <DRYL.Components.Demo.Components.Examples.TreeView.Files />
    </DemoExample>

</div>
