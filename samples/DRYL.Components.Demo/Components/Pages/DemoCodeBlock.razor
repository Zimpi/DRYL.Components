@page "/code-block"

<PageTitle>DRYL — Code Block</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="code-block">
        A glass code surface with a language label and a copy-to-clipboard
        button — the natural home for code emitted by a model. Code is
        syntax-highlighted server-side by a dependency-free C# tokenizer
        (no JS) and HTML-encoded, so it is safe against injection.
    </ComponentDocHeader>

    <DemoExample Title="Basic" Source="CodeBlock/Basic">
        <DRYL.Components.Demo.Components.Examples.CodeBlock.Basic />
    </DemoExample>

    <DemoExample Title="With line numbers" Source="CodeBlock/LineNumbers">
        <DRYL.Components.Demo.Components.Examples.CodeBlock.LineNumbers />
    </DemoExample>

    <DemoExample Title="Languages" Source="CodeBlock/Languages">
        <DRYL.Components.Demo.Components.Examples.CodeBlock.Languages />
    </DemoExample>

    <DemoExample Title="Highlighting off" Source="CodeBlock/HighlightingOff"
                 Description="Set Highlight=&quot;false&quot; to render verbatim plain text.">
        <DRYL.Components.Demo.Components.Examples.CodeBlock.HighlightingOff />
    </DemoExample>

    <DemoExample Title="AI states" Source="CodeBlock/AiStates">
        <DRYL.Components.Demo.Components.Examples.CodeBlock.AiStates />
    </DemoExample>

</div>
