@page "/tool-call"

<PageTitle>DRYL — Tool Call</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="tool-call">
        Visualises a single agent tool / function call — name, a live status pill
        and a collapsible body with the arguments and result as JSON. Status maps
        to the shared <code>AiState</code> vocabulary; stack several in a
        <code>DrylTimeline</code> for a full agent trace.
    </ComponentDocHeader>

    <DemoExample Title="States" Source="ToolCall/States">
        <DRYL.Components.Demo.Components.Examples.ToolCall.States />
    </DemoExample>

    <DemoExample Title="Agent trace (in a timeline)" Source="ToolCall/AgentTrace">
        <DRYL.Components.Demo.Components.Examples.ToolCall.AgentTrace />
    </DemoExample>

</div>
