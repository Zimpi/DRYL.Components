@page "/components"

<PageTitle>DRYL — Components</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <div class="col" style="gap: var(--sp-2);">
        <span class="eyebrow">Library</span>
        <h2>Components</h2>
        <p class="lead">
            @ComponentCatalog.Entries.Count components across @ComponentCatalog.CategoryOrder.Count
            categories — each documented with live examples and the exact code that produced them.
        </p>
    </div>

    @foreach (var group in ComponentCatalog.ByCategory())
    {
        <section class="col" style="gap: var(--sp-3);">
            <h3>@group.Key</h3>
            <div class="stagger"
                 style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--sp-4);">
                @foreach (var entry in group)
                {
                    <a href="@entry.Slug" style="text-decoration: none; color: inherit;">
                        <DrylCard>
                            <div class="col" style="gap: var(--sp-3);">
                                <div class="row" style="justify-content: space-between; align-items: center;">
                                    <DrylIcon Name="@entry.Icon" Size="20" />
                                    @if (entry.Ai)
                                    {
                                        <DrylBadge Kind="DrylBadge.BadgeKind.Accent" Dot="true">AI</DrylBadge>
                                    }
                                </div>
                                <div class="col" style="gap: var(--sp-1);">
                                    <h4 style="margin: 0;">@entry.Title</h4>
                                    <p style="margin: 0; color: var(--fg-muted); font-size: 13px;">@entry.Summary</p>
                                </div>
                            </div>
                        </DrylCard>
                    </a>
                }
            </div>
        </section>
    }

</div>
