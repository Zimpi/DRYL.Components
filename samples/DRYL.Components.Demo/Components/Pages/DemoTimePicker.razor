@page "/timepicker"

<PageTitle>DRYL — Time Picker</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="timepicker">
        Time-only picker with a scrollable hour and minute panel.
        Click the input to open, select hour and minute, then press
        <strong>Done</strong> or <code>Enter</code> to commit.
        Use <code>MinuteStep</code> to limit granularity.
    </ComponentDocHeader>

    <DemoExample Title="Basics" Source="TimePicker/Basics">
        <DRYL.Components.Demo.Components.Examples.TimePicker.Basics />
    </DemoExample>

    <DemoExample Title="Min / Max" Source="TimePicker/MinMax">
        <DRYL.Components.Demo.Components.Examples.TimePicker.MinMax />
    </DemoExample>

    <DemoExample Title="States" Source="TimePicker/States">
        <DRYL.Components.Demo.Components.Examples.TimePicker.States />
    </DemoExample>

    <DemoExample Title="AI mode" Source="TimePicker/AiMode">
        <DRYL.Components.Demo.Components.Examples.TimePicker.AiMode />
    </DemoExample>

    <DemoExample Title="Form validation" Source="TimePicker/Validation">
        <DRYL.Components.Demo.Components.Examples.TimePicker.Validation />
    </DemoExample>

    <DemoExample Title="Live preview" Source="TimePicker/LivePreview">
        <DRYL.Components.Demo.Components.Examples.TimePicker.LivePreview />
    </DemoExample>

</div>
