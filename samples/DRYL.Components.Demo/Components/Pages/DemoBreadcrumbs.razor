@page "/breadcrumbs"

<PageTitle>DRYL — Breadcrumbs</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="breadcrumbs">
        Hierarchical navigation trail. Each <code>DrylBreadcrumbItem</code>
        registers with the parent; the last crumb renders as the current page
        (<code>aria-current="page"</code>). Set <code>MaxItems</code> to collapse
        the middle of a deep trail into an ellipsis.
    </ComponentDocHeader>

    <DemoExample Title="Basics" Source="Breadcrumbs/Basics">
        <DRYL.Components.Demo.Components.Examples.Breadcrumbs.Basics />
    </DemoExample>

    <DemoExample Title="With icons" Source="Breadcrumbs/Icons">
        <DRYL.Components.Demo.Components.Examples.Breadcrumbs.Icons />
    </DemoExample>

    <DemoExample Title="Collapsed (MaxItems = 3)" Source="Breadcrumbs/Collapsed">
        <DRYL.Components.Demo.Components.Examples.Breadcrumbs.Collapsed />
    </DemoExample>

    <DemoExample Title="Custom separator" Source="Breadcrumbs/CustomSeparator">
        <DRYL.Components.Demo.Components.Examples.Breadcrumbs.CustomSeparator />
    </DemoExample>

</div>
