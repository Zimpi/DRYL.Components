@page "/pagination"

<PageTitle>DRYL — Pagination</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="pagination">
        Page navigation with an optional rows-per-page selector. Used inside
        <code>DrylTable</code>, but standalone too — image galleries, search
        results, any paged list. Pages are zero-indexed on the wire; the UI
        shows 1-based labels. The active page carries <code>aria-current="page"</code>.
    </ComponentDocHeader>

    <DemoExample Title="Full — with page-size selector" Source="Pagination/Full"
                 Description="The default: first / previous / numbered pages / next / last, plus a rows selector.">
        <DRYL.Components.Demo.Components.Examples.Pagination.Full />
    </DemoExample>

    <DemoExample Title="Minimal — buttons only" Source="Pagination/Minimal"
                 Description="Set ShowPageSize=&quot;false&quot; to hide the rows selector.">
        <DRYL.Components.Demo.Components.Examples.Pagination.Minimal />
    </DemoExample>

    <DemoExample Title="Many pages — ellipsis logic" Source="Pagination/ManyPages"
                 Description="With more than seven pages, the middle collapses into an ellipsis that follows the current page.">
        <DRYL.Components.Demo.Components.Examples.Pagination.ManyPages />
    </DemoExample>

    <DemoExample Title="Custom page sizes" Source="Pagination/CustomSizes"
                 Description="Provide your own PageSizeOptions.">
        <DRYL.Components.Demo.Components.Examples.Pagination.CustomSizes />
    </DemoExample>

    <DemoExample Title="Empty — no items" Source="Pagination/Empty"
                 Description="With TotalCount=&quot;0&quot; the info area shows &quot;No items&quot; and the controls clamp to a single page.">
        <DRYL.Components.Demo.Components.Examples.Pagination.Empty />
    </DemoExample>

</div>
