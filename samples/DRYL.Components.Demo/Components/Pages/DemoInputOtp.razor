@page "/otp"

<PageTitle>DRYL — OTP Input</PageTitle>

<div class="col fade-in" style="gap: var(--sp-7);">

    <ComponentDocHeader Slug="otp">
        Fixed-box code entry for OTP and 2FA flows. Type a digit to auto-advance;
        paste a full code to fill all boxes at once. Use <code>@@bind-Value</code>
        to get the raw string and validate its length via DataAnnotations.
    </ComponentDocHeader>

    <DemoExample Title="Basics" Source="InputOtp/Basics">
        <DRYL.Components.Demo.Components.Examples.InputOtp.Basics />
    </DemoExample>

    <DemoExample Title="States" Source="InputOtp/States">
        <DRYL.Components.Demo.Components.Examples.InputOtp.States />
    </DemoExample>

    <DemoExample Title="AI mode" Source="InputOtp/AiMode">
        <DRYL.Components.Demo.Components.Examples.InputOtp.AiMode />
    </DemoExample>

    <DemoExample Title="Form validation" Source="InputOtp/Validation">
        <DRYL.Components.Demo.Components.Examples.InputOtp.Validation />
    </DemoExample>

    <DemoExample Title="Live preview" Source="InputOtp/LivePreview">
        <DRYL.Components.Demo.Components.Examples.InputOtp.LivePreview />
    </DemoExample>

</div>
