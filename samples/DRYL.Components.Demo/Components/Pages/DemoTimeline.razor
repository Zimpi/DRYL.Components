    </DemoExample>

    <DemoExample Title="AI agent trace" Source="Timeline/AiTrace"
                 Description="Drive the live step through the AI lifecycle.">
        <DRYL.Components.Demo.Components.Examples.Timeline.AiTrace />
    </DemoExample>

</div>
