    </DemoExample>

    <DemoExample Title="MaxTags" Source="ChipInput/MaxTags">
        <DRYL.Components.Demo.Components.Examples.ChipInput.MaxTags />
    </DemoExample>

    <DemoExample Title="States" Source="ChipInput/States">
        <DRYL.Components.Demo.Components.Examples.ChipInput.States />
    </DemoExample>

    <DemoExample Title="AI mode" Source="ChipInput/AiMode">
        <DRYL.Components.Demo.Components.Examples.ChipInput.AiMode />
    </DemoExample>

    <DemoExample Title="Live preview" Source="ChipInput/LivePreview">
